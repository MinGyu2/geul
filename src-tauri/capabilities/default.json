{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "주 창의 핵심 권한·문서 세션·엔진 편집·보존 검사 저장·창 종료 확인만 허용한다. Linux native 파일 선택, 유효한 DOCX 새 파일 생성, 동일 형식의 새 목적지 Save As를 지원한다. Save As도 모든 보존 검사를 통과해야 하며 기존 목적지를 덮어쓰지 않는다. 파일 시스템·셸 플러그인 권한은 부여하지 않는다.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-window-close-confirmed",
    "allow-document-open",
    "allow-document-close",
    "allow-document-session",
    "allow-document-sessions",
    "allow-document-load",
    "allow-document-set-state",
    "allow-document-commit",
    "allow-docx-load",
    "allow-docx-view",
    "allow-docx-selection-text",
    "allow-clipboard-read-text",
    "allow-docx-edit",
    "allow-docx-render",
    "allow-docx-roundtrip",
    "allow-docx-preflight",
    "allow-docx-save",
    "allow-document-original",
    "allow-document-preflight",
    "allow-document-save",
    "allow-document-file-dialog",
    "allow-document-new",
    "allow-document-save-as",
    "allow-docx-save-as",
    "allow-recovery-list",
    "allow-recovery-restore",
    "allow-recovery-discard",
    "allow-recovery-forget-session",
    "allow-docx-checkpoint",
    "allow-document-checkpoint"
  ]
}
