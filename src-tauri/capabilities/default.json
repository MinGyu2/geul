{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "주 창의 핵심 권한·문서 세션·엔진 편집·보존 검사 저장·창 종료 확인만 허용한다. Linux native 파일 선택, 유효한 DOCX 새 파일 생성, 동일 형식의 새 목적지 Save As를 지원한다. Save As도 모든 보존 검사를 통과해야 하며 기존 목적지를 덮어쓰지 않는다. PDF 내보내기는 native 대화상자에서 고른 .pdf 경로에만 쓰며(문서 세션·원본은 바꾸지 않음), 기존 일반 .pdf 파일은 PDF 전용 대화상자(pdf_export_dialog)의 GTK 덮어쓰기 확인이 그 내보내기에 발급한 일회용 허가가 있을 때만 신원 조건 원자적 교체로 바꾼다. 글꼴은 카탈로그 조회·시스템 목록 새로 고침, native 대화상자에서 고른 글꼴 파일 하나의 검증 등록(앱 전용 fonts 폴더), 사용자 글꼴 제거, 등록된 사용자 글꼴 바이트 조회(RHWP 화면용)만 허용한다. 파일 시스템·셸 플러그인 권한은 부여하지 않는다.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-window-close-confirmed",
    "allow-document-open",
    "allow-document-close",
    "allow-document-session",
    "allow-document-sessions",
    "allow-document-load",
    "allow-document-set-state",
    "allow-document-commit",
    "allow-docx-load",
    "allow-docx-view",
    "allow-docx-selection-text",
    "allow-clipboard-read-text",
    "allow-picture-import",
    "allow-docx-edit",
    "allow-docx-render",
    "allow-docx-roundtrip",
    "allow-docx-preflight",
    "allow-docx-save",
    "allow-document-original",
    "allow-document-preflight",
    "allow-document-save",
    "allow-document-file-dialog",
    "allow-pdf-export-dialog",
    "allow-document-new",
    "allow-document-save-as",
    "allow-docx-save-as",
    "allow-recovery-list",
    "allow-recovery-restore",
    "allow-recovery-discard",
    "allow-recovery-forget-session",
    "allow-docx-checkpoint",
    "allow-document-checkpoint",
    "allow-document-export-pdf",
    "allow-pdf-release-overwrite-grant",
    "allow-docx-export-pdf",
    "allow-font-catalog",
    "allow-font-refresh",
    "allow-font-register",
    "allow-font-remove",
    "allow-font-user-face"
  ]
}
