+/// Stored rendering matrices are retained verbatim. The body path editor separately
+/// maps the modeled rotation and flips between display and source coordinates.
+fn geul_path_has_identity_matrices(raw: &[u8]) -> bool {
+    let Some((count, matrices)) = raw.split_at_checked(2) else {
+        return false;
+    };
+    let count = u16::from_le_bytes([count[0], count[1]]) as usize;
+    count == 1 && matrices.len() == 48 + count * 96
+        && matrices.chunks_exact(48).all(|matrix| {
+            matrix.chunks_exact(8).enumerate().all(|(index, bytes)| {
+                let value = f64::from_le_bytes(bytes.try_into().unwrap());
+                value == if index == 0 || index == 4 { 1.0 } else { 0.0 }
+            })
+        })
+}
+
 fn geul_same_point(a: &crate::model::Point, b: &crate::model::Point) -> bool {
     a.x == b.x && a.y == b.y
 }
