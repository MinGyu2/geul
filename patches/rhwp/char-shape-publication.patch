+    /// Prove per-ID correspondence with the actual reopened export. Keep the live
+    /// definitions for history reconciliation: HWP reparsing adds raw_data and
+    /// normalizes attr, which are not an identity change in the emitted format.
+    pub fn capture_publishing_char_shapes_native(
+        &self,
+        exported: &Self,
+    ) -> Result<Vec<crate::model::style::CharShape>, HwpError> {
+        use crate::parser::FileFormat;
+        use crate::serializer::{char_shape::serialize_char_shape, hwpx::char_shapes::char_pr_xml};
+        let fail = || HwpError::RenderError("publication character shape identity mismatch".into());
+        let live = &self.document.doc_info.char_shapes;
+        let output = &exported.document.doc_info.char_shapes;
+        if self.source_format != exported.source_format || live.len() != output.len() {
+            return Err(fail());
+        }
+        for (id, (before, after)) in live.iter().zip(output).enumerate() {
+            let equal = match self.source_format {
+                FileFormat::Hwp => {
+                    // Raw bytes remain authoritative for source records. Also
+                    // compare effective properties to catch inconsistent raw/IR
+                    // values that would silently lose a live formatting change.
+                    let effective = serialize_char_shape(before);
+                    let parsed = serialize_char_shape(after);
+                    before.raw_data.as_deref().unwrap_or(&effective)
+                        == after.raw_data.as_deref().unwrap_or(&parsed)
+                        && effective == parsed
+                }
+                FileFormat::Hwpx => {
+                    let id = u32::try_from(id).map_err(|_| fail())?;
+                    char_pr_xml(id, before).map_err(|_| fail())?
+                        == char_pr_xml(id, after).map_err(|_| fail())?
+                }
+                _ => false,
+            };
+            if !equal { return Err(fail()); }
+        }
+        Ok(live.clone())
+    }
