+    /// Rebase a restored live model onto definitions actually exported by this session.
+    /// Original definitions keep their exact identity, including opaque source data.
+    /// Only known mutable appended references may move; snapshots are never modified.
+    pub fn reconcile_char_shapes_native(
+        &mut self,
+        prefix: &[crate::model::style::CharShape],
+        original: usize,
+    ) -> Result<String, HwpError> {
+        let fail = || HwpError::RenderError("incompatible published character shapes".into());
+        let current = &self.document.doc_info.char_shapes;
+        if original > current.len() || original > prefix.len() {
+            return Err(fail());
+        }
+        // PartialEq deliberately ignores raw/source fields, so it is insufficient here.
+        let keys = |shapes: &[crate::model::style::CharShape]| {
+            shapes
+                .iter()
+                .map(serde_json::to_vec)
+                .collect::<Result<Vec<_>, _>>()
+                .map_err(|_| fail())
+        };
+        let old_keys = keys(current)?;
+        let mut new_keys = keys(prefix)?;
+        if old_keys[..original] != new_keys[..original] {
+            return Err(fail());
+        }
+        // These buffers survive Document snapshot restore. Their appended IDs belong
+        // to a different table generation, so a mapping derived from the restored
+        // document cannot prove their meaning. Original IDs are stable in both.
+        let mut unowned_buffer_ref = false;
+        let mut check_buffer = |id: &mut u32, _: Site| {
+            unowned_buffer_ref |= (*id as usize) >= original;
+        };
+        if let Some(clipboard) = self.clipboard.as_mut() {
+            visit_paragraphs(&mut clipboard.paragraphs, &mut check_buffer);
+        }
+        if let Some(transpose) = self.table_transpose_clipboard.as_mut() {
+            for row in &mut transpose.data.cells {
+                for cell in row {
+                    visit_paragraphs(cell, &mut check_buffer);
+                }
+            }
+        }
+        if unowned_buffer_ref {
+            return Err(fail());
+        }
+        let mut shapes = prefix.to_vec();
+        let mut map: Vec<u32> = (0..original as u32).collect();
+        for (old, key) in old_keys.iter().enumerate().skip(original) {
+            let next = if new_keys.get(old) == Some(key) {
+                old
+            } else if let Some(found) = new_keys.iter().position(|candidate| candidate == key) {
+                found
+            } else {
+                let next = shapes.len();
+                shapes.push(current[old].clone());
+                new_keys.push(key.clone());
+                next
+            };
+            map.push(u32::try_from(next).map_err(|_| fail())?);
+        }
+        // Prove the complete mapping before changing the live table or any reference.
+        let mut invalid = false;
+        self.visit_char_shape_refs(&mut |id, site| {
+            if *id == u32::MAX && site == Site::Fixed {
+                return;
+            }
+            match map.get(*id as usize) {
+                Some(next) => invalid |= site == Site::Fixed && next != id,
+                None => invalid = true,
+            }
+        });
+        if invalid {
+            return Err(fail());
+        }
+        if old_keys == new_keys {
+            return Ok("{\"ok\":true}".into());
+        }
+        for section in &mut self.document.sections {
+            let mut changed = false;
+            let mut remap = |id: &mut u32, site: Site| {
+                if site == Site::Remappable && map[*id as usize] != *id {
+                    *id = map[*id as usize];
+                    changed = true;
+                }
+            };
+            visit_paragraphs(&mut section.paragraphs, &mut remap);
+            for master in &mut section.section_def.master_pages {
+                visit_paragraphs(&mut master.paragraphs, &mut remap);
+            }
+            if changed {
+                section.raw_stream = None;
+            }
+        }
+        let mut remap = |id: &mut u32, site: Site| {
+            if site == Site::Remappable {
+                *id = map[*id as usize];
+            }
+        };
+        if let Some(clipboard) = self.clipboard.as_mut() {
+            visit_paragraphs(&mut clipboard.paragraphs, &mut remap);
+        }
+        if let Some(transpose) = self.table_transpose_clipboard.as_mut() {
+            for row in &mut transpose.data.cells {
+                for cell in row {
+                    visit_paragraphs(cell, &mut remap);
+                }
+            }
+        }
+        self.document.doc_info.char_shapes = shapes;
+        self.document.doc_info.raw_stream_dirty = true;
+        self.rebuild_derived_state();
+        Ok("{\"ok\":true}".into())
+    }
