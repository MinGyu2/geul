+#[derive(Clone, Copy)]
+struct GeulHwpxGroupChildTransform {
+    x: i32,
+    y: i32,
+    width: u32,
+    height: u32,
+    scale_x: f64,
+    scale_y: f64,
+}
+
+fn geul_group_scale_supported(value: f64) -> bool {
+    value == 0.5 || value == 1.0 || value == 2.0
+}
+
+fn geul_scaled_dimension(local: u32, scale: f64) -> Option<u32> {
+    let displayed = f64::from(local) * scale.abs();
+    if !displayed.is_finite() || displayed.fract() != 0.0 || displayed < 1.0 || displayed > f64::from(MAX_RECT_DIM_HU) {
+        return None;
+    }
+    Some(displayed as u32)
+}
+
+fn geul_hwpx_group_child_transform(
+    sa: &crate::model::shape::ShapeComponentAttr,
+    local_width: u32,
+    local_height: u32,
+) -> Option<GeulHwpxGroupChildTransform> {
+    if sa.rotation_angle != 0 || sa.horz_flip || sa.vert_flip || (sa.flip & 3) != 0
+        || !sa.render_sx.is_finite() || !sa.render_sy.is_finite()
+        || !sa.render_b.is_finite() || !sa.render_c.is_finite()
+        || sa.render_b != 0.0 || sa.render_c != 0.0
+        || !geul_group_scale_supported(sa.render_sx) || !geul_group_scale_supported(sa.render_sy)
+    {
+        return None;
+    }
+
+    // Accept identity matrix chains for existing group children, or one
+    // canonical HWPX scale pair for a transformed child. Rotation, shear,
+    // scale/rotation matrix offsets, composite scale chains, and malformed raw
+    // data stay fail-closed. The separate transMatrix translation remains editable.
+    if !sa.raw_rendering.is_empty() {
+        let (count_bytes, rest) = sa.raw_rendering.split_at_checked(2)?;
+        let count = u16::from_le_bytes([count_bytes[0], count_bytes[1]]) as usize;
+        if count > 64 || count.checked_mul(96).and_then(|n| n.checked_add(48)) != Some(rest.len()) {
+            return None;
+        }
+        let trans = geul_read_matrix_f64_le(&rest[..48])?;
+        if trans[0] != 1.0 || trans[1] != 0.0 || trans[3] != 0.0 || trans[4] != 1.0 {
+            return None;
+        }
+        let mut composite_scale = (1.0, 1.0);
+        for (index, pair) in rest[48..].chunks_exact(96).enumerate() {
+            let scale = geul_read_matrix_f64_le(&pair[..48])?;
+            let rotation = geul_read_matrix_f64_le(&pair[48..])?;
+            if !geul_is_exact_identity_matrix(&rotation) {
+                return None;
+            }
+            if !geul_is_exact_identity_matrix(&scale) {
+                if count != 1 || index != 0
+                    || scale[1] != 0.0 || scale[2] != 0.0 || scale[3] != 0.0 || scale[5] != 0.0
+                    || !geul_group_scale_supported(scale[0]) || !geul_group_scale_supported(scale[4])
+                {
+                    return None;
+                }
+                composite_scale = (scale[0], scale[4]);
+            }
+        }
+        if composite_scale.0 != sa.render_sx || composite_scale.1 != sa.render_sy {
+            return None;
+        }
+        let raw_tx = geul_finite_hwpx_int(trans[2], MAX_RECT_DIM_HU)?;
+        let raw_ty = geul_finite_hwpx_int(trans[5], MAX_RECT_DIM_HU)?;
+        // The HWPX parser promotes <offset> to the modeled translation only for
+        // identity matrices. Preserve that established identity-child behavior.
+        let identity_offset_translation = sa.render_sx == 1.0 && sa.render_sy == 1.0
+            && raw_tx == 0 && raw_ty == 0 && sa.render_tx == f64::from(sa.offset_x)
+            && sa.render_ty == f64::from(sa.offset_y);
+        if !identity_offset_translation
+            && (sa.render_tx != f64::from(raw_tx) || sa.render_ty != f64::from(raw_ty))
+        {
+            return None;
+        }
+    } else if sa.render_sx != 1.0 || sa.render_sy != 1.0
+        || sa.render_tx != f64::from(sa.offset_x) || sa.render_ty != f64::from(sa.offset_y)
+    {
+        // An absent source matrix can only represent the existing identity case.
+        return None;
+    }
+
+    let tx = geul_finite_hwpx_int(sa.render_tx, MAX_RECT_DIM_HU)?;
+    let ty = geul_finite_hwpx_int(sa.render_ty, MAX_RECT_DIM_HU)?;
+    let origin_x = f64::from(tx);
+    let origin_y = f64::from(ty);
+    let end_x = origin_x + f64::from(local_width) * sa.render_sx;
+    let end_y = origin_y + f64::from(local_height) * sa.render_sy;
+    let left = geul_finite_hwpx_int(origin_x.min(end_x), MAX_RECT_DIM_HU)?;
+    let top = geul_finite_hwpx_int(origin_y.min(end_y), MAX_RECT_DIM_HU)?;
+    let right = geul_finite_hwpx_int(origin_x.max(end_x), MAX_RECT_DIM_HU)?;
+    let bottom = geul_finite_hwpx_int(origin_y.max(end_y), MAX_RECT_DIM_HU)?;
+    let width = u32::try_from(right.checked_sub(left)?).ok()?;
+    let height = u32::try_from(bottom.checked_sub(top)?).ok()?;
+    if width != geul_scaled_dimension(local_width, sa.render_sx)?
+        || height != geul_scaled_dimension(local_height, sa.render_sy)?
+        || !((sa.offset_x == left && sa.offset_y == top) || (sa.offset_x == 0 && sa.offset_y == 0))
+    {
+        return None;
+    }
+    Some(GeulHwpxGroupChildTransform {
+        x: left,
+        y: top,
+        width,
+        height,
+        scale_x: sa.render_sx,
+        scale_y: sa.render_sy,
+    })
+}
+
+fn geul_group_local_dimension(displayed: u32, scale: f64) -> Option<u32> {
+    if !geul_group_scale_supported(scale) {
+        return None;
+    }
+    let local = f64::from(displayed) / scale.abs();
+    if !local.is_finite() || local.fract() != 0.0 || local < 1.0 || local > f64::from(MAX_RECT_DIM_HU) {
+        return None;
+    }
+    Some(local as u32)
+}
+
+fn geul_group_child_transform_translation(x: i32, y: i32, width: u32, height: u32, sx: f64, sy: f64) -> Option<(i32, i32)> {
+    if width == 0 || height == 0 || !geul_group_scale_supported(sx) || !geul_group_scale_supported(sy) {
+        return None;
+    }
+    (u32::try_from(x).ok()? <= MAX_RECT_DIM_HU && u32::try_from(y).ok()? <= MAX_RECT_DIM_HU).then_some((x, y))
+}
+
+fn geul_write_hwpx_group_child_translation(sa: &mut crate::model::shape::ShapeComponentAttr, tx: i32, ty: i32) -> bool {
+    if !sa.raw_rendering.is_empty() {
+        let Some((count_bytes, rest)) = sa.raw_rendering.split_at_checked(2) else {
+            return false;
+        };
+        let count = u16::from_le_bytes([count_bytes[0], count_bytes[1]]) as usize;
+        if count > 64 || count.checked_mul(96).and_then(|size| size.checked_add(48)) != Some(rest.len()) {
+            return false;
+        }
+        sa.raw_rendering[18..26].copy_from_slice(&f64::from(tx).to_le_bytes());
+        sa.raw_rendering[42..50].copy_from_slice(&f64::from(ty).to_le_bytes());
+    }
+    sa.render_tx = f64::from(tx);
+    sa.render_ty = f64::from(ty);
+    true
 }

