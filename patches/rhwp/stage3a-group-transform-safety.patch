+        assert_eq!(&identity_chain.raw_rendering[18..26], &5200.0_f64.to_le_bytes());
+        assert_eq!(&identity_chain.raw_rendering[42..50], &200.0_f64.to_le_bytes());
+        assert_eq!(&identity_chain.raw_rendering[50..], &identity_chain_original[50..]);
+
