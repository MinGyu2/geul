+/// `hh:strikeout@shape`: the active line shape, otherwise the source's inactive
+/// spelling (`"3D"` placeholder when recorded, else the standard `"NONE"`).
+fn strikeout_shape_token(cs: &CharShape) -> &'static str {
+    if !cs.strikethrough && cs.hwpx_inactive_strike_3d {
+        "3D"
+    } else {
+        strike_shape_str(cs.strikethrough, cs.strike_shape)
+    }
