     #[test]
+    fn strikeout_inactive_3d_placeholder_keeps_its_spelling() {
+        let (cs, out) = char_pr_roundtrip(r##"<hh:strikeout shape="3D" color="#FF0000"/>"##);
+        assert!(
+            !cs.strikethrough,
+            "3D placeholder must never be active strikeout"
+        );
+        assert!(cs.hwpx_inactive_strike_3d);
+        assert!(
+            out.contains(r##"<hh:strikeout shape="3D" color="#FF0000"/>"##),
+            "{out}"
+        );
+        // Standard inactive spelling and active shapes are unchanged.
+        let (cs, out) = char_pr_roundtrip(r##"<hh:strikeout shape="NONE" color="#000000"/>"##);
+        assert!(!cs.hwpx_inactive_strike_3d);
+        assert!(
+            out.contains(r##"<hh:strikeout shape="NONE" color="#000000"/>"##),
+            "{out}"
+        );
+        let (cs, out) = char_pr_roundtrip(r##"<hh:strikeout shape="DASH" color="#0000FF"/>"##);
+        assert!(cs.strikethrough && !cs.hwpx_inactive_strike_3d);
+        assert!(
+            out.contains(r##"<hh:strikeout shape="DASH" color="#0000FF"/>"##),
+            "{out}"
+        );
+        // Other placeholder-like values are not preserved (fail-closed: the
