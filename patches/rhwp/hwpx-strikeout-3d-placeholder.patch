+        // Enabling strikeout writes the real shape, not the placeholder.
+        cs.strikethrough = true;
+        cs.strike_shape = 1;
+        let out = crate::serializer::hwpx::char_shapes::char_pr_xml(0, &cs).unwrap();
+        assert!(out.contains(r##"<hh:strikeout shape="DASH""##), "{out}");
+        // A derived charPr (formatting command) uses the standard spelling.
+        let (source, _) = char_pr_roundtrip(r##"<hh:strikeout shape="3D" color="#000000"/>"##);
+        let mods = crate::model::style::CharShapeMods {
+            italic: Some(true),
+            ..Default::default()
+        };
+        let derived = mods.apply_to(&source);
+        assert!(!derived.hwpx_inactive_strike_3d && derived.italic);
+        let out = crate::serializer::hwpx::char_shapes::char_pr_xml(1, &derived).unwrap();
+        assert!(
+            out.contains(r##"<hh:strikeout shape="NONE" color="#000000"/>"##),
+            "{out}"
+        );
+        // Spelling is not formatting identity: reuse still finds the source.
+        let (none, _) = char_pr_roundtrip(r##"<hh:strikeout shape="NONE" color="#000000"/>"##);
+        assert_eq!(source, none);
+        let mut doc = crate::model::document::Document::default();
+        doc.doc_info.char_shapes = vec![source.clone()];
+        let unchanged = crate::model::style::CharShapeMods::default();
+        assert_eq!(doc.find_or_create_char_shape(0, &unchanged), 0);
+        assert_eq!(doc.doc_info.char_shapes.len(), 1);
