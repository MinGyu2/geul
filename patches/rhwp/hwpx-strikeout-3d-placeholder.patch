+        let (cs, out) = char_pr_roundtrip(r##"<hh:strikeout shape="4D" color="#000000"/>"##);
+        assert!(!cs.strikethrough && !cs.hwpx_inactive_strike_3d);
+        assert!(
+            out.contains(r##"<hh:strikeout shape="NONE" color="#000000"/>"##),
+            "{out}"
+        );
+    }
