+    /// Export one supported HWPX curve as an isolated package with only its owned resources.
+    #[wasm_bindgen(js_name = exportHwpxCurveClipboard)]
+    pub fn export_hwpx_curve_clipboard(
+        &mut self,
+        section_idx: u32,
+        para_idx: u32,
+        control_idx: u32,
+    ) -> Result<Vec<u8>, JsValue> {
+        if self.core.source_format != crate::parser::FileFormat::Hwpx {
+            return Err(JsValue::from_str(
+                "curve clipboard requires an HWPX source document",
+            ));
+        }
+
+        let saved_clipboard = self.core.clipboard.take();
+        let saved_cascade = self.core.paste_cascade_count;
+        let copied = self.core.copy_control_native(
+            section_idx as usize,
+            para_idx as usize,
+            &[],
+            control_idx as usize,
+        );
+        let clipboard = self.core.clipboard.take();
+        self.core.clipboard = saved_clipboard;
+        self.core.paste_cascade_count = saved_cascade;
+        copied.map_err(JsValue::from)?;
+
+        let mut clip_para = clipboard
+            .and_then(|mut value| value.paragraphs.drain(..).next())
+            .ok_or_else(|| JsValue::from_str("curve clipboard source is empty"))?;
