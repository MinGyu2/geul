+        imported.core.clipboard = saved_import_clipboard;
+        let mut clip_para = source_clipboard
+            .and_then(|mut value| value.paragraphs.drain(..).next())
+            .ok_or_else(|| JsValue::from_str("curve clipboard package has no control"))?;
+        let mut source_ids = std::collections::BTreeSet::new();
+        let root = match clip_para.controls.first() {
