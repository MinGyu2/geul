+            .core
+            .document
+            .sections
+            .get(section_idx as usize)
+            .ok_or_else(|| JsValue::from_str("curve clipboard destination section is missing"))?;
+        let paragraph = section
+            .paragraphs
+            .get(para_idx as usize)
+            .ok_or_else(|| JsValue::from_str("curve clipboard destination paragraph is missing"))?;
+        if char_offset as usize > paragraph.text.chars().count() {
+            return Err(JsValue::from_str(
+                "curve clipboard destination offset is out of range",
+            ));
+        }
+
+        let mut imported = HwpDocument::from_bytes(package).map_err(JsValue::from)?;
+        if imported.core.source_format != crate::parser::FileFormat::Hwpx
+            || imported.core.document.sections.len() != 1
+            || imported.core.document.sections[0].paragraphs.len() != 1
+            || !imported.core.document.sections[0].paragraphs[0]
+                .text
+                .is_empty()
+        {
+            return Err(JsValue::from_str(
+                "curve clipboard package structure is invalid",
+            ));
+        }
+        let mut curve_control_idx = None;
+        let mut section_def_count = 0usize;
+        let mut column_def_count = 0usize;
+        for (control_idx, control) in imported.core.document.sections[0].paragraphs[0]
+            .controls
+            .iter()
