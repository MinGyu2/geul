+fn hwpx_curve_segment_safe(element: &BytesStart<'_>, self_closing: bool) -> bool {
+    if !self_closing {
+        return false;
+    }
+    let mut seen: Vec<Vec<u8>> = Vec::new();
+    let mut coordinates = 0u8;
+    let mut has_type = false;
+    let mut count = 0usize;
+    for attr in element.attributes() {
+        let Ok(attr) = attr else { return false };
+        let key = attr.key.as_ref().as_bytes();
+        if seen.iter().any(|previous| previous.as_slice() == key) {
+            return false;
+        }
+        seen.push(key.to_vec());
+        let value = match attr.normalized_value(quick_xml::XmlVersion::Implicit1_0) {
+            Ok(value) => value,
+            Err(_) => return false,
+        };
+        let value = value.as_ref();
+        count += 1;
+        match key {
+            b"type" => {
+                has_type = true;
+                if !matches!(value, "LINE" | "CURVE") {
+                    return false;
+                }
+            }
+            b"x1" | b"y1" | b"x2" | b"y2" => {
+                if value.parse::<i32>().is_err() {
+                    return false;
+                }
+                coordinates |= match key {
+                    b"x1" => 1,
+                    b"y1" => 2,
+                    b"x2" => 4,
+                    _ => 8,
+                };
+            }
+            _ => return false,
+        }
+    }
+    coordinates == 0b1111 && count == if has_type { 5 } else { 4 }
+}
