+fn inspect_hwpx_curve_shape(
+    shape: &ShapeObject,
+    resources: &mut std::collections::BTreeSet<u16>,
+) -> Result<(), String> {
+    let ShapeObject::Curve(curve) = shape else {
+        return Err("portable curve package must contain one curve".into());
+    };
+    if !curve.drawing.shape_attr.hwpx_curve_clipboard_safe
+        || curve.drawing.caption.is_some()
+        || curve.drawing.text_box.is_some()
+        || curve.hwpx_segments.is_empty()
+        || curve.hwpx_segments.len() > MAX_HWPX_CURVE_SEGMENTS
+        || curve.segment_types.len() != 0
+        || curve.points.len() != curve.hwpx_segments.len() + 1
+    {
+        return Err("curve source envelope is unsupported or incomplete".into());
+    }
+
+    for (index, segment) in curve.hwpx_segments.iter().enumerate() {
+        if segment.has_children {
+            return Err("curve segment children are not represented by the portable model".into());
+        }
+        let mut keys = std::collections::BTreeSet::new();
+        let mut points = [None; 4];
+        let mut segment_type = None;
+        for (name, value) in &segment.attributes {
+            if !keys.insert(name.as_str()) {
+                return Err("curve segment has duplicate attributes".into());
+            }
+            match name.as_str() {
+                "type" if matches!(value.as_str(), "LINE" | "CURVE") => {
+                    segment_type = Some(value.as_str());
+                }
+                "type" => return Err("curve segment type is unsupported".into()),
+                "x1" => points[0] = value.parse::<i32>().ok(),
+                "y1" => points[1] = value.parse::<i32>().ok(),
+                "x2" => points[2] = value.parse::<i32>().ok(),
+                "y2" => points[3] = value.parse::<i32>().ok(),
+                _ => return Err("curve segment has unsupported attributes".into()),
+            }
+        }
+        if keys.len() != if segment_type.is_some() { 5 } else { 4 }
+            || points.iter().any(Option::is_none)
+            || points[0] != Some(segment.start.x)
+            || points[1] != Some(segment.start.y)
+            || points[2] != Some(segment.end.x)
+            || points[3] != Some(segment.end.y)
+            || curve.points[index].x != segment.start.x
+            || curve.points[index].y != segment.start.y
+            || curve.points[index + 1].x != segment.end.x
+            || curve.points[index + 1].y != segment.end.y
+        {
+            return Err("curve endpoint chain does not match its source segments".into());
+        }
+    }
+
+    if let Some(image) = &curve.drawing.fill.image {
+        if image.bin_data_id == 0 {
+            return Err("curve image fill has no owned resource".into());
+        }
+        resources.insert(image.bin_data_id);
     }
     Ok(())
 }
