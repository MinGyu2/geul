+    /// Import one bounded HWPX curve package as an atomic, undoable control edit.
+    #[wasm_bindgen(js_name = pasteHwpxCurveClipboard)]
+    pub fn paste_hwpx_curve_clipboard(
+        &mut self,
+        section_idx: u32,
+        para_idx: u32,
+        char_offset: u32,
+        package: &[u8],
+    ) -> Result<String, JsValue> {
+        if package.is_empty() || package.len() > MAX_HWPX_GROUP_CLIPBOARD_BYTES {
+            return Err(JsValue::from_str("curve clipboard package size is invalid"));
+        }
+        if self.core.source_format != crate::parser::FileFormat::Hwpx {
+            return Err(JsValue::from_str(
