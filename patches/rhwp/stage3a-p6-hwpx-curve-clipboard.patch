+            Some(Control::Shape(shape)) => shape.as_ref(),
+            _ => return Err(JsValue::from_str("selected object is not an HWPX curve")),
+        };
+        let mut source_ids = std::collections::BTreeSet::new();
+        inspect_hwpx_curve_shape(root, &mut source_ids).map_err(JsValue::from)?;
+
+        // The isolated package supplies its own default paragraph formatting.
+        clip_para.para_shape_id = 0;
+        clip_para.style_id = 0;
+        if let Some(shape) = clip_para.char_shapes.first_mut() {
+            shape.char_shape_id = 0;
+        }
+        let assets =
+            load_hwpx_group_assets(&self.core.document, &source_ids).map_err(JsValue::from)?;
+        let mut id_map = std::collections::BTreeMap::new();
+        let mut doc_info_bins = Vec::with_capacity(assets.len());
+        let mut bin_data_content = Vec::with_capacity(assets.len());
+        for (index, asset) in assets.into_iter().enumerate() {
+            let new_id = u16::try_from(index + 1)
+                .map_err(|_| JsValue::from_str("curve has too many owned resources"))?;
+            id_map.insert(
+                asset.source_id,
+                GroupClipboardResource {
+                    position_id: new_id,
+                    storage_id: new_id,
+                    extension: asset.extension.clone(),
+                },
+            );
+            let mut descriptor = asset.descriptor;
+            descriptor.raw_data = None;
+            descriptor.storage_id = new_id;
+            descriptor.data_type = crate::model::bin_data::BinDataType::Embedding;
+            descriptor.abs_path = None;
+            descriptor.rel_path = None;
+            descriptor.extension = Some(asset.extension.clone());
+            doc_info_bins.push(descriptor);
+            bin_data_content.push(crate::model::bin_data::BinDataContent {
+                id: new_id,
+                data: crate::model::bin_data::BinDataBytes::from_shared(asset.bytes),
+                extension: asset.extension,
+            });
+        }
+        remap_hwpx_group_resources(
+            match clip_para.controls.first_mut().unwrap() {
+                Control::Shape(shape) => shape.as_mut(),
+                _ => unreachable!(),
+            },
+            &id_map,
+        )
+        .map_err(JsValue::from)?;
+
+        let mut isolated = HwpDocument::create_empty();
+        isolated
+            .core
+            .create_blank_document_native()
+            .map_err(JsValue::from)?;
+        let mut section = Section::default();
+        section.section_def.page_def = crate::model::page::PageDef::a4_default();
+        section.paragraphs.push(clip_para);
+        let mut document = isolated.core.document.clone();
+        document.sections.clear();
+        document.sections.push(section);
+        document.doc_info.bin_data_list = doc_info_bins;
+        document.bin_data_content = bin_data_content;
+        isolated.core.set_document(document);
+        let serialized = isolated
+            .core
+            .export_hwpx_native_with_report()
+            .map_err(JsValue::from)?;
+        if !serialized.content_loss().is_empty() {
+            return Err(JsValue::from_str(
+                "curve clipboard serialization reports content loss",
+            ));
+        }
+        let (bytes, _) = serialized.into_parts();
+        if bytes.len() > MAX_HWPX_GROUP_CLIPBOARD_BYTES {
+            return Err(JsValue::from_str(
+                "curve clipboard package exceeds its size limit",
+            ));
+        }
+        Ok(bytes)
+    }
