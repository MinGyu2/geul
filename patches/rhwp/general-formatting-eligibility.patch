+
+    /// General formatting derives new definitions without raw payloads. Refuse a
+    /// source whose opaque bytes cannot be reproduced by the existing serializer.
+    /// Original definitions remain untouched; T009 still checks the whole output.
+    pub fn can_format_characters_native(&self) -> bool {
+        use crate::parser::FileFormat;
+        use crate::serializer::char_shape::serialize_char_shape;
+        match self.source_format {
+            FileFormat::Hwpx => true,
+            FileFormat::Hwp => self.document.doc_info.char_shapes.iter().all(|cs| {
+                cs.raw_data.as_ref().is_none_or(|raw| *raw == serialize_char_shape(cs))
+            }) && self.document.sections.iter().all(|section| {
+                // An edit reconstructs its section. Opaque owner subtrees and
+                // range annotations have no general-formatting preservation proof.
+                // Capture this read-only source eligibility at load, before typing
+                // invalidates raw streams; the session owns that load generation.
+                section.raw_stream.as_ref().is_some_and(|raw| {
+                    crate::parser::record::Record::read_all(raw).is_ok_and(|records| {
+                        records.iter().all(|r| (66..=85).contains(&r.tag_id)
+                            && (r.tag_id != 70 || r.data.is_empty()))
+                    })
+                })
+            }),
+            _ => false,
+        }
     }
 
     /// 지금 글자 모양 수(호출자가 불러온 직후의 기준 수를 기록할 때 쓴다).
