+    /// General formatting derives new definitions without raw payloads. Refuse a
+    /// source whose opaque bytes cannot be reproduced by the existing serializer.
+    /// Original definitions remain untouched; T009 still checks the whole output.
+    pub fn can_format_characters_native(&self) -> bool {
+        use crate::parser::FileFormat;
+        use crate::serializer::char_shape::serialize_char_shape;
+        match self.source_format {
+            FileFormat::Hwpx => true,
+            FileFormat::Hwp => self.document.doc_info.char_shapes.iter().all(|cs| {
+                cs.raw_data.as_ref().is_none_or(|raw| *raw == serialize_char_shape(cs))
+            }) && self.document.sections.iter().all(|section| {
+                // An edit reconstructs its section. Opaque owner subtrees and
+                // range annotations have no general-formatting preservation proof.
+                // Capture this read-only source eligibility at load, before typing
+                // invalidates raw streams; the session owns that load generation.
+                section.raw_stream.as_ref().is_some_and(|raw| {
+                    crate::parser::record::Record::read_all(raw).is_ok_and(|records| {
+                        records.iter().all(|r| (66..=85).contains(&r.tag_id)
+                            && (r.tag_id != 70 || r.data.is_empty()))
+                    })
+                })
+            }),
+            _ => false,
+        }
+    }
+
+    /// Bounded, read-only scalar-coordinate formatting inventory. No per-character
+    /// JS/WASM calls or font/language JSON. Control positions are proved from the
+    /// actual UTF-16 gaps, never from getControls' stream-position fallbacks.
+    pub fn formatting_runs_native(
+        &self, section: usize, paragraph: usize, control: u32, cell: usize,
+        cell_paragraph: usize, start: usize, end: usize,
+    ) -> Result<String, HwpError> {
+        use crate::model::style::UnderlineType;
+        let fail = || HwpError::RenderError("unsupported formatting selection".into());
+        let in_cell = control != u32::MAX;
+        let para = if in_cell {
+            self.get_cell_paragraph_ref(section, paragraph, control as usize, cell, cell_paragraph).ok_or_else(fail)?
+        } else {
+            self.document.sections.get(section).and_then(|s| s.paragraphs.get(paragraph)).ok_or_else(fail)?
+        };
+        if start > end || end > para.char_offsets.len() || end - start > 1_048_576
+            || !para.field_ranges.is_empty() || !para.orphan_field_ends.is_empty()
+            || !para.title_marks.is_empty() || !para.range_tags.is_empty()
+            || para.char_shapes.windows(2).any(|w| w[0].start_pos > w[1].start_pos) { return Err(fail()); }
+        let mut ci = 0usize;
+        let mut gap = |delta: u32, boundary: usize| -> Result<(), HwpError> {
+            if delta % 8 != 0 || delta as usize / 8 > para.controls.len() - ci { return Err(fail()); }
+            for _ in 0..delta / 8 {
+                let object = match &para.controls[ci] {
+                    Control::SectionDef(_) | Control::ColumnDef(_) => false,
+                    Control::Table(_) if !in_cell => true,
+                    Control::Picture(_) => true,
+                    Control::Shape(shape) if matches!(shape.as_ref(), ShapeObject::Picture(_)) => true,
+                    _ => return Err(fail()),
+                };
+                if object && (start == end || (start < boundary && boundary < end)) { return Err(fail()); }
+                ci += 1;
+            }
+            Ok(())
+        };
+        let mut cursor = 0u32;
+        let mut length = 0usize;
+        for (i, ch) in para.text.chars().enumerate() {
+            let off = *para.char_offsets.get(i).ok_or_else(fail)?;
+            gap(off.checked_sub(cursor).ok_or_else(fail)?, i)?;
+            if i >= start && i < end && (ch == '\u{fffc}' || (ch.is_control() && ch != '\t')) { return Err(fail()); }
+            cursor = off.checked_add(Paragraph::char_stream_len(ch)).ok_or_else(fail)?;
+            length += 1;
+        }
+        if length != para.char_offsets.len() { return Err(fail()); }
+        gap(para.char_count.saturating_sub(1).checked_sub(cursor).ok_or_else(fail)?, length)?;
+        if ci != para.controls.len() { return Err(fail()); }
+        let mut runs: Vec<[usize; 3]> = Vec::new();
+        let mut shape = 0usize;
+        for offset in start..end {
+            let pos = para.char_offsets[offset];
+            while shape + 1 < para.char_shapes.len() && para.char_shapes[shape + 1].start_pos <= pos { shape += 1; }
+            let id = para.char_shapes.get(shape).map_or(0, |s| s.char_shape_id);
+            let style = self.styles.char_styles.get(id as usize).ok_or_else(fail)?;
+            let mask = usize::from(style.bold) | (usize::from(style.italic) << 1)
+                | (usize::from(!matches!(style.underline, UnderlineType::None)) << 2)
+                | (usize::from(style.strikethrough) << 3);
+            if let Some(last) = runs.last_mut().filter(|r| r[2] == mask) { last[1] = offset + 1; }
+            else {
+                if runs.len() >= 65_536 { return Err(fail()); }
+                runs.push([offset, offset + 1, mask]);
+            }
+        }
+        Ok(serde_json::json!({"length":length,"runs":runs}).to_string())
     }
 
