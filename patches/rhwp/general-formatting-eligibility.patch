index 0000000..3ae2d59
--- /dev/null
+++ b/src/renderer/natural_metrics.rs
@@ -0,0 +1,632 @@
+//! Host-bound natural font metrics (geul).
+//!
+//! A host that knows the exact font bytes its WebView paints with binds them here by the document's
+//! *requested* family name. Layout then measures glyph advances from those bytes instead of the HFT
+//! tables or heuristics, and Canvas paints with private CSS aliases whose `FontFace` was created from
+//! the very same bytes, so measurement, paint, caret, hit testing and selection consume one geometry.
+//!
+//! Ownership and invariants:
+//! - The snapshot is derived, session-only state owned by `DocumentCore`. It never enters the document
+//!   model, serialization or history: binding a face never rewrites a stored family name.
+//! - A snapshot is immutable once committed (`Arc`). Layout transactions read one snapshot; a commit
+//!   replaces it atomically and bumps the generation, after which the owner rebuilds derived layout.
+//! - Font bytes are parsed once at staging and are **not retained**: only a bounded code point →
+//!   advance table survives, so there is no font buffer to leak or to use after a host refresh.
+//! - Every input is bounded (face count, byte length, code points). Malformed faces are rejected.
+//! - Only faces whose advances are instance-independent for the CSS request are accepted: variable
+//!   fonts are accepted only when every axis is `wght`, with a default equal to the bound weight.
+//! - Lookup mirrors CSS per-character fallback over the bound chain (primary family, then fallback
+//!   families). When the face the WebView would use is not an exact style match (synthetic bold), or
+//!   no bound face covers the character, lookup returns `None` and the legacy measurement applies.
+use std::collections::HashMap;
+use std::sync::Arc;
+
+/// Most faces (all styles of all families) in one snapshot.
+pub const MAX_NATURAL_FACES: usize = 64;
+/// Most bytes accepted for one face's font file.
+pub const MAX_NATURAL_FACE_BYTES: usize = 64 << 20;
+/// Most code points recorded for one face.
+pub const MAX_NATURAL_CODEPOINTS: usize = 200_000;
+/// Most code points across a snapshot.
+pub const MAX_NATURAL_TOTAL_CODEPOINTS: usize = 2_000_000;
+/// Most fallback families in the chain.
+pub const MAX_NATURAL_FALLBACKS: usize = 8;
+/// Most document family keys one staged face may serve.
+pub const MAX_NATURAL_KEYS_PER_FACE: usize = 64;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum NaturalFontError {
+    InvalidFamily,
+    InvalidAlias,
+    TooLarge,
+    TooMany,
+    Damaged,
+    UnsupportedVariation,
+    Conflict,
+    NoStage,
+    CountMismatch,
+}
+
+impl NaturalFontError {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::InvalidFamily => "invalid-family",
+            Self::InvalidAlias => "invalid-alias",
+            Self::TooLarge => "too-large",
+            Self::TooMany => "too-many",
+            Self::Damaged => "damaged",
+            Self::UnsupportedVariation => "unsupported-variation",
+            Self::Conflict => "conflict",
+            Self::NoStage => "no-stage",
+            Self::CountMismatch => "count-mismatch",
+        }
+    }
+}
+
+/// One parsed face: its style and code point → advance table (font units).
+#[derive(Debug)]
+pub struct NaturalFace {
+    pub bold: bool,
+    pub italic: bool,
+    pub units_per_em: u16,
+    /// Bytes and SHA-256 prefix of the source, for diagnostics/identity only.
+    pub source_len: usize,
+    pub source_digest: String,
+    advances: HashMap<u32, u16>,
+}
+
+impl NaturalFace {
+    /// Parse `bytes` (TTF/OTF or a collection face). The bytes are not retained.
+    pub fn parse(
+        bytes: &[u8],
+        face_index: u32,
+        bold: bool,
+        italic: bool,
+    ) -> Result<Self, NaturalFontError> {
+        if bytes.is_empty() || bytes.len() > MAX_NATURAL_FACE_BYTES {
+            return Err(NaturalFontError::TooLarge);
+        }
+        let face =
+            ttf_parser::Face::parse(bytes, face_index).map_err(|_| NaturalFontError::Damaged)?;
+        let units_per_em = face.units_per_em();
+        if units_per_em == 0 {
+            return Err(NaturalFontError::Damaged);
+        }
+        // CSS maps font-weight onto `wght` and font size onto `opsz`; any other axis, or a `wght`
+        // default that differs from the bound weight, would make WebView advances differ.
+        if face.is_variable() {
+            let expected = if bold { 700.0 } else { 400.0 };
+            for axis in face.variation_axes() {
+                let wght = axis.tag == ttf_parser::Tag::from_bytes(b"wght");
+                if !wght || (axis.def_value - expected).abs() > 0.5 {
+                    return Err(NaturalFontError::UnsupportedVariation);
+                }
+            }
+        }
+        let cmap = face.tables().cmap.ok_or(NaturalFontError::Damaged)?;
+        let mut advances = HashMap::new();
+        let mut overflow = false;
+        for subtable in cmap.subtables {
+            if !subtable.is_unicode() {
+                continue;
+            }
+            subtable.codepoints(|code_point| {
+                if overflow || advances.contains_key(&code_point) {
+                    return;
+                }
+                if advances.len() >= MAX_NATURAL_CODEPOINTS {
+                    overflow = true;
+                    return;
+                }
+                let Some(glyph) = subtable.glyph_index(code_point) else {
+                    return;
+                };
+                if glyph.0 == 0 {
+                    return;
+                }
+                if let Some(advance) = face.glyph_hor_advance(glyph) {
+                    advances.insert(code_point, advance);
+                }
+            });
+        }
+        if overflow {
+            return Err(NaturalFontError::TooLarge);
+        }
+        if advances.is_empty() {
+            return Err(NaturalFontError::Damaged);
+        }
+        Ok(Self {
+            bold,
+            italic,
+            units_per_em,
+            source_len: bytes.len(),
+            source_digest: crate::paint::resource_digest_hex(bytes)
+                .chars()
+                .take(16)
+                .collect(),
+            advances,
+        })
+    }
+
+    pub fn covers(&self, c: char) -> bool {
+        self.advances.contains_key(&(c as u32))
+    }
+
+    /// Advance of `c` in em units.
+    pub fn advance_em(&self, c: char) -> Option<f64> {
+        self.advances
+            .get(&(c as u32))
+            .map(|advance| f64::from(*advance) / f64::from(self.units_per_em))
+    }
+
+    pub fn code_point_count(&self) -> usize {
+        self.advances.len()
+    }
+}
+
+/// The faces bound to one CSS alias (one family, up to four styles).
+#[derive(Debug, Default)]
+pub struct NaturalFamily {
+    pub alias: String,
+    pub faces: Vec<Arc<NaturalFace>>,
+}
+
+impl NaturalFamily {
+    /// The face CSS font matching picks for `bold`/`italic` among the registered faces
+    /// (weight first, then style), and whether it is an exact weight match.
+    fn pick(&self, bold: bool, italic: bool) -> Option<&NaturalFace> {
+        self.faces
+            .iter()
+            .find(|face| face.bold == bold && face.italic == italic)
+            .or_else(|| self.faces.iter().find(|face| face.bold == bold))
+            .or_else(|| {
+                self.faces
+                    .iter()
+                    .find(|face| !face.bold && face.italic == italic)
+            })
+            .or_else(|| self.faces.first())
+            .map(|face| face.as_ref())
+    }
+}
+
+/// Immutable, committed binding set.
+#[derive(Debug, Default)]
+pub struct NaturalFontSnapshot {
+    pub generation: u64,
+    /// Requested document family → bound family.
+    families: HashMap<String, NaturalFamily>,
+    /// Coverage fallback chain, in CSS order.
+    fallbacks: Vec<NaturalFamily>,
+}
+
+/// Identity equality: two styles are equal only when they share the same committed snapshot.
+impl PartialEq for NaturalFontSnapshot {
+    fn eq(&self, other: &Self) -> bool {
+        std::ptr::eq(self, other)
+    }
+}
+
+/// Result of one natural lookup.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct NaturalAdvance {
+    pub advance_em: f64,
+    /// 0 = requested family, n = fallback n-1.
+    pub chain_index: usize,
+}
+
+impl NaturalFontSnapshot {
+    pub fn is_bound(&self, family: &str) -> bool {
+        self.families.contains_key(family)
+    }
+
+    /// CSS per-character fallback over the bound chain. `None`: legacy measurement applies,
+    /// either because `family` is not bound, nothing bound covers `c`, or the WebView would
+    /// synthesize the weight (advance not derivable from the bound bytes).
+    pub fn lookup(
+        &self,
+        family: &str,
+        bold: bool,
+        italic: bool,
+        c: char,
+    ) -> Option<NaturalAdvance> {
+        let primary = self.families.get(family)?;
+        for (chain_index, bound) in std::iter::once(primary)
+            .chain(self.fallbacks.iter())
+            .enumerate()
+        {
+            let Some(face) = bound.pick(bold, italic) else {
+                continue;
+            };
+            if !face.covers(c) {
+                continue;
+            }
+            if face.bold != bold {
+                return None;
+            }
+            return face.advance_em(c).map(|advance_em| NaturalAdvance {
+                advance_em,
+                chain_index,
+            });
+        }
+        None
+    }
+
+    /// Quoted CSS aliases to put in front of the legacy family chain, or `None` if unbound.
+    pub fn css_prefix(&self, family: &str) -> Option<String> {
+        let primary = self.families.get(family)?;
+        let mut out = String::new();
+        for bound in std::iter::once(primary).chain(self.fallbacks.iter()) {
+            if !out.is_empty() {
+                out.push_str(", ");
+            }
+            out.push('"');
+            out.push_str(&bound.alias);
+            out.push('"');
+        }
+        Some(out)
+    }
+
+    pub fn status_json(&self) -> serde_json::Value {
+        let describe = |bound: &NaturalFamily| {
+            serde_json::json!({
+                "alias": bound.alias,
+                "faces": bound.faces.iter().map(|face| serde_json::json!({
+                    "bold": face.bold,
+                    "italic": face.italic,
+                    "unitsPerEm": face.units_per_em,
+                    "codePoints": face.code_point_count(),
+                    "sourceBytes": face.source_len,
+                    "sourceDigest": face.source_digest,
+                })).collect::<Vec<_>>(),
+            })
+        };
+        let mut families = self.families.iter().collect::<Vec<_>>();
+        families.sort_by(|a, b| a.0.cmp(b.0));
+        serde_json::json!({
+            "generation": self.generation,
+            "families": families.into_iter().map(|(name, bound)| {
+                let mut value = describe(bound);
+                value["family"] = serde_json::Value::String(name.clone());
+                value
+            }).collect::<Vec<_>>(),
+            "fallbacks": self.fallbacks.iter().map(describe).collect::<Vec<_>>(),
+        })
+    }
+}
+
+fn valid_family(name: &str) -> bool {
+    !name.is_empty()
+        && name.trim() == name
+        && name.len() <= 128
+        && !name
+            .chars()
+            .any(|c| c.is_control() || matches!(c, '"' | ',' | ';' | '\\' | '{' | '}' | '\u{fffc}'))
+}
+
+fn valid_alias(alias: &str) -> bool {
+    (8..=64).contains(&alias.len())
+        && alias.starts_with("__")
+        && alias
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-')
+}
+
+/// A set under construction. Nothing is visible to layout until `commit`.
+#[derive(Debug, Default)]
+pub struct NaturalFontStage {
+    families: HashMap<String, NaturalFamily>,
+    fallbacks: Vec<NaturalFamily>,
+    faces: usize,
+    code_points: usize,
+}
+
+impl NaturalFontStage {
+    /// Stage one face. `family = None` stages a coverage fallback; `Some` holds one or more document
+    /// family keys separated by `\n` (keys never contain control characters) that share this face.
+    /// The face is parsed once and shared. Every check runs before anything is staged.
+    pub fn stage(
+        &mut self,
+        family: Option<&str>,
+        alias: &str,
+        face: NaturalFace,
+    ) -> Result<usize, NaturalFontError> {
+        let keys: Vec<&str> = match family {
+            Some(names) => names.split('\n').collect(),
+            None => Vec::new(),
+        };
+        if family.is_some()
+            && (keys.is_empty()
+                || keys.len() > MAX_NATURAL_KEYS_PER_FACE
+                || !keys.iter().all(|k| valid_family(k)))
+        {
+            return Err(NaturalFontError::InvalidFamily);
+        }
+        if !valid_alias(alias) {
+            return Err(NaturalFontError::InvalidAlias);
+        }
+        if self.faces >= MAX_NATURAL_FACES
+            || self.code_points + face.code_point_count() > MAX_NATURAL_TOTAL_CODEPOINTS
+        {
+            return Err(NaturalFontError::TooMany);
+        }
+        // Several document keys may share one alias (one installed family), but an alias must never
+        // name different bytes for the same style: the WebView would paint one of them only.
+        let same_style_other_source = |bound: &NaturalFamily| {
+            bound.alias == alias
+                && bound.faces.iter().any(|f| {
+                    f.bold == face.bold
+                        && f.italic == face.italic
+                        && f.source_digest != face.source_digest
+                })
+        };
+        if self.families.values().any(same_style_other_source)
+            || self.fallbacks.iter().any(same_style_other_source)
+        {
+            return Err(NaturalFontError::Conflict);
+        }
+        let duplicate = |bound: &NaturalFamily| {
+            bound
+                .faces
+                .iter()
+                .any(|f| f.bold == face.bold && f.italic == face.italic)
+        };
+        for key in &keys {
+            if let Some(bound) = self.families.get(*key) {
+                if bound.alias != alias || duplicate(bound) {
+                    return Err(NaturalFontError::Conflict);
+                }
+            }
+        }
+        let fallback_index = self.fallbacks.iter().position(|b| b.alias == alias);
+        if family.is_none() {
+            match fallback_index {
+                Some(index) if duplicate(&self.fallbacks[index]) => {
+                    return Err(NaturalFontError::Conflict)
+                }
+                None if self.fallbacks.len() >= MAX_NATURAL_FALLBACKS => {
+                    return Err(NaturalFontError::TooMany)
+                }
+                _ => {}
+            }
+        }
+        let face = Arc::new(face);
+        if family.is_some() {
+            for key in keys {
+                self.families
+                    .entry(key.to_string())
+                    .or_insert_with(|| NaturalFamily {
+                        alias: alias.to_string(),
+                        faces: Vec::new(),
+                    })
+                    .faces
+                    .push(Arc::clone(&face));
+            }
+        } else if let Some(index) = fallback_index {
+            self.fallbacks[index].faces.push(Arc::clone(&face));
+        } else {
+            self.fallbacks.push(NaturalFamily {
+                alias: alias.to_string(),
+                faces: vec![Arc::clone(&face)],
+            });
+        }
+        self.code_points += face.code_point_count();
+        self.faces += 1;
+        Ok(self.faces)
+    }
+
+    pub fn face_count(&self) -> usize {
+        self.faces
+    }
+
+    pub fn commit(self, generation: u64) -> NaturalFontSnapshot {
+        NaturalFontSnapshot {
+            generation,
+            families: self.families,
+            fallbacks: self.fallbacks,
+        }
+    }
+}
+
+/// Owner held by `DocumentCore`.
+#[derive(Debug, Default)]
+pub struct NaturalFontOwner {
+    active: Option<Arc<NaturalFontSnapshot>>,
+    stage: Option<NaturalFontStage>,
+    generation: u64,
+}
+
+impl NaturalFontOwner {
+    pub fn active(&self) -> Option<Arc<NaturalFontSnapshot>> {
+        self.active.clone()
+    }
+
+    pub fn generation(&self) -> u64 {
+        self.generation
+    }
+
+    pub fn begin(&mut self) {
+        self.stage = Some(NaturalFontStage::default());
+    }
+
+    pub fn stage(
+        &mut self,
+        family: Option<&str>,
+        alias: &str,
+        face: NaturalFace,
+    ) -> Result<usize, NaturalFontError> {
+        self.stage
+            .as_mut()
+            .ok_or(NaturalFontError::NoStage)?
+            .stage(family, alias, face)
+    }
+
+    /// Publish the staged set. The caller rebuilds derived layout afterwards.
+    pub fn commit(&mut self, expected_faces: usize) -> Result<u64, NaturalFontError> {
+        let stage = self.stage.take().ok_or(NaturalFontError::NoStage)?;
+        if stage.face_count() != expected_faces {
+            return Err(NaturalFontError::CountMismatch);
+        }
+        self.generation = self.generation.saturating_add(1);
+        self.active = if stage.face_count() == 0 {
+            None
+        } else {
+            Some(Arc::new(stage.commit(self.generation)))
+        };
+        Ok(self.generation)
+    }
+
+    /// Share another owner's committed snapshot (same immutable `Arc`, no font bytes), e.g. so a
+    /// reopened export used as save evidence measures exactly like the live document.
+    pub fn adopt(&mut self, snapshot: Option<Arc<NaturalFontSnapshot>>) -> bool {
+        let changed = match (&self.active, &snapshot) {
+            (Some(a), Some(b)) => !Arc::ptr_eq(a, b),
+            (None, None) => false,
+            _ => true,
+        };
+        self.stage = None;
+        if changed {
+            self.generation = self.generation.saturating_add(1);
+            self.active = snapshot;
+        }
+        changed
+    }
+
+    /// Drop the active set and any stage. Returns whether layout depended on it.
+    pub fn clear(&mut self) -> bool {
+        self.stage = None;
+        let had = self.active.take().is_some();
+        if had {
+            self.generation = self.generation.saturating_add(1);
+        }
+        had
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn fake_face(bold: bool, entries: &[(char, u16)]) -> NaturalFace {
+        NaturalFace {
+            bold,
+            italic: false,
+            units_per_em: 1000,
+            source_len: 1,
+            source_digest: format!("{entries:?}"),
+            advances: entries.iter().map(|(c, a)| (*c as u32, *a)).collect(),
+        }
+    }
+
+    #[test]
+    fn lookup_follows_css_fallback_order_and_refuses_synthetic_bold() {
+        let mut stage = NaturalFontStage::default();
+        stage
+            .stage(Some("Doc"), "__geul_nf_a1", fake_face(false, &[('A', 600)]))
+            .unwrap();
+        stage
+            .stage(
+                None,
+                "__geul_nf_fb",
+                fake_face(false, &[('A', 100), ('가', 900)]),
+            )
+            .unwrap();
+        let snapshot = stage.commit(1);
+        assert_eq!(
+            snapshot
+                .lookup("Doc", false, false, 'A')
+                .unwrap()
+                .advance_em,
+            0.6
+        );
+        let hangul = snapshot.lookup("Doc", false, false, '가').unwrap();
+        assert_eq!((hangul.advance_em, hangul.chain_index), (0.9, 1));
+        assert!(snapshot.lookup("Doc", true, false, 'A').is_none());
+        assert!(snapshot.lookup("Other", false, false, 'A').is_none());
+        assert!(snapshot.lookup("Doc", false, false, 'Z').is_none());
+        assert_eq!(
+            snapshot.css_prefix("Doc").unwrap(),
+            "\"__geul_nf_a1\", \"__geul_nf_fb\""
+        );
+    }
+
+    #[test]
+    fn stage_rejects_invalid_and_conflicting_bindings() {
+        let mut stage = NaturalFontStage::default();
+        assert_eq!(
+            stage.stage(Some("a\"b"), "__geul_nf_a1", fake_face(false, &[('A', 1)])),
+            Err(NaturalFontError::InvalidFamily)
+        );
+        assert_eq!(
+            stage.stage(Some("Doc"), "bad alias", fake_face(false, &[('A', 1)])),
+            Err(NaturalFontError::InvalidAlias)
+        );
+        stage
+            .stage(Some("Doc"), "__geul_nf_a1", fake_face(false, &[('A', 1)]))
+            .unwrap();
+        assert_eq!(
+            stage.stage(Some("Doc"), "__geul_nf_a1", fake_face(false, &[('A', 1)])),
+            Err(NaturalFontError::Conflict)
+        );
+        // Another key may share the alias with identical bytes, never with different bytes.
+        assert!(stage
+            .stage(Some("Other"), "__geul_nf_a1", fake_face(false, &[('A', 1)]))
+            .is_ok());
+        assert_eq!(
+            stage.stage(Some("Third"), "__geul_nf_a1", fake_face(false, &[('B', 1)])),
+            Err(NaturalFontError::Conflict)
+        );
+    }
+
+    #[test]
+    fn one_face_serves_several_keys_atomically() {
+        let mut stage = NaturalFontStage::default();
+        assert_eq!(
+            stage.stage(
+                Some("A\nB"),
+                "__geul_nf_m1",
+                fake_face(false, &[('A', 500)])
+            ),
+            Ok(1)
+        );
+        // A bad key anywhere refuses the whole call.
+        assert_eq!(
+            stage.stage(
+                Some("C\nbad\"key"),
+                "__geul_nf_m2",
+                fake_face(false, &[('A', 1)])
+            ),
+            Err(NaturalFontError::InvalidFamily)
+        );
+        let snapshot = stage.commit(1);
+        assert_eq!(
+            snapshot.lookup("A", false, false, 'A').unwrap().advance_em,
+            0.5
+        );
+        assert_eq!(
+            snapshot.lookup("B", false, false, 'A').unwrap().advance_em,
+            0.5
+        );
+        assert!(!snapshot.is_bound("C"));
+    }
+
+    #[test]
+    fn owner_commit_is_atomic_and_generational() {
+        let mut owner = NaturalFontOwner::default();
+        assert_eq!(owner.commit(0), Err(NaturalFontError::NoStage));
+        owner.begin();
+        owner
+            .stage(Some("Doc"), "__geul_nf_a1", fake_face(false, &[('A', 1)]))
+            .unwrap();
+        assert_eq!(owner.commit(2), Err(NaturalFontError::CountMismatch));
+        assert!(owner.active().is_none());
+        owner.begin();
+        owner
+            .stage(Some("Doc"), "__geul_nf_a1", fake_face(false, &[('A', 1)]))
+            .unwrap();
+        let generation = owner.commit(1).unwrap();
+        assert_eq!(owner.active().unwrap().generation, generation);
+        assert!(owner.clear());
+        assert!(owner.active().is_none());
+        assert!(owner.generation() > generation);
+    }
+}
