+impl DocumentCore {
+    /// Reconcile the restored font table before reconciling character shapes.
+    /// Prefix owns immutable definitions captured from the exact exported revision.
+    pub fn reconcile_font_shape_prefix_native(&mut self, prefix: &[crate::model::style::CharShape],
+        fonts: &[Vec<Font>], original_shapes: usize, original_fonts: [usize; 7]) -> Result<String, HwpError> {
+        let fail = || HwpError::RenderError("incompatible published font table".into());
+        self.document_font_table_native()?;
+        if fonts.len() != 7 { return Err(fail()); }
+        let current = &self.document.doc_info.font_faces;
+        let mut merged = fonts.to_vec();
+        let mut maps: [Vec<u16>; 7] = std::array::from_fn(|_| Vec::new());
+        for lang in 0..7 {
+            let n = original_fonts[lang];
+            if n > current[lang].len() || n > fonts[lang].len() || fonts[lang].len() > 65_536 { return Err(fail()); }
+            let keys = |faces: &[Font]| faces.iter().map(serde_json::to_vec).collect::<Result<Vec<_>, _>>().map_err(|_| fail());
+            let old = keys(&current[lang])?;
+            let mut new = keys(&fonts[lang])?;
+            if old[..n] != new[..n] { return Err(fail()); }
+            for (id, key) in old.iter().enumerate() {
+                let next = if new.get(id) == Some(key) { id }
+                    else if let Some(found) = new.iter().position(|k| k == key) { found }
+                    else {
+                        let next = merged[lang].len();
+                        merged[lang].push(current[lang][id].clone()); new.push(key.clone()); next
+                    };
+                maps[lang].push(u16::try_from(next).map_err(|_| fail())?);
+            }
+        }
+        if merged.iter().map(Vec::len).sum::<usize>() > 100_000 { return Err(fail()); }
+        let mut shapes = self.document.doc_info.char_shapes.clone();
+        for (id, shape) in shapes.iter_mut().enumerate() {
+            for lang in 0..7 {
+                let next = *maps[lang].get(usize::from(shape.font_ids[lang])).ok_or_else(fail)?;
+                if id < original_shapes && next != shape.font_ids[lang] { return Err(fail()); }
+                shape.font_ids[lang] = next;
+                if let Some(raw) = shape.raw_data.as_mut() {
+                    raw.get_mut(lang * 2..lang * 2 + 2).ok_or_else(fail)?.copy_from_slice(&next.to_le_bytes());
+                }
+            }
+        }
+        // Existing shape reconciliation proves all mappings before it mutates
+        // references. Roll back staged DocInfo if that proof refuses; history
+        // snapshots and publication prefix are never modified.
+        if serde_json::to_vec(&self.document.doc_info.font_faces).map_err(|_| fail())?
+            == serde_json::to_vec(&merged).map_err(|_| fail())?
+            && serde_json::to_vec(&self.document.doc_info.char_shapes).map_err(|_| fail())?
+                == serde_json::to_vec(&shapes).map_err(|_| fail())? {
+            return self.reconcile_char_shapes_native(prefix, original_shapes);
+        }
+        let saved = self.document.doc_info.clone();
+        self.document.doc_info.font_faces = merged;
+        self.document.doc_info.char_shapes = shapes;
+        self.document.doc_info.raw_stream_dirty = true;
+        match self.reconcile_char_shapes_native(prefix, original_shapes) {
+            Ok(result) => { self.rebuild_derived_state(); Ok(result) }
+            Err(error) => { self.document.doc_info = saved; Err(error) }
+        }
+    }
+
+    /// Remove only unreferenced definitions after the protected font prefix.
+    /// All model font references are CHAR_SHAPE slots; snapshot tables remain owned
+    /// by snapshots and are reconciled when restored, never compacted in place.
+    pub fn compact_unpublished_fonts_native(&mut self, fonts: &[Vec<Font>]) -> Result<String, HwpError> {
+        let fail = || HwpError::RenderError("font compaction proof refused".into());
+        self.document_font_table_native()?;
+        if fonts.len() != 7 { return Err(fail()); }
+        let current = &self.document.doc_info.font_faces;
+        let mut keep: [Vec<bool>; 7] = std::array::from_fn(|lang| vec![false; current[lang].len()]);
+        for lang in 0..7 {
+            if fonts[lang].len() > current[lang].len() { return Err(fail()); }
+            for (id, font) in fonts[lang].iter().enumerate() {
+                if serde_json::to_vec(font).map_err(|_| fail())? != serde_json::to_vec(&current[lang][id]).map_err(|_| fail())? { return Err(fail()); }
+                keep[lang][id] = true;
+            }
+        }
+        for shape in &self.document.doc_info.char_shapes {
+            for lang in 0..7 { keep[lang][usize::from(shape.font_ids[lang])] = true; }
+        }
+        let mut maps: [Vec<u16>; 7] = std::array::from_fn(|_| Vec::new());
+        let mut compacted: Vec<Vec<Font>> = Vec::new();
+        for lang in 0..7 {
+            let mut faces = Vec::new();
+            for (id, face) in current[lang].iter().enumerate() {
+                maps[lang].push(u16::try_from(faces.len()).map_err(|_| fail())?);
+                if keep[lang][id] { faces.push(face.clone()); }
+            }
+            compacted.push(faces);
+        }
+        if compacted.iter().zip(current).all(|(a,b)| a.len() == b.len()) { return Ok("{\"ok\":true}".into()); }
+        for shape in &mut self.document.doc_info.char_shapes {
+            for lang in 0..7 {
+                shape.font_ids[lang] = maps[lang][usize::from(shape.font_ids[lang])];
+                if let Some(raw) = shape.raw_data.as_mut() {
+                    raw[lang * 2..lang * 2 + 2].copy_from_slice(&shape.font_ids[lang].to_le_bytes());
+                }
+            }
+        }
+        self.document.doc_info.font_faces = compacted;
+        self.document.doc_info.raw_stream_dirty = true;
+        self.rebuild_derived_state();
+        Ok("{\"ok\":true}".into())
+    }
+
+    pub fn prove_publishing_fonts_native(&self, exported: &Self) -> Result<(), HwpError> {
+        use crate::parser::FileFormat;
+        let fail = || HwpError::RenderError("publication font identity mismatch".into());
+        self.document_font_table_native()?; exported.document_font_table_native()?;
+        let (a,b) = (&self.document.doc_info.font_faces, &exported.document.doc_info.font_faces);
+        if a.len() != b.len() { return Err(fail()); }
+        for (old, new) in a.iter().zip(b) {
+            if old.len() != new.len() { return Err(fail()); }
+            for (old, new) in old.iter().zip(new) {
+                let equal = match self.source_format {
+                    FileFormat::Hwp => {
+                        let x = crate::serializer::doc_info::serialize_face_name(old);
+                        let y = crate::serializer::doc_info::serialize_face_name(new);
+                        old.raw_data.as_deref().unwrap_or(&x) == new.raw_data.as_deref().unwrap_or(&y) && x == y
+                    }
+                    FileFormat::Hwpx => {
+                        let mut x = old.clone(); let mut y = new.clone();
+                        x.raw_data = None; y.raw_data = None;
+                        serde_json::to_vec(&x).map_err(|_| fail())? == serde_json::to_vec(&y).map_err(|_| fail())?
+                    }
+                    _ => false,
+                };
+                if !equal { return Err(fail()); }
+            }
+        }
+        Ok(())
+    }
+}
