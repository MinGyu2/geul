+
+    /// [geul] Whether deriving character shapes can preserve this document's
+    /// source properties. Read-only; not a substitute for original preflight.
+    #[wasm_bindgen(js_name = canFormatCharacters)]
+    pub fn can_format_characters(&self) -> bool {
+        self.can_format_characters_native()
     }
 
