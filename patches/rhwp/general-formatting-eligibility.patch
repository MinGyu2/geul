+//! geul: WASM surface for host-bound natural font metrics. Validation, limits and ownership live in
+//! `DocumentCore` / `renderer::natural_metrics`; this layer only converts arguments and errors.
+use super::HwpDocument;
+use wasm_bindgen::prelude::*;
+
+#[wasm_bindgen]
+impl HwpDocument {
+    /// JSON: the family keys layout looks natural metrics up by.
+    #[wasm_bindgen(js_name = getNaturalFontRequests)]
+    pub fn get_natural_font_requests(&self) -> String {
+        self.core.natural_font_requests_native()
+    }
+
+    /// Start a new staged set (discarding an unfinished one). Layout is unchanged until commit.
+    #[wasm_bindgen(js_name = beginNaturalFontSet)]
+    pub fn begin_natural_font_set(&mut self) {
+        self.core.begin_natural_font_set_native();
+    }
+
+    /// Stage one face bound to document family key `family` (empty string = coverage fallback).
+    #[wasm_bindgen(js_name = stageNaturalFontFace)]
+    pub fn stage_natural_font_face(
+        &mut self,
+        family: &str,
+        alias: &str,
+        bold: bool,
+        italic: bool,
+        font_bytes: &[u8],
+        face_index: u32,
+    ) -> Result<String, JsValue> {
+        let family = (!family.is_empty()).then_some(family);
+        self.core
+            .stage_natural_font_face_native(family, alias, bold, italic, font_bytes, face_index)
+            .map_err(JsValue::from)
+    }
+
+    /// Atomically publish the staged set (must hold exactly `expected_faces`) and rebuild layout.
+    #[wasm_bindgen(js_name = commitNaturalFontSet)]
+    pub fn commit_natural_font_set(&mut self, expected_faces: u32) -> Result<String, JsValue> {
+        self.core
+            .commit_natural_font_set_native(expected_faces as usize)
+            .map_err(JsValue::from)
+    }
+
+    /// Drop natural metrics (legacy measurement). Returns whether layout was rebuilt.
+    #[wasm_bindgen(js_name = clearNaturalFonts)]
+    pub fn clear_natural_fonts(&mut self) -> bool {
+        self.core.clear_natural_fonts_native()
+    }
+
+    /// Measure with `source`'s committed natural-font snapshot (shared, immutable; no font bytes are
+    /// copied). Used for reopened save evidence. Returns whether layout was rebuilt.
+    #[wasm_bindgen(js_name = adoptNaturalFontsFrom)]
+    pub fn adopt_natural_fonts_from(&mut self, source: &HwpDocument) -> bool {
+        self.core.adopt_natural_fonts_native(&source.core)
+    }
+
+    /// JSON: the committed snapshot's identity (generation, aliases, face digests).
+    #[wasm_bindgen(js_name = getNaturalFontStatus)]
+    pub fn get_natural_font_status(&self) -> String {
+        self.core.natural_font_status_native()
+    }
+}
