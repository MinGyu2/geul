+impl DocumentCore {
+    /// Explicit family intent applies to all seven language slots. Renderer
+    /// fallback never enters this table. Resolve every ordinal before mutation.
+    pub fn resolve_document_font_family_native(&mut self, name: &str) -> Result<String, HwpError> {
+        let fail = || HwpError::RenderError("unsupported document font family".into());
+        if name.is_empty() || name.trim() != name || name.len() > 128
+            || name.chars().any(|c| c.is_control() || matches!(c, '\"' | ',' | ';' | '\\' | '{' | '}' | '\u{fffc}')) {
+            return Err(fail());
+        }
+        self.document_font_table_native()?;
+        let info = &self.document.doc_info;
+        let mut ids = [0u16; 7];
+        let mut missing = [false; 7];
+        for lang in 0..7 {
+            let matches: Vec<_> = info.font_faces[lang].iter().enumerate().filter(|(_, f)| f.name == name).collect();
+            ids[lang] = match matches.as_slice() {
+                [(id, _)] => u16::try_from(*id).map_err(|_| fail())?,
+                [] => { missing[lang] = true; u16::try_from(info.font_faces[lang].len()).map_err(|_| fail())? },
+                _ => return Err(fail()),
+            };
+        }
+        let total: usize = info.font_faces.iter().map(Vec::len).sum();
+        if total + missing.iter().filter(|m| **m).count() > 100_000 { return Err(fail()); }
+        // The narrow HWP append proof supports plain definitions only. Known
+        // compatibility default-name variants require a separate serializer proof.
+        let candidate = Font { raw_data: None, name: name.into(),
+            alt_type: if matches!(self.source_format, crate::parser::FileFormat::Hwpx) { 1 } else { 0 },
+            is_embedded: false, bin_item_id_ref: String::new(), resolved_bin_data_id: None,
+            alt_name: None, type_info: None, default_name: None, subst_font: None };
+        if missing.iter().any(|m| *m) && matches!(self.source_format, crate::parser::FileFormat::Hwp)
+            && crate::serializer::doc_info::serialize_face_name(&candidate).first() != Some(&0) { return Err(fail()); }
+        // Allocate every new face before committing any slot. No placeholders,
+        // no ignored surgical-insert errors, no partial language updates.
+        let mut fonts = info.font_faces.clone();
+        for lang in 0..7 {
+            if missing[lang] {
+                fonts[lang].push(candidate.clone());
+            }
+        }
+        let out = serde_json::to_string(&ids).map_err(|_| fail())?;
+        if missing.iter().any(|m| *m) {
+            self.document.doc_info.font_faces = fonts;
+            self.document.doc_info.raw_stream_dirty = true;
+        }
+        Ok(out)
+    }
+}
