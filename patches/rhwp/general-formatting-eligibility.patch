+//! geul: commands owning the host-bound natural font metric snapshot.
+//!
+//! The snapshot is derived layout input, never document data: staging, committing or clearing it
+//! does not touch the model, history or serialization. A commit rebuilds derived layout with the
+//! same rule as `restoreSessionLayout`, so every page, caret and selection query afterwards reads
+//! the committed generation.
+use super::DocumentCore;
+use crate::error::HwpError;
+use crate::renderer::natural_metrics::{NaturalFace, NaturalFontError};
+
+/// Most distinct family keys reported to the host.
+const MAX_NATURAL_REQUESTS: usize = 512;
+
+fn visit_paragraph_marks(paragraph: &mut crate::model::paragraph::Paragraph, depth: usize) {
+    paragraph.natural_metric_generation = None;
+    if depth >= 32 {
+        return;
+    }
+    for control in &mut paragraph.controls {
+        if let crate::model::control::Control::Table(table) = control {
+            for cell in &mut table.cells {
+                for child in &mut cell.paragraphs {
+                    visit_paragraph_marks(child, depth + 1);
+                }
+            }
+        }
+    }
+}
+
+/// Forget edit-reflow provenance (load normalization and replaced documents are document data).
+pub(crate) fn clear_natural_reflow_marks(document: &mut crate::model::document::Document) {
+    for section in &mut document.sections {
+        for paragraph in &mut section.paragraphs {
+            visit_paragraph_marks(paragraph, 0);
+        }
+    }
+}
+
+fn natural_error(context: &str, error: NaturalFontError) -> HwpError {
+    HwpError::RenderError(format!("natural font {context} failed: {}", error.as_str()))
+}
+
+impl DocumentCore {
+    /// The exact family keys layout looks natural metrics up by (the resolved `TextStyle` family
+    /// strings of every character style and language slot), with their CSS chain members and
+    /// whether a bold/regular style uses them. Bounded; deterministic order.
+    pub fn natural_font_requests_native(&self) -> String {
+        let mut keys: std::collections::BTreeMap<String, (bool, bool)> = Default::default();
+        let mut truncated = false;
+        for style in &self.styles.char_styles {
+            for lang in 0..7 {
+                let key = style.font_family_for_lang(lang);
+                if key.is_empty() {
+                    continue;
+                }
+                if !keys.contains_key(key) && keys.len() >= MAX_NATURAL_REQUESTS {
+                    truncated = true;
+                    continue;
+                }
+                let entry = keys.entry(key.to_string()).or_default();
+                if style.bold {
+                    entry.1 = true;
+                } else {
+                    entry.0 = true;
+                }
+            }
+        }
+        let requests = keys
+            .into_iter()
+            .map(|(key, (regular, bold))| {
+                let members = key
+                    .split(',')
+                    .map(str::trim)
+                    .filter(|member| !member.is_empty())
+                    .map(str::to_string)
+                    .collect::<Vec<_>>();
+                serde_json::json!({ "key": key, "members": members, "regular": regular, "bold": bold })
+            })
+            .collect::<Vec<_>>();
+        serde_json::json!({
+            "generation": self.natural_fonts.generation(),
+            "truncated": truncated,
+            "requests": requests,
+        })
+        .to_string()
+    }
+
+    /// Re-wrap body and top-level table-cell paragraphs whose rows an edit reflow produced under a
+    /// different natural-font generation than the current styles carry. Rows with no mark (file
+    /// provided or load-normalized) are document data and are never touched, so an unedited document
+    /// keeps its stored line layout byte for byte. Nested-table and text-box paragraphs keep their
+    /// rows until their next edit (documented limitation).
+    pub(crate) fn reflow_stale_natural_paragraphs(&mut self) -> usize {
+        use crate::model::control::Control;
+        let current = self
+            .styles
+            .natural_fonts
+            .as_ref()
+            .map_or(0, |snapshot| snapshot.generation);
+        let stale = |mark: Option<u64>| mark.is_some_and(|generation| generation != current);
+        let mut body = Vec::new();
+        let mut cells = Vec::new();
+        for (s, section) in self.document.sections.iter().enumerate() {
+            for (p, paragraph) in section.paragraphs.iter().enumerate() {
+                if stale(paragraph.natural_metric_generation) {
+                    body.push((s, p));
+                }
+                for (c, control) in paragraph.controls.iter().enumerate() {
+                    if let Control::Table(table) = control {
+                        for (ci, cell) in table.cells.iter().enumerate() {
+                            for (cp, child) in cell.paragraphs.iter().enumerate() {
+                                if stale(child.natural_metric_generation) {
+                                    cells.push((s, p, c, ci, cp));
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        for &(s, p) in &body {
+            self.reflow_paragraph(s, p);
+        }
+        for &(s, p, c, ci, cp) in &cells {
+            self.reflow_cell_paragraph(s, p, c, ci, cp);
+        }
+        body.len() + cells.len()
+    }
+
+    pub fn begin_natural_font_set_native(&mut self) {
+        self.natural_fonts.begin();
+    }
+
+    /// Parse and stage one face. `family = None` stages a coverage fallback face.
+    #[allow(clippy::too_many_arguments)]
+    pub fn stage_natural_font_face_native(
+        &mut self,
+        family: Option<&str>,
+        alias: &str,
+        bold: bool,
+        italic: bool,
+        bytes: &[u8],
+        face_index: u32,
+    ) -> Result<String, HwpError> {
+        let face = NaturalFace::parse(bytes, face_index, bold, italic)
+            .map_err(|e| natural_error("parse", e))?;
+        let summary = serde_json::json!({
+            "unitsPerEm": face.units_per_em,
+            "codePoints": face.code_point_count(),
+            "sourceDigest": face.source_digest,
+        });
+        let staged = self
+            .natural_fonts
+            .stage(family, alias, face)
+            .map_err(|e| natural_error("stage", e))?;
+        Ok(serde_json::json!({ "ok": true, "staged": staged, "face": summary }).to_string())
+    }
+
+    /// Publish the staged set (atomically) and rebuild derived layout from it.
+    pub fn commit_natural_font_set_native(
+        &mut self,
+        expected_faces: usize,
+    ) -> Result<String, HwpError> {
+        let generation = self
+            .natural_fonts
+            .commit(expected_faces)
+            .map_err(|e| natural_error("commit", e))?;
+        self.rebuild_derived_state();
+        Ok(serde_json::json!({ "ok": true, "generation": generation, "pageCount": self.page_count() }).to_string())
+    }
+
+    /// Return to legacy metrics. Rebuilds only when a snapshot was active.
+    pub fn clear_natural_fonts_native(&mut self) -> bool {
+        let had = self.natural_fonts.clear();
+        if had {
+            self.rebuild_derived_state();
+        }
+        had
+    }
+
+    /// Measure with `source`'s committed snapshot (or none). Rebuilds only when it changed.
+    pub fn adopt_natural_fonts_native(&mut self, source: &DocumentCore) -> bool {
+        let changed = self.natural_fonts.adopt(source.natural_fonts.active());
+        if changed {
+            self.rebuild_derived_state();
+        }
+        changed
+    }
+
+    pub fn natural_font_status_native(&self) -> String {
+        match self.natural_fonts.active() {
+            Some(snapshot) => {
+                let mut status = snapshot.status_json();
+                status["active"] = serde_json::Value::Bool(true);
+                status.to_string()
+            }
+            None => serde_json::json!({ "active": false, "generation": self.natural_fonts.generation() }).to_string(),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const LATIN: &[u8] = include_bytes!("../../tests/fixtures/fonts/RHWPExactKerningSmoke.ttf");
+    const KOREAN: &[u8] = include_bytes!("../../ttfs/opensource/NotoSansKR-Regular.ttf");
+
+    fn doc(text: &str) -> DocumentCore {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        core.insert_text_native(0, 0, 0, text).unwrap();
+        core
+    }
+
+    fn xs(core: &DocumentCore, offsets: &[usize]) -> Vec<f64> {
+        offsets
+            .iter()
+            .map(|&offset| {
+                let rect: serde_json::Value =
+                    serde_json::from_str(&core.get_cursor_rect_native(0, 0, offset).unwrap())
+                        .unwrap();
+                rect["x"].as_f64().unwrap()
+            })
+            .collect()
+    }
+
+    fn keys(core: &DocumentCore) -> Vec<String> {
+        let value: serde_json::Value =
+            serde_json::from_str(&core.natural_font_requests_native()).unwrap();
+        value["requests"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|r| r["key"].as_str().unwrap().to_string())
+            .collect()
+    }
+
+    fn bind(core: &mut DocumentCore, primary: &[u8], fallback: Option<&[u8]>) {
+        core.begin_natural_font_set_native();
+        let mut count = 0;
+        for (i, key) in keys(core).iter().enumerate() {
+            core.stage_natural_font_face_native(
+                Some(key),
+                &format!("__geul_nf_t{i}"),
+                false,
+                false,
+                primary,
+                0,
+            )
+            .unwrap();
+            count += 1;
+        }
+        if let Some(bytes) = fallback {
+            core.stage_natural_font_face_native(None, "__geul_nf_fb0", false, false, bytes, 0)
+                .unwrap();
+            count += 1;
+        }
+        core.commit_natural_font_set_native(count).unwrap();
+    }
+
+    #[test]
+    fn natural_binding_changes_advances_and_survives_rebuild_edit_and_clear() {
+        let text = "WWWWoooo가나다";
+        let mut core = doc(text);
+        let offsets = [0, 4, 8, 11];
+        let legacy = xs(&core, &offsets);
+
+        bind(&mut core, LATIN, Some(KOREAN));
+        let natural = xs(&core, &offsets);
+        assert_ne!(legacy, natural, "binding must change measured positions");
+
+        // The Latin run measures with the bound face; the ratio of the W and o spans follows its advances.
+        let face =
+            crate::renderer::natural_metrics::NaturalFace::parse(LATIN, 0, false, false).unwrap();
+        let (w, i) = (face.advance_em('W').unwrap(), face.advance_em('o').unwrap());
+        let ratio = (natural[1] - natural[0]) / (natural[2] - natural[1]);
+        assert!(
+            (ratio - w / i).abs() < 0.05 * (w / i),
+            "ratio {ratio} vs {}",
+            w / i
+        );
+        // Hangul is not in the Latin fixture: it measures with the Korean fallback face.
+        assert!(face.advance_em('가').is_none());
+        let korean =
+            crate::renderer::natural_metrics::NaturalFace::parse(KOREAN, 0, false, false).unwrap();
+        let hangul_span = natural[3] - natural[2];
+        let em_per_hangul = korean.advance_em('가').unwrap();
+        let latin_w_px = (natural[1] - natural[0]) / 4.0;
+        let expected = latin_w_px / w * em_per_hangul * 3.0;
+        assert!(
+            (hangul_span - expected).abs() < 0.6,
+            "hangul {hangul_span} vs {expected}"
+        );
+
+        // A full derived rebuild keeps the binding and the geometry.
+        core.rebuild_derived_state();
+        assert_eq!(xs(&core, &offsets), natural);
+
+        // Incremental layout after an edit equals the full rebuild of the same model.
+        core.insert_text_native(0, 0, 4, "W").unwrap();
+        let after_edit = xs(&core, &[0, 5, 9, 12]);
+        core.rebuild_derived_state();
+        assert_eq!(xs(&core, &[0, 5, 9, 12]), after_edit);
+
+        // Clearing returns to the legacy model; the document text and font names are untouched.
+        let names_before = keys(&core);
+        assert!(core.clear_natural_fonts_native());
+        assert_eq!(keys(&core), names_before);
+        core.delete_text_native(0, 0, 4, 1).unwrap();
+        assert_eq!(xs(&core, &offsets), legacy);
+    }
+
+    #[test]
+    fn adopted_snapshot_gives_a_second_document_identical_geometry() {
+        let text = "WWWWoooo가나다";
+        let mut live = doc(text);
+        let mut other = doc(text);
+        bind(&mut live, LATIN, Some(KOREAN));
+        assert_ne!(xs(&live, &[0, 11]), xs(&other, &[0, 11]));
+        assert!(other.adopt_natural_fonts_native(&live));
+        assert_eq!(xs(&live, &[0, 4, 8, 11]), xs(&other, &[0, 4, 8, 11]));
+        assert!(
+            !other.adopt_natural_fonts_native(&live),
+            "re-adopting the same snapshot is a no-op"
+        );
+        let empty = DocumentCore::new_empty();
+        assert!(other.adopt_natural_fonts_native(&empty));
+        assert_ne!(xs(&live, &[0, 11]), xs(&other, &[0, 11]));
+    }
+
+    #[test]
+    fn unbound_documents_and_bad_input_keep_legacy_layout() {
+        let mut core = doc("ABC");
+        let legacy = xs(&core, &[0, 3]);
+        core.begin_natural_font_set_native();
+        assert!(core
+            .stage_natural_font_face_native(
+                Some("Doc"),
+                "__geul_nf_x1",
+                false,
+                false,
+                b"not a font",
+                0
+            )
+            .is_err());
+        assert!(core
+            .stage_natural_font_face_native(Some("Doc"), "x", false, false, LATIN, 0)
+            .is_err());
+        // Binding a family the document does not use changes nothing.
+        core.stage_natural_font_face_native(
+            Some("Unused Family"),
+            "__geul_nf_x1",
+            false,
+            false,
+            LATIN,
+            0,
+        )
+        .unwrap();
+        core.commit_natural_font_set_native(1).unwrap();
+        assert_eq!(xs(&core, &[0, 3]), legacy);
+        // Commit without a stage fails closed and leaves the active set in place.
+        assert!(core.commit_natural_font_set_native(0).is_err());
+        let status: serde_json::Value =
+            serde_json::from_str(&core.natural_font_status_native()).unwrap();
+        assert_eq!(status["active"], true);
+    }
+}
