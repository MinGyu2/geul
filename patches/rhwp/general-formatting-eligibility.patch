+    /// Load-time source eligibility, complementary to the backend's independent
+    /// original preflight. HWP reconstruction must preserve the complete DocInfo.
+    pub fn can_format_fonts_native(&self) -> bool {
+        use crate::parser::FileFormat;
+        if self.document_font_table_native().is_err() { return false; }
+        match self.source_format {
+            FileFormat::Hwpx => true,
+            FileFormat::Hwp => {
+                if !self.document.doc_info.raw_stream.as_ref().is_some_and(|raw| raw.len() <= 8 * 1024 * 1024) { return false; }
