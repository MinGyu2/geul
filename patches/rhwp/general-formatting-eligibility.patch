+
+    #[test]
+    fn natural_commit_rewraps_edited_rows_and_never_file_rows() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        core.insert_text_native(0, 0, 0, &"W".repeat(100)).unwrap();
+        let body = |core: &DocumentCore| starts(&core.document.sections[0].paragraphs[0]);
+        let legacy = body(&core);
+        bind(&mut core, NOTO, "n1");
+        let noto = body(&core);
+        bind(&mut core, SMOKE, "s1");
+        let smoke = body(&core);
+        assert!(
+            noto.len() >= 2 && smoke.len() >= 2,
+            "{legacy:?} {noto:?} {smoke:?}"
+        );
+        // W is 0.878em in Noto Sans KR and 0.6em in the smoke face: fewer W fit per Noto line.
+        assert!(noto[1] < smoke[1], "{noto:?} {smoke:?}");
+        assert_eq!(
+            core.document.sections[0].paragraphs[0]
+                .natural_metric_generation
+                .is_some(),
+            true
+        );
+
+        // Rows from a file are document data: binding changes neither the rows nor the export.
+        for hwpx in [false, true] {
+            let bytes = if hwpx {
+                core.export_hwpx_native().unwrap()
+            } else {
+                core.export_hwp_native().unwrap()
+            };
+            let mut reopened = DocumentCore::from_bytes(&bytes).unwrap();
+            let rows = body(&reopened);
+            let export = |d: &DocumentCore| {
+                if hwpx {
+                    d.export_hwpx_native().unwrap()
+                } else {
+                    d.export_hwp_native().unwrap()
+                }
+            };
+            let before = export(&reopened);
+            bind(&mut reopened, NOTO, "n2");
+            assert_eq!(body(&reopened), rows);
+            assert_eq!(export(&reopened), before, "hwpx={hwpx}");
+            assert!(reopened.clear_natural_fonts_native());
+            assert_eq!(export(&reopened), before, "hwpx={hwpx}");
+        }
+    }
+
+    #[test]
+    fn natural_commit_rewraps_an_edited_table_cell() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        let made: serde_json::Value =
+            serde_json::from_str(&core.create_table_native(0, 0, 0, 1, 2).unwrap()).unwrap();
+        let (p, c) = (
+            made["paraIdx"].as_u64().unwrap() as usize,
+            made["controlIdx"].as_u64().unwrap() as usize,
+        );
+        core.insert_text_in_cell_native(0, p, c, 0, 0, 0, &"W".repeat(40))
+            .unwrap();
+        let cell = |core: &DocumentCore| match &core.document.sections[0].paragraphs[p].controls[c]
+        {
+            crate::model::control::Control::Table(table) => starts(&table.cells[0].paragraphs[0]),
+            _ => unreachable!(),
+        };
+        let other = |core: &DocumentCore| match &core.document.sections[0].paragraphs[p].controls[c]
+        {
+            crate::model::control::Control::Table(table) => starts(&table.cells[1].paragraphs[0]),
+            _ => unreachable!(),
+        };
+        let untouched = other(&core);
+        bind(&mut core, NOTO, "n3");
+        let noto = cell(&core);
+        bind(&mut core, SMOKE, "s3");
+        let smoke = cell(&core);
+        assert!(noto.len() >= 2 && smoke.len() >= 2, "{noto:?} {smoke:?}");
+        assert!(noto[1] < smoke[1], "{noto:?} {smoke:?}");
+        assert_eq!(
+            other(&core),
+            untouched,
+            "the neighbouring cell keeps its rows"
+        );
+    }
+}
