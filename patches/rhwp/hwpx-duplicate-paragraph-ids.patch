     use super::*;
 
+    fn identity_doc(ids: &[u64], imported: &[(u32, u32)]) -> Document {
+        use crate::model::paragraph::Paragraph;
+        let mut doc = Document::default();
+        doc.provenance.format = crate::model::provenance::SourceFormat::Hwpx;
+        let mut section = crate::model::document::Section::default();
+        for &encoded in ids {
+            let para = Paragraph::default();
+            para.hwpx_paragraph_identity
+                .store(encoded, std::sync::atomic::Ordering::Relaxed);
+            section.paragraphs.push(para);
+        }
+        doc.sections.push(section);
+        doc.hwpx_imported_paragraph_ids = std::sync::Arc::new(imported.iter().copied().collect());
+        for &encoded in ids {
+            if encoded <= u64::from(u32::MAX) + 1 {
+                doc.hwpx_paragraph_next
+                    .fetch_max(encoded, std::sync::atomic::Ordering::Relaxed);
+            }
+        }
+        doc
+    }
+
+    fn prepare(doc: &Document) -> Result<Vec<u32>, String> {
+        let mut ctx = SerializeContext::collect_from_document(doc);
+        ctx.prepare_paragraph_ids(doc).map_err(|e| e.to_string())?;
+        Ok(doc.sections[0]
+            .paragraphs
+            .iter()
+            .map(|p| ctx.paragraph_id(p))
+            .collect())
+    }
+
+    #[test]
+    fn imported_duplicate_paragraph_ids_are_preserved_exactly() {
+        // id 0 three times and 7 twice, as Hancom writes them; encoded = id + 1.
+        let doc = identity_doc(&[1, 1, 8, 1, 8], &[(0, 3), (7, 2)]);
+        assert_eq!(prepare(&doc).unwrap(), vec![0, 0, 7, 0, 7]);
+        // Repeated export keeps the same values.
+        assert_eq!(prepare(&doc).unwrap(), vec![0, 0, 7, 0, 7]);
+    }
+
+    #[test]
+    fn new_paragraphs_get_fresh_ids_above_imported_duplicates() {
+        let doc = identity_doc(&[1, 0, 1, 0], &[(0, 2)]);
+        let ids = prepare(&doc).unwrap();
+        assert_eq!((ids[0], ids[2]), (0, 0));
+        assert!(ids[1] > 0 && ids[3] > 0 && ids[1] != ids[3], "{ids:?}");
+        assert_eq!(prepare(&doc).unwrap(), ids, "allocation must be stable");
+    }
+
+    #[test]
+    fn duplicates_beyond_source_multiplicity_are_refused() {
+        let doc = identity_doc(&[1, 1, 1], &[(0, 2)]);
+        assert!(prepare(&doc)
+            .unwrap_err()
+            .contains("ambiguous duplicate HWPX paragraph id"));
+        // A value that was unique in the source may not become duplicated.
+        let doc = identity_doc(&[6, 6], &[(5, 1)]);
+        assert!(prepare(&doc)
+            .unwrap_err()
+            .contains("ambiguous duplicate HWPX paragraph id"));
+        // A value absent from the source may not be duplicated either.
+        let doc = identity_doc(&[10, 10], &[]);
+        assert!(prepare(&doc)
+            .unwrap_err()
+            .contains("ambiguous duplicate HWPX paragraph id"));
+    }
+
+    #[test]
+    fn aliased_identity_cells_are_refused_even_within_source_multiplicity() {
+        let mut doc = identity_doc(&[1, 1], &[(0, 3)]);
+        // A plain clone shares the identity cell (snapshot semantics). Inserting it
+        // into the same document without remapping is an aliasing defect.
+        let alias = doc.sections[0].paragraphs[0].clone();
+        doc.sections[0].paragraphs.push(alias);
+        assert!(prepare(&doc)
+            .unwrap_err()
+            .contains("aliased HWPX paragraph identity"));
+        // An aliased copy of a new paragraph must not receive one identity twice.
+        let mut doc = identity_doc(&[1, 0], &[(0, 1)]);
+        let alias = doc.sections[0].paragraphs[1].clone();
+        doc.sections[0].paragraphs.push(alias);
+        assert!(prepare(&doc)
+            .unwrap_err()
+            .contains("aliased HWPX paragraph identity"));
+    }
+
+    #[test]
+    fn missing_or_invalid_imported_paragraph_ids_are_still_refused() {
