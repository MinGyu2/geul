+    /// Path routing shares the existing table geometry implementation. The final
+    /// entry identifies the table; its cell/paragraph selects no separate engine.
+    pub fn edit_table_by_cell_path_native(&mut self, section: usize, paragraph: usize,
+        path: &[(usize, usize, usize)], op: &str, args: &[u16]) -> Result<String, HwpError> {
+        let fail = || HwpError::RenderError("invalid table operation".into());
+        let table = self.resolve_table_mut_by_cell_path(section, paragraph, path)?;
+        match (op, args) {
+            ("insertRowAbove", [row, 0]) => table.insert_row(*row, false),
+            ("insertRowBelow", [row, 1]) => table.insert_row(*row, true),
+            ("insertColumnLeft", [col, 0]) => table.insert_column(*col, false),
+            ("insertColumnRight", [col, 1]) => table.insert_column(*col, true),
+            ("deleteRow", [row]) => table.delete_row(*row),
+            ("deleteColumn", [col]) => table.delete_column(*col),
+            ("mergeRight" | "mergeBelow" | "mergeCells", [r, c, er, ec]) => table.merge_cells(*r, *c, *er, *ec),
+            ("splitCell", [row, col]) => table.split_cell(*row, *col),
+            _ => return Err(fail()),
+        }.map_err(HwpError::RenderError)?;
+        let counts: Vec<usize> = table.cells.iter().map(|c| c.paragraphs.len()).collect();
+        let mut cell_path = path.to_vec();
+        let last = cell_path.len() - 1;
+        for (cell, count) in counts.into_iter().enumerate() {
+            for para in 0..count {
+                cell_path[last].1 = cell;
+                cell_path[last].2 = para;
+                self.reflow_cell_paragraph_by_path(section, paragraph, &cell_path, para);
+            }
+            self.recalculate_cell_paragraph_vpos_by_path(section, paragraph, &cell_path, 0, None);
+        }
+        self.mark_cell_control_dirty(section, paragraph, path[0].0);
+        self.document.sections[section].raw_stream = None;
+        self.recompose_section(section);
+        self.paginate_if_needed();
+        Ok("{\"ok\":true}".into())
     }

