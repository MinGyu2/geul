+    pub fn get_table_properties_by_path(&self, section: u32, paragraph: u32,
+        path_json: &str) -> Result<String, JsValue> {
+        let path = DocumentCore::parse_cell_path(path_json)?;
+        self.get_table_properties_by_path_native(section as usize, paragraph as usize, &path).map_err(Into::into)
+    }
+
+    /// [geul] Caption paragraphs of an explicitly path-owned table (read-only):
+    /// `{"paragraphs":[...]}` or `{"paragraphs":null}` when the table has none.
+    #[wasm_bindgen(js_name = getTableCaptionByPath)]
+    pub fn get_table_caption_by_path(&self, section: u32, paragraph: u32,
+        path_json: &str) -> Result<String, JsValue> {
+        let path = DocumentCore::parse_cell_path(path_json)?;
+        let table = self.resolve_table_by_path(section as usize, paragraph as usize, &path)?;
+        let Some(caption) = table.caption.as_ref() else { return Ok("{\"paragraphs\":null}".into()) };
+        if caption.paragraphs.len() > 10_000 || caption.paragraphs.iter().map(|p| p.text.len()).sum::<usize>() > 4 * 1024 * 1024 {
+            return Err(JsValue::from_str("caption budget"));
+        }
+        // Caption identity: paragraph texts, their paragraph/character shape references and owned
+        // control count, and the caption's own layout attributes (direction, alignment, sizes).
+        let value = serde_json::json!({
+            "paragraphs": caption.paragraphs.iter().map(|p| p.text.as_str()).collect::<Vec<_>>(),
+            "shapes": caption.paragraphs.iter().map(|p| serde_json::json!({
+                "paraShape": p.para_shape_id,
+                "charShapes": p.char_shapes.iter().map(|c| [c.start_pos, c.char_shape_id]).collect::<Vec<_>>(),
+                "controls": p.controls.len(),
+            })).collect::<Vec<_>>(),
+            "attrs": {
+                "direction": format!("{:?}", caption.direction),
+                "vertAlign": format!("{:?}", caption.vert_align),
+                "width": caption.width, "spacing": caption.spacing,
+                "maxWidth": caption.max_width, "includeMargin": caption.include_margin,
+            },
+        });
+        Ok(value.to_string())
+    }
