+    #[wasm_bindgen(js_name = createTableInCellByPath)]
+    pub fn create_table_in_cell_by_path(&mut self, section: u32, paragraph: u32,
+        path_json: &str, offset: u32, rows: u32, cols: u32) -> Result<String, JsValue> {
+        let path = DocumentCore::parse_cell_path(path_json)?;
+        if path.is_empty() || path.len() >= 64 || rows == 0 || rows > 512 || cols == 0 || cols > 64 || rows * cols > 4096 {
+            return Err(JsValue::from_str("table resource budget"));
+        }
+        self.create_table_with_path_native(section as usize, paragraph as usize, offset as usize,
+            rows as u16, cols as u16, true, None, None, &path).map_err(Into::into)
+    }
