+            row_count,
+            col_count,
+            current_row: target_row,
+            current_col: target_col,
+        };
+
+        let result = crate::document_core::table_calc::evaluate_formula(formula, &ctx, &get_cell)
+            .map_err(|e| HwpError::RenderError(format!("계산식 오류: {}", e)))?;
+        Ok((result, target_cell_idx))
+    }
