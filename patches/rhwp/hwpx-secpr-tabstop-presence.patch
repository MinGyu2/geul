+        );
+        let output = replace_secpr_tab_stop(&input, &section.section_def).unwrap();
+        assert!(output.starts_with(r#"<x tabStopVal="4000"/>"#));
+        assert!(output.ends_with(&format!("<hp:secPr{PAIR}/>")));
+        assert_eq!(output.matches(PAIR).count(), 1);
+        for template in [
+            "<other/>",
+            "<hp:secPr ",
+            "<hp:secPr tabStopVal=\"4000\">",
+            "<hp:secPr tabStopUnit=\"HWPUNIT\">",
+        ] {
+            assert!(replace_secpr_tab_stop(template, &section.section_def)
+                .unwrap_err()
+                .to_string()
+                .contains("template"));
+        }
+    }
+}
