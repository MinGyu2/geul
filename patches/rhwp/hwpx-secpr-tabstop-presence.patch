+        let expected = [None, Some("3500"), None];
+        for (index, section) in doc.sections.iter().enumerate() {
+            let mut clone = section.clone();
+            clone.paragraphs[0].text.push_str("changed text");
+            clone.section_def.column_spacing += 1;
+            let attrs = attributes(&emit(&clone, index).unwrap());
+            assert_eq!(
+                attrs
+                    .iter()
+                    .find(|(k, _)| k == "tabStopVal")
+                    .map(|(_, v)| v.as_str()),
+                expected[index]
+            );
+            assert_eq!(
+                attrs
+                    .iter()
+                    .find(|(k, _)| k == "tabStopUnit")
+                    .map(|(_, v)| v.as_str()),
+                if index == 2 { Some("CHAR") } else { None }
+            );
+        }
+    }
