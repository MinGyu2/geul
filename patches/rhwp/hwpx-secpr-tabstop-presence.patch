+
+/// Transform only the first template secPr OPENING TAG, never its children,
+/// following definitions or similarly named attributes elsewhere. The fixed
+/// template must contain both exact anchors once; fail closed if it changes.
+fn replace_secpr_tab_stop(xml: &str, sd: &SectionDef) -> Result<String, SerializeError> {
+    let fail = |message: &str| SerializeError::UnsupportedInput(message.into());
+    let start = xml
+        .find("<hp:secPr ")
+        .ok_or_else(|| fail("HWPX secPr tab-stop template: missing opening tag"))?;
+    let end = start
+        + xml[start..]
+            .find('>')
+            .ok_or_else(|| fail("HWPX secPr tab-stop template: unterminated tag"))?;
+    let mut tag = xml[start..end].to_string();
+    let attributes = match &sd.hwpx_tab_stop {
+        Some(source) => source.attributes(sd.default_tab_spacing).map_err(fail)?,
+        None => (Some("4000"), Some("HWPUNIT")),
+    };
+    for (name, default, value) in [
+        ("tabStopVal", "4000", attributes.0),
+        ("tabStopUnit", "HWPUNIT", attributes.1),
+    ] {
+        let anchor = format!(r#" {name}="{default}""#);
+        if tag.matches(&anchor).count() != 1 {
+            return Err(fail(
+                "HWPX secPr tab-stop template: missing or duplicate attribute anchor",
+            ));
+        }
+        // References to whitespace must remain references on re-emission: raw
+        // tabs/newlines would normalize to spaces on the next XML parse.
+        let replacement = value
+            .map(|v| {
+                format!(
+                    r#" {name}="{}""#,
+                    xml_escape(v)
+                        .replace('\t', "&#9;")
+                        .replace('\n', "&#10;")
+                        .replace('\r', "&#13;")
+                )
+            })
+            .unwrap_or_default();
+        tag = tag.replacen(&anchor, &replacement, 1);
+    }
+    Ok(format!("{}{}{}", &xml[..start], tag, &xml[end..]))
+}
+
+/// Validate all owners before emitting ZIP bytes, including nested sublists
+/// whose existing renderer can otherwise swallow a control writer error.
+/// A stream whose head SectionDef disagrees with its first control cannot be
+/// represented by this serializer without a general section ownership rewrite.
+/// Leave that unsupported structure explicit instead of borrowing provenance.
+pub(super) fn validate_tab_stop_provenance(doc: &Document) -> Result<(), SerializeError> {
+    let validate = |sd: &SectionDef| -> Result<(), SerializeError> {
+        if let Some(source) = &sd.hwpx_tab_stop {
+            source
+                .attributes(sd.default_tab_spacing)
+                .map_err(|e| SerializeError::UnsupportedInput(e.into()))?;
+        }
+        Ok(())
+    };
+    for section in &doc.sections {
+        validate(&section.section_def)?;
+        let first = section
+            .paragraphs
+            .iter()
+            .flat_map(|p| &p.controls)
+            .find_map(|c| {
+                if let Control::SectionDef(sd) = c {
+                    Some(sd)
+                } else {
+                    None
+                }
+            });
+        if let Some(first) = first {
+            if first.hwpx_tab_stop != section.section_def.hwpx_tab_stop {
+                return Err(SerializeError::UnsupportedInput(
+                    "HWPX secPr tab-stop provenance: inconsistent section head and first definition".into(),
+                ));
+            }
+        }
+    }
+    for paragraph in crate::model::identity::hwpx_paragraphs(doc) {
+        for control in &paragraph.controls {
+            if let Control::SectionDef(sd) = control {
+                validate(sd)?;
+            }
+        }
+    }
+    Ok(())
 }
 
