+#[cfg(test)]
+mod secpr_tab_stop_preservation {
+    use super::*;
+    use crate::parser::hwpx::section::parse_hwpx_section;
+
+    const PAIR: &str = r#" tabStopVal="4000" tabStopUnit="HWPUNIT""#;
+
+    fn imported(attributes: &str) -> Section {
+        parse_hwpx_section(&EMPTY_SECTION_XML.replacen(PAIR, attributes, 1)).unwrap()
+    }
+
+    fn emit(section: &Section, index: usize) -> Result<String, SerializeError> {
+        let mut doc = Document::default();
+        doc.sections = vec![section.clone()];
+        validate_tab_stop_provenance(&doc)?;
+        let mut ctx = SerializeContext::collect_from_document(&doc);
+        String::from_utf8(write_section(section, &doc, index, &mut ctx)?)
+            .map_err(|e| SerializeError::XmlError(e.to_string()))
+    }
+
+    fn attributes(xml: &str) -> Vec<(String, String)> {
+        let mut reader = quick_xml::Reader::from_str(xml);
+        loop {
+            match reader.read_event().unwrap() {
+                quick_xml::events::Event::Start(e) if e.name().as_ref() == "hp:secPr" => {
+                    return e
+                        .attributes()
+                        .map(|a| {
+                            let a = a.unwrap();
+                            (
+                                a.key.as_ref().to_string(),
+                                a.normalized_value(quick_xml::XmlVersion::Implicit1_0)
+                                    .unwrap()
+                                    .into_owned(),
+                            )
+                        })
+                        .filter(|(k, _)| {
+                            matches!(k.as_str(), "tabStop" | "tabStopVal" | "tabStopUnit")
+                        })
+                        .collect();
+                }
+                quick_xml::events::Event::Eof => panic!("secPr missing"),
+                _ => {}
+            }
+        }
+    }
+
+    #[test]
+    fn absent_explicit_single_nondefault_and_integer_spellings_roundtrip() {
+        for pair in [
+            "",
+            PAIR,
+            r#" tabStopVal="0""#,
+            r#" tabStopUnit="CHAR""#,
+            r#" tabStopVal="2000" tabStopUnit="CHAR""#,
+            r#" tabStopVal="3500" tabStopUnit="HWPUNIT""#,
+            r#" tabStopVal=" +004000 " tabStopUnit="HWPUNIT""#,
+            r#" tabStopVal="-1""#,
+            r#" tabStopVal="99999999999999999999999999999999999999999999999999""#,
+            r#" tabStopVal="&#9;+004000&#10;" tabStopUnit="HWP&#85;NIT""#,
+        ] {
+            let original = EMPTY_SECTION_XML.replacen(PAIR, pair, 1).replacen(
+                r#"tabStop="8000""#,
+                r#"tabStop="12345""#,
+                1,
+            );
+            let section = parse_hwpx_section(&original).unwrap();
+            assert_eq!(section.section_def.default_tab_spacing, 12345);
+            let output = emit(&section, 0).unwrap();
+            assert_eq!(attributes(&output), attributes(&original), "{pair}");
+            assert_eq!(output, emit(&section, 0).unwrap(), "repeat export");
+            assert_eq!(
+                attributes(&emit(&parse_hwpx_section(&output).unwrap(), 0).unwrap()),
+                attributes(&original),
+                "reopen"
+            );
+        }
+    }
+
+    #[test]
+    fn malformed_values_duplicates_entities_and_empty_definitions_are_rejected() {
+        for (pair, reason) in [
+            (r#" tabStopVal="4.0""#, "tabStopVal"),
+            (r#" tabStopVal="NaN""#, "tabStopVal"),
+            (r#" tabStopVal="1 2""#, "tabStopVal"),
+            (r#" tabStopVal="""#, "tabStopVal"),
+            (r#" tabStopUnit="PX""#, "tabStopUnit"),
+            (r#" tabStopUnit=" HWPUNIT ""#, "tabStopUnit"),
+            (r#" tabStopVal="1" tabStopVal="2""#, "tab-stop attributes"),
+            (
+                r#" tabStopUnit="CHAR" tabStopUnit="HWPUNIT""#,
+                "tab-stop attributes",
+            ),
+            (r#" tabStopVal=4000"#, "tab-stop attributes"),
+            (r#" tabStopVal="&undefined;""#, "tab-stop attribute value"),
+        ] {
+            let error = parse_hwpx_section(&EMPTY_SECTION_XML.replacen(PAIR, pair, 1))
+                .unwrap_err()
+                .to_string();
+            assert!(error.contains(reason), "{pair}: {error}");
+        }
+        let error = parse_hwpx_section(
+            r#"<hs:sec><hp:p><hp:run><hp:secPr tabStopVal="1"/></hp:run></hp:p></hs:sec>"#,
+        )
+        .unwrap_err()
+        .to_string();
+        assert!(
+            error.contains("empty section definition unsupported"),
+            "{error}"
+        );
+    }
+
+    #[test]
+    fn separate_sections_and_clones_keep_their_own_attributes() {
+        let mut doc = Document::default();
+        doc.sections = vec![
