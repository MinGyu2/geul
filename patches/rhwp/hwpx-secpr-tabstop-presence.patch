+/// Source spelling of the independent HWPX secPr tab attributes.
+/// OWPML ParaList schema: xs:integer (default 0), CHAR|HWPUNIT (default HWPUNIT).
+/// Keep the decoded integer spelling, including sign/leading zeros/whitespace:
+/// numeric equivalence does not imply canonical XML equality. No bounded integer
+/// conversion is needed: this metadata is not an effective layout value.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct HwpxTabStop {
+    value: Option<String>,
+    unit: Option<String>,
+    source_tab_spacing: HwpUnit,
+}
+
+impl HwpxTabStop {
+    pub(crate) fn new(
+        value: Option<String>,
+        unit: Option<String>,
+        source_tab_spacing: HwpUnit,
+    ) -> Result<Self, &'static str> {
+        if let Some(value) = &value {
+            let token = value.trim_matches([' ', '\t', '\r', '\n']);
+            let digits = token.strip_prefix(['+', '-']).unwrap_or(token);
+            if digits.is_empty() || !digits.bytes().all(|c| c.is_ascii_digit()) {
+                return Err("HWPX secPr tabStopVal: expected xs:integer");
+            }
+        }
+        if !matches!(unit.as_deref(), None | Some("CHAR" | "HWPUNIT")) {
+            return Err("HWPX secPr tabStopUnit: unsupported unit");
+        }
+        Ok(Self {
+            value,
+            unit,
+            source_tab_spacing,
+        })
+    }
+
+    pub(crate) fn attributes(
+        &self,
+        current_tab_spacing: HwpUnit,
+    ) -> Result<(Option<&str>, Option<&str>), &'static str> {
+        // The existing editing API changes legacy tabStop, with no contract for
+        // deriving the newer pair. Refuse instead of guessing or reusing stale
+        // source spelling. Unrelated edits and unchanged clones keep provenance.
+        if self.source_tab_spacing != current_tab_spacing {
+            return Err(
+                "HWPX secPr tab-stop provenance: tab spacing changed; conversion unsupported",
+            );
+        }
+        Ok((self.value.as_deref(), self.unit.as_deref()))
+    }
+}
