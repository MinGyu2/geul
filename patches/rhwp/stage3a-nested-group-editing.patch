+            || !target.can_resize
+            || target.id != expected_id
+            || target.inst_id != expected_inst_id
+            || width < 1
+            || height < 1
+        {
+            return Err(geul_bad_shape_edit());
+        }
+        let displayed_width = width as u32;
+        let displayed_height = height as u32;
+        if i64::from(target.x) + i64::from(displayed_width) > i64::from(state.width)
+            || i64::from(target.y) + i64::from(displayed_height) > i64::from(state.height)
+            || (displayed_width == target.width && displayed_height == target.height)
+        {
+            return Err(geul_bad_shape_edit());
+        }
+        let (new_width, new_height) = (
+            geul_group_local_dimension(displayed_width, target.scale_x)
+                .ok_or_else(geul_bad_shape_edit)?,
+            geul_group_local_dimension(displayed_height, target.scale_y)
+                .ok_or_else(geul_bad_shape_edit)?,
+        );
+        if new_width == target.local_width && new_height == target.local_height {
+            return Err(geul_bad_shape_edit());
+        }
+        let ShapeObject::Group(root) = self
+            .advanced_body_shape(sec, para, ctrl)
