+        let local_x = target
+            .x
+            .checked_sub(parent_x)
+            .ok_or_else(geul_bad_shape_edit)?;
+        let local_y = target
+            .y
+            .checked_sub(parent_y)
+            .ok_or_else(geul_bad_shape_edit)?;
+        if local_x < 0
+            || local_y < 0
+            || i64::from(local_x) + i64::from(displayed_width) > i64::from(parent_width)
+            || i64::from(local_y) + i64::from(displayed_height) > i64::from(parent_height)
+        {
+            return Err(geul_bad_shape_edit());
+        }
+        let local_width = i32::try_from(new_width).map_err(|_| geul_bad_shape_edit())?;
+        let local_height = i32::try_from(new_height).map_err(|_| geul_bad_shape_edit())?;
+        let ShapeObject::Group(root) = self.resolve_shape_control_mut(sec, para, ctrl)? else {
+            return Err(geul_bad_shape_edit());
+        };
+        let child =
+            geul_nested_group_path_target_mut(root, &path).ok_or_else(geul_bad_shape_edit)?;
+        let is_ellipse = matches!(child, ShapeObject::Ellipse(_));
+        let width_changed = new_width != target.local_width;
+        let height_changed = new_height != target.local_height;
+        {
+            let sa = child.shape_attr_mut();
+            sa.original_width = new_width;
+            sa.original_height = new_height;
+            sa.current_width = new_width;
+            sa.current_height = new_height;
+            sa.original_width_was_zero = false;
+            sa.original_height_was_zero = false;
+            sa.current_width_was_zero = false;
+            sa.current_height_was_zero = false;
+            if width_changed || !is_ellipse {
+                sa.rotation_center.x = local_width / 2;
+            }
+            if height_changed || !is_ellipse {
+                sa.rotation_center.y = local_height / 2;
+            }
+        }
+        {
+            let common = child.common_mut();
+            common.width = new_width;
+            common.height = new_height;
+        }
+        match child {
+            ShapeObject::Rectangle(rect) => {
+                rect.x_coords = [0, local_width, local_width, 0];
+                rect.y_coords = [0, 0, local_height, local_height];
+            }
+            ShapeObject::Ellipse(ellipse) => {
+                let cx = if width_changed {
+                    local_width / 2
+                } else {
+                    ellipse.center.x
+                };
+                let cy = if height_changed {
+                    local_height / 2
+                } else {
