+/// Nested groups are editable only when each stored child matrix addresses a
+/// local, bounded frame. Imported groups with already-composed/global child
+/// coordinates, unsupported members, or transformed parent frames stay closed.
+fn geul_nested_group_children_are_local(
+    group: &crate::model::shape::GroupShape,
+    expected_group_level: u16,
+    depth: usize,
+    visited: &mut usize,
+) -> Option<()> {
+    if depth >= MAX_GEUL_GROUP_NESTED_DEPTH
+        || group.caption.is_some()
+        || group.common.locked
+        || group.common.size_protect
+        || group.children.is_empty()
+        || group.children.len() > 128
+    {
+        return None;
+    }
+    let (width, height) = geul_exact_hwpx_size(&group.common, &group.shape_attr)?;
+    for child in &group.children {
+        *visited = visited.checked_add(1)?;
+        if *visited > MAX_GEUL_GROUP_NESTED_NODES
+            || child.shape_attr().group_level != expected_group_level
+        {
+            return None;
+        }
+        match child {
+            ShapeObject::Group(nested) => {
+                let transform =
+                    geul_group_child_frame_transform(child, width, height, expected_group_level)?;
+                if transform.width == 0 || transform.height == 0 {
+                    return None;
+                }
+                geul_nested_group_children_are_local(
+                    nested,
+                    expected_group_level.checked_add(1)?,
+                    depth + 1,
+                    visited,
+                )?;
+            }
+            ShapeObject::Rectangle(_) | ShapeObject::Ellipse(_) => {
+                let (local_width, local_height) =
+                    geul_exact_hwpx_size(child.common(), child.shape_attr())?;
+                let transform =
+                    geul_hwpx_group_child_transform(child.shape_attr(), local_width, local_height)?;
+                let (move_ok, _) = geul_group_child_geom_support(child, local_width, local_height);
+                if !move_ok
+                    || transform.x < 0
+                    || transform.y < 0
+                    || i64::from(transform.x) + i64::from(transform.width) > i64::from(width)
+                    || i64::from(transform.y) + i64::from(transform.height) > i64::from(height)
+                {
+                    return None;
+                }
+            }
+            _ => return None,
+        }
+    }
+    Some(())
+}
+
+fn geul_collect_nested_group_children(
+    group: &crate::model::shape::GroupShape,
+    root_width: u32,
+    root_height: u32,
+    local_parent_width: u32,
+    local_parent_height: u32,
+    parent_x: i32,
+    parent_y: i32,
+    expected_group_level: u16,
+    path_prefix: &[GeulGroupAddressStep],
+    hwp5: bool,
+    visited: &mut usize,
+    seen: &mut std::collections::HashSet<(u32, u32)>,
+    out: &mut Vec<GeulGroupChildState>,
+) -> Option<()> {
+    for (child_index, child) in group.children.iter().enumerate() {
+        *visited = visited.checked_add(1)?;
+        if *visited > MAX_GEUL_GROUP_NESTED_NODES {
+            return None;
+        }
+        let step = geul_group_address_step(child_index, child)?;
+        let mut path = path_prefix.to_vec();
+        path.push(step);
+        if path.len() > MAX_GEUL_GROUP_NESTED_DEPTH {
+            return None;
+        }
+        match child {
+            ShapeObject::Group(nested) => {
+                let transform = geul_group_child_frame_transform(
+                    child,
+                    local_parent_width,
+                    local_parent_height,
+                    expected_group_level,
+                )?;
+                let next_x = parent_x.checked_add(transform.x)?;
+                let next_y = parent_y.checked_add(transform.y)?;
+                let (nested_width, nested_height) =
+                    geul_exact_hwpx_size(&nested.common, &nested.shape_attr)?;
+                geul_collect_nested_group_children(
+                    nested,
+                    root_width,
+                    root_height,
+                    nested_width,
+                    nested_height,
+                    next_x,
+                    next_y,
+                    expected_group_level.checked_add(1)?,
+                    &path,
+                    hwp5,
+                    visited,
+                    seen,
+                    out,
+                )?;
+            }
+            ShapeObject::Rectangle(_) | ShapeObject::Ellipse(_) => {
+                let state = geul_group_child_state(
+                    out.len(),
+                    child,
+                    root_width,
+                    root_height,
+                    local_parent_width,
+                    local_parent_height,
+                    parent_x,
+                    parent_y,
+                    expected_group_level,
+                    path,
+                    hwp5,
+                )?;
+                if !seen.insert((state.id, state.inst_id)) {
+                    return None;
+                }
+                out.push(state);
+            }
+            _ => return None,
+        }
+    }
+    Some(())
+}
+
+fn geul_group_path_parent_frame(
+    root: &crate::model::shape::GroupShape,
+    path: &[GeulGroupAddressStep],
+) -> Option<(i32, i32, u32, u32)> {
+    if path.len() < 2 || path.len() > MAX_GEUL_GROUP_NESTED_DEPTH {
+        return None;
+    }
+    let mut group = root;
+    let mut x = 0i32;
+    let mut y = 0i32;
+    for (depth, step) in path[..path.len() - 1].iter().enumerate() {
+        let child = group.children.get(step.index)?;
+        let actual = geul_group_address_step(step.index, child)?;
+        if actual != *step {
+            return None;
+        }
+        let ShapeObject::Group(nested) = child else {
+            return None;
+        };
+        let (parent_width, parent_height) = if depth == 0 {
+            geul_exact_hwpx_size(&root.common, &root.shape_attr)?
+        } else {
+            geul_exact_hwpx_size(&group.common, &group.shape_attr)?
+        };
+        let group_level = u16::try_from(depth + 1).ok()?;
+        let transform =
+            geul_group_child_frame_transform(child, parent_width, parent_height, group_level)?;
+        x = x.checked_add(transform.x)?;
+        y = y.checked_add(transform.y)?;
+        group = nested;
+    }
+    let (width, height) = geul_exact_hwpx_size(&group.common, &group.shape_attr)?;
+    Some((x, y, width, height))
+}
+
+fn geul_nested_group_path_target_mut<'a>(
+    root: &'a mut crate::model::shape::GroupShape,
+    path: &[GeulGroupAddressStep],
+) -> Option<&'a mut ShapeObject> {
+    if path.len() < 2 || path.len() > MAX_GEUL_GROUP_NESTED_DEPTH {
+        return None;
+    }
+    let mut group = root;
+    for step in &path[..path.len() - 1] {
+        let child = group.children.get_mut(step.index)?;
+        let actual = geul_group_address_step(step.index, child)?;
+        if actual != *step {
+            return None;
+        }
+        let ShapeObject::Group(nested) = child else {
+            return None;
+        };
+        group = nested;
+    }
+    let leaf = path.last()?;
+    let child = group.children.get_mut(leaf.index)?;
+    (geul_group_address_step(leaf.index, child)? == *leaf).then_some(child)
 }

