+const MAX_GEUL_GROUP_NESTED_DEPTH: usize = 64;
+const MAX_GEUL_GROUP_NESTED_NODES: usize = 256;
+
+fn geul_group_address_step(index: usize, child: &ShapeObject) -> Option<GeulGroupAddressStep> {
+    match child {
+        ShapeObject::Group(group) => Some(GeulGroupAddressStep {
+            index,
+            id: group.common.instance_id,
+            inst_id: group.hwpx_inst_id.unwrap_or(group.common.instance_id),
+        }),
+        ShapeObject::Rectangle(_) | ShapeObject::Ellipse(_) => {
+            let drawing = child.drawing()?;
+            Some(GeulGroupAddressStep {
+                index,
+                id: child.common().instance_id,
+                inst_id: drawing.inst_id,
+            })
+        }
+        _ => None,
+    }
+}
+
+fn geul_group_child_frame_transform(
+    child: &ShapeObject,
+    parent_width: u32,
+    parent_height: u32,
+    expected_group_level: u16,
+) -> Option<GeulHwpxGroupChildTransform> {
+    let ShapeObject::Group(group) = child else {
+        return None;
+    };
+    if group.caption.is_some()
+        || group.common.locked
+        || group.common.size_protect
+        || group.shape_attr.group_level != expected_group_level
+    {
+        return None;
+    }
+    let (width, height) = geul_exact_hwpx_size(&group.common, &group.shape_attr)?;
+    let transform = geul_hwpx_group_child_transform(&group.shape_attr, width, height)?;
+    if transform.scale_x != 1.0
+        || transform.scale_y != 1.0
+        || i64::from(transform.x) + i64::from(transform.width) > i64::from(parent_width)
+        || i64::from(transform.y) + i64::from(transform.height) > i64::from(parent_height)
+        || transform.x < 0
+        || transform.y < 0
+    {
+        return None;
+    }
+    Some(transform)
+}
