+/// Detect the canonical nested-container form whose child coordinates are
+/// local to each container. HWPX files that store already-composed coordinates
+/// continue through the existing top-level coordinate path.
+fn nested_group_children_are_local(group: &crate::model::shape::GroupShape, depth: usize) -> bool {
+    if depth >= 64
+        || group.children.is_empty()
+        || group.shape_attr.rotation_angle != 0
+        || group.shape_attr.horz_flip
+        || group.shape_attr.vert_flip
+        || group.shape_attr.flip & 3 != 0
+        || group.shape_attr.render_sx != 1.0
+        || group.shape_attr.render_sy != 1.0
+        || group.shape_attr.render_b != 0.0
+        || group.shape_attr.render_c != 0.0
+        || group.shape_attr.original_width == 0
+        || group.shape_attr.original_height == 0
+    {
+        return false;
+    }
+    let width = f64::from(group.shape_attr.original_width);
+    let height = f64::from(group.shape_attr.original_height);
+    group.children.iter().all(|child| {
+        let sa = child.shape_attr();
+        if !sa.render_tx.is_finite()
+            || !sa.render_ty.is_finite()
+            || !sa.render_sx.is_finite()
+            || !sa.render_sy.is_finite()
+            || !sa.render_b.is_finite()
+            || !sa.render_c.is_finite()
+            || sa.render_sx <= 0.0
+            || sa.render_sy <= 0.0
+            || sa.render_b != 0.0
+            || sa.render_c != 0.0
+            || sa.horz_flip
+            || sa.vert_flip
+            || sa.flip & 3 != 0
+        {
+            return false;
+        }
+        let child_width = f64::from(sa.original_width) * sa.render_sx;
+        let child_height = f64::from(sa.original_height) * sa.render_sy;
+        if !child_width.is_finite()
+            || !child_height.is_finite()
+            || child_width < 1.0
+            || child_height < 1.0
+            || sa.render_tx < 0.0
+            || sa.render_ty < 0.0
+            || sa.render_tx + child_width > width
+            || sa.render_ty + child_height > height
+        {
+            return false;
+        }
+        match child {
+            ShapeObject::Group(nested) => nested_group_children_are_local(nested, depth + 1),
+            ShapeObject::Rectangle(_) | ShapeObject::Ellipse(_) => true,
+            _ => false,
+        }
+    })
 }

