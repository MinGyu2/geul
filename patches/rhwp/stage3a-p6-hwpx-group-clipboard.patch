+const MAX_HWPX_GROUP_CLIPBOARD_BYTES: usize = 8 * 1024 * 1024;
+const MAX_HWPX_GROUP_MEDIA_BYTES: usize = 6 * 1024 * 1024;
+const MAX_HWPX_GROUP_NODES: usize = 256;
+const MAX_HWPX_GROUP_DEPTH: usize = 8;
+
+struct HwpxGroupAsset {
+    source_id: u16,
+    descriptor: crate::model::bin_data::BinData,
+    bytes: Vec<u8>,
+    extension: String,
+}
