+#[derive(Clone)]
+struct GroupClipboardResource {
+    position_id: u16,
+    storage_id: u16,
+    extension: String,
+}
+
+fn inspect_hwpx_group_shape(
+    shape: &ShapeObject,
+    depth: usize,
+    node_count: &mut usize,
+    resources: &mut std::collections::BTreeSet<u16>,
+) -> Result<(), String> {
+    if depth > MAX_HWPX_GROUP_DEPTH {
+        return Err("group clipboard nesting exceeds its depth limit".into());
+    }
+    *node_count = node_count.saturating_add(1);
+    if *node_count > MAX_HWPX_GROUP_NODES {
+        return Err("group clipboard contains too many objects".into());
+    }
+
+    match shape {
+        ShapeObject::Group(group) => {
+            if group.caption.is_some() {
+                return Err("group captions are not supported by portable group transfer".into());
+            }
+            for child in &group.children {
+                inspect_hwpx_group_shape(child, depth + 1, node_count, resources)?;
+            }
+        }
+        ShapeObject::Picture(picture) => {
+            if picture.caption.is_some()
+                || picture.image_attr.external_path.is_some()
+                || picture.image_attr.bin_data_id == 0
+            {
+                return Err("group picture is not an owned embedded image".into());
+            }
+            resources.insert(picture.image_attr.bin_data_id);
+        }
+        ShapeObject::Line(line) => {
+            if line.connector.is_some() {
+                return Err("connected lines are not supported in portable group transfer".into());
+            }
+            inspect_hwpx_group_drawing(&line.drawing, resources)?;
+        }
+        ShapeObject::Rectangle(value) => inspect_hwpx_group_drawing(&value.drawing, resources)?,
+        ShapeObject::Ellipse(value) => inspect_hwpx_group_drawing(&value.drawing, resources)?,
+        ShapeObject::Arc(value) => inspect_hwpx_group_drawing(&value.drawing, resources)?,
+        ShapeObject::Polygon(value) => inspect_hwpx_group_drawing(&value.drawing, resources)?,
+        ShapeObject::Curve(_) => {
+            return Err("curve groups require the unresolved HWPX curve format contract".into())
+        }
+        ShapeObject::Chart(_) | ShapeObject::Ole(_) => {
+            return Err(
+                "chart and OLE children are not supported in portable group transfer".into(),
+            )
+        }
+    }
+    Ok(())
+}
+
+fn inspect_hwpx_group_drawing(
+    drawing: &crate::model::shape::DrawingObjAttr,
+    resources: &mut std::collections::BTreeSet<u16>,
+) -> Result<(), String> {
+    if drawing.text_box.is_some() || drawing.caption.is_some() {
+        return Err(
+            "group text boxes and captions are not supported by portable group transfer".into(),
+        );
+    }
+    if let Some(image) = &drawing.fill.image {
+        if image.bin_data_id == 0 {
+            return Err("group image fill has no owned resource".into());
+        }
+        resources.insert(image.bin_data_id);
+    }
+    Ok(())
+}
+
+fn load_hwpx_group_assets(
+    document: &Document,
+    resource_ids: &std::collections::BTreeSet<u16>,
+) -> Result<Vec<HwpxGroupAsset>, String> {
+    let mut result = Vec::with_capacity(resource_ids.len());
+    let mut total_bytes = 0usize;
+    for &source_id in resource_ids {
+        let mut descriptors = document
+            .doc_info
+            .bin_data_list
+            .iter()
+            .filter(|descriptor| descriptor.storage_id == source_id);
+        let descriptor = descriptors
+            .next()
+            .ok_or_else(|| format!("group resource {} is not registered", source_id))?;
+        if descriptors.next().is_some() {
+            return Err(format!("group resource {} has an ambiguous owner", source_id));
+        }
+        if descriptor.data_type != crate::model::bin_data::BinDataType::Embedding
+            || descriptor.storage_id == 0
+        {
+            return Err(format!(
+                "group resource {} is not an embedded asset",
+                source_id
+            ));
+        }
+        let mut contents = document
+            .bin_data_content
+            .iter()
+            .filter(|content| content.id == descriptor.storage_id);
+        let content = contents
+            .next()
+            .ok_or_else(|| format!("group resource {} has no content", source_id))?;
+        if contents.next().is_some() {
+            return Err(format!("group resource {} has ambiguous content", source_id));
+        }
+        let extension = content.extension.to_ascii_lowercase();
+        if extension.len() > 16
+            || !extension.bytes().all(|byte| byte.is_ascii_alphanumeric())
+            || descriptor
+                .extension
+                .as_deref()
+                .is_some_and(|value| value.to_ascii_lowercase() != extension)
+        {
+            return Err(format!(
+                "group resource {} has an unsupported extension",
+                source_id
+            ));
+        }
+        let bytes = content
+            .data
+            .load_limited(MAX_HWPX_GROUP_MEDIA_BYTES)
+            .filter(|bytes| !bytes.is_empty())
+            .ok_or_else(|| {
+                format!(
+                    "group resource {} is missing or exceeds the size limit",
+                    source_id
+                )
+            })?;
+        total_bytes = total_bytes
+            .checked_add(bytes.len())
+            .filter(|total| *total <= MAX_HWPX_GROUP_MEDIA_BYTES)
+            .ok_or_else(|| "group clipboard media exceeds its size limit".to_string())?;
+        result.push(HwpxGroupAsset {
+            source_id,
+            descriptor: descriptor.clone(),
+            bytes,
+            extension,
+        });
+    }
+    Ok(result)
+}
+
+fn remap_hwpx_group_resources(
+    shape: &mut ShapeObject,
+    resources: &std::collections::BTreeMap<u16, GroupClipboardResource>,
+) -> Result<(), String> {
+    match shape {
+        ShapeObject::Group(group) => {
+            for child in &mut group.children {
+                remap_hwpx_group_resources(child, resources)?;
+            }
+        }
+        ShapeObject::Picture(picture) => {
+            let resource = resources
+                .get(&picture.image_attr.bin_data_id)
+                .ok_or_else(|| "group picture resource was not remapped".to_string())?;
+            picture.image_attr.bin_data_id = resource.position_id;
+            picture.href = Some(format!(
+                "BinData/image{}.{}",
+                resource.storage_id, resource.extension
+            ));
+        }
+        _ => {
+            if let Some(drawing) = shape.drawing_mut() {
+                if let Some(image) = &mut drawing.fill.image {
+                    let resource = resources
+                        .get(&image.bin_data_id)
+                        .ok_or_else(|| "group image fill resource was not remapped".to_string())?;
+                    image.bin_data_id = resource.position_id;
+                }
+            }
+        }
+    }
+    Ok(())
+}
