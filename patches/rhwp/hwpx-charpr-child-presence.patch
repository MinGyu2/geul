+    #[test]
+    fn char_pr_default_children_keep_original_presence() {
+        // Absent (older Hancom): not invented on export.
+        let (cs, out) = char_pr_roundtrip("");
+        assert_eq!(cs.hwpx_omitted_children, 0b1111);
+        for tag in ["hh:underline", "hh:strikeout", "hh:outline", "hh:shadow"] {
+            assert!(!out.contains(tag), "{tag} invented: {out}");
+        }
+        // Explicitly present with the same default values: kept.
+        let (cs, out) = char_pr_roundtrip(&DEFAULT_CHILDREN.concat());
+        assert_eq!(cs.hwpx_omitted_children, 0);
+        for child in DEFAULT_CHILDREN {
+            assert!(out.contains(child), "{child} lost: {out}");
+        }
+        // Mixed presence, in each combination of one present child.
+        for (i, child) in DEFAULT_CHILDREN.iter().enumerate() {
+            let (cs, out) = char_pr_roundtrip(child);
+            assert_eq!(cs.hwpx_omitted_children, 0b1111 & !(1 << i));
+            for (j, other) in DEFAULT_CHILDREN.iter().enumerate() {
+                assert_eq!(out.contains(other), i == j, "{other} in {out}");
+            }
+        }
+        // Non-default values are written exactly.
+        let (_, out) = char_pr_roundtrip(
+            r##"<hh:underline type="BOTTOM" shape="DOT" color="#FF0000"/><hh:shadow type="DROP" color="#B2B2B2" offsetX="10" offsetY="10"/>"##,
+        );
+        assert!(
