+/// Children the HWPX source omitted and whose values still equal the values an
+/// absent child parses to (`CharShape::default()`). A changed value is written
+/// even if the source omitted the child, so the recorded omission never hides
+/// an edit. Shapes without HWPX provenance (bits 0) write every child.
+fn omitted_default_children(cs: &CharShape) -> u8 {
+    let d = CharShape::default();
+    let mut omitted = 0;
+    if cs.underline_type == d.underline_type
+        && cs.underline_shape == d.underline_shape
+        && cs.underline_color == d.underline_color
+    {
+        omitted |= HWPX_CHARPR_OMITTED_UNDERLINE;
+    }
+    if cs.strikethrough == d.strikethrough
+        && cs.strike_shape == d.strike_shape
+        && cs.strike_color == d.strike_color
+    {
+        omitted |= HWPX_CHARPR_OMITTED_STRIKEOUT;
+    }
+    if cs.outline_type == d.outline_type {
+        omitted |= HWPX_CHARPR_OMITTED_OUTLINE;
+    }
+    if cs.shadow_type == d.shadow_type
+        && cs.shadow_color == d.shadow_color
+        && cs.shadow_offset_x == d.shadow_offset_x
+        && cs.shadow_offset_y == d.shadow_offset_y
+    {
+        omitted |= HWPX_CHARPR_OMITTED_SHADOW;
+    }
+    omitted & cs.hwpx_omitted_children
+}
