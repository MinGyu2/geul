+            "{out}"
+        );
+        assert!(
+            out.contains(r##"<hh:shadow type="DROP" color="#B2B2B2" offsetX="10" offsetY="10"/>"##),
+            "{out}"
+        );
+        assert!(
+            !out.contains("hh:strikeout") && !out.contains("hh:outline"),
+            "{out}"
+        );
+    }
