+    /// A join keeps the first paragraph's paragraph style; `Paragraph::merge_from`
+    /// appends the later text and its character formatting. Permit different
+    /// paragraph styles only when both sides have fully observable, ordinary text.
+    /// Refuse invisible structure which the text/font-run query cannot observe.
+    pub fn can_join_textbox_paragraphs(&self, sec: usize, para: usize, ctrl: usize, first: usize) -> bool {
+        use crate::model::paragraph::{ColumnBreakType, Paragraph};
+        use crate::parser::FileFormat;
+        if !matches!(self.source_format, FileFormat::Hwp | FileFormat::Hwpx) {
+            return false;
+        }
+        let Some(shape) = self.advanced_body_shape(sec, para, ctrl) else {
+            return false;
+        };
+        let Some(textbox) = get_textbox_from_shape(shape) else {
+            return false;
+        };
+        if shape.shape_attr().group_level != 0 || Self::shape_caption_ref(shape).is_some()
+            || textbox.paragraphs.len() > 64
+        {
+            return false;
+        }
+        let Some(pair) = textbox.paragraphs.get(first..).and_then(|paragraphs| paragraphs.get(..2)) else {
+            return false;
+        };
+        fn ordinary(para: &Paragraph, format: FileFormat) -> bool {
+            let metadata = match format {
+                FileFormat::Hwp => matches!(para.raw_header_extra.len(), 0 | 10 | 12),
+                FileFormat::Hwpx => para.raw_header_extra.len() <= 10,
+                _ => false,
+            };
+            !para.text.is_empty()
+                && para.column_type == ColumnBreakType::None && para.raw_break_type == 0
+                && !para.page_break_synthesized && metadata
+                && para.controls.is_empty() && para.ctrl_data_records.is_empty()
+                && para.field_ranges.is_empty() && para.orphan_field_ends.is_empty()
+                && para.range_tags.is_empty() && para.title_marks.is_empty() && para.markpen_marks.is_empty()
+                && para.tab_extended.is_empty() && !para.text.contains('\t')
+                && para.hwpx_text_topology.is_none() && para.numbering_restart.is_none()
+        }
+        pair.iter().all(|para| ordinary(para, self.source_format))
+    }
+
+    /// Only ordinary text in a flat, unlocked drawing text box may be split.
