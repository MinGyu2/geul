+            return false;
+        };
+        let Some(textbox) = get_textbox_from_shape(shape) else {
+            return false;
+        };
+        if shape.shape_attr().group_level != 0 || Self::shape_caption_ref(shape).is_some()
+            || textbox.paragraphs.len() > 64
+        {
+            return false;
+        }
+        let Some(target) = textbox.paragraphs.get(paragraph) else {
+            return false;
+        };
+        let metadata = match self.source_format {
+            FileFormat::Hwp => matches!(target.raw_header_extra.len(), 0 | 10 | 12),
+            FileFormat::Hwpx => target.raw_header_extra.len() <= 10,
+            _ => false,
+        };
+        !target.text.is_empty()
+            && target.column_type == ColumnBreakType::None && target.raw_break_type == 0
+            && !target.page_break_synthesized && metadata
+            && target.controls.is_empty() && target.ctrl_data_records.is_empty()
+            && target.field_ranges.is_empty() && target.orphan_field_ends.is_empty()
+            && target.range_tags.is_empty() && target.title_marks.is_empty() && target.markpen_marks.is_empty()
+            && target.tab_extended.is_empty() && !target.text.contains('\t')
+            && target.hwpx_text_topology.is_none() && target.numbering_restart.is_none()
+    }
