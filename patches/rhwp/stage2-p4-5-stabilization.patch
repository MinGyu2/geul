+impl DocumentCore {
+    /// [geul] P4 stabilization: read-only family resolution for structural paste.
+    /// The family must name exactly one existing face in every language slot
+    /// (the same rule as `resolve_document_font_family_native`, without ever
+    /// appending a face). Anything else is refused instead of being ignored.
+    pub(crate) fn existing_font_ids_for_family(&self, name: &str) -> Result<[u16; 7], HwpError> {
+        let fail = || HwpError::RenderError("unsupported font family in pasted cells".into());
+        self.document_font_table_native().map_err(|_| fail())?;
+        self.unique_face_ids(name).ok_or_else(fail)
+    }
+
+    fn unique_face_ids(&self, name: &str) -> Option<[u16; 7]> {
+        if name.is_empty() || name.trim() != name || name.len() > 128
+            || name.chars().any(|c| c.is_control() || matches!(c, '\"' | ',' | ';' | '\\' | '{' | '}' | '\u{fffc}')) {
+            return None;
+        }
+        let faces = &self.document.doc_info.font_faces;
+        if faces.len() != 7 {
+            return None;
+        }
+        let mut ids = [0u16; 7];
+        for (lang, slot) in faces.iter().enumerate() {
+            let mut matches = slot.iter().enumerate().filter(|(_, f)| f.name == name);
+            ids[lang] = match (matches.next(), matches.next()) {
+                (Some((id, _)), None) => u16::try_from(id).ok()?,
+                _ => return None,
+            };
+        }
+        Some(ids)
+    }
+
+    /// [geul] P4 stabilization: the single family a shape uses in all seven
+    /// language slots, when that family also resolves uniquely by name.
+    pub(crate) fn uniform_font_family(&self, shape: &crate::model::style::CharShape) -> Option<String> {
+        let faces = &self.document.doc_info.font_faces;
+        let name = &faces.first()?.get(usize::from(shape.font_ids[0]))?.name;
+        for lang in 1..7 {
+            if faces.get(lang)?.get(usize::from(shape.font_ids[lang]))?.name != *name {
+                return None;
+            }
+        }
+        (self.unique_face_ids(name)? == shape.font_ids).then(|| name.clone())
+    }
+}
