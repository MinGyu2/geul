+        /// Resolve a pasted run's shape without touching live DocInfo: reuse the
+        /// base when nothing changes, then an equal existing definition, then an
+        /// equal shape staged by this paste; otherwise stage a new definition.
+        fn stage_char_shape(
+            existing: &[CharShape],
+            staged: &mut Vec<CharShape>,
+            base_id: u32,
+            mods: &CharShapeMods,
+            no_highlight: bool,
+        ) -> Result<u32, HwpError> {
+            let base = existing
+                .get(base_id as usize)
+                .ok_or_else(|| HwpError::RenderError("missing base charShape".into()))?;
+            let mut modified = mods.apply_to(base);
+            let none_shade = |c: u32| c == 0xFFFF_FFFF || c == 0x00FF_FFFF;
+            if no_highlight {
+                // Keep the base's own spelling of "no highlight" (both are none).
+                modified.shade_color = if none_shade(base.shade_color) { base.shade_color } else { 0xFFFF_FFFF };
+            }
+            // CharShape equality ignores source-only spelling (raw bytes etc.).
+            if *base == modified {
+                return Ok(base_id);
+            }
+            if let Some(i) = existing.iter().position(|cs| *cs == modified) {
+                return Ok(i as u32);
+            }
+            let next = existing.len() + staged.iter().position(|cs| *cs == modified).unwrap_or(staged.len());
+            let id = u32::try_from(next)
+                .ok()
+                .filter(|id| *id < 65_536)
+                .ok_or_else(|| HwpError::RenderError("charShape limit exceeded".into()))?;
+            if next == existing.len() + staged.len() {
+                staged.push(modified);
+            }
+            Ok(id)
+        }
 
