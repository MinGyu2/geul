+
+/// HWP5 5.0 revision 1.3, table 92 fixes a straight-line component at 18 bytes:
+/// four INT32 coordinates and a UINT16 direction flag. Both serializer paths must
+/// emit the same format, including line children inside groups.
+#[test]
+fn hwp5_straight_line_component_uses_18_byte_spec_at_both_ownership_levels() {
+    use crate::model::shape::{GroupShape, LineShape, ShapeObject};
+
+    for started_right_or_bottom in [false, true] {
+        for nested in [false, true] {
+            let line = LineShape {
+                started_right_or_bottom,
+                ..Default::default()
+            };
+            let shape = if nested {
+                ShapeObject::Group(GroupShape {
+                    children: vec![ShapeObject::Line(line)],
+                    ..Default::default()
+                })
+            } else {
+                ShapeObject::Line(line)
+            };
+            let mut records = Vec::new();
+            serialize_control(&Control::Shape(Box::new(shape)), 1, None, &mut records);
+            let line = records
+                .iter()
+                .find(|record| record.tag_id == tags::HWPTAG_SHAPE_COMPONENT_LINE)
+                .expect("line component record");
+            assert_eq!(line.data.len(), 18, "HWP5 table 92 component length");
+            assert_eq!(
+                u16::from_le_bytes([line.data[16], line.data[17]]),
+                u16::from(started_right_or_bottom),
+                "UINT16 direction flag must roundtrip at the correct width"
+            );
+        }
+    }
+}
