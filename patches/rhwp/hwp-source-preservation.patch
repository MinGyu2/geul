+const MAX_RECT_DIM_HU: u32 = 2_000_000;
+const MAX_RECT_VERTEX_HU: i32 = 10_000_000;
+
+fn scale_rectangle_axis(coords: [i32; 4], old_dim: u32, new_dim: u32) -> Option<[i32; 4]> {
+    if old_dim == 0
+        || new_dim == 0
+        || old_dim > MAX_RECT_DIM_HU
+        || new_dim > MAX_RECT_DIM_HU
+    {
+        return None;
+    }
+    if coords
+        .iter()
+        .any(|&c| !(-MAX_RECT_VERTEX_HU..=MAX_RECT_VERTEX_HU).contains(&c))
+    {
+        return None;
+    }
+    let (Some(&min_c), Some(&max_c)) = (coords.iter().min(), coords.iter().max()) else {
+        return None;
+    };
+    if min_c >= max_c {
+        return None;
+    }
+    if old_dim == new_dim {
+        return Some(coords);
+    }
+    let den = i128::from(old_dim);
+    let num_scale = i128::from(new_dim);
+    let mut out = [0i32; 4];
+    for (i, &c) in coords.iter().enumerate() {
+        let num = i128::from(c) * num_scale;
+        let rounded = if num >= 0 {
+            (num + den / 2) / den
+        } else {
+            (num - den / 2) / den
+        };
+        let scaled = i32::try_from(rounded).ok()?;
+        if !(-MAX_RECT_VERTEX_HU..=MAX_RECT_VERTEX_HU).contains(&scaled) {
+            return None;
+        }
+        out[i] = scaled;
+    }
+    let (Some(&new_min), Some(&new_max)) = (out.iter().min(), out.iter().max()) else {
+        return None;
+    };
+    if new_min >= new_max {
+        return None;
+    }
+    Some(out)
+}
