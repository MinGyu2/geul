+    new_w: Option<u32>,
+    new_h: Option<u32>,
+    preserve_hwp_geometry: bool,
+) -> Result<Option<RectVertexPlan>, HwpError> {
+    let target_w = new_w.unwrap_or(width_before);
+    let target_h = new_h.unwrap_or(height_before);
+    if !preserve_hwp_geometry {
+        let w = i32::try_from(target_w)
+            .map_err(|_| HwpError::RenderError("사각형 너비가 i32 범위를 초과했습니다".into()))?;
