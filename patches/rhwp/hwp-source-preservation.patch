+    fn validate_source_rotated_rendering(sa: &crate::model::shape::ShapeComponentAttr) -> bool {
+        let raw = &sa.raw_rendering;
+        if raw.len() != 146 || u16::from_le_bytes([raw[0], raw[1]]) != 1 {
+            return false;
+        }
+        let Some(translation) = Self::parse_rendering_matrix(&raw[2..50]) else {
+            return false;
+        };
+        let Some(scale) = Self::parse_rendering_matrix(&raw[50..98]) else {
+            return false;
+        };
+        let Some(rotation) = Self::parse_rendering_matrix(&raw[98..146]) else {
+            return false;
+        };
+
+        // The HWP parser composes T × R × S. The writer and the Hancom
+        // rotated-picture sample use the component offsets in T and cancel
+        // them in R, leaving the rotated bounds at the local origin.
+        let (x, y) = (f64::from(sa.offset_x), f64::from(sa.offset_y));
+        let (w, h) = (f64::from(sa.current_width), f64::from(sa.current_height));
+        let theta = f64::from(sa.rotation_angle).to_radians();
+        let (cos, sin) = (theta.cos(), theta.sin());
+        let tx = -(w * cos).min(0.0) - (-h * sin).min(0.0);
+        let ty = -(w * sin).min(0.0) - (h * cos).min(0.0);
+        let scale_matches = |actual: f64, expected: f64| {
+            (actual - expected).abs() <= 8.0 * f64::EPSILON * expected
+        };
+        // Trigonometry and summation may differ by a few ULPs. The scale
+        // here also covers cancellation near zero and snapped right angles.
+        let position_tol = 16.0 * f64::EPSILON * (w + h + x.abs() + y.abs());
+        translation == [1.0, 0.0, x, 0.0, 1.0, y]
+            && scale[1] == 0.0 && scale[2] == 0.0 && scale[3] == 0.0 && scale[5] == 0.0
+            && scale_matches(scale[0], w / f64::from(sa.original_width))
+            && scale_matches(scale[4], h / f64::from(sa.original_height))
+            && (rotation[0] - cos).abs() <= 1e-12
+            && (rotation[1] + sin).abs() <= 1e-12
+            && (rotation[3] - sin).abs() <= 1e-12
+            && (rotation[4] - cos).abs() <= 1e-12
+            && (rotation[2] - (tx - x)).abs() <= position_tol
+            && (rotation[5] - (ty - y)).abs() <= position_tol
+    }
