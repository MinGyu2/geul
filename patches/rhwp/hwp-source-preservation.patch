+    fn parse_rendering_matrix(bytes: &[u8]) -> Option<[f64; 6]> {
+        if bytes.len() != 48 {
+            return None;
+        }
+        let mut m = [0.0f64; 6];
+        for (i, slot) in m.iter_mut().enumerate() {
+            let v = f64::from_le_bytes(bytes[i * 8..(i + 1) * 8].try_into().ok()?);
+            if !v.is_finite() {
+                return None;
+            }
+            *slot = v;
+        }
+        Some(m)
+    }
