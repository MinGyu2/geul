+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::serializer::hwpx::content::{write_content_hpf, BinDataEntry};
+
+    fn item(id: &str, href: &str) -> String {
+        let media = if href.ends_with(".png") {
+            "image/png"
+        } else if href.ends_with(".js") {
+            "application/javascript"
+        } else {
+            "application/xml"
+        };
+        let embedded = if media == "image/png" {
+            r#" isEmbeded="1""#
+        } else {
+            ""
+        };
+        format!(r#"<opf:item id="{id}" href="{href}" media-type="{media}"{embedded}/>"#)
+    }
+    fn package(items: &[String], spine: &str) -> String {
+        format!(
+            r#"<opf:package xmlns:opf="http://www.idpf.org/2007/opf/"><opf:manifest>{}</opf:manifest><opf:spine>{spine}</opf:spine></opf:package>"#,
+            items.join("")
+        )
+    }
+    fn basic(extra: &[String]) -> Vec<String> {
+        let mut items = vec![
+            item("header", "Contents/header.xml"),
+            item("section0", "Contents/section0.xml"),
+            item("settings", "settings.xml"),
+        ];
+        items.extend_from_slice(extra);
+        items
+    }
+    fn bin(id: &str) -> BinDataEntry {
+        BinDataEntry {
+            id: id.into(),
+            href: format!("BinData/{id}.png"),
+            media_type: "image/png".into(),
+            is_embedded: true,
+        }
+    }
+    fn export(
+        original: &str,
+        sections: usize,
+        bins: &[BinDataEntry],
+        masters: &[(usize, String, String)],
+    ) -> Result<Vec<u8>, SerializeError> {
+        let sections: Vec<_> = (0..sections)
+            .map(|i| format!("Contents/section{i}.xml"))
+            .collect();
+        write_content_hpf(&sections, bins, masters, Some(original.as_bytes()))
+    }
+    fn ids(bytes: &[u8]) -> Vec<String> {
+        read_manifest(std::str::from_utf8(bytes).unwrap())
+            .unwrap()
+            .items
+            .into_iter()
+            .map(|item| item.id)
+            .collect()
+    }
+
+    #[test]
+    fn interleaved_bindata_and_script_order_repeats() {
+        let source = package(
+            &[
+                item("image2", "BinData/image2.png"),
+                item("header", "Contents/header.xml"),
+                item("image1", "BinData/image1.png"),
+                item("section0", "Contents/section0.xml"),
+                item("script", "Scripts/headerScripts.js"),
+                item("settings", "settings.xml"),
+            ],
+            r#"<opf:itemref idref="section0" linear="no"/>"#,
+        );
+        let bins = [bin("image1"), bin("image2")];
+        let out = export(&source, 1, &bins, &[]).unwrap();
+        assert_eq!(
+            ids(&out),
+            ["image2", "header", "image1", "section0", "script", "settings"]
+        );
+        assert!(std::str::from_utf8(&out)
+            .unwrap()
+            .contains(r#"idref="section0" linear="no""#));
+        assert_eq!(out, export(&source, 1, &bins, &[]).unwrap());
+        assert_eq!(
+            out,
+            export(std::str::from_utf8(&out).unwrap(), 1, &bins, &[]).unwrap()
+        );
+    }
+
+    #[test]
+    fn new_bindata_and_sections_have_stable_noncolliding_positions() {
+        let source = package(&basic(&[item("image1", "BinData/image1.png")]), "");
+        let bins = [bin("image1"), bin("image2")];
+        let out = export(&source, 2, &bins, &[]).unwrap();
+        assert_eq!(
+            ids(&out),
+            ["header", "section0", "settings", "image1", "section1", "image2"]
+        );
+        assert_eq!(
+            out,
+            export(std::str::from_utf8(&out).unwrap(), 2, &bins, &[]).unwrap()
+        );
+        assert!(export(&source, 1, &[bin("image1"), bin("header")], &[]).is_err());
+        assert!(export(&source, 1, &[bin("image1"), bin("image1")], &[]).is_err());
+    }
+
+    #[test]
+    fn omitted_or_changed_existing_resources_are_refused() {
+        let source = package(&basic(&[item("image1", "BinData/image1.png")]), "");
+        assert!(export(&source, 1, &[], &[]).is_err());
+        let mut changed = bin("image1");
+        changed.href = "BinData/other.png".into();
+        assert!(export(&source, 1, &[changed], &[]).is_err());
+        let mut changed = bin("image1");
+        changed.media_type = "image/jpeg".into();
+        assert!(export(&source, 1, &[changed], &[]).is_err());
+    }
