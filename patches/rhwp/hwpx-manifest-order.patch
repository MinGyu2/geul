+            valid.replace("<opf:manifest>", "<opf:manifest extra=\"1\">"),
+        ];
+        for source in cases {
+            assert!(export(&source, 1, &[], &[]).is_err(), "{source}");
+        }
+    }
+
+    #[test]
+    fn final_zip_targets_include_passthrough_scripts() {
+        let source = package(&basic(&[item("script", "Scripts/headerScripts.js")]), "");
+        let content = export(&source, 1, &[], &[]).unwrap();
+        let zip = |script: bool| {
+            let mut z = super::super::writer::HwpxZipWriter::new();
+            for name in [
+                "Contents/header.xml",
+                "Contents/section0.xml",
+                "settings.xml",
+            ] {
+                z.write_stored(name, b"data").unwrap();
+            }
+            if script {
+                z.write_stored("Scripts/headerScripts.js", b"script")
+                    .unwrap();
+            }
+            z.finish().unwrap()
+        };
+        assert!(validate_targets(&zip(false), &content).is_err());
+        assert!(validate_targets(&zip(true), &content).is_ok());
+    }
+    #[test]
+    fn legacy_jpeg_media_spelling_requires_same_resource_and_actual_jpeg() {
+        let image = item("image1", "BinData/image1.jpg").replace("application/xml", "image/jpg");
+        let source = package(&basic(&[image]), "");
+        let entry = || BinDataEntry {
+            id: "image1".into(),
+            href: "BinData/image1.jpg".into(),
+            media_type: "image/jpeg".into(),
+            is_embedded: true,
+        };
+        let content = export(&source, 1, &[entry()], &[]).unwrap();
+        assert!(std::str::from_utf8(&content)
+            .unwrap()
+            .contains(r#"media-type="image/jpg""#));
+        assert_eq!(
+            content,
+            export(std::str::from_utf8(&content).unwrap(), 1, &[entry()], &[]).unwrap()
+        );
+        let zip = |data: &[u8]| {
+            let mut z = super::super::writer::HwpxZipWriter::new();
+            for name in [
+                "Contents/header.xml",
+                "Contents/section0.xml",
+                "settings.xml",
+            ] {
+                z.write_stored(name, b"data").unwrap();
+            }
+            z.write_stored("BinData/image1.jpg", data).unwrap();
+            z.finish().unwrap()
+        };
+        assert!(validate_targets(&zip(&[0xff, 0xd8, 0xff, 0xe0]), &content).is_ok());
+        assert!(validate_targets(&zip(b"not a JPEG"), &content).is_err());
+        let mut wrong = entry();
+        wrong.media_type = "image/png".into();
+        assert!(export(&source, 1, &[wrong], &[]).is_err());
+    }
+}
