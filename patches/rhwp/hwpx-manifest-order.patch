+//! Preserve existing manifest order by stable identity, using actual emitted
+//! entries. Original bytes are never replayed as a substitute for resources.
+use std::collections::{BTreeMap, HashSet};
+use std::ops::Range;
+
+use quick_xml::events::Event;
+use quick_xml::name::ResolveResult;
+use quick_xml::reader::NsReader;
+use quick_xml::XmlVersion;
+
+use super::SerializeError;
+
+fn refused(message: impl std::fmt::Display) -> SerializeError {
+    SerializeError::UnsupportedInput(format!("HWPX manifest preservation: {message}"))
+}
+
+struct Item {
+    id: String,
+    href: String,
+    media_type: String,
+    embedded: bool,
+    span: Range<usize>,
+}
+impl Item {
+    // Preserve Hancom's legacy JPEG MIME spelling only when the actual emitted
+    // resource has the same identity/path and is explicitly a JPEG. The final
+    // ZIP validator additionally checks its JPEG signature before publication.
+    fn jpeg_spelling_of(&self, actual: &Self) -> bool {
+        self.id == actual.id
+            && self.href == actual.href
+            && self.embedded
+            && actual.embedded
+            && self.media_type == "image/jpg"
+            && actual.media_type == "image/jpeg"
+            && (self.href.ends_with(".jpg") || self.href.ends_with(".jpeg"))
+    }
+}
+
+struct Manifest {
+    items: Vec<Item>,
+    content: Range<usize>,
+}
+
+/// The caller validates the whole original with content's strict XML reader.
+/// This reader additionally refuses unmodeled manifest structure/attributes.
+fn read_manifest(xml: &str) -> Result<Manifest, SerializeError> {
+    let mut reader = NsReader::from_str(xml);
+    let mut depth = 0usize;
+    let mut inside = false;
+    let mut content = None;
+    let mut items = Vec::new();
+    let (mut ids, mut hrefs) = (HashSet::new(), HashSet::new());
+    let mut open_item = None;
+    loop {
+        let start = reader.buffer_position() as usize;
+        let event = reader.read_event().map_err(refused)?;
+        let end = reader.buffer_position() as usize;
+        match event {
+            Event::Start(ref e) | Event::Empty(ref e) => {
+                let (ns, name) = reader.resolver().resolve_element(e.name());
+                let opf = matches!(ns, ResolveResult::Bound(ns) if matches!(ns.as_ref(), "http://www.idpf.org/2007/opf/" | "http://www.idpf.org/2007/opf"));
+                if depth == 1 && opf && name.as_ref() == "manifest" {
+                    if content.is_some() {
+                        return Err(refused("duplicate manifest"));
+                    }
+                    for attr in e.attributes() {
+                        let attr = attr.map_err(refused)?;
+                        let (ns, _) = reader.resolver().resolve_attribute(attr.key);
+                        if !matches!(ns, ResolveResult::Bound(ns) if ns.as_ref() == "http://www.w3.org/2000/xmlns/")
+                            && attr.key.as_ref() != "xmlns"
+                        {
+                            return Err(refused("unsupported manifest attributes"));
+                        }
+                    }
+                    inside = matches!(event, Event::Start(_));
+                    content = Some(end..end);
+                } else if inside {
+                    if depth != 2 || !opf || name.as_ref() != "item" || open_item.is_some() {
+                        return Err(refused("unsupported manifest child"));
+                    }
+                    let mut attrs = BTreeMap::new();
+                    for attr in e.attributes() {
+                        let attr = attr.map_err(refused)?;
+                        let (ns, name) = reader.resolver().resolve_attribute(attr.key);
+                        if matches!(ns, ResolveResult::Bound(ns) if ns.as_ref() == "http://www.w3.org/2000/xmlns/")
+                            || attr.key.as_ref() == "xmlns"
+                        {
+                            continue;
+                        }
+                        if !matches!(ns, ResolveResult::Unbound)
+                            || !matches!(name.as_ref(), "id" | "href" | "media-type" | "isEmbeded")
+                        {
+                            return Err(refused("unsupported manifest item attribute"));
+                        }
+                        let value = attr
+                            .normalized_value(XmlVersion::Implicit1_0)
+                            .map_err(refused)?
+                            .into_owned();
+                        if attrs.insert(name.as_ref().to_owned(), value).is_some() {
+                            return Err(refused("duplicate item attribute"));
+                        }
+                    }
+                    let mut required = |key| {
+                        attrs
+                            .remove(key)
+                            .filter(|v| !v.is_empty())
+                            .ok_or_else(|| refused(format!("missing item {key}")))
+                    };
+                    let id = required("id")?;
+                    let href = required("href")?;
+                    let media_type = required("media-type")?;
+                    if id.chars().any(char::is_whitespace) || href.chars().any(char::is_control) {
+                        return Err(refused("invalid item identity/path"));
+                    }
+                    let embedded = match attrs.get("isEmbeded").map(String::as_str) {
+                        None | Some("1") => true,
+                        Some("0") => false,
+                        _ => return Err(refused("unsupported isEmbeded value")),
+                    };
+                    if !ids.insert(id.clone()) || !hrefs.insert(href.clone()) {
+                        return Err(refused("duplicate item ID or href"));
+                    }
+                    items.push(Item {
+                        id,
+                        href,
+                        media_type,
+                        embedded,
+                        span: start..end,
+                    });
+                    if matches!(event, Event::Start(_)) {
+                        open_item = Some(items.len() - 1);
+                    }
+                }
+                if matches!(event, Event::Start(_)) {
+                    depth += 1;
+                }
+            }
+            Event::End(_) => {
+                depth = depth
+                    .checked_sub(1)
+                    .ok_or_else(|| refused("unexpected closing tag"))?;
+                if inside && depth == 2 {
+                    let index = open_item
+                        .take()
+                        .ok_or_else(|| refused("unexpected manifest item end"))?;
+                    items[index].span.end = end;
+                } else if inside && depth == 1 {
+                    content
+                        .as_mut()
+                        .ok_or_else(|| refused("missing manifest"))?
+                        .end = start;
+                    inside = false;
+                }
+            }
+            Event::Text(text)
+                if inside
+                    && (open_item.is_some()
+                        || !text
+                            .as_ref()
+                            .chars()
+                            .all(|c| matches!(c, ' ' | '\t' | '\r' | '\n'))) =>
+            {
+                return Err(refused("manifest character data"))
+            }
+            Event::PI(_) | Event::Comment(_) | Event::CData(_) | Event::GeneralRef(_) if inside => {
+                return Err(refused("unsupported manifest event"))
+            }
+            Event::Eof => break,
+            _ => {}
+        }
+    }
+    Ok(Manifest {
+        items,
+        content: content.ok_or_else(|| refused("missing manifest"))?,
+    })
+}
+
+pub(super) fn preserve_order(
+    generated: Vec<u8>,
+    original: &str,
+    spine: &BTreeMap<String, Option<String>>,
+    section_hrefs: &[String],
+    masters: &[(usize, String, String)],
+) -> Result<Vec<u8>, SerializeError> {
+    let xml = std::str::from_utf8(&generated).map_err(refused)?;
+    let before = read_manifest(original)?;
+    let after = read_manifest(xml)?;
+    let old: BTreeMap<_, _> = before
+        .items
+        .iter()
+        .map(|item| (item.id.as_str(), item))
+        .collect();
+    let actual: BTreeMap<_, _> = after
+        .items
+        .iter()
+        .map(|item| (item.id.as_str(), item))
+        .collect();
+    if !old.contains_key("header") || spine.keys().any(|id| !old.contains_key(id.as_str())) {
+        return Err(refused("missing header or referenced manifest item"));
+    }
+    for item in &before.items {
+        let emitted = actual
+            .get(item.id.as_str())
+            .ok_or_else(|| refused(format!("original item omitted/unsupported: {}", item.id)))?;
+        if item.href != emitted.href
+            || (item.media_type != emitted.media_type && !item.jpeg_spelling_of(emitted))
+            || item.embedded != emitted.embedded
+        {
+            return Err(refused(format!(
+                "changed item identity/metadata: {}",
+                item.id
+            )));
+        }
+    }
+    let mut order = Vec::new();
+    let mut used = HashSet::new();
+    for item in &before.items {
+        // A newly created master page for an existing section belongs directly
+        // before its owner. Existing relative order is never changed.
+        if let Some(owner) = section_hrefs.iter().position(|href| href == &item.href) {
+            for (_, id, _) in masters
+                .iter()
+                .filter(|(index, id, _)| *index == owner && !old.contains_key(id.as_str()))
+            {
+                let new = actual
+                    .get(id.as_str())
+                    .ok_or_else(|| refused("missing new master page"))?;
+                if used.insert(new.id.as_str()) {
+                    order.push(*new);
+                }
+            }
+        }
+        let emitted = actual[item.id.as_str()];
+        if !used.insert(emitted.id.as_str()) {
+            return Err(refused("duplicate ordered entry"));
+        }
+        order.push(emitted);
+    }
+    // New sections/master groups and ordinary resources retain their generated
+    // relative order at the end; new master pages above are already accounted for.
+    for item in &after.items {
+        if used.insert(item.id.as_str()) {
+            order.push(item);
+        }
+    }
+    let mut result = Vec::with_capacity(generated.len());
+    result.extend_from_slice(&generated[..after.content.start]);
+    for item in order {
+        if old
+            .get(item.id.as_str())
+            .is_some_and(|source| source.jpeg_spelling_of(item))
+        {
+            let tag = std::str::from_utf8(&generated[item.span.clone()]).map_err(refused)?;
+            let needle = r#"media-type="image/jpeg""#;
+            if tag.matches(needle).count() != 1 {
+                return Err(refused("unexpected JPEG item serialization"));
+            }
+            result.extend_from_slice(
+                tag.replacen(needle, r#"media-type="image/jpg""#, 1)
+                    .as_bytes(),
+            );
+        } else {
+            result.extend_from_slice(&generated[item.span.clone()]);
+        }
+    }
+    result.extend_from_slice(&generated[after.content.end..]);
+    let reordered = std::str::from_utf8(&result).map_err(refused)?;
+    let parse = |s| crate::parser::hwpx::content::parse_content_hpf(s).map_err(refused);
+    let source = parse(original)?;
+    let output = parse(reordered)?;
+    // Reuse the engine's actual ownership interpretation (including its legacy
+    // fallback). Never approve an order which would bind a master to another section.
+    let owners = |groups: &[Vec<String>]| -> BTreeMap<String, usize> {
+        groups
+            .iter()
+            .enumerate()
+            .flat_map(|(i, items)| items.iter().map(move |href| (href.clone(), i)))
+            .collect()
+    };
+    let actual_owners: BTreeMap<_, _> = masters
+        .iter()
+        .map(|(owner, _, href)| (href.clone(), *owner))
+        .collect();
+    if output.section_files != section_hrefs
+        || owners(&output.section_master_page_files) != actual_owners
+        || owners(&source.section_master_page_files)
+            .iter()
+            .any(|(href, owner)| actual_owners.get(href) != Some(owner))
+    {
+        return Err(refused("section/master-page ownership would change"));
+    }
+    Ok(result)
+}
+
+/// Check the actual completed ZIP, including passthrough Scripts targets.
+/// External linked resources (isEmbeded=0) intentionally have no ZIP part.
+pub(super) fn validate_targets(bytes: &[u8], content: &[u8]) -> Result<(), SerializeError> {
+    let manifest = read_manifest(std::str::from_utf8(content).map_err(refused)?)?;
+    let mut archive = zip::ZipArchive::new(std::io::Cursor::new(bytes)).map_err(refused)?;
+    let names: HashSet<_> = archive.file_names().map(str::to_owned).collect();
+    if names.len() != archive.len() {
+        return Err(refused("duplicate ZIP part"));
+    }
+    for item in manifest.items {
+        if item.embedded && !names.contains(item.href.as_str()) {
+            return Err(refused(format!("dangling manifest href: {}", item.href)));
+        }
+        if item.media_type == "image/jpg" {
+            use std::io::Read;
+            let mut signature = [0u8; 3];
+            if !item.embedded {
+                return Err(refused("unverified linked JPEG MIME spelling"));
+            }
+            archive
+                .by_name(&item.href)
+                .map_err(refused)?
+                .read_exact(&mut signature)
+                .map_err(refused)?;
+            if signature != [0xff, 0xd8, 0xff] {
+                return Err(refused("JPEG MIME spelling without JPEG signature"));
+            }
+        }
+    }
+    Ok(())
+}
