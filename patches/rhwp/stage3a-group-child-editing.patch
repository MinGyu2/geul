+            attribute(has_instid, d.inst_id, source.and_then(|ids| ids.inst_id.as_deref())),
+        );
+    }
+    let instid = if d.inst_id != 0 { d.inst_id } else { c.instance_id };
+    (Some(c.instance_id.to_string()), Some(instid.to_string()))
