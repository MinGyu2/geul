+    #[test]
+    fn geul_ellipse_geometry_prevents_overflow_and_blocks_noncanonical_resize() {
+        let mk_ellipse = |w: u32, h: u32| -> crate::model::shape::EllipseShape {
+            let wi = w as i32;
+            let hi = h as i32;
+            let p = crate::model::Point { x: wi, y: hi / 2 };
+            let mut e = crate::model::shape::EllipseShape::default();
+            e.common.width = w;
+            e.common.height = h;
+            e.center = crate::model::Point { x: wi / 2, y: hi / 2 };
+            e.axis1 = p;
+            e.axis2 = crate::model::Point { x: wi / 2, y: hi };
+            e.start1 = p;
+            e.end1 = p;
+            e.start2 = p;
+            e.end2 = p;
+            e
+        };
+        // E1 & E2: Even & odd canonical ellipses support move + resize
+        assert_eq!(geul_group_child_geom_support(&ShapeObject::Ellipse(mk_ellipse(5200, 4100)), 5200, 4100), (true, true));
+        assert_eq!(geul_group_child_geom_support(&ShapeObject::Ellipse(mk_ellipse(101, 51)), 101, 51), (true, true));
+
+        // E3: Noncanonical start1..end2 (even when pairs are equal) preserves move but rejects resize
+        let mut noncanon = mk_ellipse(5200, 4100);
+        noncanon.start1 = crate::model::Point { x: 0, y: 0 };
+        noncanon.end1 = crate::model::Point { x: 0, y: 0 };
+        assert_eq!(geul_group_child_geom_support(&ShapeObject::Ellipse(noncanon), 5200, 4100), (true, false));
+
+        // E4: Extreme i32::MIN / i32::MAX must never overflow or pass
+        let mut extreme = mk_ellipse(2, 2);
+        extreme.center = crate::model::Point { x: i32::MIN + 1, y: i32::MAX };
+        assert_eq!(geul_group_child_geom_support(&ShapeObject::Ellipse(extreme), 2, 2), (false, false));
+    }
