+    pub fn move_group_child(
+        &mut self,
+        sec: usize,
+        para: usize,
+        ctrl: usize,
+        index: usize,
+        expected_id: u32,
+        expected_inst_id: u32,
+        x: i32,
+        y: i32,
+    ) -> Result<(), HwpError> {
+        let state = self.inspect_editable_group_children(sec, para, ctrl).ok_or_else(geul_bad_shape_edit)?;
+        let target = state.children.get(index).ok_or_else(geul_bad_shape_edit)?;
+        if !target.can_move || target.id != expected_id || target.inst_id != expected_inst_id
+            || x < 0 || y < 0
+            || i64::from(x) + i64::from(target.width) > i64::from(state.width)
+            || i64::from(y) + i64::from(target.height) > i64::from(state.height)
+            || (x == target.x && y == target.y)
+        {
+            return Err(geul_bad_shape_edit());
+        }
+        let ShapeObject::Group(group) = self.resolve_shape_control_mut(sec, para, ctrl)? else {
+            return Err(geul_bad_shape_edit());
+        };
+        let child = group.children.get_mut(index).ok_or_else(geul_bad_shape_edit)?;
+        {
+            let sa = child.shape_attr_mut();
+            sa.offset_x = x;
+            sa.offset_y = y;
+            sa.render_tx = f64::from(x);
+            sa.render_ty = f64::from(y);
+            sa.raw_rendering.clear();
+        }
+        let common = child.common_mut();
+        common.horizontal_offset = x as u32;
+        common.vertical_offset = y as u32;
+        self.refresh_advanced_shape(sec);
+        Ok(())
+    }
+
+    pub fn resize_group_child(
+        &mut self,
+        sec: usize,
+        para: usize,
+        ctrl: usize,
+        index: usize,
+        expected_id: u32,
+        expected_inst_id: u32,
+        width: i32,
+        height: i32,
+    ) -> Result<(), HwpError> {
+        let state = self.inspect_editable_group_children(sec, para, ctrl).ok_or_else(geul_bad_shape_edit)?;
+        let target = state.children.get(index).ok_or_else(geul_bad_shape_edit)?;
+        if !target.can_resize || target.id != expected_id || target.inst_id != expected_inst_id
+            || width < 1 || height < 1
+        {
+            return Err(geul_bad_shape_edit());
+        }
+        let new_w = width as u32;
+        let new_h = height as u32;
+        if i64::from(target.x) + i64::from(new_w) > i64::from(state.width)
+            || i64::from(target.y) + i64::from(new_h) > i64::from(state.height)
+            || (new_w == target.width && new_h == target.height)
+        {
+            return Err(geul_bad_shape_edit());
+        }
+        let ShapeObject::Group(group) = self.resolve_shape_control_mut(sec, para, ctrl)? else {
+            return Err(geul_bad_shape_edit());
+        };
+        let child = group.children.get_mut(index).ok_or_else(geul_bad_shape_edit)?;
+        {
+            let sa = child.shape_attr_mut();
+            sa.original_width = new_w;
+            sa.original_height = new_h;
+            sa.current_width = new_w;
+            sa.current_height = new_h;
+            sa.original_width_was_zero = false;
+            sa.original_height_was_zero = false;
+            sa.current_width_was_zero = false;
+            sa.current_height_was_zero = false;
+            sa.rotation_center = crate::model::Point { x: width / 2, y: height / 2 };
+            sa.render_sx = 1.0;
+            sa.render_sy = 1.0;
+            sa.render_b = 0.0;
+            sa.render_c = 0.0;
+            sa.raw_rendering.clear();
+        }
+        {
+            let common = child.common_mut();
+            common.width = new_w;
+            common.height = new_h;
+        }
+        match child {
+            ShapeObject::Rectangle(rect) => {
+                rect.x_coords = [0, width, width, 0];
+                rect.y_coords = [0, 0, height, height];
+            }
+            ShapeObject::Ellipse(ellipse) => {
+                let cx = width / 2;
+                let cy = height / 2;
+                ellipse.center = crate::model::Point { x: cx, y: cy };
+                ellipse.axis1 = crate::model::Point { x: width, y: cy };
+                ellipse.axis2 = crate::model::Point { x: cx, y: height };
+                let p = crate::model::Point { x: width, y: cy };
+                ellipse.start1 = p;
+                ellipse.end1 = p;
+                ellipse.start2 = p;
+                ellipse.end2 = p;
+            }
+            _ => return Err(geul_bad_shape_edit()),
+        }
+        self.refresh_advanced_shape(sec);
+        Ok(())
+    }
