+
+fn geul_read_matrix_f64_le(bytes: &[u8]) -> Option<[f64; 6]> {
+    if bytes.len() != 48 {
+        return None;
+    }
+    let mut out = [0.0f64; 6];
+    for (dst, chunk) in out.iter_mut().zip(bytes.chunks_exact(8)) {
+        let value = f64::from_le_bytes(chunk.try_into().ok()?);
+        if !value.is_finite() {
+            return None;
+        }
+        *dst = value;
+    }
+    Some(out)
+}
+
+fn geul_is_exact_identity_matrix(m: &[f64; 6]) -> bool {
+    m[0] == 1.0 && m[1] == 0.0 && m[2] == 0.0 && m[3] == 0.0 && m[4] == 1.0 && m[5] == 0.0
+}
+
+fn geul_finite_hwpx_int(value: f64, max_hu: u32) -> Option<i32> {
+    if !value.is_finite() || value.fract() != 0.0 || value < 0.0 || value > f64::from(max_hu) {
+        return None;
+    }
+    Some(value as i32)
+}
+
+fn geul_flat_hwpx_identity(sa: &crate::model::shape::ShapeComponentAttr, require_zero_offset: bool) -> bool {
+    if sa.rotation_angle != 0 || sa.horz_flip || sa.vert_flip || (sa.flip & 3) != 0
+        || !sa.render_sx.is_finite() || !sa.render_sy.is_finite()
+        || !sa.render_b.is_finite() || !sa.render_c.is_finite()
+        || sa.render_sx != 1.0 || sa.render_sy != 1.0
+        || sa.render_b != 0.0 || sa.render_c != 0.0
+    {
+        return false;
+    }
+    let Some(tx) = geul_finite_hwpx_int(sa.render_tx, MAX_RECT_DIM_HU) else {
+        return false;
+    };
+    let Some(ty) = geul_finite_hwpx_int(sa.render_ty, MAX_RECT_DIM_HU) else {
+        return false;
+    };
+    if tx != sa.offset_x || ty != sa.offset_y {
+        return false;
+    }
+    if require_zero_offset && (tx != 0 || ty != 0) {
+        return false;
+    }
+    if !sa.raw_rendering.is_empty() {
+        let Some((cnt_bytes, rest)) = sa.raw_rendering.split_at_checked(2) else {
+            return false;
+        };
+        let count = u16::from_le_bytes([cnt_bytes[0], cnt_bytes[1]]) as usize;
+        if count > 64 || count.checked_mul(96).and_then(|n| n.checked_add(48)) != Some(rest.len()) {
+            return false;
+        }
+        let Some(trans) = geul_read_matrix_f64_le(&rest[..48]) else {
+            return false;
+        };
+        if trans[0] != 1.0 || trans[1] != 0.0 || trans[3] != 0.0 || trans[4] != 1.0 {
+            return false;
+        }
+        let Some(rtx) = geul_finite_hwpx_int(trans[2], MAX_RECT_DIM_HU) else {
+            return false;
+        };
+        let Some(rty) = geul_finite_hwpx_int(trans[5], MAX_RECT_DIM_HU) else {
+            return false;
+        };
+        if require_zero_offset {
+            if rtx != 0 || rty != 0 {
+                return false;
+            }
+        } else if !((rtx == 0 && rty == 0) || (rtx == tx && rty == ty)) {
+            return false;
+        }
+        for pair in rest[48..].chunks_exact(96) {
+            let Some(sca) = geul_read_matrix_f64_le(&pair[..48]) else {
+                return false;
+            };
+            let Some(rot) = geul_read_matrix_f64_le(&pair[48..96]) else {
+                return false;
+            };
+            if !geul_is_exact_identity_matrix(&sca) || !geul_is_exact_identity_matrix(&rot) {
+                return false;
+            }
+        }
+    }
+    true
+}
+
+fn geul_exact_hwpx_size(
+    common: &crate::model::shape::CommonObjAttr,
+    sa: &crate::model::shape::ShapeComponentAttr,
+) -> Option<(u32, u32)> {
+    let (w, h) = (common.width, common.height);
+    if w == 0 || w > MAX_RECT_DIM_HU || h == 0 || h > MAX_RECT_DIM_HU
+        || sa.original_width_was_zero || sa.original_height_was_zero
+        || sa.current_width_was_zero || sa.current_height_was_zero
+        || sa.original_width != w || sa.original_height != h
+        || sa.current_width != w || sa.current_height != h
+    {
+        return None;
+    }
+    Some((w, h))
+}
+
+fn geul_group_child_geom_support(child: &ShapeObject, w: u32, h: u32) -> (bool, bool) {
+    let Ok(w_i) = i32::try_from(w) else { return (false, false) };
+    let Ok(h_i) = i32::try_from(h) else { return (false, false) };
+    match child {
+        ShapeObject::Rectangle(rect) => {
+            let ok = rect.round_rate <= 100
+                && rect.source_hwp_geometry.is_none()
+                && rect.x_coords == [0, w_i, w_i, 0]
+                && rect.y_coords == [0, 0, h_i, h_i];
+            (ok, ok)
+        }
+        ShapeObject::Ellipse(ellipse) => {
+            let w64 = i64::from(w);
+            let h64 = i64::from(h);
+            let cx = i64::from(ellipse.center.x);
+            let cy = i64::from(ellipse.center.y);
+            let a1x = i64::from(ellipse.axis1.x);
+            let a1y = i64::from(ellipse.axis1.y);
+            let a2x = i64::from(ellipse.axis2.x);
+            let a2y = i64::from(ellipse.axis2.y);
+            let axes_ok = ellipse.attr == 0
+                && cx >= w64 / 2 && cx <= (w64 + 1) / 2
+                && cy >= h64 / 2 && cy <= (h64 + 1) / 2
+                && a1x == w64 && a1y == cy
+                && a2x == cx && a2y == h64;
+            if !axes_ok {
+                return (false, false);
+            }
+            let canonical_endpoints = i64::from(ellipse.start1.x) == a1x && i64::from(ellipse.start1.y) == a1y
+                && i64::from(ellipse.end1.x) == a1x && i64::from(ellipse.end1.y) == a1y
+                && i64::from(ellipse.start2.x) == a1x && i64::from(ellipse.start2.y) == a1y
+                && i64::from(ellipse.end2.x) == a1x && i64::from(ellipse.end2.y) == a1y;
+            // Moving only updates parent-local offset and leaves ellipse axes/endpoints untouched,
+            // whereas resizing overwrites start1..end2 with the canonical full-ellipse endpoint.
+            (true, canonical_endpoints)
+        }
+        _ => (false, false),
+    }
+}
+
+fn geul_group_child_state(index: usize, child: &ShapeObject, gw: u32, gh: u32) -> Option<GeulGroupChildState> {
+    let kind = match child {
+        ShapeObject::Rectangle(_) => "rectangle",
+        ShapeObject::Ellipse(_) => "ellipse",
+        _ => return None,
+    };
+    let common = child.common();
+    let drawing = child.drawing()?;
+    let sa = child.shape_attr();
+    if sa.hwpx_group_child_source_ids.as_ref().is_some_and(|source| source.invalid) {
+        return None;
+    }
+    let id = common.instance_id;
+    let inst_id = drawing.inst_id;
+    let (x, y) = (sa.offset_x, sa.offset_y);
+    let exact_size = geul_exact_hwpx_size(common, sa);
+    let (w, h) = exact_size.unwrap_or((common.width, common.height));
+    let (geom_move_ok, geom_resize_ok) = geul_group_child_geom_support(child, w, h);
+    let structurally_valid = exact_size.is_some()
+        && !(id == 0 && inst_id == 0)
+        && sa.group_level == 1
+        && drawing.caption.is_none()
+        && drawing.text_box.is_none()
+        && geul_flat_hwpx_identity(sa, false)
+        && geom_move_ok
+        && x >= 0 && y >= 0
+        && i64::from(x) + i64::from(w) <= i64::from(gw)
+        && i64::from(y) + i64::from(h) <= i64::from(gh);
+    let can_move = structurally_valid && !common.locked;
+    let can_resize = can_move && geom_resize_ok && !common.size_protect;
+    Some(GeulGroupChildState {
+        index,
+        kind,
+        id,
+        inst_id,
+        x,
+        y,
+        width: w,
+        height: h,
+        size_protect: common.size_protect,
+        locked: common.locked,
+        can_move,
+        can_resize,
+    })
+}
