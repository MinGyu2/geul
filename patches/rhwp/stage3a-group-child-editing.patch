+    fn inspect_editable_group_children(&self, sec: usize, para: usize, ctrl: usize) -> Option<GeulEditableGroupChildren> {
+        use crate::parser::FileFormat;
+        if self.source_format != FileFormat::Hwpx {
+            return None;
+        }
+        let ShapeObject::Group(group) = self.advanced_body_shape(sec, para, ctrl)? else {
+            return None;
+        };
+        if group.caption.is_some() || group.common.size_protect || group.shape_attr.group_level != 0
+            || group.children.is_empty() || group.children.len() > 128
+            || !geul_flat_hwpx_identity(&group.shape_attr, true)
+        {
+            return None;
+        }
+        let (gw, gh) = geul_exact_hwpx_size(&group.common, &group.shape_attr)?;
+        let mut seen = std::collections::HashSet::with_capacity(group.children.len());
+        let mut children = Vec::with_capacity(group.children.len());
+        for (index, child) in group.children.iter().enumerate() {
+            let state = geul_group_child_state(index, child, gw, gh)?;
+            if !seen.insert((state.id, state.inst_id)) {
+                return None;
+            }
+            children.push(state);
+        }
+        if !children.iter().any(|c| c.can_move || c.can_resize) {
+            return None;
+        }
+        Some(GeulEditableGroupChildren {
+            parent_id: group.common.instance_id,
+            width: gw,
+            height: gh,
+            children,
+        })
+    }
