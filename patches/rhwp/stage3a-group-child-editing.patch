 // ─── 그리기 객체 파싱 (rect, ellipse, line, arc, polygon, curve) ───

+fn parse_group_child_ids(
+    element: &quick_xml::events::BytesStart,
+    shape_attr: &mut ShapeComponentAttr,
+) -> Result<(u32, u32), HwpxError> {
+    let mut source = crate::model::shape::HwpxGroupChildSourceIds::default();
+    let (mut id, mut inst_id) = (None, None);
+    for attr in element.attributes() {
+        let attr = attr.map_err(|err| HwpxError::XmlError(format!("group child attributes: {err}")))?;
+        let (number, spelling) = match attr.key.as_ref().as_bytes() {
+            b"id" => (&mut id, &mut source.id),
+            b"instid" => (&mut inst_id, &mut source.inst_id),
+            _ => continue,
+        };
+        let value = attr.normalized_value(quick_xml::XmlVersion::Implicit1_0)
+            .map_err(|err| HwpxError::XmlError(format!("group child identifier: {err}")))?;
+        if value.chars().any(|ch| !matches!(ch, '\t' | '\n' | '\r'
+            | '\u{20}'..='\u{D7FF}' | '\u{E000}'..='\u{FFFD}' | '\u{10000}'..='\u{10FFFF}'))
+        {
+            return Err(HwpxError::XmlError("invalid XML character in group child identifier".into()));
+        }
+        let lexical = value.trim_matches([' ', '\t', '\n', '\r']);
+        // xs:nonNegativeInteger permits signed zero, but Rust's u32 parser rejects a minus sign.
+        let parsed = if let Some(magnitude) = lexical.strip_prefix('-') {
+            (!magnitude.is_empty() && magnitude.bytes().all(|b| b == b'0')).then_some(0)
+        } else {
+            lexical.parse::<u32>().ok()
+        };
+        source.invalid |= parsed.is_none();
+        *number = Some(parsed.unwrap_or(0));
+        if parsed.is_none_or(|value_num| value_num.to_string() != value) {
+            *spelling = Some(value.into_owned());
+        }
+    }
+    shape_attr.hwpx_group_child_id_presence = Some((id.is_some(), inst_id.is_some()));
+    if source.id.is_some() || source.inst_id.is_some() {
+        shape_attr.hwpx_group_child_source_ids = Some(Box::new(source));
+    }
+    Ok((id.unwrap_or(0), inst_id.unwrap_or(0)))
+}
