+    /// Export the selected body control as a bounded, standalone HWP5 fragment.
+    /// Only the selected control, its reachable BinData, and source DocInfo tables
+    /// are carried. The live document model is never edited by this operation.
+    pub fn export_hwp5_control_clipboard_native(
+        &mut self,
+        section_idx: usize,
+        para_idx: usize,
+        control_idx: usize,
+    ) -> Result<Vec<u8>, HwpError> {
+        if self.source_format != crate::parser::FileFormat::Hwp {
+            return Err(HwpError::RenderError(
+                "HWP5 object clipboard requires an HWP5 source".to_string(),
+            ));
+        }
+
+        self.copy_control_native(section_idx, para_idx, &[], control_idx)?;
+        let clip_para = self
+            .clipboard
+            .as_ref()
+            .and_then(|clipboard| clipboard.paragraphs.first())
+            .cloned()
+            .ok_or_else(|| HwpError::RenderError("object clipboard is empty".to_string()))?;
+        if clip_para.controls.len() != 1
+            || !matches!(
+                clip_para.controls.first(),
+                Some(Control::Table(_) | Control::Shape(_) | Control::Picture(_))
+            )
+        {
+            return Err(HwpError::RenderError(
+                "only a single body table, picture, or shape can be exported".to_string(),
+            ));
+        }
+
+        let mut fragment = self.document.clone();
+        let mut section =
+            fragment.sections.get(section_idx).cloned().ok_or_else(|| {
+                HwpError::RenderError("source section is out of range".to_string())
+            })?;
+        section.paragraphs = vec![clip_para];
+        section.raw_stream = None;
+        section.raw_provenance = None;
+        // The fragment owns a body object only. Master-page stories and unrelated CFB
+        // streams are not part of this clipboard operation.
+        section.section_def.master_pages.clear();
+        fragment.sections = vec![section];
+        fragment.preview = None;
+        fragment.extra_streams.clear();
+        fragment.hwpx_aux_entries.clear();
+        fragment.doc_info.raw_stream = None;
+        fragment.doc_info.raw_provenance = None;
+        fragment.doc_info.raw_stream_dirty = true;
+
+        // Apply the same strict support and reference-closure checks used by the
+        // destination importer before pruning any resource that opaque records might
+        // reference. Unsupported or ambiguous objects stay same-document only.
+        super::paragraph_block::validate_hwp5_clipboard_fragment(&fragment)?;
+        super::bin_data_prune::prune_unreferenced_bin_data(&mut fragment);
+
+        let mut remaining = MAX_HWP5_OBJECT_CLIPBOARD_BYTES;
+        for content in &mut fragment.bin_data_content {
+            let bytes = content.data.load_limited_shared(remaining).ok_or_else(|| {
+                HwpError::RenderError(
+                    "object resources exceed the HWP5 clipboard size limit".to_string(),
+                )
+            })?;
+            if bytes.is_empty() {
+                return Err(HwpError::RenderError(
+                    "object references an empty embedded resource".to_string(),
+                ));
+            }
+            remaining = remaining.saturating_sub(bytes.len());
+            content.data = crate::model::bin_data::BinDataBytes::from_shared(bytes);
+        }
+
+        let bytes = crate::serializer::serialize_document(&fragment)
+            .map_err(|error| HwpError::RenderError(error.to_string()))?;
+        if bytes.is_empty() || bytes.len() > MAX_HWP5_OBJECT_CLIPBOARD_BYTES {
+            return Err(HwpError::RenderError(
+                "serialized HWP5 object fragment exceeds the clipboard size limit".to_string(),
+            ));
+        }
+        Ok(bytes)
+    }
