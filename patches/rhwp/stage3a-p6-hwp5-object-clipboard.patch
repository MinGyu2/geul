+/// HWP5 serializes section and column definitions as controls at the beginning of a
+/// section's first paragraph. They are owned by the destination section, not by the
+/// copied object. Strip only the exact pair emitted for a one-section fragment; reject
+/// any additional or reordered control before importing the object.
+pub(super) fn normalize_hwp5_clipboard_fragment(source: &mut Document) -> Result<(), HwpError> {
+    if source.sections.len() != 1 || source.sections[0].paragraphs.len() != 1 {
+        return Err(invalid(
+            "HWP5 clipboard fragment must contain one section and paragraph",
+        ));
+    }
+    let section = &mut source.sections[0];
+    let paragraph = &mut section.paragraphs[0];
+    if paragraph.controls.len() != 3 || paragraph.ctrl_data_records.len() != 3 {
+        return Err(invalid(
+            "HWP5 clipboard fragment must contain one object and its section controls",
+        ));
+    }
+    let section_def_matches = match &paragraph.controls[0] {
+        crate::model::control::Control::SectionDef(control) => {
+            serde_json::to_value(&**control).ok() == serde_json::to_value(&section.section_def).ok()
+        }
+        _ => false,
+    };
+    if !section_def_matches
+        || !matches!(
+            paragraph.controls.get(1),
+            Some(crate::model::control::Control::ColumnDef(_))
+        )
+    {
+        return Err(invalid(
+            "HWP5 clipboard section controls are missing, ambiguous, or inconsistent",
+        ));
+    }
+    paragraph.controls.drain(0..2);
+    paragraph.ctrl_data_records.drain(0..2);
+    validate_hwp5_clipboard_fragment(source)
+}
