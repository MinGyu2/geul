+    /// [geul] Stage 2 P4-3: read table pagination & header-row state for rows [start_row..=end_row].
+    pub fn get_table_pagination_by_path_native(
+        &self,
+        section: usize,
+        paragraph: usize,
+        path: &[(usize, usize, usize)],
+        start_row: u16,
+        end_row: u16,
+    ) -> Result<String, HwpError> {
+        let table = self.resolve_table_by_path(section, paragraph, path)?;
+        if table.row_count == 0 || start_row > end_row || end_row >= table.row_count {
+            return Err(HwpError::RenderError("table pagination row range out of bounds".into()));
+        }
+        let leading = table.leading_header_rows().len();
+        let mut any_true = false;
+        let mut any_false = false;
+        for r in start_row..=end_row {
+            let mut has_cells = false;
+            let mut all_hdr = true;
+            for cell in &table.cells {
+                let cr1 = cell.row + cell.row_span.saturating_sub(1);
+                if cell.row <= r && r <= cr1 {
+                    has_cells = true;
+                    if !cell.is_header {
+                        all_hdr = false;
+                    }
+                }
+            }
+            if has_cells && all_hdr {
+                any_true = true;
+            } else {
+                any_false = true;
+            }
+        }
+        let page_break = match table.page_break {
+            crate::model::table::TablePageBreak::None => "none",
+            crate::model::table::TablePageBreak::CellBreak => "cell",
+            crate::model::table::TablePageBreak::RowBreak => "row",
+        };
+        let row_header = if any_true && !any_false {
+            serde_json::json!(true)
+        } else if !any_true && any_false {
+            serde_json::json!(false)
+        } else {
+            serde_json::Value::Null
+        };
+        Ok(serde_json::json!({
+            "pageBreak": page_break,
+            "repeatHeader": table.repeat_header,
+            "leadingHeaderRows": leading,
+            "rowCount": table.row_count,
+            "rowHeader": row_header,
+            "rowHeaderMixed": any_true && any_false,
+            "canEnableHeader": (start_row as usize) <= leading,
+        })
+        .to_string())
+    }
+
+    /// [geul] Stage 2 P4-3: set/clear repeating header rows contiguously from row 0 and sync repeat_header.
+    pub fn set_table_header_rows_by_path_native(
+        &mut self,
+        section: usize,
+        paragraph: usize,
+        path: &[(usize, usize, usize)],
+        start_row: u16,
+        end_row: u16,
+        is_header: bool,
+    ) -> Result<String, HwpError> {
+        {
+            let table = self.resolve_table_mut_by_cell_path(section, paragraph, path)?;
+            if table.row_count == 0 || start_row > end_row || end_row >= table.row_count {
+                return Err(HwpError::RenderError("header row range out of bounds".into()));
+            }
+            let leading = table.leading_header_rows().len();
+            if is_header && (start_row as usize) > leading {
+                return Err(HwpError::RenderError(
+                    "repeating header rows must start contiguously from the first row".into(),
+                ));
+            }
+            for cell in &table.cells {
+                let cr1 = cell.row + cell.row_span.saturating_sub(1);
+                let touches = cr1 >= start_row && cell.row <= end_row;
+                if !is_header && touches && cell.row < start_row {
+                    return Err(HwpError::RenderError(
+                        "cannot clear header flag on partial vertically merged cell".into(),
+                    ));
+                }
+                if is_header && touches && cr1 > end_row {
+                    return Err(HwpError::RenderError(
+                        "cannot mark partial vertically merged cell as header".into(),
+                    ));
+                }
+            }
+            for cell in &mut table.cells {
+                let cr1 = cell.row + cell.row_span.saturating_sub(1);
+                if is_header {
+                    if cr1 >= start_row && cell.row <= end_row {
+                        cell.set_header(true);
+                    }
+                } else if cr1 >= start_row {
+                    cell.set_header(false);
+                }
+            }
+            table.repeat_header = !table.leading_header_rows().is_empty();
+        }
+        if path.len() > 1 {
+            self.mark_cell_control_dirty(section, paragraph, path[0].0);
+        }
+        self.document.sections[section].raw_stream = None;
+        self.recompose_section(section);
+        self.paginate_if_needed();
+        Ok("{\"ok\":true}".into())
+    }
