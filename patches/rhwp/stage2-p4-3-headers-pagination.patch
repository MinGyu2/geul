+    #[test]
+    fn stage2_p4_3_repeating_headers_and_pagination_hwpx_and_hwp() {
+        let (mut core, para, ctrl) = core_with_table(14, 2);
+        let path = vec![(ctrl, 0usize, 0usize)];
+        // Normalize HWP-like defaults & populate 2 header rows + 12 tall body rows spanning 2+ pages
+        core.set_table_properties_by_path_native(
+            0,
+            para,
+            &path,
+            r#"{"textWrap":"TopAndBottom","treatAsChar":false,"pageBreak":2}"#,
+        )
+        .unwrap();
+        core.insert_text_in_cell_by_path(0, para, &[(ctrl, 0, 0)], 0, "HDR_ZERO")
+            .unwrap();
+        core.insert_text_in_cell_by_path(0, para, &[(ctrl, 2, 0)], 0, "HDR_ONE")
+            .unwrap();
+        core.format_table_cells_by_path_native(
+            0,
+            para,
+            &path,
+            r#"{"rect":{"startRow":0,"startCol":0,"endRow":13,"endCol":1},"rowHeight":{"heightPt":70.0}}"#,
+        )
+        .unwrap();
+
+        // Reject non-leading header row (row 3 when row 0 is not header)
+        assert!(core
+            .set_table_header_rows_by_path_native(0, para, &path, 3, 3, true)
+            .is_err());
+
+        // Set rows 0..=1 as contiguous repeating header rows
+        core.set_table_header_rows_by_path_native(0, para, &path, 0, 1, true)
+            .unwrap();
+        let pg_info: serde_json::Value = serde_json::from_str(
+            &core
+                .get_table_pagination_by_path_native(0, para, &path, 0, 1)
+                .unwrap(),
+        )
+        .unwrap();
+        assert_eq!(pg_info["repeatHeader"], true);
+        assert_eq!(pg_info["leadingHeaderRows"], 2);
+        assert_eq!(pg_info["pageBreak"], "row");
+        assert_eq!(pg_info["rowHeader"], true);
+
+        // Render page 2 (index 1) and confirm repeated headers appear on continuation page!
+        assert!(core.page_count() >= 2, "expected >=2 pages, got {}", core.page_count());
+        let p2_html = core.render_page_html_native(1).unwrap();
+        assert!(p2_html.contains("HDR_ZERO"), "page 2 missing HDR_ZERO: {}", p2_html);
+        assert!(p2_html.contains("HDR_ONE"), "page 2 missing HDR_ONE: {}", p2_html);
+
+        // Save/reopen HWPX & HWP and confirm preservation
+        let hwpx = core.export_hwpx_native().unwrap();
+        let reopened_hwpx = DocumentCore::from_bytes(&hwpx).unwrap();
+        let rt_hwpx = table(&reopened_hwpx, para, ctrl);
+        assert!(rt_hwpx.repeat_header);
+        assert_eq!(rt_hwpx.leading_header_rows(), vec![0, 1]);
+        assert_eq!(rt_hwpx.page_break, crate::model::table::TablePageBreak::RowBreak);
+        assert_eq!(reopened_hwpx.controls_json(), core.controls_json());
+
+        let hwp = core.export_hwp_native().unwrap();
+        let reopened_hwp = DocumentCore::from_bytes(&hwp).unwrap();
+        let rt_hwp = table(&reopened_hwp, para, ctrl);
+        assert!(rt_hwp.repeat_header);
+        assert_eq!(rt_hwp.leading_header_rows(), vec![0, 1]);
+        assert_eq!(rt_hwp.page_break, crate::model::table::TablePageBreak::RowBreak);
+        assert_eq!(reopened_hwp.controls_json(), core.controls_json());
+
+        // Clearing row 1 leaves row 0 as 1-row leading header; clearing row 0 turns repeat_header off
+        core.set_table_header_rows_by_path_native(0, para, &path, 1, 1, false)
+            .unwrap();
+        let info_one: serde_json::Value = serde_json::from_str(
+            &core
+                .get_table_pagination_by_path_native(0, para, &path, 0, 1)
+                .unwrap(),
+        )
+        .unwrap();
+        assert_eq!(info_one["leadingHeaderRows"], 1);
+        assert_eq!(info_one["repeatHeader"], true);
+        assert_eq!(info_one["rowHeaderMixed"], true);
+
+        core.set_table_header_rows_by_path_native(0, para, &path, 0, 0, false)
+            .unwrap();
+        assert!(!table(&core, para, ctrl).repeat_header);
+    }
