+/// Structural curve edits require at least three unique anchors. A repeated
+/// first/last point is the sole permitted duplicate and denotes closure.
+fn geul_hwpx_curve_anchor_topology_valid(points: &[crate::model::Point]) -> bool {
+    if !(3..=257).contains(&points.len()) {
+        return false;
+    }
+    let closed = points.len() > 1 && geul_same_point(&points[0], points.last().unwrap());
+    let anchor_count = points.len() - usize::from(closed);
+    if !(3..=256).contains(&anchor_count) {
+        return false;
+    }
+    points[..anchor_count]
+        .iter()
+        .map(|point| (point.x, point.y))
+        .collect::<std::collections::BTreeSet<_>>()
+        .len()
+        == anchor_count
+}
