+/// Exact LINE operations may not change the neighboring-anchor dependency of
+/// a CURVE segment. Return only standard LINEs with no adjacent CURVE segment;
+/// the mutation API additionally proves that every derived curve is unchanged.
+fn geul_hwpx_exact_line_segments(
+    segments: &[HwpxCurveSegment],
+    points: &[crate::model::Point],
+) -> Option<Vec<usize>> {
+    if segments.is_empty()
+        || !geul_hwpx_curve_matches(segments, points)
+        || !geul_hwpx_curve_anchor_topology_valid(points)
+        || segments.iter().any(|segment| geul_hwpx_standard_segment_type(segment).is_none())
+    {
+        return None;
+    }
+    let closed = geul_same_point(&points[0], points.last()?);
+    Some(segments.iter().enumerate().filter_map(|(index, segment)| {
+        if !geul_hwpx_line_segment_is_editable(segment) {
+            return None;
+        }
+        let previous_curve = if index > 0 {
+            geul_hwpx_standard_segment_type(&segments[index - 1]) == Some("CURVE")
+        } else {
+            closed && geul_hwpx_standard_segment_type(segments.last()?) == Some("CURVE")
+        };
+        let next_curve = if index + 1 < segments.len() {
+            geul_hwpx_standard_segment_type(&segments[index + 1]) == Some("CURVE")
+        } else {
+            closed && geul_hwpx_standard_segment_type(segments.first()?) == Some("CURVE")
+        };
+        (!previous_curve && !next_curve).then_some(index)
+    }).collect())
+}
