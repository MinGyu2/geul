+/// Exact integer numerators (denominator six) for every derived CURVE cubic.
+/// This compares the geometry used by the current renderer without a floating
+/// point tolerance and is intentionally independent of serialized controls.
+fn geul_hwpx_curve_geometry_signature(
+    segments: &[HwpxCurveSegment],
+    points: &[crate::model::Point],
+) -> Option<Vec<[[i64; 2]; 4]>> {
+    if !geul_hwpx_curve_matches(segments, points)
+        || !geul_hwpx_curve_anchor_topology_valid(points)
+        || segments.iter().any(|segment| geul_hwpx_standard_segment_type(segment).is_none())
+    {
+        return None;
+    }
+    let closed = geul_same_point(&points[0], points.last()?);
+    let anchor_count = points.len().checked_sub(usize::from(closed))?;
+    if segments.len() != if closed { anchor_count } else { anchor_count.checked_sub(1)? } {
+        return None;
+    }
+    let scaled = |point: crate::model::Point| [6 * i64::from(point.x), 6 * i64::from(point.y)];
+    let mut signature = Vec::new();
+    for (index, segment) in segments.iter().enumerate() {
+        if geul_hwpx_standard_segment_type(segment) != Some("CURVE") {
+            continue;
+        }
+        let start_index = index;
+        let end_index = if closed { (index + 1) % anchor_count } else { index + 1 };
+        let previous_index = if index > 0 { index - 1 } else if closed { anchor_count - 1 } else { start_index };
+        let next_index = if end_index + 1 < anchor_count { end_index + 1 } else if closed { 0 } else { end_index };
+        let p0 = points[start_index];
+        let p1 = points[end_index];
+        let previous = points[previous_index];
+        let next = points[next_index];
+        signature.push([
+            scaled(p0),
+            [6 * i64::from(p0.x) + i64::from(p1.x) - i64::from(previous.x),
+             6 * i64::from(p0.y) + i64::from(p1.y) - i64::from(previous.y)],
+            [6 * i64::from(p1.x) - i64::from(next.x) + i64::from(p0.x),
+             6 * i64::from(p1.y) - i64::from(next.y) + i64::from(p0.y)],
+            scaled(p1),
+        ]);
+    }
+    Some(signature)
 }

