+
+#[test]
+fn newly_created_cell_with_flags_retains_hancom_width_ref_contract() {
+    use crate::model::table::{Cell, CELL_FLAG_HAS_MARGIN, CELL_FLAG_HEADER};
+
+    let mut cell = Cell::new_empty(0, 0, 5000, 500, 1);
+    assert_eq!(cell.list_header_width_ref, 0);
+    cell.set_apply_inner_margin(true);
+    cell.set_header(true);
+    let mut records = Vec::new();
+    serialize_cell(&cell, 2, &mut records);
+    let hdr = records
+        .iter()
+        .find(|r| r.tag_id == tags::HWPTAG_LIST_HEADER)
+        .expect("HWPTAG_LIST_HEADER emitted");
+    let serialized_flags = u16::from_le_bytes([hdr.data[6], hdr.data[7]]);
+    assert_eq!(
+        serialized_flags,
+        0x0400 | CELL_FLAG_HAS_MARGIN | CELL_FLAG_HEADER
+    );
+}
