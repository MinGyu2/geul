-    } else {
-        cell.list_header_width_ref
-    };
+    // 만든 셀은 한컴 호환 47바이트 LIST_HEADER 계약을 위해 기본값 0x0400을 유지한다
+    // (`set_apply_inner_margin`/`set_header` 등이 하위 플래그 비트만 먼저 켠 경우 포함).
+    let list_header_width_ref =
