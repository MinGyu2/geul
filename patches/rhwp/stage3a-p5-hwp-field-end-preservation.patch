+
+fn read_hwp5_field_end(data: &[u8], pos: usize) -> Option<[u16; 7]> {
+    let payload = data.get(pos + 2..pos + 16)?;
+    let mut units = [0; 7];
+    for (unit, bytes) in units.iter_mut().zip(payload.chunks_exact(2)) {
+        *unit = u16::from_le_bytes([bytes[0], bytes[1]]);
+    }
+    Some(units)
 }
 
