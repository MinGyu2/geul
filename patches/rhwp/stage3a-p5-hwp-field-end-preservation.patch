+#[test]
+fn matched_hwp5_field_end_keeps_its_opaque_payload() {
+    let payload: [u16; 7] = [0x6b6c, 0x0963, 0x0001, 0x0000, 0x0025, 0x0000, 0x0004];
+    let mut data = Vec::new();
+    for unit in [0x0003u16, 0x6b6c, 0x0963, 1, 0, 0, 0, 0x0003] {
+        data.extend_from_slice(&unit.to_le_bytes());
+    }
+    data.extend_from_slice(&u16::from(b'A').to_le_bytes());
+    data.extend_from_slice(&0x0004u16.to_le_bytes());
+    for unit in payload {
+        data.extend_from_slice(&unit.to_le_bytes());
+    }
+    data.extend_from_slice(&0x000Du16.to_le_bytes());
+
+    let parts = parse_para_text(&data);
+    assert_eq!(parts.text, "A");
+    assert_eq!(parts.field_ranges.len(), 1);
+    assert_eq!(parts.field_ranges[0].hwp5_end.unwrap().data, payload);
+}
