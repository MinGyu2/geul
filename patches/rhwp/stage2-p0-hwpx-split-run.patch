+fn atom_char(atom: &str) -> Result<Option<char>, &'static str> {
+    if let Some(rest) = atom.strip_prefix("c:") {
+        let mut chars = rest.chars();
+        let ch = chars.next().ok_or(FORMAT_BOUNDARY)?;
+        if chars.next().is_some() {
+            return Err(FORMAT_BOUNDARY);
+        }
+        Ok(Some(ch))
+    } else if let Some(rest) = atom.strip_prefix("i:") {
+        let tag = rest.split(':').next().unwrap_or("");
+        match tag {
+            "tab" => Ok(Some('\t')),
+            "lineBreak" | "columnBreak" => Ok(Some('\n')),
+            "nbSpace" => Ok(Some('\u{00A0}')),
+            "fwSpace" => Ok(Some('\u{2007}')),
+            "hyphen" => Ok(Some('\u{00AD}')),
+            "titleMark" | "markpenBegin" | "markpenEnd" => Ok(None),
+            _ => Err(FORMAT_BOUNDARY),
+        }
+    } else {
+        Err(FORMAT_BOUNDARY)
+    }
+}
+
+fn control_is_auto_num(key: &str) -> bool {
+    key.starts_with("o:ctrl:") && key.contains("/autoNum/")
+}
