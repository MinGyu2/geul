+    /// Split a line at an exact interior point or remove a point between
+    /// consecutive collinear lines. Existing cubic points and commands stay in place.
+    pub fn edit_curve_interior_line(
+        &mut self, sec: usize, para: usize, ctrl: usize, index: usize, insert: Option<crate::model::Point>,
+    ) -> Result<(), HwpError> {
+        let (curve, _) = self.editable_terminal_curve(sec, para, ctrl).ok_or_else(geul_bad_shape_edit)?;
+        let mut points = curve.points.clone();
+        let mut commands = curve.segment_types.clone();
+        let handles = geul_cubic_handles(&points, &commands).ok_or_else(geul_bad_shape_edit)?;
+        let between = |a, p, b| {
+            !geul_same_point(&a, &p) && !geul_same_point(&p, &b)
+                && geul_within_segment_bounds(p, a, b) && geul_cross(a, p, b) == 0
+        };
+        if index >= points.len() - 1 {
+            return Err(geul_bad_shape_edit());
+        }
+        let command = handles[..index].iter().filter(|handle| !**handle).count();
+        if let Some(point) = insert {
+            if points.len() == 257 || handles[index] || handles[index + 1] || commands[command] != 0
+                || !between(points[index], point, points[index + 1])
+            {
+                return Err(geul_bad_shape_edit());
+            }
+            points.insert(index + 1, point);
+            commands.insert(command, 0);
+        } else {
+            if index == 0 || handles[index - 1..=index + 1].contains(&true)
+                || commands[command - 1..=command] != [0, 0]
+                || !between(points[index - 1], points[index], points[index + 1])
+            {
+                return Err(geul_bad_shape_edit());
+            }
+            points.remove(index);
+            commands.remove(command);
         }
         geul_cubic_handles(&points, &commands).ok_or_else(geul_bad_shape_edit)?;
         let ShapeObject::Curve(curve) = self.resolve_shape_control_mut(sec, para, ctrl)? else {
