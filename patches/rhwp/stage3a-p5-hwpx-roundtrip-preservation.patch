+
+/// Reconstruct an XML element from the original quick-xml event payloads.
+/// Attribute spelling/order, references, comments, and nested unknown nodes
+/// remain intact; callers retain it only while the corresponding model fields
+/// are unchanged.
+pub(crate) fn begin_element_markup(start: &BytesStart<'_>) -> Vec<u8> {
+    let mut markup = Vec::with_capacity(start.as_ref().len() + 2);
+    markup.push(b'<');
+    markup.extend_from_slice(start.as_ref().as_bytes());
+    markup.push(b'>');
+    markup
+}
+
+pub(crate) fn empty_element_markup(start: &BytesStart<'_>) -> Vec<u8> {
+    let mut markup = Vec::with_capacity(start.as_ref().len() + 3);
+    markup.push(b'<');
+    markup.extend_from_slice(start.as_ref().as_bytes());
+    markup.extend_from_slice(b"/>");
+    markup
+}
+
+pub(crate) fn append_event_markup(markup: &mut Vec<u8>, event: &Event<'_>) -> bool {
+    match event {
+        Event::Start(element) => {
+            markup.push(b'<');
+            markup.extend_from_slice(element.as_ref().as_bytes());
+            markup.push(b'>');
+        }
+        Event::Empty(element) => {
+            markup.push(b'<');
+            markup.extend_from_slice(element.as_ref().as_bytes());
+            markup.extend_from_slice(b"/>");
+        }
+        Event::End(element) => {
+            markup.extend_from_slice(b"</");
+            markup.extend_from_slice(element.as_ref().as_bytes());
+            markup.push(b'>');
+        }
+        Event::Text(text) => markup.extend_from_slice(text.as_ref().as_bytes()),
+        Event::CData(text) => {
+            markup.extend_from_slice(b"<![CDATA[");
+            markup.extend_from_slice(text.as_ref().as_bytes());
+            markup.extend_from_slice(b"]]>");
+        }
+        Event::Comment(text) => {
+            markup.extend_from_slice(b"<!--");
+            markup.extend_from_slice(text.as_ref().as_bytes());
+            markup.extend_from_slice(b"-->");
+        }
+        Event::PI(text) => {
+            markup.extend_from_slice(b"<?");
+            markup.extend_from_slice(text.as_ref().as_bytes());
+            markup.extend_from_slice(b"?>");
+        }
+        Event::GeneralRef(reference) => {
+            markup.push(b'&');
+            markup.extend_from_slice(reference.as_ref().as_bytes());
+            markup.push(b';');
+        }
+        Event::Decl(_) | Event::DocType(_) | Event::Eof => return false,
+    }
+    true
+}
 
