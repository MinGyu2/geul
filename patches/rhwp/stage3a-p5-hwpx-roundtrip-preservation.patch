+/// XML 1.0 normalizes literal CRLF and CR line endings to LF before parsing.
+/// Character references are handled separately and deliberately keep CR.
+fn append_xml_line_normalized(target: &mut String, source: &str) {
+    let mut remaining = source;
+    while let Some(index) = remaining.find('\r') {
+        target.push_str(&remaining[..index]);
+        target.push('\n');
+        remaining = &remaining[index + 1..];
+        if let Some(rest) = remaining.strip_prefix('\n') {
+            remaining = rest;
+        }
+    }
+    target.push_str(remaining);
 }
 
