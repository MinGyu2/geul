+    fn detached_snapshots_share_one_monotonic_reservation() {
+        use crate::model::paragraph::Paragraph;
+        let mut doc = identity_doc(&[1, 1, 0], &[(0, 2)]);
+        // A detached snapshot (document clone) shares identity cells and the
+        // reservation counter with the live document.
+        let mut snapshot = doc.clone();
+        snapshot.sections[0].paragraphs.push(Paragraph::default());
+        let snap_ids = prepare(&snapshot).unwrap();
+        assert_eq!(&snap_ids[..2], &[0, 0]);
+        // The shared new paragraph keeps the value reserved through the snapshot.
+        let live = prepare(&doc).unwrap();
+        assert_eq!(live[2], snap_ids[2]);
+        // A paragraph that exists only in the live document never receives the
+        // value already reserved by the snapshot-only paragraph.
+        doc.sections[0].paragraphs.push(Paragraph::default());
+        let later = prepare(&doc).unwrap();
+        assert!(
+            later[3] > snap_ids[3] && snap_ids[3] > snap_ids[2],
+            "{snap_ids:?} {later:?}"
+        );
+    }
