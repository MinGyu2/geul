+#[test]
+fn geul_formula_field_matches_hancom_sample_shape() {
+    let bytes = std::fs::read(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/samples/calc-cell.hwp"
+    ))
+    .expect("한컴 저장 표본");
+    let doc = HwpDocument::from_bytes(&bytes).unwrap();
+    let hancom = geul_formula_fields(&doc);
+    assert!(!hancom.is_empty());
+    for (command, value, properties, extra) in &hancom {
+        assert!(
+            command.starts_with('=')
+                && command.contains("??%")
+                && command.ends_with(&format!(",;;{value}")),
+            "{command}"
+        );
+        assert_eq!((*properties, *extra), (0, 0x08), "{command}");
+    }
+}
