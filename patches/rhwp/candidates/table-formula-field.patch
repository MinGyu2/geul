+// ---- [geul candidate] 표 계산식 필드(한컴 %fmu) ----
+
+fn geul_formula_doc() -> HwpDocument {
+    let mut doc = HwpDocument::create_empty();
+    doc.create_table_native(0, 0, 0, 3, 3).expect("3행 3열 표");
+    for (cell, text) in [(0, "10"), (1, "20"), (3, "1"), (4, "2"), (6, "기존")] {
+        doc.insert_text_in_cell_native(0, 0, 0, cell, 0, 0, text)
+            .expect("셀 입력");
+    }
+    doc
+}
+
+fn geul_formula_fields(doc: &HwpDocument) -> Vec<(String, String, u32, u8)> {
+    doc.core
+        .collect_all_fields()
+        .into_iter()
+        .filter(|f| f.field.field_type == crate::model::control::FieldType::Formula)
+        .map(|f| {
+            (
+                f.field.command.clone(),
+                f.value.clone(),
+                f.field.properties,
+                f.field.extra_properties,
+            )
+        })
+        .collect()
+}
+
+#[test]
+fn geul_formula_g_format_matches_printf() {
+    use crate::document_core::queries::field_query::format_formula_g as g;
+    for (v, s) in [
+        (0.0, "0"),
+        (30.0, "30"),
+        (2.5, "2.5"),
+        (0.1 + 0.2, "0.3"),
+        (1.0 / 3.0, "0.333333"),
+        (-14.0, "-14"),
+        (123456.0, "123456"),
+        (1234567.0, "1.23457e+06"),
+        (999999.5, "1e+06"),
+        (0.0001, "0.0001"),
+        (0.00001234, "1.234e-05"),
+    ] {
+        assert_eq!(g(v).as_deref(), Some(s), "{v}");
+    }
+    assert_eq!(g(f64::NAN), None);
+    assert_eq!(g(f64::INFINITY), None);
+}
+
+fn geul_calc_cell() -> HwpDocument {
+    let bytes = std::fs::read(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/samples/calc-cell.hwp"
+    ))
+    .expect("한컴 저장 표본");
+    HwpDocument::from_bytes(&bytes).unwrap()
+}
