+impl DocumentCore {
+    /// [geul candidate] 표 셀에 **계산식 필드**(한컴 `%fmu`, FieldType::Formula)를 넣거나 같은 셀의 계산식 필드를 바꾼다.
+    ///
+    /// 한컴이 저장한 실물(`samples/calc-cell.hwp`)의 계산식 필드와 같은 모양을 만든다: CTRL_HEADER 속성 0, 추가 속성 0x08,
+    /// 명령 `={식}??%g,;;{결과}`, 필드 범위 안의 글자 = 결과. 결과 서식은 `%g`만 지원한다. 식 계산은 기존
+    /// `evaluate_table_formula`(쓰지 않음)와 같다. 셀은 문단 하나여야 하고, 그 문단은 컨트롤이 없거나(글자는 결과로 바뀜)
+    /// 문단 전체를 덮는 계산식 필드 하나만 있어야 한다(바꾸기·다시 계산). 그 밖은 아무것도 바꾸지 않고 거부한다. 다시 계산은
+    /// 자동이 아니다: 같은 식으로 다시 부르면 지금 값으로 결과를 다시 쓴다.
+    pub fn insert_table_formula_field_native(
+        &mut self,
+        section_idx: usize,
+        parent_para_idx: usize,
+        control_idx: usize,
+        target_row: usize,
+        target_col: usize,
+        formula: &str,
+    ) -> Result<String, HwpError> {
+        let formula = formula.trim();
+        if !formula.starts_with('=')
+            || formula.contains(['\u{0}', '?', ';'])
+            || formula.chars().any(char::is_control)
+        {
+            return Err(HwpError::InvalidField(
+                "계산식은 '='로 시작하고 ? ; 제어 문자를 포함할 수 없음".into(),
+            ));
+        }
+        let evaluated = self.evaluate_table_formula(
+            section_idx,
+            parent_para_idx,
+            control_idx,
+            target_row,
+            target_col,
+            formula,
+            false,
+        )?;
+        let result = evaluated
+            .split("\"result\":")
+            .nth(1)
+            .and_then(|rest| rest.split(',').next())
+            .and_then(|v| v.trim().parse::<f64>().ok())
+            .ok_or_else(|| HwpError::InvalidField("계산 결과를 읽을 수 없음".into()))?;
+        let text = format_formula_g(result)
+            .ok_or_else(|| HwpError::InvalidField("계산 결과가 유한한 수가 아님".into()))?;
+        let command = format!("{formula}??%g,;;{text}");
+        let field_id = self.next_click_here_field_id();
+
+        // 검증과 변경은 문단 사본에서 한다(실패하면 문서는 그대로).
+        let cell_idx = {
+            let section = self
+                .document
+                .sections
+                .get(section_idx)
+                .ok_or_else(|| HwpError::InvalidField("구역 인덱스 초과".into()))?;
+            let para = section
+                .paragraphs
+                .get(parent_para_idx)
+                .ok_or_else(|| HwpError::InvalidField("문단 인덱스 초과".into()))?;
+            let Some(Control::Table(table)) = para.controls.get(control_idx) else {
+                return Err(HwpError::InvalidField("표 컨트롤이 아님".into()));
+            };
+            table
+                .cells
+                .iter()
+                .position(|cell| cell.row as usize == target_row && cell.col as usize == target_col)
+                .ok_or_else(|| HwpError::InvalidField("결과 셀을 찾을 수 없음".into()))?
+        };
+        let cell_para_count = {
+            let Some(Control::Table(table)) = self.document.sections[section_idx].paragraphs
+                [parent_para_idx]
+                .controls
+                .get(control_idx)
+            else {
+                return Err(HwpError::InvalidField("표 컨트롤이 아님".into()));
+            };
+            table.cells[cell_idx].paragraphs.len()
+        };
+        if cell_para_count != 1 {
+            return Err(HwpError::InvalidField(
+                "계산식 셀은 문단 하나여야 함".into(),
+            ));
+        }
+        let mut para = self
+            .get_cell_paragraph_mut(section_idx, parent_para_idx, control_idx, cell_idx, 0)?
+            .clone();
+        let text_len = para.text.chars().count();
+        let existing = match (para.controls.as_slice(), para.field_ranges.as_slice()) {
+            ([], []) => None,
+            ([Control::Field(f)], [range])
+                if f.field_type == FieldType::Formula
+                    && range.control_idx == 0
+                    && range.start_char_idx == 0
+                    && range.end_char_idx == text_len =>
+            {
+                Some(())
+            }
+            _ => {
+                return Err(HwpError::InvalidField(
+                    "계산식 셀에 다른 컨트롤이나 필드가 있음".into(),
+                ));
+            }
+        };
+        let field_id = match existing {
+            Some(()) => {
+                let Some(Control::Field(f)) = para.controls.get_mut(0) else {
+                    return Err(invalid_raw_slots());
+                };
+                let (properties, id) = (f.properties, f.field_id);
+                f.command = command.clone();
+                Self::replace_field_text_model(&mut para, 0, &text)?;
+                if let Some(Control::Field(f)) = para.controls.get_mut(0) {
+                    f.properties = properties;
+                }
+                id
+            }
+            None => {
+                if text_len > 0 {
+                    para.delete_text_at(0, text_len);
+                    rebuild_char_offsets(&mut para);
+                }
+                let gaps = raw_slot_gaps(&para)?;
+                let field = Field {
+                    field_type: FieldType::Formula,
+                    command: command.clone(),
+                    properties: 0,
+                    extra_properties: 0x08,
+                    field_id,
+                    ctrl_id: tags::FIELD_FORMULA,
+                    instance_id: None,
+                    raw_type: None,
+                    ctrl_data_name: None,
+                    memo_index: 0,
+                    memo_paragraphs: Vec::new(),
+                    memo_text_direction: None,
+                    raw_parameters_xml: None,
+                    parameters: Default::default(),
+                    guide_residue: None,
+                    hyperlink_format: None,
+                };
+                insert_field_control_at(&mut para, 0, 0, gaps[0].1, 0, &gaps, field)?;
+                Self::replace_field_text_model(&mut para, 0, &text)?;
+                // 한컴 저장본의 계산식 필드는 속성 0 이다(값을 채운 표시 비트 15를 남기지 않음).
+                if let Some(Control::Field(f)) = para.controls.get_mut(0) {
+                    f.properties = 0;
+                }
+                field_id
+            }
+        };
+        *self.get_cell_paragraph_mut(section_idx, parent_para_idx, control_idx, cell_idx, 0)? =
+            para;
+
+        self.mark_cell_control_dirty(section_idx, parent_para_idx, control_idx);
+        self.reflow_cell_paragraph(section_idx, parent_para_idx, control_idx, cell_idx, 0);
+        if let Some(section) = self.document.sections.get_mut(section_idx) {
+            section.raw_stream = None;
+        }
+        self.mark_section_dirty(section_idx);
+        self.paginate_if_needed();
+        self.invalidate_page_tree_cache();
+        self.event_log.push(DocumentEvent::CellTextChanged {
+            section: section_idx,
+            para: parent_para_idx,
+            ctrl: control_idx,
+            cell: cell_idx,
+        });
+        Ok(format!(
+            "{{\"ok\":true,\"fieldId\":{},\"text\":{},\"command\":{}}}",
+            field_id,
+            json_escape(&text),
+            json_escape(&command)
+        ))
+    }
+}
