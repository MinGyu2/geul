+    #[test]
+    fn picture_evidence_by_path_supports_textbox_and_table_owners() {
+        use sha2::{Digest, Sha256};
+
+        let bytes = {
+            use image::ImageEncoder;
+            let mut png = Vec::new();
+            image::codecs::png::PngEncoder::new(&mut png)
+                .write_image(
+                    &[0x5a, 0xa0, 0x28, 0xff],
+                    1,
+                    1,
+                    image::ExtendedColorType::Rgba8,
+                )
+                .expect("encode a valid one-pixel PNG");
+            png
+        };
+        let expected_sha256 = Sha256::digest(&bytes)
+            .iter()
+            .map(|byte| format!("{byte:02x}"))
+            .collect::<String>();
+
+        let mut textbox_core = DocumentCore::new_empty();
+        textbox_core.create_blank_document_native().unwrap();
+        let (textbox_para, textbox_ctrl) = create_shape(&mut textbox_core, "textbox");
+        let textbox_path = [(textbox_ctrl, 0, 0)];
+        let inserted = textbox_core
+            .insert_picture_native(
+                0, textbox_para, 0, &textbox_path, &bytes, 5000, 5000, 1, 1, "png",
+                "Nested textbox picture", None, None,
+            )
+            .expect("insert a picture into the text box paragraph");
+        let textbox_picture_ctrl = parse_idx(&inserted, "controlIdx");
+        let evidence: serde_json::Value = serde_json::from_str(
+            &textbox_core.get_cell_picture_by_path_native(
+                0, textbox_para, &textbox_path, textbox_picture_ctrl,
+            ).expect("textbox-owned picture evidence"),
+        ).unwrap();
+        assert_eq!(evidence["path"][0]["controlIndex"], textbox_ctrl);
+        assert_eq!(evidence["path"][0]["cellIndex"], 0);
+        assert_eq!(evidence["controlIdx"], textbox_picture_ctrl);
+        assert_eq!(evidence["byteLength"], bytes.len());
+        assert_eq!(evidence["sha256"], expected_sha256);
+
+        let owner_before: serde_json::Value = serde_json::from_str(
+            &textbox_core.get_shape_properties_native(0, textbox_para, textbox_ctrl).unwrap(),
+        ).unwrap();
+        let saved = textbox_core.export_hwpx_native().unwrap();
+        let reopened = DocumentCore::from_bytes(&saved).expect("reopen HWPX textbox picture");
+        let reopened_evidence: serde_json::Value = serde_json::from_str(
+            &reopened.get_cell_picture_by_path_native(
+                0, textbox_para, &textbox_path, textbox_picture_ctrl,
+            ).expect("reopened textbox-owned picture evidence"),
+        ).unwrap();
+        assert_eq!(reopened_evidence, evidence, "picture owner and resource identity survive save/reopen");
+        let owner_after: serde_json::Value = serde_json::from_str(
+            &reopened.get_shape_properties_native(0, textbox_para, textbox_ctrl).unwrap(),
+        ).unwrap();
+        for key in ["instanceId", "width", "height", "horzOffset", "vertOffset"] {
+            assert_eq!(owner_after[key], owner_before[key], "textbox owner field {key} changed");
+        }
+
+        let mut table_core = DocumentCore::new_empty();
+        table_core.create_blank_document_native().unwrap();
+        let table = table_core.create_table_native(0, 0, 0, 1, 1).unwrap();
+        let table_ctrl = parse_idx(&table, "controlIdx");
+        let table_path = [(table_ctrl, 0, 0)];
+        let inserted = table_core.insert_picture_in_cell_by_path_native(
+            0, 0, &table_path, 0, &bytes, 5000, 5000, 1, 1, "png", "Table picture",
+        ).expect("existing table-cell picture insertion remains supported");
+        let table_picture_ctrl = parse_idx(&inserted, "controlIdx");
+        let table_evidence: serde_json::Value = serde_json::from_str(
+            &table_core.get_cell_picture_by_path_native(0, 0, &table_path, table_picture_ctrl).unwrap(),
+        ).unwrap();
+        assert_eq!(table_evidence["sha256"], expected_sha256);
+        let table_saved = table_core.export_hwpx_native().unwrap();
+        let table_reopened = DocumentCore::from_bytes(&table_saved).expect("reopen table picture");
+        let reopened_table_evidence: serde_json::Value = serde_json::from_str(
+            &table_reopened.get_cell_picture_by_path_native(0, 0, &table_path, table_picture_ctrl).unwrap(),
+        ).unwrap();
+        assert_eq!(reopened_table_evidence, table_evidence, "table-cell ownership remains unchanged");
+
+        let bad_textbox_path = [(textbox_ctrl, 1, 0)];
+        assert!(textbox_core.get_cell_picture_by_path_native(
+            0, textbox_para, &bad_textbox_path, textbox_picture_ctrl,
+        ).is_err(), "nonzero textbox cell index is rejected");
+        let (_, rectangle_ctrl) = create_shape(&mut textbox_core, "rectangle");
+        let unsupported_path = [(rectangle_ctrl, 0, 0)];
+        assert!(textbox_core.get_cell_picture_by_path_native(
+            0, textbox_para, &unsupported_path, 0,
+        ).is_err(), "shape without a text box cannot alias a picture owner");
+    }
