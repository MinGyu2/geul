+fn basic_shape_type_change_target(
+    shape: &ShapeObject,
+    format: crate::parser::FileFormat,
+) -> Option<&'static str> {
+    use crate::model::shape::ShapeObject as Shape;
+    use crate::parser::FileFormat;
+
+    if !matches!(format, FileFormat::Hwp | FileFormat::Hwpx) {
+        return None;
+    }
+    let common = shape.common();
+    let drawing = shape.drawing()?;
+    let attr = &drawing.shape_attr;
+    if common.locked
+        || common.instance_id == 0
+        || !(1..=2_000_000).contains(&common.width)
+        || !(1..=2_000_000).contains(&common.height)
+        || attr.group_level != 0
+        || drawing.caption.is_some()
+        || drawing.text_box.is_some()
+        || drawing.fill.image.is_some()
+        || matches!(drawing.fill.fill_type, crate::model::style::FillType::Image)
+        || attr.current_width != 0 && attr.current_width != common.width
+        || attr.current_height != 0 && attr.current_height != common.height
+        || attr.original_width != 0 && attr.original_width != common.width
+        || attr.original_height != 0 && attr.original_height != common.height
+    {
+        return None;
+    }
+    if format == FileFormat::Hwpx && !attr.hwpx_basic_shape_type_change_safe {
+        return None;
+    }
+
+    let (width, height) = (common.width as i32, common.height as i32);
+    match shape {
+        Shape::Rectangle(rect) => {
+            if rect.round_rate != 0
+                || rect.raw_trailing.len() != 0
+                || rect.raw_payload_size.is_some_and(|size| size != 33)
+                || rect.x_coords != [0, width, width, 0]
+                || rect.y_coords != [0, 0, height, height]
+            {
+                None
+            } else {
+                Some("ellipse")
+            }
+        }
+        Shape::Ellipse(ellipse) => {
+            let center_is_canonical = match format {
+                FileFormat::Hwp => ellipse.center.x == width / 2 && ellipse.center.y == height / 2,
+                FileFormat::Hwpx => {
+                    (width / 2..=(width + 1) / 2).contains(&ellipse.center.x)
+                        && (height / 2..=(height + 1) / 2).contains(&ellipse.center.y)
+                }
+                _ => false,
+            };
+            let canonical = center_is_canonical
+                && ellipse.axis1.x == width
+                && ellipse.axis1.y == ellipse.center.y
+                && ellipse.axis2.x == ellipse.center.x
+                && ellipse.axis2.y == height;
+            let format_data_safe = match format {
+                FileFormat::Hwp => {
+                    let end = Point {
+                        x: width,
+                        y: ellipse.center.y,
+                    };
+                    ellipse.attr == 0
+                        && ellipse.raw_trailing.is_empty()
+                        && ellipse.raw_payload_size.is_none_or(|size| size == 60)
+                        && [ellipse.start1, ellipse.end1, ellipse.start2, ellipse.end2]
+                            .into_iter()
+                            .all(|point| point.x == end.x && point.y == end.y)
+                }
+                FileFormat::Hwpx => {
+                    ellipse.hwpx_interval_dirty != Some(true)
+                        && ellipse.hwpx_has_arc_pr != Some(true)
+                        && ellipse
+                            .hwpx_arc_type
+                            .as_deref()
+                            .is_none_or(|kind| kind == "NORMAL")
+                }
+                _ => false,
+            };
+            if canonical && format_data_safe {
+                Some("rectangle")
+            } else {
+                None
+            }
+        }
+        _ => None,
+    }
+}
