+fn hwpx_optional_attr(element: &BytesStart<'_>, key: &[u8]) -> Option<String> {
+    element.attributes().flatten().find_map(|attr| {
+        (attr.key.as_ref().as_bytes() == key)
+            .then(|| {
+                attr.normalized_value(quick_xml::XmlVersion::Implicit1_0)
+                    .ok()
+            })
+            .flatten()
+            .map(|value| value.into_owned())
+    })
+}
+
+fn hwpx_optional_bool_attr(element: &BytesStart<'_>, key: &[u8]) -> Option<bool> {
+    hwpx_optional_attr(element, key).and_then(|value| match value.as_str() {
+        "1" | "true" => Some(true),
+        "0" | "false" => Some(false),
+        _ => None,
+    })
+}
