+/// Read a basic shape's description only when it is plain XML text. The shape writer
+/// serializes this modeled field as escaped text, so nested markup or processing data
+/// must keep the object outside the type-conversion envelope.
+fn read_plain_shape_comment(reader: &mut Reader<&[u8]>) -> Result<(String, bool), HwpxError> {
+    let mut text = String::new();
+    let mut safe = true;
+    let mut buf = Vec::new();
+    loop {
+        match reader.read_event_into(&mut buf) {
+            Ok(Event::Text(value)) => append_xml_line_normalized(&mut text, value.as_ref()),
+            Ok(Event::GeneralRef(value)) => {
+                let predefined = matches!(value.as_ref(), "lt" | "gt" | "amp" | "quot" | "apos");
+                safe &= value.resolve_char_ref().ok().flatten().is_some() || predefined;
+                text.push_str(&decode_xml_general_ref(&value));
+            }
+            Ok(Event::End(ref end)) if local_name(end.name().as_ref()) == b"shapeComment" => {
+                break;
+            }
+            Ok(Event::Start(_)) => {
+                safe = false;
+                skip_element(reader, b"")?;
+            }
+            Ok(Event::Empty(_))
+            | Ok(Event::CData(_))
+            | Ok(Event::Comment(_))
+            | Ok(Event::PI(_))
+            | Ok(Event::DocType(_)) => safe = false,
+            Ok(Event::Eof) => {
+                return Err(HwpxError::XmlError("shapeComment: unexpected EOF".into()));
+            }
+            Err(error) => {
+                return Err(HwpxError::XmlError(format!("shapeComment: {error}")));
+            }
+            _ => safe = false,
+        }
+        buf.clear();
+    }
+    Ok((text, safe))
+}
