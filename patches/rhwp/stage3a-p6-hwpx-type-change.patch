+fn hwpx_basic_shape_root_safe(element: &BytesStart<'_>, shape_type: &[u8]) -> bool {
+    let mut safe = matches!(shape_type, b"rect" | b"ellipse");
+    let mut seen: Vec<Vec<u8>> = Vec::new();
+    for attr in element.attributes() {
+        let Ok(attr) = attr else { return false };
+        let key = attr.key.as_ref().as_bytes();
+        if seen.iter().any(|previous| previous.as_slice() == key) {
+            return false;
+        }
+        seen.push(key.to_vec());
+        let value = match attr.normalized_value(quick_xml::XmlVersion::Implicit1_0) {
+            Ok(value) => value,
+            Err(_) => return false,
+        };
+        let value = value.as_ref();
+        safe &= match attr.key.as_ref().as_bytes() {
+            b"id" | b"instid" => value.parse::<u32>().is_ok(),
+            b"zOrder" => value.parse::<i32>().is_ok(),
+            b"groupLevel" => value.parse::<u16>().is_ok(),
+            b"numberingType" => matches!(value, "NONE" | "PICTURE" | "TABLE" | "EQUATION"),
+            b"textWrap" => matches!(
+                value,
+                "SQUARE"
+                    | "TIGHT"
+                    | "THROUGH"
+                    | "TOP_AND_BOTTOM"
+                    | "BEHIND_TEXT"
+                    | "IN_FRONT_OF_TEXT"
+            ),
+            b"textFlow" => matches!(
+                value,
+                "BOTH_SIDES" | "LEFT_ONLY" | "RIGHT_ONLY" | "LARGEST_ONLY"
+            ),
+            b"lock" => matches!(value, "0" | "1"),
+            // These values are emitted as fixed defaults by the supported writer.
+            b"dropcapstyle" => value == "None",
+            b"href" => value.is_empty(),
+            b"ratio" if shape_type == b"rect" => {
+                value.parse::<u8>().is_ok_and(|ratio| ratio <= 100)
+            }
+            b"intervalDirty" if shape_type == b"ellipse" => {
+                matches!(value, "0" | "1" | "false" | "true")
+            }
+            b"hasArcPr" if shape_type == b"ellipse" => {
+                matches!(value, "0" | "1" | "false" | "true")
+            }
+            b"arcType" if shape_type == b"ellipse" => matches!(value, "NORMAL" | "PIE" | "CHORD"),
+            _ => false,
+        };
+    }
+    safe
+}
