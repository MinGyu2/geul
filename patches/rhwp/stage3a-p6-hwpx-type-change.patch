+fn converted_basic_shape(shape: &ShapeObject, target: &str) -> Option<ShapeObject> {
+    use crate::model::shape::ShapeObject as Shape;
+    let (width, height) = (shape.common().width as i32, shape.common().height as i32);
+    let converted = match (shape, target) {
+        (Shape::Rectangle(rect), "ellipse") => {
+            let center = Point {
+                x: width / 2,
+                y: height / 2,
+            };
+            let endpoint = Point {
+                x: width,
+                y: center.y,
+            };
+            Shape::Ellipse(EllipseShape {
+                common: rect.common.clone(),
+                drawing: rect.drawing.clone(),
+                attr: 0,
+                center,
+                axis1: endpoint,
+                axis2: Point {
+                    x: center.x,
+                    y: height,
+                },
+                start1: endpoint,
+                end1: endpoint,
+                start2: endpoint,
+                end2: endpoint,
+                ..Default::default()
+            })
+        }
+        (Shape::Ellipse(ellipse), "rectangle") => Shape::Rectangle(RectangleShape {
+            common: ellipse.common.clone(),
+            drawing: ellipse.drawing.clone(),
+            round_rate: 0,
+            x_coords: [0, width, width, 0],
+            y_coords: [0, 0, height, height],
+            ..Default::default()
+        }),
+        _ => return None,
+    };
+    let mut converted = converted;
+    if let Some(drawing) = converted.drawing_mut() {
+        // The shape-specific HWP5 control ID comes from the enum variant.
+        drawing.shape_attr.ctrl_id = 0;
+    }
+    Some(converted)
 }
