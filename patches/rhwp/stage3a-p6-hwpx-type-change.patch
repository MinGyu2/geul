+fn hwpx_basic_shape_child_safe(local: &[u8], element: &BytesStart<'_>, shape_type: &[u8]) -> bool {
+    let allowed: &[&[u8]] = match local {
+        b"renderingInfo" | b"fillBrush" | b"shapeComment" => &[],
+        b"pt0" | b"pt1" | b"pt2" | b"pt3" if shape_type == b"rect" => &[b"x", b"y"],
+        b"center" | b"ax1" | b"ax2" | b"start1" | b"end1" | b"start2" | b"end2"
+            if shape_type == b"ellipse" =>
+        {
+            &[b"x", b"y"]
+        }
+        b"offset" => &[b"x", b"y"],
+        b"orgSz" | b"curSz" => &[b"width", b"height"],
+        b"flip" => &[b"horizontal", b"vertical"],
+        b"rotationInfo" => &[b"angle", b"centerX", b"centerY", b"rotateimage"],
+        b"lineShape" => &[
+            b"color",
+            b"width",
+            b"style",
+            b"endCap",
+            b"headStyle",
+            b"tailStyle",
+            b"headfill",
+            b"tailfill",
+            b"headSz",
+            b"tailSz",
+            b"outlineStyle",
+            b"alpha",
+        ],
+        b"shadow" => &[b"type", b"color", b"offsetX", b"offsetY", b"alpha"],
+        b"sz" => &[
+            b"width",
+            b"height",
+            b"widthRelTo",
+            b"heightRelTo",
+            b"protect",
+        ],
+        b"pos" => &[
+            b"treatAsChar",
+            b"affectLSpacing",
+            b"flowWithText",
+            b"allowOverlap",
+            b"holdAnchorAndSO",
+            b"vertRelTo",
+            b"horzRelTo",
+            b"vertAlign",
+            b"horzAlign",
+            b"vertOffset",
+            b"horzOffset",
+        ],
+        b"outMargin" => &[b"left", b"right", b"top", b"bottom"],
+        _ => return false,
+    };
+    let mut seen: Vec<Vec<u8>> = Vec::new();
+    for attr in element.attributes() {
+        let Ok(attr) = attr else { return false };
+        let key = attr.key.as_ref().as_bytes();
+        if seen.iter().any(|previous| previous.as_slice() == key)
+            || !allowed.iter().any(|name| *name == key)
+        {
+            return false;
+        }
+        seen.push(key.to_vec());
+        let value = match attr.normalized_value(quick_xml::XmlVersion::Implicit1_0) {
+            Ok(value) => value,
+            Err(_) => return false,
+        };
+        if local == b"lineShape"
+            && attr.key.as_ref().as_bytes() == b"alpha"
+            && value.as_ref() != "0"
+        {
+            return false;
+        }
+    }
+    true
+}
