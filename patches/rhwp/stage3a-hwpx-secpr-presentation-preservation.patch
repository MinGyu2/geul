+/// Add preserved, currently unmodeled presentation nodes back to the generated secPr.
+fn append_hwpx_presentation(xml: &str, sd: &SectionDef) -> Result<String, SerializeError> {
+    if sd.hwpx_presentation_xml.is_empty() {
+        return Ok(xml.to_string());
+    }
+    let close = xml.rfind("</hp:secPr>").ok_or_else(|| {
+        SerializeError::UnsupportedInput("HWPX secPr presentation: missing secPr end".into())
+    })?;
+    let extra: String = sd.hwpx_presentation_xml.iter().cloned().collect();
+    let mut output = String::with_capacity(xml.len() + extra.len());
+    output.push_str(&xml[..close]);
+    output.push_str(&extra);
+    output.push_str(&xml[close..]);
+    Ok(output)
 }
 
