+/// Retain one unmodeled HWPX secPr subtree as validated XML events.
+///
+/// The source namespace declarations for the HWPML `hp` and `hc` prefixes are present in the
+/// section template used by the writer. Capturing the complete subtree also preserves nested
+/// brush/gradation data instead of retaining only the element's visible scalar attributes.
+fn capture_hwpx_element(
+    reader: &mut Reader<&[u8]>,
+    start: BytesStart<'_>,
+) -> Result<String, HwpxError> {
+    let mut writer = Writer::new(Vec::new());
+    writer
+        .write_event(Event::Start(start.into_owned()))
+        .map_err(|error| HwpxError::XmlError(format!("secPr child: {error}")))?;
+    let mut depth = 1usize;
+    let mut buffer = Vec::new();
+    while depth > 0 {
+        let event = reader
+            .read_event_into(&mut buffer)
+            .map_err(|error| HwpxError::XmlError(format!("secPr child: {error}")))?;
+        match &event {
+            Event::Start(_) => depth += 1,
+            Event::End(_) => depth -= 1,
+            Event::Eof => return Err(HwpxError::XmlError("secPr child is unterminated".into())),
+            _ => {}
+        }
+        writer
+            .write_event(event.into_owned())
+            .map_err(|error| HwpxError::XmlError(format!("secPr child: {error}")))?;
+        buffer.clear();
+    }
+    String::from_utf8(writer.into_inner())
+        .map_err(|error| HwpxError::XmlError(format!("secPr child encoding: {error}")))
+}
+
+fn write_hwpx_event(event: Event<'_>) -> Result<String, HwpxError> {
+    let mut writer = Writer::new(Vec::new());
+    writer
+        .write_event(event.into_owned())
+        .map_err(|error| HwpxError::XmlError(format!("secPr child: {error}")))?;
+    String::from_utf8(writer.into_inner())
+        .map_err(|error| HwpxError::XmlError(format!("secPr child encoding: {error}")))
+}
