+/// [geul] Bounds of a table restructured through the explicit-path editor (same as the application).
+const GEUL_SPLIT_MAX_ROWS: u32 = 512;
+const GEUL_SPLIT_MAX_COLS: u32 = 64;
+const GEUL_SPLIT_MAX_CELLS: usize = 4096;
+/// [geul] Narrowest sub-cell an ordinary split may create (6 pt in HWPUNIT).
+const GEUL_SPLIT_MIN_WIDTH: u32 = 600;
+
+/// [geul] Split one ordinary (unmerged 1x1) cell into `rows` x `cols` cells through
+/// `Table::split_cell_into`: the grid gains `rows-1` rows and `cols-1` columns, every
+/// other cell crossing the target row/column widens its span, the original cell keeps
+/// its paragraphs as the top-left sub-cell and new sub-cells are empty template cells.
+/// Every precondition is checked before the table is touched, so a refusal never
+/// leaves a partial edit. Merged cells keep the separate `splitCell` (unmerge) contract.
+fn geul_split_ordinary_cell(
+    table: &mut crate::model::table::Table,
+    row: u16,
+    col: u16,
+    rows: u16,
+    cols: u16,
+) -> Result<(), String> {
+    let cell = table
+        .cells
+        .iter()
+        .find(|c| c.row == row && c.col == col)
+        .ok_or_else(|| "split target cell not found".to_string())?;
+    if cell.row_span != 1 || cell.col_span != 1 {
+        return Err("only an unmerged cell can be split into a grid".into());
+    }
+    if rows == 0 || cols == 0 || u32::from(rows) * u32::from(cols) < 2 {
+        return Err("split dimensions must produce at least two cells".into());
+    }
+    if u32::from(table.row_count) + u32::from(rows) - 1 > GEUL_SPLIT_MAX_ROWS
+        || u32::from(table.col_count) + u32::from(cols) - 1 > GEUL_SPLIT_MAX_COLS
+        || table.cells.len() + usize::from(rows) * usize::from(cols) - 1 > GEUL_SPLIT_MAX_CELLS
+    {
+        return Err("split exceeds table limits".into());
+    }
+    if cell.width / u32::from(cols) < GEUL_SPLIT_MIN_WIDTH {
+        return Err("split cells would be narrower than the minimum width".into());
+    }
+    table.split_cell_into(row, col, rows, cols, false, false)
+}
