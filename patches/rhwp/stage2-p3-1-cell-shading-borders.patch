+    /// [geul] Read-only cell shading and border summary for a rectangular selection in a path-owned table.
+    pub fn get_table_cell_formatting_by_path_native(
+        &self,
+        section: usize,
+        paragraph: usize,
+        path: &[(usize, usize, usize)],
+        start_row: u16,
+        start_col: u16,
+        end_row: u16,
+        end_col: u16,
+    ) -> Result<String, HwpError> {
+        use crate::model::style::{BorderLine, FillType};
+        let table = self.resolve_table_by_path(section, paragraph, path)?;
+        if table.row_count == 0
+            || table.col_count == 0
+            || start_row > end_row
+            || end_row >= table.row_count
+            || start_col > end_col
+            || end_col >= table.col_count
+        {
+            return Err(HwpError::RenderError("invalid table cell range".into()));
+        }
+        let mut selected = Vec::new();
+        for (ci, cell) in table.cells.iter().enumerate() {
+            let cr0 = cell.row;
+            let cr1 = cell.row.saturating_add(cell.row_span).saturating_sub(1);
+            let cc0 = cell.col;
+            let cc1 = cell.col.saturating_add(cell.col_span).saturating_sub(1);
+            if cr0 <= end_row && cr1 >= start_row && cc0 <= end_col && cc1 >= start_col {
+                if cr0 < start_row || cr1 > end_row || cc0 < start_col || cc1 > end_col {
+                    return Err(HwpError::RenderError("selection overlaps merged cells partially".into()));
+                }
+                selected.push(ci);
+            }
+        }
+        if selected.is_empty() {
+            return Err(HwpError::RenderError("empty table cell selection".into()));
+        }
+        let has_zones = !table.zones.is_empty();
+        let bf_of = |id: u16| -> Option<&crate::model::style::BorderFill> {
+            id.checked_sub(1).and_then(|idx| self.document.doc_info.border_fills.get(idx as usize))
+        };
+        let mut shading_uniform = true;
+        let mut shading_color: Option<Option<String>> = None;
+        let mut uniform_border: Option<Option<BorderLine>> = None;
+        let mut border_uniform = true;
+        for &ci in &selected {
+            let cell = &table.cells[ci];
+            let Some(bf) = bf_of(cell.border_fill_id) else {
+                shading_uniform = false;
+                border_uniform = false;
+                continue;
+            };
+            let cell_shading: Option<String> = match bf.fill.fill_type {
+                FillType::None => None,
+                FillType::Solid => {
+                    if let Some(s) = &bf.fill.solid {
+                        if (s.pattern_type != 0 && s.pattern_type != -1) || bf.fill.alpha != 0 {
+                            shading_uniform = false;
+                            None
+                        } else if s.background_color == 0xFFFFFFFF {
+                            None
+                        } else {
+                            let css = color_ref_to_css(s.background_color);
+                            Some(css.trim_start_matches('#').to_ascii_uppercase())
+                        }
+                    } else {
+                        shading_uniform = false;
+                        None
+                    }
+                }
+                _ => {
+                    shading_uniform = false;
+                    None
+                }
+            };
+            if shading_uniform {
+                match &shading_color {
+                    None => shading_color = Some(cell_shading),
+                    Some(prev) if *prev != cell_shading => shading_uniform = false,
+                    _ => {}
+                }
+            }
+            if border_uniform {
+                let first = bf.borders[0];
+                if bf.borders.iter().all(|b| *b == first) {
+                    match uniform_border {
+                        None => uniform_border = Some(Some(first)),
+                        Some(Some(prev)) if prev == first => {}
+                        _ => border_uniform = false,
+                    }
+                } else {
+                    border_uniform = false;
+                }
+            }
+        }
+        let border_json = match (border_uniform, uniform_border) {
+            (true, Some(Some(b))) => serde_json::json!({
+                "uniform": true,
+                "lineType": border_line_type_to_u8_val(b.line_type),
+                "width": b.width,
+                "color": color_ref_to_css(b.color).trim_start_matches('#').to_ascii_uppercase(),
+            }),
+            _ => serde_json::json!({ "uniform": false }),
+        };
+        Ok(serde_json::json!({
+            "hasZones": has_zones,
+            "cellCount": selected.len(),
+            "shading": {
+                "uniform": shading_uniform,
+                "color": if shading_uniform { shading_color.flatten() } else { None },
+            },
+            "border": border_json,
+        })
+        .to_string())
+    }
