+#[cfg(test)]
+mod geul_cell_formatting_tests {
+    //! [geul] Stage 2 Phase 3 P3-1: cell shading and borders across HWP and HWPX.
+    use crate::document_core::DocumentCore;
+    use crate::model::control::Control;
+    use crate::model::style::{BorderLineType, FillType};
+    use crate::model::table::Table;
+
+    fn core_with_table(rows: u16, cols: u16) -> (DocumentCore, usize, usize) {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        let value: serde_json::Value =
+            serde_json::from_str(&core.create_table_native(0, 0, 0, rows, cols).unwrap()).unwrap();
+        let (para, ctrl) = (
+            value["paraIdx"].as_u64().unwrap() as usize,
+            value["controlIdx"].as_u64().unwrap() as usize,
+        );
+        (core, para, ctrl)
+    }
+
+    fn table(core: &DocumentCore, para: usize, ctrl: usize) -> &Table {
+        match &core.document.sections[0].paragraphs[para].controls[ctrl] {
+            Control::Table(t) => t,
+            _ => panic!("table"),
+        }
+    }
+
+    #[test]
+    fn shading_borders_neighbors_compaction_and_roundtrip() {
+        let (mut core, para, ctrl) = core_with_table(3, 3);
+        let path = [(ctrl, 0, 0)];
+        let baseline = core.document.doc_info.border_fills.len();
+
+        // Single cell shading + removal
+        core.format_table_cells_by_path_native(
+            0,
+            para,
+            &path,
+            r#"{"rect":{"startRow":0,"startCol":0,"endRow":0,"endCol":0},"shading":{"color":"FFE0B2"}}"#,
+        )
+        .unwrap();
+        let info: serde_json::Value = serde_json::from_str(
+            &core
+                .get_table_cell_formatting_by_path_native(0, para, &path, 0, 0, 0, 0)
+                .unwrap(),
+        )
+        .unwrap();
+        assert_eq!(info["shading"]["uniform"], true);
+        assert_eq!(info["shading"]["color"], "FFE0B2");
+
+        // Change shading then remove -> compaction prunes superseded intermediate BorderFill
+        core.format_table_cells_by_path_native(
+            0,
+            para,
+            &path,
+            r#"{"rect":{"startRow":0,"startCol":0,"endRow":0,"endCol":0},"shading":{"color":"C8E6C9"}}"#,
+        )
+        .unwrap();
+        core.compact_appended_border_fills_native(baseline).unwrap();
+        assert_eq!(core.document.doc_info.border_fills.len(), baseline + 1);
+
+        // Outside borders on 2x2 rect (0..=1, 0..=1) syncs exterior neighbors (0,2), (1,2), (2,0), (2,1)
+        core.format_table_cells_by_path_native(
+            0,
+            para,
+            &path,
+            r#"{"rect":{"startRow":0,"startCol":0,"endRow":1,"endCol":1},"borders":{"kind":"outside","lineType":8,"width":6,"color":"C00000"}}"#,
+        )
+        .unwrap();
+        core.compact_appended_border_fills_native(baseline).unwrap();
+
+        let t = table(&core, para, ctrl);
+        let bf_of = |r: u16, c: u16| {
+            let cell = t.cells.iter().find(|x| x.row == r && x.col == c).unwrap();
+            &core.document.doc_info.border_fills[(cell.border_fill_id - 1) as usize]
+        };
+        // Cell (0,0) top/left changed, right/bottom unchanged
+        assert_eq!(bf_of(0, 0).borders[2].line_type, BorderLineType::Double);
+        assert_eq!(bf_of(0, 0).borders[0].line_type, BorderLineType::Double);
+        assert_eq!(bf_of(0, 0).borders[1].line_type, BorderLineType::Solid);
+        assert_eq!(bf_of(0, 0).borders[3].line_type, BorderLineType::Solid);
+        assert_eq!(bf_of(0, 0).fill.fill_type, FillType::Solid);
+        // Neighbor (0,2) left edge synced to Double
+        assert_eq!(bf_of(0, 2).borders[0].line_type, BorderLineType::Double);
+        // Unrelated corner (2,2) untouched
+        assert_eq!(bf_of(2, 2).borders[0].line_type, BorderLineType::Solid);
+        assert_eq!(bf_of(2, 2).fill.fill_type, FillType::None);
+
+        // Export HWP and HWPX and reopen independently
+        let hwp_bytes = core.export_hwp_native().unwrap();
+        let reopened_hwp = DocumentCore::from_hwp_bytes(&hwp_bytes).unwrap();
+        let rt_hwp = table(&reopened_hwp, para, ctrl);
+        let bf_hwp = &reopened_hwp.document.doc_info.border_fills
+            [(rt_hwp.cells[0].border_fill_id - 1) as usize];
+        assert_eq!(bf_hwp.borders[2].line_type, BorderLineType::Double);
+        assert_eq!(bf_hwp.fill.fill_type, FillType::Solid);
+
+        let hwpx_bytes = core.export_hwpx_native().unwrap();
+        let reopened_hwpx = DocumentCore::from_hwpx_bytes(&hwpx_bytes).unwrap();
+        let rt_hwpx = table(&reopened_hwpx, para, ctrl);
+        let bf_hwpx = &reopened_hwpx.document.doc_info.border_fills
+            [(rt_hwpx.cells[0].border_fill_id - 1) as usize];
+        assert_eq!(bf_hwpx.borders[2].line_type, BorderLineType::Double);
+        assert_eq!(bf_hwpx.fill.fill_type, FillType::Solid);
+    }
+
+    #[test]
+    fn nested_merged_and_negative_validation() {
+        let (mut core, para, ctrl) = core_with_table(2, 2);
+        let path = [(ctrl, 0, 0)];
+        // Inside border on single cell must fail
+        assert!(core
+            .format_table_cells_by_path_native(
+                0,
+                para,
+                &path,
+                r#"{"rect":{"startRow":0,"startCol":0,"endRow":0,"endCol":0},"borders":{"kind":"inside","lineType":1,"width":1,"color":"000000"}}"#,
+            )
+            .is_err());
+        // Invalid color / lineType / width must fail
+        assert!(core
+            .format_table_cells_by_path_native(
+                0,
+                para,
+                &path,
+                r#"{"rect":{"startRow":0,"startCol":0,"endRow":0,"endCol":0},"shading":{"color":"ZZZZZZ"}}"#,
+            )
+            .is_err());
+        assert!(core
+            .format_table_cells_by_path_native(
+                0,
+                para,
+                &path,
+                r#"{"rect":{"startRow":0,"startCol":0,"endRow":0,"endCol":0},"borders":{"kind":"all","lineType":99,"width":1,"color":"000000"}}"#,
+            )
+            .is_err());
+        // Merge (0,0)-(0,1) -> partial selection (0,0)-(1,0) must fail
+        core.edit_table_by_cell_path_native(0, para, &path, "mergeRight", &[0, 0, 0, 1])
+            .unwrap();
+        assert!(core
+            .format_table_cells_by_path_native(
+                0,
+                para,
+                &path,
+                r#"{"rect":{"startRow":0,"startCol":0,"endRow":1,"endCol":0},"shading":{"color":"AABBCC"}}"#,
+            )
+            .is_err());
+        // Nested table formatting
+        let nested_res: serde_json::Value = serde_json::from_str(
+            &core
+                .create_table_with_path_native(0, para, 0, 2, 2, true, None, None, &[(ctrl, 1, 0)])
+                .unwrap(),
+        )
+        .unwrap();
+        let nested_ctrl = nested_res["controlIdx"].as_u64().unwrap() as usize;
+        let nested_path = [(ctrl, 1, 0), (nested_ctrl, 0, 0)];
+        core.format_table_cells_by_path_native(
+            0,
+            para,
+            &nested_path,
+            r#"{"rect":{"startRow":0,"startCol":0,"endRow":0,"endCol":0},"shading":{"color":"112233"}}"#,
+        )
+        .unwrap();
+        let nested_info: serde_json::Value = serde_json::from_str(
+            &core
+                .get_table_cell_formatting_by_path_native(0, para, &nested_path, 0, 0, 0, 0)
+                .unwrap(),
+        )
+        .unwrap();
+        assert_eq!(nested_info["shading"]["color"], "112233");
+    }
