+//! [geul] 세션 중 덧붙인 글자 모양 중 어디서도 쓰지 않는 것을 정리한다(T012 장평·자간 연속 변경).
+//!
+//! `find_or_create_char_shape` 는 같은 모양을 다시 쓰지만 글자 모양 표는 덧붙임 전용이다. 같은 범위에
+//! 장평 뒤 자간을 바꾸면 중간 모양(장평만 바뀐 것)이 아무도 가리키지 않는 정의로 남는다.
+//!
+//! ## 계약
+//!
+//! - `baseline` 은 불러온 직후(또는 새 문서 직후)의 글자 모양 수다. **그보다 앞의 정의는 지우지도 번호를
+//!   바꾸지도 않는다** — 원본의 스타일·번호·글머리표·원본 바이트 보존 레코드(`raw_data`)·원본 XML 조각이
+//!   가리키는 번호는 그대로 유효하다.
+//! - 덧붙인 정의(`baseline..len`) 중 참조가 없는 것만 지우고, 남는 덧붙인 정의는 순서를 지켜 앞으로 당긴다.
+//! - 모으기와 옮기기는 **같은 방문**(`visit`)을 쓴다(`bin_data_prune` 과 같은 방식).
+//! - 덧붙인 정의를 DocInfo 쪽 참조(스타일·번호 머리·글머리표)가 가리키거나, 어떤 참조든 표 밖 번호를
+//!   가리키면 아무것도 바꾸지 않는다(fail closed). 단 `0xFFFFFFFF` 는 한컴 저장본이 번호 머리·글머리표·목록
+//!   표지에 쓰는 "참조 없음" 값이라 참조로 세지 않는다(표본 실측).
+//! - 스냅숏 저장소의 문서는 각자 자기 표를 가지므로 건드리지 않는다. RHWP 자체의 ID 기반 실행 취소
+//!   (`set_char_shape_id_native`)와 섞어 쓰면 안 되므로 기본 편집 경로에서 자동으로 부르지 않는다
+//!   (호출자 opt-in, geul 은 문서 스냅숏 기록을 쓴다).
+
+use std::collections::BTreeSet;
+
+use crate::document_core::DocumentCore;
+use crate::error::HwpError;
+use crate::model::control::Control;
+use crate::model::paragraph::{NumberingMarker, Paragraph};
+use crate::model::shape::{DrawingObjAttr, ShapeObject};
+
+/// 참조 자리의 종류.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Site {
+    /// 문단·셀·글상자 등의 글자 모양 참조: 번호를 옮길 수 있다.
+    Remappable,
+    /// DocInfo 의 스타일·번호 머리·글머리표: 덧붙인 번호를 가리키면 정리하지 않는다.
+    Fixed,
+}
+
+/// 정리 결과.
+#[derive(Debug, Clone, PartialEq, Eq, Default)]
+pub struct CharShapeCompactReport {
+    pub before: usize,
+    pub after: usize,
+    /// 정리하지 않은 이유(없으면 정리했거나 정리할 것이 없음).
+    pub skipped: Option<&'static str>,
+}
+
+fn visit_paragraphs(paragraphs: &mut [Paragraph], f: &mut dyn FnMut(&mut u32, Site)) {
+    for p in paragraphs {
+        visit_paragraph(p, f);
+    }
+}
+
+fn visit_paragraph(p: &mut Paragraph, f: &mut dyn FnMut(&mut u32, Site)) {
+    // CharShapeRef 는 HWPX 원문 위상(`hwpx_text_topology`)과 함께 옮겨야 한다. 값을 바꾸는 방문에서만
+    // 위상을 다시 묶으므로 여기서는 사본으로 먼저 본다.
+    let mut ids: Vec<u32> = p.char_shapes.iter().map(|r| r.char_shape_id).collect();
+    for id in &mut ids {
+        f(id, Site::Remappable);
+    }
+    if ids
+        .iter()
+        .zip(&p.char_shapes)
+        .any(|(a, r)| *a != r.char_shape_id)
+    {
+        let topology = crate::model::hwpx_topology::HwpxTextTopology::before_edit(p);
+        let old = topology.as_ref().map(|_| p.char_shapes.clone());
+        for (r, id) in p.char_shapes.iter_mut().zip(ids) {
+            r.char_shape_id = id;
+        }
+        p.hwpx_text_topology =
+            topology.map(|t| t.format_edit(p, old.as_deref().unwrap_or_default()));
+    }
+    if let NumberingMarker::Text(_, head) = &mut p.numbering_marker {
+        if head.char_shape_id != u32::MAX {
+            f(&mut head.char_shape_id, Site::Remappable);
+        }
+    }
+    visit_controls(&mut p.controls, f);
+}
+
+fn visit_drawing(drawing: &mut DrawingObjAttr, f: &mut dyn FnMut(&mut u32, Site)) {
+    if let Some(text_box) = drawing.text_box.as_mut() {
+        visit_paragraphs(&mut text_box.paragraphs, f);
+    }
+    if let Some(caption) = drawing.caption.as_mut() {
+        visit_paragraphs(&mut caption.paragraphs, f);
+    }
+}
+
+fn visit_shape(shape: &mut ShapeObject, f: &mut dyn FnMut(&mut u32, Site)) {
+    match shape {
+        ShapeObject::Picture(pic) => {
+            if let Some(caption) = pic.caption.as_mut() {
+                visit_paragraphs(&mut caption.paragraphs, f);
+            }
+        }
+        ShapeObject::Group(group) => {
+            for child in &mut group.children {
+                visit_shape(child, f);
+            }
+            if let Some(caption) = group.caption.as_mut() {
+                visit_paragraphs(&mut caption.paragraphs, f);
+            }
+        }
+        ShapeObject::Chart(chart) => {
+            visit_drawing(&mut chart.drawing, f);
+            if let Some(caption) = chart.caption.as_mut() {
+                visit_paragraphs(&mut caption.paragraphs, f);
+            }
+        }
+        ShapeObject::Ole(ole) => {
+            visit_drawing(&mut ole.drawing, f);
+            if let Some(caption) = ole.caption.as_mut() {
+                visit_paragraphs(&mut caption.paragraphs, f);
+            }
+        }
+        _ => {
+            if let Some(drawing) = shape.drawing_mut() {
+                visit_drawing(drawing, f);
+            }
+        }
+    }
+}
+
+fn visit_controls(controls: &mut [Control], f: &mut dyn FnMut(&mut u32, Site)) {
+    for control in controls {
+        match control {
+            Control::Picture(pic) => {
+                if let Some(caption) = pic.caption.as_mut() {
+                    visit_paragraphs(&mut caption.paragraphs, f);
+                }
+            }
+            Control::Shape(shape) => visit_shape(shape, f),
+            Control::Table(table) => {
+                for cell in &mut table.cells {
+                    visit_paragraphs(&mut cell.paragraphs, f);
+                }
+                if let Some(caption) = table.caption.as_mut() {
+                    visit_paragraphs(&mut caption.paragraphs, f);
+                }
+            }
+            Control::Header(h) => visit_paragraphs(&mut h.paragraphs, f),
+            Control::Footer(h) => visit_paragraphs(&mut h.paragraphs, f),
+            Control::Footnote(n) => visit_paragraphs(&mut n.paragraphs, f),
+            Control::Endnote(n) => visit_paragraphs(&mut n.paragraphs, f),
+            Control::HiddenComment(c) => visit_paragraphs(&mut c.paragraphs, f),
+            Control::Field(field) => {
+                if let Some(residue) = field.guide_residue.as_mut() {
+                    f(&mut residue.char_shape_id, Site::Remappable);
+                }
+                visit_paragraphs(&mut field.memo_paragraphs, f);
+            }
+            Control::CharOverlap(overlap) => {
+                for id in &mut overlap.char_shape_ids {
+                    // 한컴 저장본은 글자 겹치기의 "모양 없음"을 0xFFFFFFFF 로 쓴다(aift.hwp,
+                    // issue6031 HWPX 실측). 번호 머리 표지처럼 참조가 아니므로 옮기지도 세지도 않는다.
+                    if *id != u32::MAX {
+                        f(id, Site::Remappable);
+                    }
+                }
+            }
+            Control::SectionDef(section_def) => {
+                for master_page in &mut section_def.master_pages {
+                    visit_paragraphs(&mut master_page.paragraphs, f);
+                }
+            }
+            _ => {}
+        }
+    }
+}
+
+impl DocumentCore {
+    /// 모든 글자 모양 참조를 방문한다(문서 본문 전체, DocInfo 참조, 내부 클립보드).
+    fn visit_char_shape_refs(&mut self, f: &mut dyn FnMut(&mut u32, Site)) {
+        for section in &mut self.document.sections {
+            visit_paragraphs(&mut section.paragraphs, f);
+            for master_page in &mut section.section_def.master_pages {
+                visit_paragraphs(&mut master_page.paragraphs, f);
+            }
+        }
+        let info = &mut self.document.doc_info;
+        for style in &mut info.styles {
+            let mut id = u32::from(style.char_shape_id);
+            f(&mut id, Site::Fixed);
+        }
+        for numbering in &mut info.numberings {
+            for head in &mut numbering.heads {
+                f(&mut head.char_shape_id, Site::Fixed);
+            }
+        }
+        for bullet in &mut info.bullets {
+            f(&mut bullet.char_shape_id, Site::Fixed);
+        }
+        if let Some(clipboard) = self.clipboard.as_mut() {
+            visit_paragraphs(&mut clipboard.paragraphs, f);
+        }
+        if let Some(transpose) = self.table_transpose_clipboard.as_mut() {
+            for row in &mut transpose.data.cells {
+                for cell in row {
+                    visit_paragraphs(cell, f);
+                }
+            }
+        }
+    }
+
+    /// 덧붙인 글자 모양(`baseline..`) 중 참조 없는 것을 지우고 참조를 옮긴다. 결과 JSON:
+    /// `{"ok":true,"before":n,"after":m,"skipped":null|"이유"}`.
+    pub fn compact_appended_char_shapes_native(
+        &mut self,
+        baseline: usize,
+    ) -> Result<String, HwpError> {
+        let report = self.compact_appended_char_shapes(baseline)?;
+        Ok(format!(
+            "{{\"ok\":true,\"before\":{},\"after\":{},\"skipped\":{}}}",
+            report.before,
+            report.after,
+            report
+                .skipped
+                .map(|s| format!("\"{s}\""))
+                .unwrap_or_else(|| "null".into())
+        ))
+    }
+
+    pub(crate) fn compact_appended_char_shapes(
+        &mut self,
+        baseline: usize,
+    ) -> Result<CharShapeCompactReport, HwpError> {
+        let before = self.document.doc_info.char_shapes.len();
+        if baseline > before {
+            return Err(HwpError::RenderError(format!(
+                "글자 모양 기준 수 {baseline}이 지금 수 {before}보다 큼"
+            )));
+        }
+        let skip = |reason| CharShapeCompactReport {
+            before,
+            after: before,
+            skipped: Some(reason),
+        };
+        if baseline == before {
+            return Ok(CharShapeCompactReport {
+                before,
+                after: before,
+                skipped: None,
+            });
+        }
+        // 1. 모으기.
+        let mut referenced = BTreeSet::new();
+        let mut fixed_appended = false;
+        let mut dangling = false;
+        self.visit_char_shape_refs(&mut |id, site| {
+            // 한컴 저장본의 번호 머리·글머리표·목록 표지는 0xFFFFFFFF 를 "참조 없음"으로 쓴다(실측).
+            if *id == u32::MAX && site == Site::Fixed {
+                return;
+            }
+            let index = *id as usize;
+            if index >= before {
+                dangling = true;
+            } else if index >= baseline {
+                referenced.insert(index);
+                fixed_appended |= site == Site::Fixed;
+            }
+        });
+        if dangling {
+            return Ok(skip("dangling"));
+        }
+        if fixed_appended {
+            return Ok(skip("docinfo-reference"));
+        }
+        if referenced.len() == before - baseline {
+            return Ok(CharShapeCompactReport {
+                before,
+                after: before,
+                skipped: None,
+            });
+        }
+        // 2. 옛 번호 → 새 번호(원본 정의는 그대로, 남는 덧붙인 정의는 순서를 지켜 앞으로).
+        let mut map: Vec<u32> = (0..baseline as u32).collect();
+        map.resize(before, u32::MAX);
+        for (next, old) in referenced.iter().enumerate() {
+            map[*old] = (baseline + next) as u32;
+        }
+        // 3. 옮기기(같은 방문). Fixed 자리는 덧붙인 번호를 가리키지 않음을 위에서 확인했다.
+        let mut changed_sections = vec![false; self.document.sections.len()];
+        {
+            let map = &map;
+            for (index, section) in self.document.sections.iter_mut().enumerate() {
+                let mut changed = false;
+                let mut remap = |id: &mut u32, site: Site| {
+                    if *id == u32::MAX {
+                        return;
+                    }
+                    let next = map[*id as usize];
+                    if site == Site::Remappable && next != *id {
+                        *id = next;
+                        changed = true;
+                    }
+                };
+                visit_paragraphs(&mut section.paragraphs, &mut remap);
+                for master_page in &mut section.section_def.master_pages {
+                    visit_paragraphs(&mut master_page.paragraphs, &mut remap);
+                }
+                changed_sections[index] = changed;
+            }
+            let mut remap_rest = |id: &mut u32, site: Site| {
+                if site == Site::Remappable && *id != u32::MAX {
+                    *id = map[*id as usize];
+                }
+            };
+            if let Some(clipboard) = self.clipboard.as_mut() {
+                visit_paragraphs(&mut clipboard.paragraphs, &mut remap_rest);
+            }
+            if let Some(transpose) = self.table_transpose_clipboard.as_mut() {
+                for row in &mut transpose.data.cells {
+                    for cell in row {
+                        visit_paragraphs(cell, &mut remap_rest);
+                    }
+                }
+            }
+        }
+        // 4. 표 정리. 남는 것만, 순서 그대로.
+        let mut index = 0usize;
+        self.document.doc_info.char_shapes.retain(|_| {
+            let keep = index < baseline || map[index] != u32::MAX;
+            index += 1;
+            keep
+        });
+        self.document.doc_info.raw_stream_dirty = true;
+        for (section, changed) in self.document.sections.iter_mut().zip(&changed_sections) {
+            if *changed {
+                section.raw_stream = None;
+            }
+        }
+        self.rebuild_derived_state();
+        Ok(CharShapeCompactReport {
+            before,
+            after: self.document.doc_info.char_shapes.len(),
+            skipped: None,
+        })
+    }
+
+    /// 지금 글자 모양 수(호출자가 불러온 직후의 기준 수를 기록할 때 쓴다).
+    pub fn char_shape_count_native(&self) -> usize {
+        self.document.doc_info.char_shapes.len()
+    }
+}
+
