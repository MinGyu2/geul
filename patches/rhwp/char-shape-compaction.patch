+//! [geul] 덧붙인 글자 모양 정리 시험. 실제 한컴 저장 표본을 실제 RHWP 내보내기·다시 열기로 확인한다.
+use super::*;
+use crate::parser::cfb_reader::CfbReader;
+use crate::parser::record::Record;
+
+const W150: &str = r#"{"ratios":[150,150,150,150,150,150,150]}"#;
+const W80: &str = r#"{"ratios":[80,80,80,80,80,80,80]}"#;
+const S10: &str = r#"{"spacings":[10,10,10,10,10,10,10]}"#;
+const SM20: &str = r#"{"spacings":[-20,-20,-20,-20,-20,-20,-20]}"#;
+const BOLD: &str = r#"{"bold":true}"#;
+
+fn sample(name: &str) -> Vec<u8> {
+    std::fs::read(format!("{}/samples/{name}", env!("CARGO_MANIFEST_DIR"))).expect("표본")
+}
+
+fn open(bytes: &[u8]) -> DocumentCore {
+    DocumentCore::from_bytes(bytes).expect("열기")
+}
+
+/// 글이 4자 이상인 첫 본문 문단.
+fn text_para(core: &DocumentCore) -> usize {
+    core.document.sections[0]
+        .paragraphs
+        .iter()
+        .position(|p| p.text.chars().filter(|c| !c.is_control()).count() >= 4)
+        .expect("글 있는 문단")
+}
+
+/// 문단 글자 위치의 (장평, 자간) 7개 값과 모양 번호.
+fn metrics_at(core: &DocumentCore, para: usize, offset: usize) -> (Vec<u8>, Vec<i8>, u32) {
+    let p = &core.document.sections[0].paragraphs[para];
+    let id = p.char_shape_id_at(offset).expect("모양");
+    let cs = &core.document.doc_info.char_shapes[id as usize];
+    (cs.ratios.to_vec(), cs.spacings.to_vec(), id)
+}
+
+fn hwp_docinfo(bytes: &[u8]) -> Vec<Record> {
+    let mut cfb = CfbReader::open(bytes).expect("CFB");
+    let header = cfb.read_stream_raw("FileHeader").expect("FileHeader");
+    let compressed = header.get(36).is_some_and(|flags| flags & 1 != 0);
+    Record::read_all(&cfb.read_doc_info(compressed).expect("DocInfo")).expect("레코드")
+}
+
+fn apply(core: &mut DocumentCore, para: usize, props: &str) {
+    core.apply_char_format_native(0, para, 0, 3, props)
+        .expect("서식");
+}
+
+#[test]
+fn chained_metric_edits_leave_no_unreferenced_appended_shape() {
+    for name in ["KTX.hwp", "hwpx/ref/ref_text.hwpx"] {
+        for (label, chain) in [
+            ("width-width", vec![W150, W80]),
+            ("spacing-spacing", vec![S10, SM20]),
+            ("width-spacing", vec![W150, S10]),
+            ("spacing-width", vec![S10, W150]),
+            ("width-bold-spacing", vec![W150, BOLD, S10]),
+        ] {
+            let mut core = open(&sample(name));
+            let para = text_para(&core);
+            let baseline = core.char_shape_count_native();
+            let untouched = metrics_at(&core, para, 3);
+            let original_shapes = core.document.doc_info.char_shapes.clone();
+            for props in &chain {
+                apply(&mut core, para, props);
+            }
+            let edited = metrics_at(&core, para, 0);
+            let report = core.compact_appended_char_shapes(baseline).unwrap();
+            assert_eq!(report.skipped, None, "{name} {label}");
+            // 체인의 마지막 결과 모양 하나만 남는다(같은 모양이 이미 있으면 0).
+            assert!(report.after <= baseline + 1, "{name} {label}: {report:?}");
+            assert_eq!(
+                &core.document.doc_info.char_shapes[..baseline],
+                &original_shapes[..],
+                "{name} {label}: 원본 정의 그대로"
+            );
+            let after = metrics_at(&core, para, 0);
+            assert_eq!(
+                (&after.0, &after.1),
+                (&edited.0, &edited.1),
+                "{name} {label}: 결과 값 그대로"
+            );
+            assert_eq!(
+                metrics_at(&core, para, 3),
+                untouched,
+                "{name} {label}: 범위 밖 그대로"
+            );
+            // 실제 저장·다시 열기(원래 형식).
+            let bytes = if name.ends_with(".hwp") {
+                core.export_hwp_native()
+            } else {
+                core.export_hwpx_native()
+            }
+            .expect("저장");
+            let reopened = open(&bytes);
+            assert_eq!(
+                reopened.char_shape_count_native(),
+                report.after,
+                "{name} {label}: 다시 연 표 크기"
+            );
+            let back = metrics_at(&reopened, para, 0);
+            assert_eq!(
+                (&back.0, &back.1),
+                (&edited.0, &edited.1),
+                "{name} {label}: 다시 연 값"
+            );
+            // 둘째 회차: 다시 연 문서에서 또 바꾸고 정리.
+            let mut again = reopened;
+            let base2 = again.char_shape_count_native();
+            apply(&mut again, para, W80);
+            apply(&mut again, para, SM20);
+            let r2 = again.compact_appended_char_shapes(base2).unwrap();
+            assert!(r2.after <= base2 + 1, "{name} {label}: 둘째 {r2:?}");
+            let _ = if name.ends_with(".hwp") {
+                again.export_hwp_native()
+            } else {
+                again.export_hwpx_native()
+            }
+            .expect("둘째 저장");
+        }
+    }
+}
+
+#[test]
+fn compaction_in_table_cells_and_snapshot_restore() {
+    let mut core = open(&sample("calc-cell.hwp"));
+    let baseline = core.char_shape_count_native();
+    let snap = core.save_snapshot_native();
+    core.apply_char_format_in_cell_native(0, 0, 2, 0, 0, 0, 1, W150)
+        .unwrap();
+    core.apply_char_format_in_cell_native(0, 0, 2, 0, 0, 0, 1, S10)
+        .unwrap();
+    core.apply_char_format_in_cell_native(0, 0, 2, 1, 0, 0, 1, W80)
+        .unwrap();
+    assert_eq!(core.char_shape_count_native(), baseline + 3);
+    let report = core.compact_appended_char_shapes(baseline).unwrap();
+    assert_eq!((report.after, report.skipped), (baseline + 2, None));
+    let bytes = core.export_hwp_native().unwrap();
+    let back = open(&bytes);
+    assert_eq!(back.char_shape_count_native(), baseline + 2);
+    // 스냅숏 복원은 그때의 표로 돌아간다(스냅숏 문서는 정리와 무관).
+    core.restore_snapshot_native(snap).unwrap();
+    assert_eq!(core.char_shape_count_native(), baseline);
+}
