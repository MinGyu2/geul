+/// 증거 기록: 한컴 HWP에 장평 한 번(+정리)을 저장했을 때 DocInfo 레코드 차이.
+#[test]
+fn hwp_docinfo_delta_of_one_metric_edit() {
+    let original = sample("KTX.hwp");
+    let mut core = open(&original);
+    let para = text_para(&core);
+    let baseline = core.char_shape_count_native();
+    apply(&mut core, para, W150);
+    apply(&mut core, para, S10);
+    core.compact_appended_char_shapes(baseline).unwrap();
+    let out = core.export_hwp_native().unwrap();
+    let (a, b) = (hwp_docinfo(&original), hwp_docinfo(&out));
+    let summary = |r: &[Record]| {
+        r.iter()
+            .map(|x| (x.tag_id, x.level, x.data.len()))
+            .collect::<Vec<_>>()
+    };
+    let mut changed = Vec::new();
+    let (mut i, mut j) = (0, 0);
+    while i < a.len() || j < b.len() {
+        match (a.get(i), b.get(j)) {
+            (Some(x), Some(y))
+                if x.tag_id == y.tag_id && x.level == y.level && x.data == y.data =>
+            {
+                i += 1;
+                j += 1;
+            }
+            (Some(x), Some(y)) if x.tag_id == y.tag_id && x.level == y.level => {
+                changed.push(format!("changed {} #{i}", x.tag_name()));
+                i += 1;
+                j += 1;
+            }
+            (_, Some(y)) => {
+                changed.push(format!(
+                    "inserted {} at {j} len {}",
+                    y.tag_name(),
+                    y.data.len()
+                ));
+                j += 1;
+            }
+            (Some(x), None) => {
+                changed.push(format!("removed {} #{i}", x.tag_name()));
+                i += 1;
+            }
+            (None, None) => break,
+        }
+    }
+    eprintln!(
+        "DOCINFO-DELTA records {}->{}: {changed:?}",
+        a.len(),
+        b.len()
+    );
+    eprintln!(
+        "DOCINFO-SUMMARY-LEN {} {}",
+        summary(&a).len(),
+        summary(&b).len()
+    );
+}
