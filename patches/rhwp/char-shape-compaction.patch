+/// 글자 겹치기의 0xFFFFFFFF(모양 없음)는 참조가 아니다: 정리를 막지 않고 값도 그대로 남는다.
+/// 문단 글자 범위의 같은 값은 위 시험대로 계속 dangling 이다.
+fn overlap_ids(core: &DocumentCore) -> Vec<u32> {
+    fn walk(paragraphs: &[crate::model::paragraph::Paragraph], out: &mut Vec<u32>) {
+        for p in paragraphs {
+            for control in &p.controls {
+                match control {
+                    Control::CharOverlap(o) => out.extend(&o.char_shape_ids),
+                    Control::Table(t) => {
+                        for cell in &t.cells {
+                            walk(&cell.paragraphs, out);
+                        }
+                    }
+                    _ => {}
+                }
+            }
+        }
+    }
+    let mut out = Vec::new();
+    for section in &core.document.sections {
+        walk(&section.paragraphs, &mut out);
+    }
+    out
+}
+
+#[test]
+fn char_overlap_sentinel_is_not_a_dangling_reference() {
+    for name in ["aift.hwp", "issue6031/3249937_asset_management_rules.hwpx"] {
+        let mut core = open(&sample(name));
+        let sentinels = overlap_ids(&core);
+        assert!(sentinels.contains(&u32::MAX), "{name}: 표본에 글자 겹치기 모양 없음 값이 있어야 한다");
+        let baseline = core.char_shape_count_native();
+        let para = text_para(&core);
+        apply(&mut core, para, W150);
+        apply(&mut core, para, W80);
+        assert_eq!(core.char_shape_count_native(), baseline + 2, "{name}");
+        let r = core.compact_appended_char_shapes(baseline).unwrap();
+        assert_eq!(r.skipped, None, "{name}");
+        assert_eq!(r.after, baseline + 1, "{name}");
+        assert_eq!(overlap_ids(&core), sentinels, "{name}");
+    }
+}
