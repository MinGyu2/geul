+#[test]
+fn compaction_fails_closed_and_is_a_noop_when_nothing_to_do() {
+    let mut core = open(&sample("KTX.hwp"));
+    let baseline = core.char_shape_count_native();
+    assert!(core.compact_appended_char_shapes(baseline + 1).is_err());
+    assert_eq!(
+        core.compact_appended_char_shapes(baseline).unwrap().after,
+        baseline
+    );
+    let para = text_para(&core);
+    apply(&mut core, para, W150);
+    apply(&mut core, para, S10);
+    // 덧붙인 모양을 스타일이 가리키면 정리하지 않는다.
+    let last = (core.char_shape_count_native() - 1) as u16;
+    let old = core.document.doc_info.styles[0].char_shape_id;
+    core.document.doc_info.styles[0].char_shape_id = last;
+    let r = core.compact_appended_char_shapes(baseline).unwrap();
+    assert_eq!(r.skipped, Some("docinfo-reference"));
+    assert_eq!(core.char_shape_count_native(), baseline + 2);
+    core.document.doc_info.styles[0].char_shape_id = old;
+    // Sentinel is only valid for list/DocInfo references, never paragraph runs.
+    core.document.sections[0].paragraphs[para].char_shapes[0].char_shape_id = u32::MAX;
+    let before = format!("{:?}", core.document);
+    assert_eq!(core.compact_appended_char_shapes(baseline).unwrap().skipped, Some("dangling"));
+    assert_eq!(format!("{:?}", core.document), before);
+    // 표 밖 번호를 가리키는 참조가 있으면 정리하지 않는다.
+    core.document.sections[0].paragraphs[para].char_shapes[0].char_shape_id = 9999;
+    assert_eq!(
+        core.compact_appended_char_shapes(baseline).unwrap().skipped,
+        Some("dangling")
+    );
+}
