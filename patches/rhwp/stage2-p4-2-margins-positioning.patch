+    #[test]
+    fn stage2_p4_2_cell_margins_and_table_positioning_hwpx_and_hwp() {
+        let (mut core, para, ctrl) = core_with_table(2, 2);
+        let path = vec![(ctrl, 0usize, 0usize)];
+
+        // 1. Table-wide padding + positioning (center, horzOffset, outer margins)
+        core.set_table_cell_margins_by_path_native(
+            0,
+            para,
+            &path,
+            r#"{"scope":"table","top":6,"right":12,"bottom":6,"left":12}"#,
+        )
+        .unwrap();
+        core.set_table_properties_by_path_native(
+            0,
+            para,
+            &path,
+            r#"{"textWrap":"TopAndBottom","treatAsChar":false,"horzRelTo":"Column","horzAlign":"Center","horzOffset":1800,"outerLeft":600,"outerRight":600,"outerTop":300,"outerBottom":300}"#,
+        )
+        .unwrap();
+
+        // 2. Per-cell inner margin override on (0,0) leaving (0,1) inheriting table padding
+        core.set_table_cell_margins_by_path_native(
+            0,
+            para,
+            &path,
+            r#"{"scope":"cell","rect":{"startRow":0,"startCol":0,"endRow":0,"endCol":0},"left":20,"right":20}"#,
+        )
+        .unwrap();
+        let m00: serde_json::Value = serde_json::from_str(
+            &core.get_table_cell_margins_by_path_native(0, para, &path, 0, 0, 0, 0).unwrap(),
+        )
+        .unwrap();
+        assert_eq!(m00["table"]["left"], 12.0);
+        assert_eq!(m00["cell"]["left"], 20.0);
+        assert_eq!(m00["cell"]["top"], 6.0);
+        assert_eq!(m00["cell"]["usesTableDefault"], false);
+
+        let mixed: serde_json::Value = serde_json::from_str(
+            &core.get_table_cell_margins_by_path_native(0, para, &path, 0, 0, 0, 1).unwrap(),
+        )
+        .unwrap();
+        assert_eq!(mixed["cell"]["mixed"], true);
+        assert_eq!(mixed["cell"]["mixedOverride"], true);
+
+        // 3. Reset cell (0,0) back to table default, then re-override (0,0) for save check
+        core.set_table_cell_margins_by_path_native(
+            0,
+            para,
+            &path,
+            r#"{"scope":"cell","rect":{"startRow":0,"startCol":0,"endRow":0,"endCol":0},"reset":true}"#,
+        )
+        .unwrap();
+        let after_reset: serde_json::Value = serde_json::from_str(
+            &core.get_table_cell_margins_by_path_native(0, para, &path, 0, 0, 0, 0).unwrap(),
+        )
+        .unwrap();
+        assert_eq!(after_reset["cell"]["usesTableDefault"], true);
+        assert_eq!(after_reset["cell"]["left"], 12.0);
+
+        core.set_table_cell_margins_by_path_native(
+            0,
+            para,
+            &path,
+            r#"{"scope":"cell","rect":{"startRow":0,"startCol":0,"endRow":0,"endCol":0},"top":10,"left":18}"#,
+        )
+        .unwrap();
+
+        // 4. Reject out-of-range margin and nested table positioning
+        assert!(core
+            .set_table_cell_margins_by_path_native(
+                0,
+                para,
+                &path,
+                r#"{"scope":"cell","rect":{"startRow":0,"startCol":0,"endRow":0,"endCol":0},"top":-1}"#,
+            )
+            .is_err());
+
+        let n_res: serde_json::Value = serde_json::from_str(
+            &core
+                .create_table_with_path_native(0, para, 0, 1, 2, true, None, None, &[(ctrl, 1, 0)])
+                .unwrap(),
+        )
+        .unwrap();
+        let n_ctrl = n_res["controlIdx"].as_u64().unwrap() as usize;
+        let npath = vec![(ctrl, 1usize, 0usize), (n_ctrl, 0usize, 0usize)];
+        assert!(core
+            .set_table_properties_by_path_native(0, para, &npath, r#"{"horzAlign":"Center"}"#)
+            .is_err());
+        core.set_table_cell_margins_by_path_native(
+            0,
+            para,
+            &npath,
+            r#"{"scope":"table","left":9,"right":9}"#,
