+    /// [geul] Stage 2 P4-2/P4-3: set table properties (positioning, repeatHeader, pageBreak, etc.) by path.
+    pub fn set_table_properties_by_path_native(
+        &mut self,
+        section: usize,
+        paragraph: usize,
+        path: &[(usize, usize, usize)],
+        json: &str,
+    ) -> Result<String, HwpError> {
+        if path.len() == 1 {
+            return self.set_table_properties_native(section, paragraph, path[0].0, json);
+        }
+        use super::super::helpers::{json_bool, json_i16, json_i32, json_str, json_u8};
+        if json_str(json, "horzAlign").is_some()
+            || json_str(json, "horzRelTo").is_some()
+            || json_bool(json, "treatAsChar").is_some()
+            || json_i32(json, "horzOffset").is_some()
+            || json_i16(json, "outerLeft").is_some()
+            || json_i16(json, "outerRight").is_some()
+            || json_i16(json, "outerTop").is_some()
+            || json_i16(json, "outerBottom").is_some()
+        {
+            return Err(HwpError::RenderError(
+                "nested tables do not support table positioning".into(),
+            ));
+        }
+        let table = self.resolve_table_mut_by_cell_path(section, paragraph, path)?;
+        if let Some(v) = json_u8(json, "pageBreak") {
+            table.page_break = match v {
+                1 => crate::model::table::TablePageBreak::CellBreak,
+                2 => crate::model::table::TablePageBreak::RowBreak,
+                _ => crate::model::table::TablePageBreak::None,
+            };
+        }
+        if let Some(v) = json_bool(json, "repeatHeader") {
+            table.repeat_header = v;
+        }
+        self.mark_cell_control_dirty(section, paragraph, path[0].0);
+        self.document.sections[section].raw_stream = None;
+        self.recompose_section(section);
+        self.paginate_if_needed();
+        Ok("{\"ok\":true}".into())
+    }
