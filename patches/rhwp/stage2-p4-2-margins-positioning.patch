+        .unwrap();
+
+        // 5. HWPX & HWP independent save/reopen verification (including HWPX-parsed common.attr preservation)
+        let hwpx = core.export_hwpx_native().unwrap();
+        let mut reopened_hwpx = DocumentCore::from_bytes(&hwpx).unwrap();
+        let rt_hwpx = table(&reopened_hwpx, para, ctrl);
+        assert_eq!(rt_hwpx.padding.left, 1200);
+        assert_eq!(rt_hwpx.cells[0].apply_inner_margin, true);
+        assert_eq!(rt_hwpx.cells[0].padding.left, 1800);
+        assert_eq!(rt_hwpx.cells[1].apply_inner_margin, false);
+        assert_eq!(rt_hwpx.common.horizontal_offset, 1800);
+        assert_eq!(rt_hwpx.common.margin.left, 600);
+        assert_eq!(rt_hwpx.common.horz_align, crate::model::shape::HorzAlign::Center);
+        assert_eq!(reopened_hwpx.controls_json(), core.controls_json());
+
+        // Mutate HWPX-origin table positioning again and confirm controls_json matches after re-export/reopen
+        reopened_hwpx
+            .set_table_properties_by_path_native(0, para, &path, r#"{"horzAlign":"Right","horzOffset":900}"#)
+            .unwrap();
+        let hwpx2 = reopened_hwpx.export_hwpx_native().unwrap();
+        let reopened_hwpx2 = DocumentCore::from_bytes(&hwpx2).unwrap();
+        assert_eq!(reopened_hwpx2.controls_json(), reopened_hwpx.controls_json());
+
+        let hwp = core.export_hwp_native().unwrap();
+        let reopened_hwp = DocumentCore::from_bytes(&hwp).unwrap();
+        assert_eq!(reopened_hwp.controls_json(), core.controls_json());
+        let rt_hwp = table(&reopened_hwp, para, ctrl);
+        assert_eq!(rt_hwp.padding.left, 1200);
+        assert_eq!(rt_hwp.cells[0].apply_inner_margin, true);
+        assert_eq!(rt_hwp.cells[0].padding.left, 1800);
+        assert_eq!(rt_hwp.cells[1].apply_inner_margin, false);
+        assert_eq!(rt_hwp.common.horizontal_offset, 1800);
+        assert_eq!(rt_hwp.common.margin.left, 600);
+        assert_eq!(rt_hwp.common.horz_align, crate::model::shape::HorzAlign::Center);
+    }
 }
