+    /// [geul] Stage 2 P4-2: read table-default and selected-cell inner margins (pt) by path.
+    pub fn get_table_cell_margins_by_path_native(
+        &self,
+        section: usize,
+        paragraph: usize,
+        path: &[(usize, usize, usize)],
+        start_row: u16,
+        start_col: u16,
+        end_row: u16,
+        end_col: u16,
+    ) -> Result<String, HwpError> {
+        let hu_to_pt = |hu: i16| -> f64 { (((hu as f64) / 100.0) * 100.0).round() / 100.0 };
+        let table = self.resolve_table_by_path(section, paragraph, path)?;
+        if table.row_count == 0
+            || table.col_count == 0
+            || start_row > end_row
+            || start_col > end_col
+            || end_row >= table.row_count
+            || end_col >= table.col_count
+        {
+            return Err(HwpError::RenderError("cell margin range out of bounds".into()));
+        }
+        let mut first: Option<[f64; 4]> = None;
+        let mut mixed = false;
+        let mut any_default = false;
+        let mut any_override = false;
+        let mut count = 0usize;
+        for cell in &table.cells {
+            let cell_end_r = cell.row + cell.row_span.saturating_sub(1);
+            let cell_end_c = cell.col + cell.col_span.saturating_sub(1);
+            let overlaps = cell_end_r >= start_row
+                && cell.row <= end_row
+                && cell_end_c >= start_col
+                && cell.col <= end_col;
+            if !overlaps {
+                continue;
+            }
+            count += 1;
+            if cell.apply_inner_margin {
+                any_override = true;
+            } else {
+                any_default = true;
+            }
+            let eff = cell.effective_padding(&table.padding);
+            let vals = [
+                hu_to_pt(eff.top),
+                hu_to_pt(eff.right),
+                hu_to_pt(eff.bottom),
+                hu_to_pt(eff.left),
+            ];
+            match first {
+                None => first = Some(vals),
+                Some(prev) => {
+                    if vals.iter().zip(prev.iter()).any(|(a, b)| (a - b).abs() > 0.05) {
+                        mixed = true;
+                    }
+                }
+            }
+        }
+        if count == 0 {
+            return Err(HwpError::RenderError("no cells in margin selection".into()));
+        }
+        let f = first.unwrap();
+        Ok(serde_json::json!({
+            "table": {
+                "top": hu_to_pt(table.padding.top),
+                "right": hu_to_pt(table.padding.right),
+                "bottom": hu_to_pt(table.padding.bottom),
+                "left": hu_to_pt(table.padding.left),
+            },
+            "cell": {
+                "top": if mixed { serde_json::Value::Null } else { serde_json::json!(f[0]) },
+                "right": if mixed { serde_json::Value::Null } else { serde_json::json!(f[1]) },
+                "bottom": if mixed { serde_json::Value::Null } else { serde_json::json!(f[2]) },
+                "left": if mixed { serde_json::Value::Null } else { serde_json::json!(f[3]) },
+                "mixed": mixed,
+                "usesTableDefault": !any_override,
+                "mixedOverride": any_default && any_override,
+            }
+        })
+        .to_string())
+    }
+
+    /// [geul] Stage 2 P4-2: set table-default or selected-cell inner margins (pt) by path, or reset overrides.
+    pub fn set_table_cell_margins_by_path_native(
+        &mut self,
+        section: usize,
+        paragraph: usize,
+        path: &[(usize, usize, usize)],
+        spec_json: &str,
+    ) -> Result<String, HwpError> {
+        #[derive(serde::Deserialize)]
+        #[serde(rename_all = "camelCase", deny_unknown_fields)]
+        struct RectArg {
+            start_row: u16,
+            start_col: u16,
+            end_row: u16,
+            end_col: u16,
+        }
+        #[derive(serde::Deserialize)]
+        #[serde(rename_all = "camelCase", deny_unknown_fields)]
+        struct MarginSpec {
+            scope: String,
+            #[serde(default)]
+            rect: Option<RectArg>,
+            #[serde(default)]
+            top: Option<f64>,
+            #[serde(default)]
+            right: Option<f64>,
+            #[serde(default)]
+            bottom: Option<f64>,
+            #[serde(default)]
+            left: Option<f64>,
+            #[serde(default)]
+            reset: Option<bool>,
+        }
+        let spec: MarginSpec = serde_json::from_str(spec_json)
+            .map_err(|_| HwpError::RenderError("invalid cell margin spec".into()))?;
+        let parse_side = |v: Option<f64>| -> Result<Option<i16>, HwpError> {
+            match v {
+                None => Ok(None),
+                Some(pt) => {
+                    if !pt.is_finite() || !(0.0..=144.0).contains(&pt) {
+                        return Err(HwpError::RenderError("cell margin pt out of bounds (0..=144)".into()));
+                    }
+                    Ok(Some((pt * 100.0).round() as i16))
+                }
+            }
+        };
+        let top = parse_side(spec.top)?;
+        let right = parse_side(spec.right)?;
+        let bottom = parse_side(spec.bottom)?;
+        let left = parse_side(spec.left)?;
+        let reset = spec.reset.unwrap_or(false);
+        let any_side = top.is_some() || right.is_some() || bottom.is_some() || left.is_some();
+
+        let depth = path.len().checked_sub(1).ok_or_else(|| HwpError::RenderError("empty path".into()))?;
+        let mut reflow_targets: Vec<(usize, usize)> = Vec::new();
+        {
+            let table = self.resolve_table_mut_by_cell_path(section, paragraph, path)?;
+            match spec.scope.as_str() {
+                "table" => {
+                    if reset || !any_side {
+                        return Err(HwpError::RenderError("table scope requires at least one margin side".into()));
+                    }
+                    if let Some(v) = top { table.padding.top = v; }
+                    if let Some(v) = right { table.padding.right = v; }
+                    if let Some(v) = bottom { table.padding.bottom = v; }
+                    if let Some(v) = left { table.padding.left = v; }
+                    for (ci, cell) in table.cells.iter().enumerate() {
+                        if !cell.apply_inner_margin {
+                            reflow_targets.push((ci, cell.paragraphs.len()));
+                        }
+                    }
+                }
+                "cell" => {
+                    let rect = spec.rect.as_ref().ok_or_else(|| HwpError::RenderError("cell scope requires rect".into()))?;
+                    if rect.start_row > rect.end_row
+                        || rect.start_col > rect.end_col
+                        || rect.end_row >= table.row_count
+                        || rect.end_col >= table.col_count
+                    {
+                        return Err(HwpError::RenderError("cell margin rect out of bounds".into()));
+                    }
+                    if reset && any_side {
+                        return Err(HwpError::RenderError("reset cannot be combined with margin sides".into()));
+                    }
+                    if !reset && !any_side {
+                        return Err(HwpError::RenderError("cell scope requires margins or reset".into()));
+                    }
+                    let mut indices = Vec::new();
+                    for (ci, cell) in table.cells.iter().enumerate() {
+                        let er = cell.row + cell.row_span.saturating_sub(1);
+                        let ec = cell.col + cell.col_span.saturating_sub(1);
+                        if er >= rect.start_row && cell.row <= rect.end_row && ec >= rect.start_col && cell.col <= rect.end_col {
+                            if cell.row < rect.start_row || er > rect.end_row || cell.col < rect.start_col || ec > rect.end_col {
+                                return Err(HwpError::RenderError("selection overlaps merged cells partially".into()));
+                            }
+                            indices.push(ci);
+                        }
+                    }
+                    if indices.is_empty() {
+                        return Err(HwpError::RenderError("no cells matched margin rect".into()));
+                    }
+                    let table_pad = table.padding;
+                    for ci in indices {
+                        let cell = &mut table.cells[ci];
+                        if reset {
+                            cell.set_apply_inner_margin(false);
+                            cell.padding = table_pad;
+                        } else {
+                            if !cell.apply_inner_margin {
+                                cell.padding = table_pad;
+                            }
+                            if let Some(v) = top { cell.padding.top = v; }
+                            if let Some(v) = right { cell.padding.right = v; }
+                            if let Some(v) = bottom { cell.padding.bottom = v; }
+                            if let Some(v) = left { cell.padding.left = v; }
+                            cell.set_apply_inner_margin(true);
+                        }
+                        reflow_targets.push((ci, cell.paragraphs.len()));
+                    }
+                }
+                _ => return Err(HwpError::RenderError("invalid margin scope".into())),
+            }
+        }
+
+        let last_ctrl = path[depth].0;
+        let mut inner_path = path.to_vec();
+        for (ci, para_count) in reflow_targets {
+            for pi in 0..para_count {
+                inner_path[depth] = (last_ctrl, ci, pi);
+                self.reflow_cell_paragraph_by_path(section, paragraph, &inner_path, pi);
+            }
+        }
+        if path.len() > 1 {
+            self.mark_cell_control_dirty(section, paragraph, path[0].0);
+        }
+        self.document.sections[section].raw_stream = None;
+        self.recompose_section(section);
+        self.paginate_if_needed();
+        Ok("{\"ok\":true}".into())
+    }
