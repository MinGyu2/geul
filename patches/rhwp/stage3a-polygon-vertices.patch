+fn geul_cross(a: crate::model::Point, b: crate::model::Point, c: crate::model::Point) -> i64 {
+    (i64::from(b.x) - i64::from(a.x)) * (i64::from(c.y) - i64::from(a.y))
+        - (i64::from(b.y) - i64::from(a.y)) * (i64::from(c.x) - i64::from(a.x))
+}
+
+fn geul_within_segment_bounds(p: crate::model::Point, a: crate::model::Point, b: crate::model::Point) -> bool {
+    (a.x.min(b.x)..=a.x.max(b.x)).contains(&p.x) && (a.y.min(b.y)..=a.y.max(b.y)).contains(&p.y)
+}
+
+// Input coordinates already fit the editable path's bounded original extent.
+fn geul_simple_closed_polygon(points: &[crate::model::Point]) -> bool {
+    if !geul_polygon_valid(points) || !geul_same_point(&points[0], &points[points.len() - 1]) {
+        return false;
+    }
+    let vertices = &points[..points.len() - 1];
+    let n = vertices.len();
+    let edges = points.windows(2);
+    for (i, edge) in edges.clone().enumerate() {
+        let (a, b) = (edge[0], edge[1]);
+        let prev = vertices[(i + n - 1) % n];
+        if geul_cross(prev, a, b) == 0 && !geul_within_segment_bounds(a, prev, b) {
+            return false;
+        }
+        for other in edges.clone().take(if i == 0 { n - 1 } else { n }).skip(i + 2) {
+            let (c, d) = (other[0], other[1]);
+            let (ac, ad, ca, cb) = (geul_cross(a, b, c), geul_cross(a, b, d),
+                geul_cross(c, d, a), geul_cross(c, d, b));
+            if (ac * ad.signum() < 0 && ca * cb.signum() < 0)
+                || (ac == 0 && geul_within_segment_bounds(c, a, b))
+                || (ad == 0 && geul_within_segment_bounds(d, a, b))
+                || (ca == 0 && geul_within_segment_bounds(a, c, d))
+                || (cb == 0 && geul_within_segment_bounds(b, c, d))
+            {
+                return false;
+            }
+        }
+    }
+    true
+}
+
+fn geul_polygon_winding(points: &[crate::model::Point]) -> i64 {
+    points.windows(2).map(|edge| geul_cross(crate::model::Point::default(), edge[0], edge[1])).sum::<i64>().signum()
+}
