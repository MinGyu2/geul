+    fn editable_polygon_vertices(&self, sec: usize, para: usize, ctrl: usize) -> Option<&[crate::model::Point]> {
+        let ShapeObject::Polygon(polygon) = self.advanced_body_shape(sec, para, ctrl)? else {
