+    }
+
+    pub fn edit_polygon_vertex(
+        &mut self, sec: usize, para: usize, ctrl: usize, index: usize, insert: Option<crate::model::Point>,
+    ) -> Result<(), HwpError> {
+        let original = self.editable_polygon_vertices(sec, para, ctrl).ok_or_else(geul_bad_shape_edit)?;
+        if index >= original.len() - 1 {
+            return Err(geul_bad_shape_edit());
+        }
+        let mut updated = original.to_vec();
+        if let Some(point) = insert {
+            let (a, b) = (original[index], original[index + 1]);
+            // The inserted HWPUNIT point must be strictly inside the chosen edge.
+            if original.len() == 257 || !geul_within_segment_bounds(point, a, b)
+                || geul_same_point(&point, &a) || geul_same_point(&point, &b)
+                || geul_cross(a, b, point) != 0
+            {
+                return Err(geul_bad_shape_edit());
+            }
+            updated.insert(index + 1, point);
+        } else {
+            if original.len() <= 4 {
+                return Err(geul_bad_shape_edit());
+            }
+            updated.pop();
+            updated.remove(index);
+            updated.push(updated[0]);
+        }
+        if !geul_simple_closed_polygon(&updated) || geul_polygon_winding(original) != geul_polygon_winding(&updated) {
+            return Err(geul_bad_shape_edit());
+        }
+        let ShapeObject::Polygon(polygon) = self.resolve_shape_control_mut(sec, para, ctrl)? else {
+            return Err(geul_bad_shape_edit());
+        };
+        polygon.points = updated;
+        self.refresh_advanced_shape(sec);
+        Ok(())
+    }
