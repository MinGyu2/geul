+/// Capture-level proof: equivalent spellings of the same nested values are
+/// interchangeable sources (no ambiguity refusal). Package-level export of
+/// identical nested controls is covered by the hp:autoNum regression; an
+/// id-less unterminated CLICK_HERE begin is not a round-trip structure.
+fn not_ambiguous(a: &str, b: &str) -> bool {
+    let p = imported(&r(&format!("{a}<hp:t/>{b}")));
+    p.hwpx_text_topology.as_ref().unwrap().validate(&p).is_ok()
+}
