+fn click_here(value: &str) -> String {
+    format!(
+        r#"<hp:ctrl><hp:fieldBegin type="CLICK_HERE" name="" editable="1" dirty="0"><hp:parameters cnt="1" name=""><hp:stringParam name="Command" xml:space="preserve">{value}</hp:stringParam></hp:parameters></hp:fieldBegin></hp:ctrl>"#
