+use super::*;
+use crate::parser::hwpx::section::parse_hwpx_section;
+
+fn imported(runs: &str) -> Paragraph {
+    let xml =
+        format!(r#"<hs:sec><hp:p id="7" paraPrIDRef="0" styleIDRef="0">{runs}</hp:p></hs:sec>"#);
+    parse_hwpx_section(&xml).unwrap().paragraphs.remove(0)
+}
+fn render(p: &Paragraph) -> Result<String, String> {
+    let mut ctx = SerializeContext::default();
+    let (runs, _, _) = render_paragraph_parts(p, 0, &mut ctx);
+    match ctx.text_topology_error {
+        Some(e) => Err(e),
+        None => Ok(runs),
+    }
+}
+fn r(content: &str) -> String {
+    format!(r#"<hp:run charPrIDRef="0">{content}</hp:run>"#)
+}
+fn explicit(xml: &str) -> String {
+    xml.replace("<hp:t/>", "<hp:t></hp:t>")
+}
+
+#[test]
+fn empty_text_presence_multiplicity_and_order() {
+    for body in [
+        "",
+        "<hp:t/>",
+        "<hp:t></hp:t>",
+        "<hp:t>A</hp:t><hp:t/>",
+        "<hp:t/><hp:t>A</hp:t>",
+        "<hp:t>A</hp:t><hp:t/><hp:t/><hp:t>B</hp:t>",
+        "<hp:t/><hp:t> </hp:t><hp:t/>",
+        "<hp:t/><hp:t>&amp;<![CDATA[가]]></hp:t><hp:t/>",
+    ] {
+        let source = r(body);
+        let p = imported(&source);
+        let out = render(&p).unwrap();
+        let expected = explicit(&source).replace("<![CDATA[가]]>", "가");
+        assert_eq!(out, expected, "{body}");
+        let q = imported(&out);
+        assert_eq!(render(&q).unwrap(), out);
+        assert_eq!(p.text, q.text);
+        assert_eq!(p.char_offsets, q.char_offsets);
+    }
+}
+
+#[test]
+fn empty_text_same_position_runs_are_distinct_occurrences() {
+    let source = format!(
+        "{}{}{}{}",
+        r(""),
+        r("<hp:t/><hp:t/>"),
+        r(""),
+        r("<hp:t>A</hp:t><hp:t/>")
+    );
+    let p = imported(&source);
+    assert_eq!(p.char_shapes.len(), 4);
+    assert!(p.char_shapes.iter().all(|s| s.start_pos == 0));
+    assert_eq!(render(&p).unwrap(), explicit(&source));
+    let source = source.replacen("charPrIDRef=\"0\"", "charPrIDRef=\"3\"", 1);
+    assert_eq!(render(&imported(&source)).unwrap(), explicit(&source));
+}
+
+#[test]
+fn empty_text_before_after_controls_stays_in_own_run() {
+    let control =
+        r#"<hp:ctrl><hp:pageNum pos="BOTTOM_CENTER" formatType="DIGIT" sideChar="-"/></hp:ctrl>"#;
+    let source = r(&format!("<hp:t/>{control}<hp:t/><hp:t/>"));
+    assert_eq!(render(&imported(&source)).unwrap(), explicit(&source));
+    let source = format!("{}{}{}", r("<hp:t/>"), r(control), r("<hp:t/>"));
+    assert_eq!(render(&imported(&source)).unwrap(), explicit(&source));
+}
+
+#[test]
+fn empty_text_template_handoff_is_explicitly_mapped() {
+    for runs in [
+        r("<hp:t/><hp:t>A</hp:t><hp:t/>"),
+        r(""),
+        format!("{}{}", r("<hp:t/>"), r("<hp:t/>")),
+        r("<hp:t/><hp:t>A</hp:t>").replace("charPrIDRef=\"0\"", "charPrIDRef=\"1\""),
+    ] {
+        let source = EMPTY_SECTION_XML.replacen(TEMPLATE_TEXT_RUN, &runs, 1);
+        let section = parse_hwpx_section(&source).unwrap();
+        let doc = Document {
+            sections: vec![section.clone()],
+            ..Default::default()
+        };
+        let mut ctx = SerializeContext::collect_from_document(&doc);
+        let out = String::from_utf8(write_section(&section, &doc, 0, &mut ctx).unwrap()).unwrap();
+        assert_eq!(ctx.text_topology_error, None);
+        assert!(out.contains(&explicit(&runs)), "{out}");
+        let reopened = parse_hwpx_section(&out).unwrap();
+        assert_eq!(section.paragraphs[0].text, reopened.paragraphs[0].text);
+        assert_eq!(
+            section.paragraphs[0].char_shapes.len(),
+            reopened.paragraphs[0].char_shapes.len()
+        );
+    }
+}
+
+#[test]
+fn empty_text_real_text_commands_update_anchors_and_keep_formatting() {
+    for (at, expected) in [(0, "가AB"), (1, "A가B"), (2, "AB가")] {
+        let mut p = imported(&r("<hp:t>A</hp:t><hp:t/><hp:t>B</hp:t>"));
+        p.insert_text_at(at, "가");
+        assert_eq!(p.text, expected);
+        let xml = render(&p).unwrap();
+        let marker = if at == 0 {
+            "<hp:t>가A</hp:t><hp:t></hp:t><hp:t>B</hp:t>"
+        } else if at == 1 {
+            "<hp:t>A가</hp:t><hp:t></hp:t><hp:t>B</hp:t>"
+        } else {
+            "<hp:t>A</hp:t><hp:t></hp:t><hp:t>B가</hp:t>"
+        };
+        assert_eq!(xml, r(marker));
+        assert_eq!(p.char_shape_id_at(0), Some(0));
+    }
+    let mut p = imported(&r("<hp:t>AB</hp:t><hp:t/><hp:t>CD</hp:t>"));
+    assert_eq!(p.delete_text_at(1, 2), 2);
+    assert_eq!(
+        render(&p).unwrap(),
+        r("<hp:t>A</hp:t><hp:t></hp:t><hp:t>D</hp:t>")
+    );
+    // Korean IME's delete/insert composition cycle in an empty imported slot.
+    let mut p = imported(&r("<hp:t/>"));
+    p.insert_text_at(0, "ㅎ");
+    p.delete_text_at(0, 1);
+    p.insert_text_at(0, "한글");
+    assert_eq!(render(&p).unwrap(), r("<hp:t>한글</hp:t>"));
+}
+
+#[test]
+fn empty_text_boundary_insertion_uses_editor_selected_run_occurrence() {
+    let mut p = imported(&format!(
+        "{}{}",
+        r("<hp:t>A</hp:t><hp:t/>"),
+        r("<hp:t/><hp:t>B</hp:t>")
+    ));
+    p.insert_text_at(1, "가");
+    assert_eq!(
+        render(&p).unwrap(),
+        format!(
+            "{}{}",
+            r("<hp:t>A가</hp:t><hp:t></hp:t>"),
+            r("<hp:t></hp:t><hp:t>B</hp:t>")
+        )
+    );
+}
+
+#[test]
+fn empty_text_unrelated_edit_and_snapshot_clone_keep_owners() {
+    let p = imported(&r("<hp:t>A</hp:t><hp:t/>"));
+    let snapshot = p.clone();
+    let mut other = imported(&r("<hp:t>Z</hp:t>"));
+    other.insert_text_at(0, "가");
+    assert_eq!(render(&p).unwrap(), render(&snapshot).unwrap());
+    let mut detached = p.clone();
+    detached.hwpx_paragraph_identity = Default::default();
+    assert_eq!(
+        render(&detached).unwrap_err(),
+        "paragraph owner changed without a supported clone mapping"
+    );
+}
+
+#[test]
+fn empty_text_unsupported_edits_fail_closed_with_specific_cause() {
+    let source = r("<hp:t>A</hp:t><hp:t/><hp:t>B</hp:t>");
+    let mut p = imported(&source);
+    let q = p.split_at(1);
+    assert_eq!(
+        render(&p).unwrap_err(),
+        "paragraph split has unsupported run correspondence"
+    );
+    assert_eq!(
+        render(&q).unwrap_err(),
+        "paragraph split has unsupported run correspondence"
+    );
+    let mut p = imported(&source);
+    p.merge_from(&imported(&r("<hp:t>C</hp:t>")));
+    assert_eq!(
+        render(&p).unwrap_err(),
+        "paragraph merge has unsupported run correspondence"
+    );
+    let mut p = imported(&source);
+    p.apply_char_shape_range(0, 1, 1);
+    assert_eq!(
+        render(&p).unwrap_err(),
+        "character formatting changed run occurrence boundaries"
+    );
+    let mut p = imported(&source);
+    p.controls.push(Control::PageNumberPos(Default::default()));
+    assert_eq!(
+        render(&p).unwrap_err(),
+        "stale text, formatting or control-slot anchors"
+    );
+    // Equal shape AND offset AND run count cannot validate a changed event order.
+    let p = imported(&format!("{}{}", r("<hp:t/>"), r("")));
+    let mut changed = p.clone();
+    changed.char_shapes[1].start_pos = 9;
+    assert_eq!(
+        render(&changed).unwrap_err(),
+        "stale text, formatting or control-slot anchors"
+    );
+}
+
+#[test]
+fn empty_text_generated_paragraph_retains_existing_policy() {
+    let mut p = Paragraph::default();
+    p.char_shapes.push(crate::model::paragraph::CharShapeRef {
+        start_pos: 0,
+        char_shape_id: 0,
+    });
+    assert_eq!(render(&p).unwrap(), r("<hp:t></hp:t>"));
+}
+
+#[test]
+fn empty_text_ambiguous_template_and_actual_output_are_refused() {
+    let p = imported(&r("<hp:t>A</hp:t><hp:t/>"));
+    let t = p.hwpx_text_topology.as_ref().unwrap();
+    assert_eq!(
+        t.restore(&p, &r("<hp:t>B</hp:t>"), false).unwrap_err(),
+        "emitted text/control event order differs in IR run occurrence 0"
+    );
+    assert_eq!(
+        t.restore(&p, &format!("{}{}", r(""), r("<hp:t>A</hp:t>")), false)
+            .unwrap_err(),
+        "emitted run occurrence count does not match parser boundary plan"
+    );
+}
+
+#[test]
+fn empty_text_nested_table_and_later_paragraph_emitted_xml() {
+    let nested = r#"<hp:p id="8" paraPrIDRef="0" styleIDRef="0"><hp:run charPrIDRef="0"><hp:t>A</hp:t><hp:t/></hp:run><hp:run charPrIDRef="0"/></hp:p>"#;
