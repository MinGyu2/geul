+//! Paragraph-owned HWPX zero-width topology. No source XML is retained.
+//!
+//! A source run occurrence is mapped to the parser's boundary occurrence, not
+//! looked up by shape or offset. Only the explicit secPr handoff may share an
+//! IR occurrence. Actual emitted tokens must match each group before replay.
+//!
+//! Ownership contract:
+//! - Provenance is bound to one paragraph identity carrier AND to the numeric
+//!   value that carrier held when bound. The only value transition that needs
+//!   no explicit rebinding is the serializer's one-time reservation of a
+//!   deferred (0) identity, which it records through `record_reservation`.
+//!   Clipboard reidentification and merge-undo identity restoration rebind
+//!   explicitly. Any other value change, even in the same carrier, is refused.
+//! - Control events are compared by a classified event identity: the stable
+//!   ownership attributes plus the emitted attributes that distinguish
+//!   otherwise equal controls (`event_attrs`). Representation that the
+//!   serializer normalizes and layout detail are not identity; their bytes are
+//!   always taken from the generated fragment. Equal identities whose source
+//!   representation differs cannot be told apart and are refused.
+use std::sync::{
+    atomic::{AtomicU64, Ordering::Relaxed},
+    Arc, OnceLock,
+};
+
+use quick_xml::{events::Event, Reader};
+
+use super::{
+    control::Control,
+    paragraph::{CharShapeRef, Paragraph},
+    raw_provenance::record_digest,
+};
+
+pub(crate) const STALE: &str = "stale text, formatting or control-slot anchors";
+pub(crate) const IDENTITY_VALUE_CHANGED: &str =
+    "paragraph identity value changed without a supported reidentification";
+pub(crate) const OWNER_CHANGED: &str = "paragraph owner changed without a supported clone mapping";
+pub(crate) const FORMAT_BOUNDARY: &str = "character formatting changed run occurrence boundaries";
+pub(crate) const FORMAT_SCOPE: &str =
+    "character formatting edit changed more than run character shapes";
+pub(crate) const FORMAT_STYLED: &str =
+    "character formatting of hp:t charStyleIDRef text is unsupported";
+pub(crate) const AMBIGUOUS_CONTROL: &str = "ambiguous control event identity";
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) enum Part {
+    /// Ordered atoms (`c:` character, `i:` inline token) and the source
+    /// `hp:t@charStyleIDRef`, the only supported text-element attribute.
+    Text(Vec<String>, Option<u16>),
+    /// Classified event identity; `true` when the `hp:ctrl` holds only `hp:pageNum`.
+    Control(String, bool),
+}
+
+#[derive(Debug, Clone)]
+pub(crate) struct SourceRun {
+    pub group: usize,
+    pub shape: u32,
+    pub parts: Vec<Part>,
+}
+
+#[derive(Debug, Clone)]
+pub struct HwpxTextTopology {
+    pub(crate) runs: Vec<SourceRun>,
+    owner: Arc<AtomicU64>,
+    /// Numeric identity value of `owner` when this provenance was bound.
+    owner_value: u64,
+    /// Serializer reservation of a deferred (0) owner value. Shared by
+    /// detached snapshot clones exactly like the carrier itself.
+    reserved: Arc<OnceLock<u64>>,
+    seal: [u8; 32],
+    invalid: Option<String>,
+}
+
+// Persisted positional inputs only. Layout caches are deliberately excluded.
+// Child paragraphs own their own seals: editing a table cell does not stale
+// the parent's control slot. Stable object identities and ordered variants
+// protect that slot from replacement/reordering.
+fn seal(p: &Paragraph) -> [u8; 32] {
+    seal_with(p, &p.char_shapes)
+}
+
+fn seal_with(p: &Paragraph, shapes: &[CharShapeRef]) -> [u8; 32] {
+    let controls: Vec<_> = p
+        .controls
+        .iter()
+        .map(|c| match c {
+            Control::Table(t) => format!("table:{}", t.common.instance_id),
+            Control::Picture(t) => format!(
+                "picture:{}:{}",
+                t.common.instance_id, t.image_attr.bin_data_id
+            ),
+            Control::Shape(t) => format!("shape:{}", t.common().instance_id),
+            Control::Equation(t) => format!("equation:{}", t.common.instance_id),
+            Control::Form(t) => format!("form:{}", t.common.instance_id),
+            Control::Header(t) => format!("header:{:?}", t.apply_to),
+            Control::Footer(t) => format!("footer:{:?}", t.apply_to),
+            Control::Footnote(t) => format!("footnote:{}", t.instance_id),
+            Control::Endnote(t) => format!("endnote:{}", t.instance_id),
+            Control::SectionDef(_) => "section".into(),
+            other => format!("{:x?}", record_digest(other)),
+        })
+        .collect();
+    record_digest(&(
+        &p.text,
+        &p.char_offsets,
+        shapes,
+        p.char_count,
+        &controls,
+        &p.field_ranges,
+        // Cross-paragraph linking fills the HWP5-only begin_ctrl_id later.
+        // HWPX emits only these original positions and XML reference IDs.
+        p.orphan_field_ends
+            .iter()
+            .map(|e| (e.char_idx, e.begin_id_ref, e.field_id))
+            .collect::<Vec<_>>(),
+        &p.title_marks,
+        &p.markpen_marks,
+        &p.tab_extended,
+        // Core recomputes derived control-presence bits at XML load (#314).
+        // Only these representation-origin bits affect emitted text tokens;
+        // ordered control identities/slots are sealed independently above.
+        p.control_mask & ((1u32 << 0x18) | (1u32 << 0x1e)),
+    ))
+}
+
+fn shape_positions(p: &Paragraph) -> Vec<(u32, u32)> {
+    p.char_shapes
+        .iter()
+        .map(|v| (v.start_pos, v.char_shape_id))
+        .collect()
+}
+
+impl HwpxTextTopology {
+    fn bound(runs: Vec<SourceRun>, p: &Paragraph) -> Self {
+        Self {
+            runs,
+            owner: p.hwpx_paragraph_identity.clone(),
+            owner_value: p.hwpx_paragraph_identity.load(Relaxed),
+            reserved: Default::default(),
+            seal: seal(p),
+            invalid: None,
+        }
+    }
+
+    /// Bind to the paragraph's current identity carrier and value. Callers
+    /// must have validated the previous binding or be an explicit,
+    /// authorized reidentification.
+    fn rebind_owner(&mut self, p: &Paragraph) {
+        self.owner = p.hwpx_paragraph_identity.clone();
+        self.owner_value = p.hwpx_paragraph_identity.load(Relaxed);
+        self.reserved = Default::default();
+    }
+
+    /// Well-formed source structure outside the supported contract keeps
+    /// the document openable (viewing, other formats); HWPX export of this
+    /// paragraph fails closed with the specific cause.
+    pub(crate) fn capture(body: &str, groups: &[usize], p: &Paragraph) -> Option<Self> {
+        match Self::try_capture(body, groups, p) {
+            Ok(topology) => topology,
+            Err(why) => {
+                let mut refused = Self::bound(Vec::new(), p);
+                refused.invalid = Some(why);
+                Some(refused)
+            }
+        }
+    }
+
+    fn try_capture(body: &str, groups: &[usize], p: &Paragraph) -> Result<Option<Self>, String> {
+        let views = read_runs(body)?;
+        if views.len() != groups.len() {
+            return Err("source run occurrence mismatch".into());
+        }
+        // An empty paragraph (no text, at most the secPr/colPr template
+        // controls) whose single text-bearing run holds exactly one
+        // attribute-less empty hp:t is the writer's canonical empty line
+        // (Hancom's empty line and empty first paragraph). The IR holds all of
+        // it, and every edit's effect on that run is the intended one (typing
+        // fills it, deleting the line removes it), so it is not tracked:
+        // tracking would only refuse ordinary edits. A zero-width empty-text
+        // occurrence beside text is tracked, because unrelated formatting can
+        // merge it away (equal-neighbour shape deduplication).
+        let zero_width = |r: &RunView| {
+            r.parts.is_empty()
+                || r.parts
+                    .iter()
+                    .any(|v| matches!(&v.part, Part::Text(atoms, _) if atoms.is_empty()))
+        };
+        let text_bearing = views
+            .iter()
+            .filter(|r| r.parts.iter().any(|v| matches!(v.part, Part::Text(..))))
+            .count();
+        // One IR occurrence only: when the template secPr/colPr run and the
+        // text run differ in charPrIDRef they are two occurrences, and the
+        // writer would synthesize a text run for the template occurrence.
+        let empty_line = p.text.is_empty()
+            && p.char_shapes.len() == 1
+            && p.controls
+                .iter()
+                .all(|c| matches!(c, Control::SectionDef(_) | Control::ColumnDef(_)))
+            && text_bearing == 1
+            && views.iter().filter(|r| zero_width(r)).count() == 1
+            && views.iter().any(
+                |r| matches!(r.parts.as_slice(), [v] if v.part == Part::Text(Vec::new(), None)),
+            );
+        let sensitive = !empty_line && views.iter().any(|r| zero_width(r));
+        if !sensitive {
+            return Ok(None);
+        }
+        // An occurrence index cannot identify two owned controls after a
+        // reorder if their only persistent object identity is duplicated.
+        // Child text is deliberately not sealed (unrelated paragraph edits),
+        // so refuse this unsupported source instead of guessing ownership.
+        let mut owned = std::collections::HashSet::new();
+        for control in &p.controls {
+            let key = match control {
+                Control::Table(t) => Some(format!("table:{}", t.common.instance_id)),
+                Control::Picture(t) => Some(format!("picture:{}", t.common.instance_id)),
+                Control::Shape(t) => Some(format!("shape:{}", t.common().instance_id)),
+                Control::Equation(t) => Some(format!("equation:{}", t.common.instance_id)),
+                Control::Form(t) => Some(format!("form:{}", t.common.instance_id)),
+                Control::Footnote(t) => Some(format!("footnote:{}", t.instance_id)),
+                Control::Endnote(t) => Some(format!("endnote:{}", t.instance_id)),
+                Control::Header(t) => Some(format!("header:{:?}", t.apply_to)),
+                Control::Footer(t) => Some(format!("footer:{:?}", t.apply_to)),
+                _ => None,
+            };
+            if let Some(key) = key {
+                if !owned.insert(key) {
+                    return Err("ambiguous repeated owned-control identity".into());
+                }
+            }
+        }
+        // Two source controls with one event identity but a different source
+        // representation cannot be matched to emitted fragments by identity.
+        // Fully identical controls are interchangeable and remain supported.
+        let mut seen = std::collections::HashMap::new();
+        for view in views.iter().flat_map(|r| &r.parts) {
+            if let Part::Control(key, _) = &view.part {
+                if let Some(previous) = seen.insert(key.as_str(), view.fingerprint.as_str()) {
+                    if previous != view.fingerprint {
+                        return Err(AMBIGUOUS_CONTROL.into());
+                    }
+                }
+            }
+        }
+        let mut runs = Vec::new();
+        for (view, &group) in views.into_iter().zip(groups) {
+            if group >= p.char_shapes.len() || p.char_shapes[group].char_shape_id != view.shape {
+                return Err("source run/IR boundary mismatch".into());
+            }
+            runs.push(SourceRun {
+                group,
+                shape: view.shape,
+                parts: view.parts.into_iter().map(|x| x.part).collect(),
+            });
+        }
+        Ok(Some(Self::bound(runs, p)))
+    }
+
+    /// Identity half of `validate`: carrier pointer and numeric value. The
+    /// serializer runs it for every bound paragraph before reserving any
+    /// deferred id, so a stale carrier is refused instead of re-reserved.
+    /// A latched refusal is reported first (its specific cause), exactly as
+    /// `validate` always did.
+    pub(crate) fn validate_identity(&self, p: &Paragraph) -> Result<(), String> {
+        if let Some(why) = &self.invalid {
+            return Err(why.clone());
+        }
+        if !Arc::ptr_eq(&self.owner, &p.hwpx_paragraph_identity) {
+            return Err(OWNER_CHANGED.into());
+        }
+        // A carrier pointer alone does not prove the numeric identity: the
+        // value lives in a shared atomic cell and could change in place.
+        // Once the serializer recorded the one-time reservation of a deferred
+        // (0) identity, only that value is valid: returning to 0 must not
+        // reopen the reservation lifecycle.
+        let now = self.owner.load(Relaxed);
+        let expected = self.reserved.get().copied().unwrap_or(self.owner_value);
+        if now != expected {
+            return Err(IDENTITY_VALUE_CHANGED.into());
+        }
+        Ok(())
+    }
+
+    pub(crate) fn validate(&self, p: &Paragraph) -> Result<(), String> {
+        self.validate_identity(p)?;
+        if self.seal != seal(p) {
+            return Err(STALE.into());
+        }
+        Ok(())
+    }
+
+    /// Serializer-only: the deferred identity of this exact carrier has just
+    /// been reserved (0 -> `encoded`). Later value changes remain refused.
+    pub(crate) fn record_reservation(&self, p: &Paragraph, encoded: u64) {
+        if self.owner_value == 0 && Arc::ptr_eq(&self.owner, &p.hwpx_paragraph_identity) {
+            let _ = self.reserved.set(encoded);
+        }
+    }
+
+    /// Clipboard reidentification: a detached copy receives a new, deferred
+    /// identity carrier. Control identities are remapped separately and are
+    /// not provable here.
+    pub(crate) fn rebind_clone(&mut self, p: &Paragraph) {
+        self.rebind_owner(p);
+        if !p.controls.is_empty() {
+            self.invalidate("clipboard control identity remapping unsupported");
+        }
+    }
+
+    /// Merge undo restores the vanished paragraph's own identity value in a
+    /// new carrier (`Paragraph::apply_meta`). The caller validated the
+    /// previous binding through `before_edit`.
+    pub(crate) fn rebind_restored_identity(&mut self, p: &Paragraph) {
+        if self.invalid.is_none() {
+            self.rebind_owner(p);
+        }
+    }
+
+    pub(crate) fn invalidate(&mut self, why: &str) {
+        self.invalid.get_or_insert_with(|| why.into());
+    }
+
+    /// Called by real text commands before mutation; never bless stale inputs.
+    pub(crate) fn before_edit(p: &mut Paragraph) -> Option<Self> {
+        let mut topology = p.hwpx_text_topology.take()?;
+        if let Err(why) = topology.validate(p) {
+            topology.invalidate(&why);
+        }
+        Some(topology)
+    }
+
+    /// Keep Text event occurrences. At a t boundary, text has left affinity
+    /// within the IR-selected run; at its beginning use its first nonempty t.
+    /// In a textless run, the first explicit empty t is the edited text slot;
+    /// a bare run gets a new t as an intentional consequence of typing.
+    pub(crate) fn text_edit(
+        mut self,
+        p: &Paragraph,
+        offset: usize,
+        removed: usize,
+        inserted: &str,
+        insert_pos: u32,
+        old_shapes: &[(u32, u32)],
+    ) -> Self {
+        let shapes = shape_positions(p);
+        if shapes.len() != old_shapes.len()
+            || shapes.iter().zip(old_shapes).any(|(a, b)| a.1 != b.1)
+        {
+            self.invalidate("text edit merged or split source run occurrences");
+            return self;
+        }
+        if inserted
+            .chars()
+            .any(|c| c < ' ' || matches!(c, '\u{00a0}' | '\u{00ad}' | '\u{2007}'))
+        {
+            self.invalidate("text edit requires unsupported inline-token mapping");
+            return self;
+        }
+        let all_plain = self.runs.iter().flat_map(|r| &r.parts).all(|v| match v {
+            Part::Text(a, _) => a.iter().all(|x| x.starts_with("c:")),
+            _ => true,
+        });
+        if !all_plain {
+            self.invalidate("text edit beside inline text tokens is unsupported");
+            return self;
+        }
+        let end = offset.saturating_add(removed);
+        let mut index = 0;
+        let mut insertion = None;
+        let owner_group = shapes.iter().rposition(|x| x.0 <= insert_pos).unwrap_or(0);
+        for (ri, run) in self.runs.iter_mut().enumerate() {
+            for (pi, part) in run.parts.iter_mut().enumerate() {
+                if let Part::Text(atoms, _) = part {
+                    let start = index;
+                    index += atoms.len();
+                    if run.group == owner_group
+                        && !atoms.is_empty()
+                        && offset >= start
+                        && offset <= index
+                        && insertion.is_none()
+                    {
+                        insertion = Some((ri, pi, offset - start));
+                    }
+                    if removed != 0 {
+                        let a = offset.saturating_sub(start).min(atoms.len());
+                        let b = end.saturating_sub(start).min(atoms.len());
+                        atoms.drain(a..b);
+                    }
+                }
+            }
+        }
+        if index != p.text.chars().count() + removed - inserted.chars().count() {
+            self.invalidate("text edit visible/control projection is unsupported");
+            return self;
+        }
+        if !inserted.is_empty() {
+            let atoms: Vec<_> = inserted.chars().map(|c| format!("c:{c}")).collect();
+            if let Some((ri, pi, at)) = insertion {
+                if let Part::Text(a, _) = &mut self.runs[ri].parts[pi] {
+                    a.splice(at..at, atoms);
+                }
+            } else {
+                let candidates: Vec<_> = self
+                    .runs
+                    .iter()
+                    .enumerate()
+                    .filter(|(_, r)| {
+                        r.group == owner_group
+                            && (r.parts.is_empty()
+                                || r.parts.iter().any(|v| matches!(v, Part::Text(..))))
+                    })
+                    .map(|(i, _)| i)
+                    .collect();
+                if candidates.len() != 1 {
+                    self.invalidate("ambiguous textless run insertion ownership");
+                    return self;
+                }
+                let run = &mut self.runs[candidates[0]];
+                if let Some(Part::Text(a, _)) =
+                    run.parts.iter_mut().find(|v| matches!(v, Part::Text(..)))
+                {
+                    a.extend(atoms);
+                } else {
+                    run.parts.push(Part::Text(atoms, None));
+                }
+            }
+        }
+        self.seal = seal(p);
+        self
+    }
+
+    /// A real character-formatting command changed only `char_shape_id`
+    /// values. Supported iff every IR run occurrence keeps its index and start
+    /// position (no split/merge/relocation) and nothing but character shapes
+    /// changed during the operation. Source runs mapped to a changed
+    /// occurrence take its new shape; references are resolved at export.
+    pub(crate) fn format_edit(mut self, p: &Paragraph, old: &[CharShapeRef]) -> Self {
+        if self.invalid.is_some() {
+            return self;
+        }
+        let new = &p.char_shapes;
+        if new.len() != old.len() || new.iter().zip(old).any(|(a, b)| a.start_pos != b.start_pos) {
+            self.invalidate(FORMAT_BOUNDARY);
+            return self;
+        }
+        // before_edit proved the pre-edit seal; substituting the previous
+        // shape IDs must reproduce it exactly.
+        if seal_with(p, old) != self.seal {
+            self.invalidate(FORMAT_SCOPE);
+            return self;
+        }
+        let mut styled = false;
+        for (group, (a, b)) in new.iter().zip(old).enumerate() {
+            if a.char_shape_id == b.char_shape_id {
+                continue;
+            }
+            for run in self.runs.iter_mut().filter(|r| r.group == group) {
+                // A character style association has no defined lifetime
+                // under direct formatting; never keep it implicitly.
+                styled |= run
+                    .parts
+                    .iter()
+                    .any(|v| matches!(v, Part::Text(_, Some(_))));
+                run.shape = a.char_shape_id;
+            }
+        }
+        if styled {
+            self.invalidate(FORMAT_STYLED);
+            return self;
+        }
+        self.seal = seal(p);
+        self
+    }
+
+    /// The loader alone may clear an initial ClickHere guide while retaining
+    /// a serializer-owned GuideResidue. Boundary occurrences and shape IDs
+    /// must survive in order. Actual emission must still match every source
+    /// token/group, including the restored guide, before any bytes escape.
+    pub(crate) fn after_guide_clear(mut self, p: &Paragraph, old_shapes: &[(u32, u32)]) -> Self {
+        if p.char_shapes.len() != old_shapes.len()
+            || p.char_shapes
+                .iter()
+                .zip(old_shapes)
+                .any(|(a, b)| a.char_shape_id != b.1)
+        {
+            self.invalidate("guide normalization changed run correspondence");
+            return self;
+        }
+        let valid_guide=p.controls.iter().any(|c|matches!(c,Control::Field(f)
+            if f.field_type==super::control::FieldType::ClickHere && !f.is_dirty()
+                && f.guide_residue.as_ref().is_some_and(|r|f.guide_text().is_some_and(|g|g==r.text || g==r.text.trim_end()))));
+        if !valid_guide {
+            self.invalidate("guide normalization lacks a matching retained residue");
+            return self;
+        }
+        self.seal = seal(p);
+        self
+    }
+
+    fn partitionable(&self, p: &Paragraph) -> bool {
+        self.validate(p).is_ok()
+            && p.controls
+                .iter()
+                .all(|c| matches!(c, Control::SectionDef(_) | Control::ColumnDef(_)))
+            && self.runs.iter().all(|r| {
+                let texts: Vec<_> = r
+                    .parts
+                    .iter()
+                    .filter_map(|v| {
+                        if let Part::Text(a, _) = v {
+                            Some(a)
+                        } else {
+                            None
+                        }
+                    })
+                    .collect();
+                texts.len() <= 1
+                    && !r.parts.is_empty()
+                    && texts.iter().all(|a| a.iter().all(|s| s.starts_with("c:")))
+                    && r.parts.iter().all(|v| match v {
+                        Part::Control(k, _) => {
+                            k.starts_with("o:secPr:")
+                                || (k.starts_with("o:ctrl:") && k.contains("/colPr/"))
+                        }
+                        _ => true,
+                    })
+            })
+    }
+
+    pub(crate) fn split_edit(
+        self,
+        left: &Paragraph,
+        right: &Paragraph,
+        old: &[(u32, u32)],
+        split: u32,
+        supported: bool,
+    ) -> (Option<Self>, Option<Self>) {
+        let reject = |mut t: Self| {
+            t.invalidate("paragraph split has unsupported run correspondence");
+            (Some(t.clone()), Some(t))
+        };
+        if !supported || !right.controls.is_empty() {
+            return reject(self);
+        }
+        let mut left_old: Vec<_> = old
+            .iter()
+            .enumerate()
+            .filter(|(_, v)| v.0 < split)
+            .map(|(i, v)| (i, *v))
+            .collect();
+        let active = old.iter().rposition(|v| v.0 <= split).unwrap_or(0);
+        if left_old.is_empty() {
+            left_old.push((active, (0, old[active].1)));
+        }
+        let mut right_old: Vec<_> = old
+            .iter()
+            .enumerate()
+            .filter(|(_, v)| v.0 >= split)
+            .map(|(i, v)| (i, (v.0 - split, v.1)))
+            .collect();
+        if !right_old.iter().any(|(_, v)| v.0 == 0) {
+            right_old.insert(0, (active, (0, old[active].1)));
+        }
+        if shape_positions(left) != left_old.iter().map(|v| v.1).collect::<Vec<_>>()
+            || shape_positions(right) != right_old.iter().map(|v| v.1).collect::<Vec<_>>()
+        {
+            return reject(self);
+        }
+        let mut lr = Vec::new();
+        let mut rr = Vec::new();
+        let mut chars = 0usize;
+        for run in &self.runs {
+            let mut lp = Vec::new();
+            let mut rp = Vec::new();
+            for part in &run.parts {
+                match part {
+                    Part::Control(..) => lp.push(part.clone()),
+                    Part::Text(a, style) => {
+                        let at = left.text.chars().count().saturating_sub(chars).min(a.len());
+                        let left_has_group = left_old.iter().any(|v| v.0 == run.group);
+                        let right_has_group = right_old.iter().any(|v| v.0 == run.group);
+                        if at > 0 || (a.is_empty() && left_has_group && !right_has_group) {
+                            lp.push(Part::Text(a[..at].to_vec(), *style));
+                        }
+                        if at < a.len() || (a.is_empty() && right_has_group) {
+                            rp.push(Part::Text(a[at..].to_vec(), *style));
+                        }
+                        chars += a.len();
+                    }
+                }
+            }
+            if !lp.is_empty() {
+                let Some(group) = left_old.iter().position(|v| v.0 == run.group) else {
+                    return reject(self);
+                };
+                lr.push(SourceRun {
+                    group,
+                    shape: run.shape,
+                    parts: lp,
+                });
+            }
+            if !rp.is_empty() {
+                let Some(group) = right_old.iter().position(|v| v.0 == run.group) else {
+                    return reject(self);
+                };
+                rr.push(SourceRun {
+                    group,
+                    shape: run.shape,
+                    parts: rp,
+                });
+            }
+        }
+        if chars != left.text.chars().count() + right.text.chars().count() {
+            return reject(self);
+        }
+        let make = |runs: Vec<SourceRun>, p: &Paragraph| {
+            if runs.is_empty() {
+                None
+            } else {
+                Some(Self::bound(runs, p))
+            }
+        };
+        (make(lr, left), make(rr, right))
+    }
+
+    pub(crate) fn strip_structural(
+        mut self,
+        p: &Paragraph,
+        old: &[(u32, u32)],
+        released: u32,
+        supported: bool,
+    ) -> Self {
+        let reject = |mut t: Self| {
+            t.invalidate("clipboard structural-prefix removal has unsupported run correspondence");
+            t
+        };
+        if !supported || !p.controls.is_empty() {
+            return reject(self);
+        }
+        let first = if released == 0 {
+            0
+        } else {
+            old.iter().rposition(|v| v.0 <= released).unwrap_or(0)
+        };
+        let expected: Vec<_> = old[first..]
+            .iter()
+            .map(|(pos, id)| (pos.saturating_sub(released), *id))
+            .collect();
+        if shape_positions(p) != expected {
+            return reject(self);
+        }
+        for run in &mut self.runs {
+            run.parts.retain(|v| !matches!(v, Part::Control(..)));
+        }
+        self.runs.retain(|r| !r.parts.is_empty());
+        for run in &mut self.runs {
+            if run.group < first {
+                return reject(self);
+            }
+            run.group -= first;
+        }
+        self.seal = seal(p);
+        self
+    }
+
+    pub(crate) fn can_split(&self, p: &Paragraph) -> bool {
+        self.partitionable(p)
+    }
+
+    fn generated_plain(p: &Paragraph) -> Option<Self> {
+        if !p.controls.is_empty()
+            || !p.field_ranges.is_empty()
+            || !p.title_marks.is_empty()
+            || !p.markpen_marks.is_empty()
+            || p.char_shapes.is_empty()
+        {
+            return None;
+        }
+        let chars: Vec<_> = p.text.chars().collect();
+        let mut runs = Vec::new();
+        for (group, shape) in p.char_shapes.iter().enumerate() {
+            let from = if group == 0 {
+                0
+            } else {
+                p.char_offsets.partition_point(|v| *v < shape.start_pos)
+            };
+            let to = p.char_shapes.get(group + 1).map_or(chars.len(), |v| {
+                p.char_offsets.partition_point(|x| *x < v.start_pos)
+            });
+            if from > to || to > chars.len() {
+                return None;
+            }
+            runs.push(SourceRun {
+                group,
+                shape: shape.char_shape_id,
+                parts: vec![Part::Text(
+                    chars[from..to].iter().map(|c| format!("c:{c}")).collect(),
+                    None,
+                )],
+            });
+        }
+        Some(Self::bound(runs, p))
+    }
+
+    pub(crate) fn before_merge(
+        left: &mut Paragraph,
+        right: &Paragraph,
+    ) -> Option<(Self, Option<Self>, Vec<(u32, u32)>, Vec<(u32, u32)>)> {
+        if left.hwpx_text_topology.is_none() && right.hwpx_text_topology.is_none() {
+            return None;
+        }
+        let l = Self::before_edit(left).or_else(|| Self::generated_plain(left));
+        let mut r = right
+            .hwpx_text_topology
+            .clone()
+            .or_else(|| Self::generated_plain(right));
+        if let Some(t) = &mut r {
+            if let Err(e) = t.validate(right) {
+                t.invalidate(&e);
+            }
+        }
+        let mut l = l.unwrap_or_else(|| right.hwpx_text_topology.as_ref().unwrap().clone());
+        if !l.partitionable(left) || !right.controls.is_empty() || r.is_none() {
+            l.invalidate("paragraph merge has unsupported run correspondence");
+        }
+        Some((l, r, shape_positions(left), shape_positions(right)))
+    }
+
+    pub(crate) fn merge_edit(
+        mut self,
+        right: Option<Self>,
+        p: &Paragraph,
+        left_shapes: &[(u32, u32)],
+        right_shapes: &[(u32, u32)],
+        shift: u32,
+    ) -> Self {
+        let reject = |mut t: Self| {
+            t.invalidate("paragraph merge has unsupported run correspondence");
+            t
+        };
+        let Some(right) = right else {
+            return reject(self);
+        };
+        if right.invalid.is_some() || self.invalid.is_some() {
+            return reject(self);
+        }
+        let mut expected = left_shapes.to_vec();
+        let mut map = Vec::new();
+        for &(pos, shape) in right_shapes {
+            let v = (pos + shift, shape);
+            // A deduplicated occurrence cannot retain two source run identities.
+            if expected.last() == Some(&v) {
+                return reject(self);
+            }
+            map.push(expected.len());
+            expected.push(v);
+        }
+        if shape_positions(p) != expected {
+            return reject(self);
+        }
+        for mut run in right.runs {
+            let Some(&group) = map.get(run.group) else {
+                return reject(self);
+            };
+            run.group = group;
+            self.runs.push(run);
+        }
+        self.seal = seal(p);
+        self.rebind_owner(p);
+        self
+    }
+
+    /// Validate the actually generated runs against the source occurrences
+    /// and replay the source text-element topology around generated tokens.
+    /// Returns the restored runs and every emitted `charStyleIDRef`, which the
+    /// caller must register as style references for package validation.
+    pub(crate) fn restore(
+        &self,
+        p: &Paragraph,
+        xml: &str,
+        template: bool,
+    ) -> Result<(String, Vec<u16>), String> {
+        self.validate(p)?;
+        let generated = read_runs(xml)?;
+        let group_count = p.char_shapes.len();
+        if generated.len() != group_count + usize::from(template) {
+            return Err("emitted run occurrence count does not match parser boundary plan".into());
+        }
+        // [#6869] The serializer emits only the first hp:pageNum of a
+        // paragraph render scope and folds every later one to nothing,
+        // whatever its attributes. That deliberate normalization is the only
+        // mapped control removal; the folded source events are not replayed.
+        let mut seen_page_num = false;
+        let folded: Vec<Vec<bool>> = self
+            .runs
+            .iter()
+            .map(|r| {
+                r.parts
+                    .iter()
+                    .map(|v| {
+                        matches!(v, Part::Control(_, true))
+                            && std::mem::replace(&mut seen_page_num, true)
+                    })
+                    .collect()
+            })
+            .collect();
+        let mut result = String::new();
+        let mut styles = Vec::new();
+        for group in 0..group_count {
+            let source: Vec<_> = self
+                .runs
+                .iter()
+                .enumerate()
+                .filter(|(_, r)| r.group == group)
+                .collect();
+            if source.is_empty() {
+                return Err("missing source run occurrence".into());
+            }
+            let start = if template && group == 0 {
+                0
+            } else {
+                group + usize::from(template)
+            };
+            let stop = group + 1 + usize::from(template);
+            let mut tokens = Vec::new();
+            for view in &generated[start..stop] {
+                if view.shape != p.char_shapes[group].char_shape_id {
+                    return Err("emitted charPrIDRef differs from mapped occurrence".into());
+                }
+                for part in &view.parts {
+                    match &part.part {
+                        Part::Text(_, Some(_)) => {
+                            return Err(
+                                "emitted hp:t attribute is not owned by the source topology".into(),
+                            )
+                        }
+                        Part::Text(keys, None) => {
+                            for (key, xml) in keys.iter().zip(&part.atoms) {
+                                tokens.push((key.clone(), xml.clone()));
+                            }
+                        }
+                        Part::Control(key, _) => tokens.push((key.clone(), part.xml.clone())),
+                    }
+                }
+            }
+            let mut expected = Vec::new();
+            for &(ri, run) in &source {
+                for (pi, v) in run.parts.iter().enumerate() {
+                    match v {
+                        Part::Text(a, _) => expected.extend(a.iter().cloned()),
+                        Part::Control(k, _) if !folded[ri][pi] => expected.push(k.clone()),
+                        Part::Control(..) => {}
+                    }
+                }
+            }
+            if expected.iter().ne(tokens.iter().map(|t| &t.0)) {
+                return Err(format!(
+                    "emitted text/control event order differs in IR run occurrence {group}"
+                ));
+            }
+            let mut at = 0;
+            for (ri, run) in source {
+                result.push_str(&format!(r#"<hp:run charPrIDRef="{}">"#, run.shape));
+                for (pi, part) in run.parts.iter().enumerate() {
+                    match part {
+                        Part::Text(a, style) => {
+                            match style {
+                                Some(s) => {
+                                    styles.push(*s);
+                                    result.push_str(&format!(r#"<hp:t charStyleIDRef="{s}">"#));
+                                }
+                                None => result.push_str("<hp:t>"),
+                            }
+                            for _ in a {
+                                result.push_str(&tokens[at].1);
+                                at += 1;
+                            }
+                            result.push_str("</hp:t>");
+                        }
+                        Part::Control(..) if folded[ri][pi] => {}
+                        Part::Control(..) => {
+                            result.push_str(&tokens[at].1);
+                            at += 1;
+                        }
+                    }
+                }
+                result.push_str("</hp:run>");
+            }
+        }
+        Ok((result, styles))
+    }
+}
+
+struct ViewPart {
+    part: Part,
+    atoms: Vec<String>,
+    xml: String,
+    /// Full source representation of a control (element names and all
+    /// attributes of the ctrl and its direct children) for ambiguity checks.
+    fingerprint: String,
+}
+struct RunView {
+    shape: u32,
+    parts: Vec<ViewPart>,
+}
+
+fn local(name: &str) -> &str {
+    name.rsplit(':').next().unwrap_or(name)
+}
+fn escaped(s: &str) -> String {
+    quick_xml::escape::escape(s).into_owned()
+}
+
+fn attributes(e: &quick_xml::events::BytesStart<'_>) -> Result<Vec<(String, String)>, String> {
+    let mut attrs = Vec::new();
+    for a in e.attributes() {
+        let a = a.map_err(|e| e.to_string())?;
+        attrs.push((
+            a.key.as_ref().to_string(),
+            a.normalized_value(quick_xml::XmlVersion::Implicit1_0)
+                .map_err(|e| e.to_string())?
+                .into_owned(),
+        ));
+    }
+    attrs.sort();
+    Ok(attrs)
+}
+
+/// Stable ownership identity shared by every control kind.
+const OWNERSHIP: [&str; 3] = ["id", "beginIDRef", "fieldid"];
+
+/// Emitted event identity of a direct `hp:ctrl` child: attributes that
+/// distinguish otherwise equal controls and that RHWP emits from the model
+/// unchanged (verified against the 734-document corpus). Deliberately not
+/// identity: serializer-normalized representation (fieldBegin
+/// dirty/zorder/metaTag, footNote instId/suffixChar, colPr type) and
+/// descendants (formats, parameters, sub-lists), whose bytes always come from
+/// the generated fragment. Unlisted kinds use ownership identity only and
+/// rely on the ambiguity check.
+fn event_attrs(element: &str) -> &'static [&'static str] {
+    match element {
+        "pageNum" => &["pos", "formatType", "sideChar"],
+        "autoNum" | "newNum" => &["num", "numType"],
+        "bookmark" => &["name"],
+        "fieldBegin" => &["type", "name"],
+        "header" | "footer" => &["applyPageType"],
+        "footNote" | "endNote" => &["number"],
+        "pageHiding" => &[
+            "hideHeader",
+            "hideFooter",
+            "hideMasterPage",
+            "hideBorder",
+            "hideFill",
+            "hidePageNum",
+        ],
+        "colPr" => &["layout", "colCount", "sameSz", "sameGap"],
+        _ => &[],
+    }
+}
+
+fn identity_attrs(e: &quick_xml::events::BytesStart<'_>, element: &str) -> Result<String, String> {
+    let event = event_attrs(element);
+    let attrs: Vec<_> = attributes(e)?
+        .into_iter()
+        .filter(|(k, _)| OWNERSHIP.contains(&k.as_str()) || event.contains(&k.as_str()))
+        .collect();
+    Ok(format!("{attrs:?}"))
+}
+
+/// Inline text tokens are positional events; their layout attributes (tab
+/// width/leader/type, markpen color, ...) are emitted from the model and
+/// sealed there. Only ownership identifiers distinguish them.
+fn inline_key(e: &quick_xml::events::BytesStart<'_>) -> Result<String, String> {
+    let attrs: Vec<_> = attributes(e)?
+        .into_iter()
+        .filter(|(k, _)| matches!(k.as_str(), "id" | "Id" | "TcId"))
+        .collect();
+    Ok(format!("i:{}:{attrs:?}", local(e.name().as_ref())))
+}
+
+/// `hp:t@charStyleIDRef` is the only supported text-element attribute and
+/// must be a canonical style index (resolved against the header at export).
+fn text_style(e: &quick_xml::events::BytesStart<'_>) -> Result<Option<u16>, String> {
+    let attrs = attributes(e)?;
+    match attrs.as_slice() {
+        [] => Ok(None),
+        [(k, v)] if k == "charStyleIDRef" => match v.parse::<u16>() {
+            Ok(n) if n.to_string() == *v => Ok(Some(n)),
+            _ => Err("invalid hp:t charStyleIDRef".into()),
+        },
+        _ => Err("unsupported hp:t attributes".into()),
+    }
+}
+
+/// Read direct run children only. Controls remain opaque generated fragments;
+/// their owning occurrence and classified identity/order are verified, never
+/// copied from source. Nested paragraphs are handled by their own renderer
+/// invocation.
+fn read_runs(xml: &str) -> Result<Vec<RunView>, String> {
+    let mut reader = Reader::from_str(xml);
+    let mut runs = Vec::new();
+    let mut run: Option<RunView> = None;
+    loop {
+        let before = reader.buffer_position() as usize;
+        let event = reader.read_event().map_err(|e| e.to_string())?;
+        match event {
+            Event::Start(ref e) | Event::Empty(ref e) if local(e.name().as_ref()) == "run" => {
+                if run.is_some() {
+                    return Err("nested run outside an opaque control".into());
+                }
+                let shape = e
+                    .attributes()
+                    .collect::<Result<Vec<_>, _>>()
+                    .map_err(|e| e.to_string())?
+                    .iter()
+                    .find(|a| a.key.as_ref() == "charPrIDRef")
+                    .ok_or("run without charPrIDRef")?
+                    .normalized_value(quick_xml::XmlVersion::Implicit1_0)
+                    .map_err(|e| e.to_string())?
+                    .parse()
+                    .map_err(|_| "invalid charPrIDRef")?;
+                if e.attributes().count() != 1 {
+                    return Err("unsupported run attributes".into());
+                }
+                let v = RunView {
+                    shape,
+                    parts: Vec::new(),
+                };
+                if matches!(event, Event::Empty(_)) {
+                    runs.push(v);
+                } else {
+                    run = Some(v);
+                }
+            }
+            Event::Start(ref e) | Event::Empty(ref e) if run.is_some() => {
+                let empty = matches!(event, Event::Empty(_));
+                if local(e.name().as_ref()) == "t" {
+                    let style = text_style(e)?;
+                    let mut keys = Vec::new();
+                    let mut atoms = Vec::new();
+                    if !empty {
+                        loop {
+                            let a = reader.buffer_position() as usize;
+                            match reader.read_event().map_err(|e| e.to_string())? {
+                                Event::End(ref e) if local(e.name().as_ref()) == "t" => break,
+                                Event::Text(t) => {
+                                    for c in t.as_ref().chars() {
+                                        keys.push(format!("c:{c}"));
+                                        atoms.push(escaped(&c.to_string()));
+                                    }
+                                }
+                                Event::CData(t) => {
+                                    for c in t.as_ref().chars() {
+                                        keys.push(format!("c:{c}"));
+                                        atoms.push(escaped(&c.to_string()));
+                                    }
+                                }
+                                Event::GeneralRef(r) => {
+                                    let value = format!("&{};", r.as_ref());
+                                    let text = quick_xml::escape::unescape(&value)
+                                        .map_err(|e| e.to_string())?;
+                                    for c in text.chars() {
+                                        keys.push(format!("c:{c}"));
+                                        atoms.push(escaped(&c.to_string()));
+                                    }
+                                }
+                                Event::Empty(ref e) => {
+                                    keys.push(inline_key(e)?);
+                                    atoms.push(xml[a..reader.buffer_position() as usize].into());
+                                }
+                                Event::Eof => return Err("unterminated hp:t".into()),
+                                _ => return Err("unsupported nested text markup".into()),
+                            }
+                        }
+                    }
+                    run.as_mut().unwrap().parts.push(ViewPart {
+                        part: Part::Text(keys, style),
+                        atoms,
+                        xml: String::new(),
+                        fingerprint: String::new(),
+                    });
+                } else {
+                    let name = local(e.name().as_ref()).to_string();
+                    // Only classified identity attributes. Lexical attribute
+                    // order and normalized representation are not identity.
+                    let id = attributes(e)?
+                        .into_iter()
+                        .find(|(k, _)| k == "id")
+                        .map(|(_, v)| v);
+                    let mut key = format!("o:{name}:{id:?}");
+                    let mut fingerprint = format!("{name}{:?}", attributes(e)?);
+                    let mut children = Vec::new();
+                    if !empty {
+                        let mut depth = 1;
+                        // Ambiguity fingerprint of the whole ctrl subtree, compared
+                        // among source controls only (never against normalized
+                        // emitted output). Character data is fingerprinted as its
+                        // semantic value: text, CDATA and references are joined
+                        // after unescaping. A leaf element's value is kept even when
+                        // empty or whitespace-only (e.g. stringParam " " vs "  ");
+                        // whitespace between structural children is formatting.
+                        // `<a/>` and `<a></a>` are the same element.
+                        let mut value = String::new();
+                        let mut leaf = false;
+                        let mut flush =
+                            |fingerprint: &mut String, value: &mut String, leaf: bool| {
+                                if !value.is_empty() && (leaf || !value.trim().is_empty()) {
+                                    fingerprint.push_str(&format!("/text{value:?}"));
+                                }
+                                value.clear();
+                            };
+                        while depth > 0 {
+                            let child = reader.read_event().map_err(|e| e.to_string())?;
+                            match child {
+                                Event::Start(ref ce) | Event::Empty(ref ce) => {
+                                    let element = local(ce.name().as_ref()).to_string();
+                                    if name == "ctrl" {
+                                        flush(&mut fingerprint, &mut value, false);
+                                        fingerprint.push_str(&format!(
+                                            "/{depth}:{element}{:?}",
+                                            attributes(ce)?
+                                        ));
+                                    }
+                                    if depth == 1 && name == "ctrl" {
+                                        key.push_str(&format!(
+                                            "/{element}/{}",
+                                            identity_attrs(ce, &element)?
+                                        ));
+                                        children.push(element);
+                                    }
+                                    if matches!(child, Event::Start(_)) {
+                                        depth += 1;
+                                        leaf = true;
+                                    } else {
+                                        if name == "ctrl" {
+                                            fingerprint.push_str(&format!("/{depth}:end"));
+                                        }
+                                        leaf = false;
+                                    }
+                                }
+                                Event::End(_) => {
+                                    if name == "ctrl" {
+                                        flush(&mut fingerprint, &mut value, leaf);
+                                    }
+                                    depth -= 1;
+                                    leaf = false;
+                                    if name == "ctrl" {
+                                        fingerprint.push_str(&format!("/{depth}:end"));
+                                    }
+                                }
+                                Event::Text(ref t) if name == "ctrl" => value.push_str(t.as_ref()),
+                                Event::CData(ref t) if name == "ctrl" => value.push_str(t.as_ref()),
+                                Event::GeneralRef(ref r) if name == "ctrl" => {
+                                    let reference = format!("&{};", r.as_ref());
+                                    let text = quick_xml::escape::unescape(&reference)
+                                        .map_err(|e| e.to_string())?;
+                                    value.push_str(&text);
+                                }
+                                Event::Eof => return Err("unterminated control".into()),
+                                _ => {}
+                            }
+                        }
+                    }
+                    let page_num = name == "ctrl" && children == ["pageNum"];
+                    run.as_mut().unwrap().parts.push(ViewPart {
+                        part: Part::Control(key, page_num),
+                        atoms: Vec::new(),
+                        xml: xml[before..reader.buffer_position() as usize].into(),
+                        fingerprint,
+                    });
+                }
+            }
+            Event::End(ref e) if local(e.name().as_ref()) == "run" => {
+                runs.push(run.take().ok_or("unmatched run end")?);
+            }
+            Event::Eof => break,
+            Event::Text(t) if t.as_ref().trim().is_empty() => {}
+            _ => return Err("unsupported event between run elements".into()),
+        }
+    }
+    if run.is_some() {
+        return Err("unterminated run".into());
+    }
+    Ok(runs)
+}
