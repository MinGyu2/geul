+#[test]
+fn empty_text_unique_control_run_slot_can_be_edited_without_guessing_run() {
+    let ctrl =
+        r#"<hp:ctrl><hp:pageNum pos="BOTTOM_CENTER" formatType="DIGIT" sideChar="-"/></hp:ctrl>"#;
+    let mut p = imported(&r(&format!("{ctrl}<hp:t/>")));
+    p.insert_text_at(0, "한글");
+    assert_eq!(render(&p).unwrap(), r(&format!("{ctrl}<hp:t>한글</hp:t>")));
+    // The same visible offset before a control is not the same event anchor.
+    let mut p = imported(&r(&format!("<hp:t/>{ctrl}")));
+    p.insert_text_at(0, "한글");
+    assert_eq!(
+        render(&p).unwrap_err(),
+        "emitted text/control event order differs in IR run occurrence 0"
+    );
+}
