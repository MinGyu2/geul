+#[test]
+fn empty_text_same_carrier_identity_value_mutation_is_refused() {
+    use std::sync::atomic::Ordering::Relaxed;
+    let p = imported(&r("<hp:t>A</hp:t><hp:t/>"));
+    assert_eq!(p.hwpx_paragraph_identity.load(Relaxed), 8);
+    assert!(render(&p).is_ok());
+    let carrier = std::sync::Arc::as_ptr(&p.hwpx_paragraph_identity);
+    // Another valid numeric id inside the SAME identity carrier; nothing else changes.
+    p.hwpx_paragraph_identity.store(43, Relaxed);
+    assert_eq!(carrier, std::sync::Arc::as_ptr(&p.hwpx_paragraph_identity));
+    assert_eq!(render(&p).unwrap_err(), IDENTITY_VALUE_CHANGED);
+
+    // Full package path through the real loader and exporter.
+    let bytes = package_with(&para(7, &r("<hp:t>A</hp:t><hp:t/>")));
+    let core = crate::document_core::DocumentCore::from_bytes(&bytes).unwrap();
+    let first = core.export_hwpx_native().unwrap();
+    assert_eq!(core.export_hwpx_native().unwrap(), first);
+    let target = &core.document.sections[0].paragraphs[1];
+    assert_eq!(target.hwpx_paragraph_identity.load(Relaxed), 8);
+    target.hwpx_paragraph_identity.store(43, Relaxed);
+    let e = export_error(&core);
+    assert!(e.contains(IDENTITY_VALUE_CHANGED), "{e}");
