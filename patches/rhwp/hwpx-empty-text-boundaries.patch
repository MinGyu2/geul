+#[test]
+fn empty_text_meaningful_nested_whitespace_is_control_identity() {
+    use crate::model::hwpx_topology::AMBIGUOUS_CONTROL;
+    // One vs two spaces, empty vs one space: different effective values.
+    for (x, y) in [(" ", "  "), ("", " ")] {
+        let (a, b) = (click_here(x), click_here(y));
+        let p = imported(&r(&format!("{a}<hp:t/>{b}")));
