+            "{x:?}/{y:?}"
+        );
+    }
+    // Real package path: refused without bytes.
+    let source = r(&format!("{}<hp:t/>{}", click_here(" "), click_here("  ")));
+    let core = core_of(&para(7, &source));
+    assert!(export_error(&core).ends_with("ambiguous control event identity"));
