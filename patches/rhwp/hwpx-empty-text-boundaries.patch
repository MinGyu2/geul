+#[test]
+fn empty_text_core_control_mask_normalization_is_not_a_slot_edit() {
+    let ctrl =
+        r#"<hp:ctrl><hp:pageNum pos="BOTTOM_CENTER" formatType="DIGIT" sideChar="-"/></hp:ctrl>"#;
+    let source = r(&format!("<hp:t/>{ctrl}<hp:t/>"));
+    let mut p = imported(&source);
+    p.control_mask |= 1u32 << 0x15; // Actual XML-load presence-mask normalization.
+    assert_eq!(render(&p).unwrap(), explicit(&source));
+    p.control_mask |= 1u32 << 0x18; // This bit changes text representation, so seal it.
+    assert_eq!(
+        render(&p).unwrap_err(),
+        "stale text, formatting or control-slot anchors"
+    );
+}
