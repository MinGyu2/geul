+#[test]
+fn empty_text_equivalent_nested_spelling_is_not_ambiguous() {
+    let base = click_here(" ");
+    // Character reference and CDATA spell the same one-space value.
+    for same in [
+        click_here("&#x20;"),
+        click_here("<![CDATA[ ]]>"),
+        base.clone(),
+    ] {
+        assert!(not_ambiguous(&base, &same), "{same}");
+    }
+    // Empty element vs explicit empty pair.
+    let empty = click_here("");
+    let self_closing = empty.replace(
+        r#"xml:space="preserve"></hp:stringParam>"#,
+        r#"xml:space="preserve"/>"#,
+    );
+    assert!(not_ambiguous(&empty, &self_closing));
+    // Indentation between structural children is not a value.
+    let indented = base
+        .replace("<hp:parameters", "\n  <hp:parameters")
+        .replace("<hp:stringParam", "\n    <hp:stringParam")
+        .replace("</hp:parameters>", "\n  </hp:parameters>\n");
+    assert!(not_ambiguous(&base, &indented));
+    // Different values stay ambiguous at the same level.
+    assert!(!not_ambiguous(&base, &click_here("  ")));
+    assert!(!not_ambiguous(&click_here(""), &base));
+}
