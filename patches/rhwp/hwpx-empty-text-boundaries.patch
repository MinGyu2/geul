+//! Paragraph-owned HWPX zero-width topology. No source XML is retained.
+//!
+//! A source run occurrence is mapped to the parser's boundary occurrence, not
+//! looked up by shape or offset. Only the explicit secPr handoff may share an
+//! IR occurrence. Actual emitted tokens must match each group before replay.
+use std::sync::{atomic::AtomicU64, Arc};
+
+use quick_xml::{events::Event, Reader};
+
+use super::{control::Control, paragraph::Paragraph, raw_provenance::record_digest};
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) enum Part {
+    Text(Vec<String>),
+    Control(String),
+}
+
+#[derive(Debug, Clone)]
+pub(crate) struct SourceRun {
+    pub group: usize,
+    pub shape: u32,
+    pub parts: Vec<Part>,
+}
+
+#[derive(Debug, Clone)]
+pub struct HwpxTextTopology {
+    pub(crate) runs: Vec<SourceRun>,
+    owner: Arc<AtomicU64>,
+    seal: [u8; 32],
+    invalid: Option<String>,
+}
+
+// Persisted positional inputs only. Layout caches are deliberately excluded.
+// Child paragraphs own their own seals: editing a table cell does not stale
+// the parent's control slot. Stable object identities and ordered variants
+// protect that slot from replacement/reordering.
+fn seal(p: &Paragraph) -> [u8; 32] {
+    let controls: Vec<_> = p
+        .controls
+        .iter()
+        .map(|c| match c {
+            Control::Table(t) => format!("table:{}", t.common.instance_id),
+            Control::Picture(t) => format!(
+                "picture:{}:{}",
+                t.common.instance_id, t.image_attr.bin_data_id
+            ),
+            Control::Shape(t) => format!("shape:{}", t.common().instance_id),
+            Control::Equation(t) => format!("equation:{}", t.common.instance_id),
+            Control::Form(t) => format!("form:{}", t.common.instance_id),
+            Control::Header(t) => format!("header:{:?}", t.apply_to),
+            Control::Footer(t) => format!("footer:{:?}", t.apply_to),
+            Control::Footnote(t) => format!("footnote:{}", t.instance_id),
+            Control::Endnote(t) => format!("endnote:{}", t.instance_id),
+            Control::SectionDef(_) => "section".into(),
+            other => format!("{:x?}", record_digest(other)),
+        })
+        .collect();
+    record_digest(&(
+        &p.text,
+        &p.char_offsets,
+        &p.char_shapes,
+        p.char_count,
+        &controls,
+        &p.field_ranges,
+        // Cross-paragraph linking fills the HWP5-only begin_ctrl_id later.
+        // HWPX emits only these original positions and XML reference IDs.
+        p.orphan_field_ends
+            .iter()
+            .map(|e| (e.char_idx, e.begin_id_ref, e.field_id))
+            .collect::<Vec<_>>(),
+        &p.title_marks,
+        &p.markpen_marks,
+        &p.tab_extended,
+        // Core recomputes derived control-presence bits at XML load (#314).
+        // Only these representation-origin bits affect emitted text tokens;
+        // ordered control identities/slots are sealed independently above.
+        p.control_mask & ((1u32 << 0x18) | (1u32 << 0x1e)),
+    ))
+}
+
+impl HwpxTextTopology {
+    pub(crate) fn capture(
+        body: &str,
+        groups: &[usize],
+        p: &Paragraph,
+    ) -> Result<Option<Self>, String> {
+        let views = read_runs(body)?;
+        let sensitive = views.iter().any(|r| {
+            r.parts.is_empty()
+                || r.parts
+                    .iter()
+                    .any(|v| matches!(&v.part, Part::Text(atoms) if atoms.is_empty()))
+        });
+        // An occurrence index cannot identify two owned controls after a
+        // reorder if their only persistent object identity is duplicated.
+        // Child text is deliberately not sealed (unrelated paragraph edits),
+        // so refuse this unsupported source instead of guessing ownership.
+        let mut owned = std::collections::HashSet::new();
+        for control in &p.controls {
+            let key = match control {
+                Control::Table(t) => Some(format!("table:{}", t.common.instance_id)),
+                Control::Picture(t) => Some(format!("picture:{}", t.common.instance_id)),
+                Control::Shape(t) => Some(format!("shape:{}", t.common().instance_id)),
+                Control::Equation(t) => Some(format!("equation:{}", t.common.instance_id)),
+                Control::Form(t) => Some(format!("form:{}", t.common.instance_id)),
+                Control::Footnote(t) => Some(format!("footnote:{}", t.instance_id)),
+                Control::Endnote(t) => Some(format!("endnote:{}", t.instance_id)),
+                Control::Header(t) => Some(format!("header:{:?}", t.apply_to)),
+                Control::Footer(t) => Some(format!("footer:{:?}", t.apply_to)),
+                _ => None,
+            };
+            if let Some(key) = key {
+                if !owned.insert(key) {
+                    return Err("ambiguous repeated owned-control identity".into());
+                }
+            }
+        }
+        if views.len() != groups.len() {
+            return Err("source run occurrence mismatch".into());
+        }
+        if !sensitive {
+            return Ok(None);
+        }
+        let mut runs = Vec::new();
+        for (view, &group) in views.into_iter().zip(groups) {
+            if group >= p.char_shapes.len() || p.char_shapes[group].char_shape_id != view.shape {
+                return Err("source run/IR boundary mismatch".into());
+            }
+            runs.push(SourceRun {
+                group,
+                shape: view.shape,
+                parts: view.parts.into_iter().map(|x| x.part).collect(),
+            });
+        }
+        Ok(Some(Self {
+            runs,
+            owner: p.hwpx_paragraph_identity.clone(),
+            seal: seal(p),
+            invalid: None,
+        }))
+    }
+
+    pub(crate) fn validate(&self, p: &Paragraph) -> Result<(), String> {
+        if let Some(why) = &self.invalid {
+            return Err(why.clone());
+        }
+        if !Arc::ptr_eq(&self.owner, &p.hwpx_paragraph_identity) {
+            return Err("paragraph owner changed without a supported clone mapping".into());
+        }
+        if self.seal != seal(p) {
+            return Err("stale text, formatting or control-slot anchors".into());
+        }
+        Ok(())
+    }
+
+    pub(crate) fn rebind_clone(&mut self, p: &Paragraph) {
+        self.owner = p.hwpx_paragraph_identity.clone();
+        if !p.controls.is_empty() {
+            self.invalidate("clipboard control identity remapping unsupported");
+        }
+    }
+
+    pub(crate) fn invalidate(&mut self, why: &str) {
+        self.invalid.get_or_insert_with(|| why.into());
+    }
+
+    /// Called by real text commands before mutation; never bless stale inputs.
+    pub(crate) fn before_edit(p: &mut Paragraph) -> Option<Self> {
+        let mut topology = p.hwpx_text_topology.take()?;
+        if let Err(why) = topology.validate(p) {
+            topology.invalidate(&why);
+        }
+        Some(topology)
+    }
+
+    /// Keep Text event occurrences. At a t boundary, text has left affinity
+    /// within the IR-selected run; at its beginning use its first nonempty t.
+    /// In a textless run, the first explicit empty t is the edited text slot;
+    /// a bare run gets a new t as an intentional consequence of typing.
+    pub(crate) fn text_edit(
+        mut self,
+        p: &Paragraph,
+        offset: usize,
+        removed: usize,
+        inserted: &str,
+        insert_pos: u32,
+        old_shapes: &[(u32, u32)],
+    ) -> Self {
+        let shapes: Vec<_> = p
+            .char_shapes
+            .iter()
+            .map(|c| (c.start_pos, c.char_shape_id))
+            .collect();
+        if shapes.len() != old_shapes.len()
+            || shapes.iter().zip(old_shapes).any(|(a, b)| a.1 != b.1)
+        {
+            self.invalidate("text edit merged or split source run occurrences");
+            return self;
+        }
+        if inserted
+            .chars()
+            .any(|c| c < ' ' || matches!(c, '\u{00a0}' | '\u{00ad}' | '\u{2007}'))
+        {
+            self.invalidate("text edit requires unsupported inline-token mapping");
+            return self;
+        }
+        let all_plain = self.runs.iter().flat_map(|r| &r.parts).all(|v| match v {
+            Part::Text(a) => a.iter().all(|x| x.starts_with("c:")),
+            _ => true,
+        });
+        if !all_plain {
+            self.invalidate("text edit beside inline text tokens is unsupported");
+            return self;
+        }
+        let end = offset.saturating_add(removed);
+        let mut index = 0;
+        let mut insertion = None;
+        let owner_group = shapes.iter().rposition(|x| x.0 <= insert_pos).unwrap_or(0);
+        for (ri, run) in self.runs.iter_mut().enumerate() {
+            for (pi, part) in run.parts.iter_mut().enumerate() {
+                if let Part::Text(atoms) = part {
+                    let start = index;
+                    index += atoms.len();
+                    if run.group == owner_group
+                        && !atoms.is_empty()
+                        && offset >= start
+                        && offset <= index
+                        && insertion.is_none()
+                    {
+                        insertion = Some((ri, pi, offset - start));
+                    }
+                    if removed != 0 {
+                        let a = offset.saturating_sub(start).min(atoms.len());
+                        let b = end.saturating_sub(start).min(atoms.len());
+                        atoms.drain(a..b);
+                    }
+                }
+            }
+        }
+        if index != p.text.chars().count() + removed - inserted.chars().count() {
+            self.invalidate("text edit visible/control projection is unsupported");
+            return self;
+        }
+        if !inserted.is_empty() {
+            let atoms: Vec<_> = inserted.chars().map(|c| format!("c:{c}")).collect();
+            if let Some((ri, pi, at)) = insertion {
+                if let Part::Text(a) = &mut self.runs[ri].parts[pi] {
+                    a.splice(at..at, atoms);
+                }
+            } else {
+                let candidates: Vec<_> = self
+                    .runs
+                    .iter()
+                    .enumerate()
+                    .filter(|(_, r)| {
+                        r.group == owner_group
+                            && (r.parts.is_empty()
+                                || r.parts.iter().any(|v| matches!(v, Part::Text(_))))
+                    })
+                    .map(|(i, _)| i)
+                    .collect();
+                if candidates.len() != 1 {
+                    self.invalidate("ambiguous textless run insertion ownership");
+                    return self;
+                }
+                let run = &mut self.runs[candidates[0]];
+                if let Some(Part::Text(a)) =
+                    run.parts.iter_mut().find(|v| matches!(v, Part::Text(_)))
+                {
+                    a.extend(atoms);
+                } else {
+                    run.parts.push(Part::Text(atoms));
+                }
+            }
+        }
+        self.seal = seal(p);
+        self
+    }
+
+    /// The loader alone may clear an initial ClickHere guide while retaining
+    /// a serializer-owned GuideResidue. Boundary occurrences and shape IDs
+    /// must survive in order. Actual emission must still match every source
+    /// token/group, including the restored guide, before any bytes escape.
+    pub(crate) fn after_guide_clear(mut self, p: &Paragraph, old_shapes: &[(u32, u32)]) -> Self {
+        if p.char_shapes.len() != old_shapes.len()
+            || p.char_shapes
+                .iter()
+                .zip(old_shapes)
+                .any(|(a, b)| a.char_shape_id != b.1)
+        {
+            self.invalidate("guide normalization changed run correspondence");
+            return self;
+        }
+        let valid_guide=p.controls.iter().any(|c|matches!(c,Control::Field(f)
+            if f.field_type==super::control::FieldType::ClickHere && !f.is_dirty()
+                && f.guide_residue.as_ref().is_some_and(|r|f.guide_text().is_some_and(|g|g==r.text || g==r.text.trim_end()))));
+        if !valid_guide {
+            self.invalidate("guide normalization lacks a matching retained residue");
+            return self;
+        }
+        self.seal = seal(p);
+        self
+    }
+
+    fn partitionable(&self, p: &Paragraph) -> bool {
+        self.validate(p).is_ok()
+            && p.controls
+                .iter()
+                .all(|c| matches!(c, Control::SectionDef(_) | Control::ColumnDef(_)))
+            && self.runs.iter().all(|r| {
+                let texts: Vec<_> = r
+                    .parts
+                    .iter()
+                    .filter_map(|v| if let Part::Text(a) = v { Some(a) } else { None })
+                    .collect();
+                texts.len() <= 1
+                    && !r.parts.is_empty()
+                    && texts.iter().all(|a| a.iter().all(|s| s.starts_with("c:")))
+                    && r.parts.iter().all(|v| match v {
+                        Part::Control(k) => {
+                            k.starts_with("o:secPr:")
+                                || (k.starts_with("o:ctrl:") && k.contains("/colPr/"))
+                        }
+                        _ => true,
+                    })
+            })
+    }
+
+    pub(crate) fn split_edit(
+        self,
+        left: &Paragraph,
+        right: &Paragraph,
+        old: &[(u32, u32)],
+        split: u32,
+        supported: bool,
+    ) -> (Option<Self>, Option<Self>) {
+        let reject = |mut t: Self| {
+            t.invalidate("paragraph split has unsupported run correspondence");
+            (Some(t.clone()), Some(t))
+        };
+        if !supported || !right.controls.is_empty() {
+            return reject(self);
+        }
+        let mut left_old: Vec<_> = old
+            .iter()
+            .enumerate()
+            .filter(|(_, v)| v.0 < split)
+            .map(|(i, v)| (i, *v))
+            .collect();
+        let active = old.iter().rposition(|v| v.0 <= split).unwrap_or(0);
+        if left_old.is_empty() {
+            left_old.push((active, (0, old[active].1)));
+        }
+        let mut right_old: Vec<_> = old
+            .iter()
+            .enumerate()
+            .filter(|(_, v)| v.0 >= split)
+            .map(|(i, v)| (i, (v.0 - split, v.1)))
+            .collect();
+        if !right_old.iter().any(|(_, v)| v.0 == 0) {
+            right_old.insert(0, (active, (0, old[active].1)));
+        }
+        let positions = |p: &Paragraph| {
+            p.char_shapes
+                .iter()
+                .map(|v| (v.start_pos, v.char_shape_id))
+                .collect::<Vec<_>>()
+        };
+        if positions(left) != left_old.iter().map(|v| v.1).collect::<Vec<_>>()
+            || positions(right) != right_old.iter().map(|v| v.1).collect::<Vec<_>>()
+        {
+            return reject(self);
+        }
+        let mut lr = Vec::new();
+        let mut rr = Vec::new();
+        let mut chars = 0usize;
+        for run in &self.runs {
+            let mut lp = Vec::new();
+            let mut rp = Vec::new();
+            for part in &run.parts {
+                match part {
+                    Part::Control(_) => lp.push(part.clone()),
+                    Part::Text(a) => {
+                        let at = left.text.chars().count().saturating_sub(chars).min(a.len());
+                        let left_has_group = left_old.iter().any(|v| v.0 == run.group);
+                        let right_has_group = right_old.iter().any(|v| v.0 == run.group);
+                        if at > 0 || (a.is_empty() && left_has_group && !right_has_group) {
+                            lp.push(Part::Text(a[..at].to_vec()));
+                        }
+                        if at < a.len() || (a.is_empty() && right_has_group) {
+                            rp.push(Part::Text(a[at..].to_vec()));
+                        }
+                        chars += a.len();
+                    }
+                }
+            }
+            if !lp.is_empty() {
+                let Some(group) = left_old.iter().position(|v| v.0 == run.group) else {
+                    return reject(self);
+                };
+                lr.push(SourceRun {
+                    group,
+                    shape: run.shape,
+                    parts: lp,
+                });
+            }
+            if !rp.is_empty() {
+                let Some(group) = right_old.iter().position(|v| v.0 == run.group) else {
+                    return reject(self);
+                };
+                rr.push(SourceRun {
+                    group,
+                    shape: run.shape,
+                    parts: rp,
+                });
+            }
+        }
+        if chars != left.text.chars().count() + right.text.chars().count() {
+            return reject(self);
+        }
+        let make = |runs: Vec<SourceRun>, p: &Paragraph| {
+            if runs.is_empty() {
+                None
+            } else {
+                Some(Self {
+                    runs,
+                    owner: p.hwpx_paragraph_identity.clone(),
+                    seal: seal(p),
+                    invalid: None,
+                })
+            }
+        };
+        (make(lr, left), make(rr, right))
+    }
+
+    pub(crate) fn strip_structural(
+        mut self,
+        p: &Paragraph,
+        old: &[(u32, u32)],
+        released: u32,
+        supported: bool,
+    ) -> Self {
+        let reject = |mut t: Self| {
+            t.invalidate("clipboard structural-prefix removal has unsupported run correspondence");
+            t
+        };
+        if !supported || !p.controls.is_empty() {
+            return reject(self);
+        }
+        let first = if released == 0 {
+            0
+        } else {
+            old.iter().rposition(|v| v.0 <= released).unwrap_or(0)
+        };
+        let expected: Vec<_> = old[first..]
+            .iter()
+            .map(|(pos, id)| (pos.saturating_sub(released), *id))
+            .collect();
+        let actual: Vec<_> = p
+            .char_shapes
+            .iter()
+            .map(|s| (s.start_pos, s.char_shape_id))
+            .collect();
+        if actual != expected {
+            return reject(self);
+        }
+        for run in &mut self.runs {
+            run.parts.retain(|v| !matches!(v, Part::Control(_)));
+        }
+        self.runs.retain(|r| !r.parts.is_empty());
+        for run in &mut self.runs {
+            if run.group < first {
+                return reject(self);
+            }
+            run.group -= first;
+        }
+        self.seal = seal(p);
+        self
+    }
+
+    pub(crate) fn can_split(&self, p: &Paragraph) -> bool {
+        self.partitionable(p)
+    }
+
+    fn generated_plain(p: &Paragraph) -> Option<Self> {
+        if !p.controls.is_empty()
+            || !p.field_ranges.is_empty()
+            || !p.title_marks.is_empty()
+            || !p.markpen_marks.is_empty()
+            || p.char_shapes.is_empty()
+        {
+            return None;
+        }
+        let chars: Vec<_> = p.text.chars().collect();
+        let mut runs = Vec::new();
+        for (group, shape) in p.char_shapes.iter().enumerate() {
+            let from = if group == 0 {
+                0
+            } else {
+                p.char_offsets.partition_point(|v| *v < shape.start_pos)
+            };
+            let to = p.char_shapes.get(group + 1).map_or(chars.len(), |v| {
+                p.char_offsets.partition_point(|x| *x < v.start_pos)
+            });
+            if from > to || to > chars.len() {
+                return None;
+            }
+            runs.push(SourceRun {
+                group,
+                shape: shape.char_shape_id,
+                parts: vec![Part::Text(
+                    chars[from..to].iter().map(|c| format!("c:{c}")).collect(),
+                )],
+            });
+        }
+        Some(Self {
+            runs,
+            owner: p.hwpx_paragraph_identity.clone(),
+            seal: seal(p),
+            invalid: None,
+        })
+    }
+
+    pub(crate) fn before_merge(
+        left: &mut Paragraph,
+        right: &Paragraph,
+    ) -> Option<(Self, Option<Self>, Vec<(u32, u32)>, Vec<(u32, u32)>)> {
+        if left.hwpx_text_topology.is_none() && right.hwpx_text_topology.is_none() {
+            return None;
+        }
+        let l = Self::before_edit(left).or_else(|| Self::generated_plain(left));
+        let mut r = right
+            .hwpx_text_topology
+            .clone()
+            .or_else(|| Self::generated_plain(right));
+        if let Some(t) = &mut r {
+            if let Err(e) = t.validate(right) {
+                t.invalidate(&e);
+            }
+        }
+        let mut l = l.unwrap_or_else(|| right.hwpx_text_topology.as_ref().unwrap().clone());
+        if !l.partitionable(left) || !right.controls.is_empty() || r.is_none() {
+            l.invalidate("paragraph merge has unsupported run correspondence");
+        }
+        let positions = |p: &Paragraph| {
+            p.char_shapes
+                .iter()
+                .map(|v| (v.start_pos, v.char_shape_id))
+                .collect::<Vec<_>>()
+        };
+        Some((l, r, positions(left), positions(right)))
+    }
+
+    pub(crate) fn merge_edit(
+        mut self,
+        right: Option<Self>,
+        p: &Paragraph,
+        left_shapes: &[(u32, u32)],
+        right_shapes: &[(u32, u32)],
+        shift: u32,
+    ) -> Self {
+        let reject = |mut t: Self| {
+            t.invalidate("paragraph merge has unsupported run correspondence");
+            t
+        };
+        let Some(right) = right else {
+            return reject(self);
+        };
+        if right.invalid.is_some() {
+            return reject(self);
+        }
+        let mut expected = left_shapes.to_vec();
+        let mut map = Vec::new();
+        for &(pos, shape) in right_shapes {
+            let v = (pos + shift, shape);
+            // A deduplicated occurrence cannot retain two source run identities.
+            if expected.last() == Some(&v) {
+                return reject(self);
+            }
+            map.push(expected.len());
+            expected.push(v);
+        }
+        let actual: Vec<_> = p
+            .char_shapes
+            .iter()
+            .map(|s| (s.start_pos, s.char_shape_id))
+            .collect();
+        if actual != expected {
+            return reject(self);
+        }
+        for mut run in right.runs {
+            let Some(&group) = map.get(run.group) else {
+                return reject(self);
+            };
+            run.group = group;
+            self.runs.push(run);
+        }
+        self.seal = seal(p);
+        self.owner = p.hwpx_paragraph_identity.clone();
+        self
+    }
+
+    pub(crate) fn restore(
+        &self,
+        p: &Paragraph,
+        xml: &str,
+        template: bool,
+    ) -> Result<String, String> {
+        self.validate(p)?;
+        let generated = read_runs(xml)?;
+        let group_count = p.char_shapes.len();
+        if generated.len() != group_count + usize::from(template) {
+            return Err("emitted run occurrence count does not match parser boundary plan".into());
+        }
+        let mut result = String::new();
+        for group in 0..group_count {
+            let source: Vec<_> = self.runs.iter().filter(|r| r.group == group).collect();
+            if source.is_empty() {
+                return Err("missing source run occurrence".into());
+            }
+            let start = if template && group == 0 {
+                0
+            } else {
+                group + usize::from(template)
+            };
+            let stop = group + 1 + usize::from(template);
+            let mut tokens = Vec::new();
+            for view in &generated[start..stop] {
+                if view.shape != p.char_shapes[group].char_shape_id {
+                    return Err("emitted charPrIDRef differs from mapped occurrence".into());
+                }
+                for part in &view.parts {
+                    match &part.part {
+                        Part::Text(keys) => {
+                            for (key, xml) in keys.iter().zip(&part.atoms) {
+                                tokens.push((key.clone(), xml.clone()));
+                            }
+                        }
+                        Part::Control(key) => tokens.push((key.clone(), part.xml.clone())),
+                    }
+                }
+            }
+            let expected: Vec<_> = source
+                .iter()
+                .flat_map(|r| &r.parts)
+                .flat_map(|v| match v {
+                    Part::Text(a) => a.clone(),
+                    Part::Control(k) => vec![k.clone()],
+                })
+                .collect();
+            if expected.iter().ne(tokens.iter().map(|t| &t.0)) {
+                return Err(format!(
+                    "emitted text/control event order differs in IR run occurrence {group}"
+                ));
+            }
+            let mut at = 0;
+            for run in source {
+                result.push_str(&format!(r#"<hp:run charPrIDRef="{}">"#, run.shape));
+                for part in &run.parts {
+                    match part {
+                        Part::Text(a) => {
+                            result.push_str("<hp:t>");
+                            for _ in a {
+                                result.push_str(&tokens[at].1);
+                                at += 1;
+                            }
+                            result.push_str("</hp:t>");
+                        }
+                        Part::Control(_) => {
+                            result.push_str(&tokens[at].1);
+                            at += 1;
+                        }
+                    }
+                }
+                result.push_str("</hp:run>");
+            }
+        }
+        Ok(result)
+    }
+}
+
+struct ViewPart {
+    part: Part,
+    atoms: Vec<String>,
+    xml: String,
+}
+struct RunView {
+    shape: u32,
+    parts: Vec<ViewPart>,
+}
+
+fn local(name: &str) -> &str {
+    name.rsplit(':').next().unwrap_or(name)
+}
+fn escaped(s: &str) -> String {
+    quick_xml::escape::escape(s).into_owned()
+}
+fn tag_key(e: &quick_xml::events::BytesStart<'_>) -> Result<String, String> {
+    let mut attrs = Vec::new();
+    for a in e.attributes() {
+        let a = a.map_err(|e| e.to_string())?;
+        attrs.push((
+            a.key.as_ref().to_string(),
+            a.normalized_value(quick_xml::XmlVersion::Implicit1_0)
+                .map_err(|e| e.to_string())?
+                .into_owned(),
+        ));
+    }
+    attrs.sort();
+    Ok(format!("{}:{attrs:?}", local(e.name().as_ref())))
+}
+
+/// Read direct run children only. Controls remain opaque generated fragments;
+/// their owning occurrence and shallow identity/order are verified, never copied
+/// from source. Nested paragraphs are handled by their own renderer invocation.
+fn read_runs(xml: &str) -> Result<Vec<RunView>, String> {
+    let mut reader = Reader::from_str(xml);
+    let mut runs = Vec::new();
+    let mut run: Option<RunView> = None;
+    loop {
+        let before = reader.buffer_position() as usize;
+        let event = reader.read_event().map_err(|e| e.to_string())?;
+        match event {
+            Event::Start(ref e) | Event::Empty(ref e) if local(e.name().as_ref()) == "run" => {
+                if run.is_some() {
+                    return Err("nested run outside an opaque control".into());
+                }
+                let shape = e
+                    .attributes()
+                    .collect::<Result<Vec<_>, _>>()
+                    .map_err(|e| e.to_string())?
+                    .iter()
+                    .find(|a| a.key.as_ref() == "charPrIDRef")
+                    .ok_or("run without charPrIDRef")?
+                    .normalized_value(quick_xml::XmlVersion::Implicit1_0)
+                    .map_err(|e| e.to_string())?
+                    .parse()
+                    .map_err(|_| "invalid charPrIDRef")?;
+                if e.attributes().count() != 1 {
+                    return Err("unsupported run attributes".into());
+                }
+                let v = RunView {
+                    shape,
+                    parts: Vec::new(),
+                };
+                if matches!(event, Event::Empty(_)) {
+                    runs.push(v);
+                } else {
+                    run = Some(v);
+                }
+            }
+            Event::Start(ref e) | Event::Empty(ref e) if run.is_some() => {
+                let empty = matches!(event, Event::Empty(_));
+                if local(e.name().as_ref()) == "t" {
+                    if e.attributes().count() != 0 {
+                        return Err("unsupported hp:t attributes".into());
+                    }
+                    let mut keys = Vec::new();
+                    let mut atoms = Vec::new();
+                    if !empty {
+                        loop {
+                            let a = reader.buffer_position() as usize;
+                            match reader.read_event().map_err(|e| e.to_string())? {
+                                Event::End(ref e) if local(e.name().as_ref()) == "t" => break,
+                                Event::Text(t) => {
+                                    for c in t.as_ref().chars() {
+                                        keys.push(format!("c:{c}"));
+                                        atoms.push(escaped(&c.to_string()));
+                                    }
+                                }
+                                Event::CData(t) => {
+                                    for c in t.as_ref().chars() {
+                                        keys.push(format!("c:{c}"));
+                                        atoms.push(escaped(&c.to_string()));
+                                    }
+                                }
+                                Event::GeneralRef(r) => {
+                                    let value = format!("&{};", r.as_ref());
+                                    let text = quick_xml::escape::unescape(&value)
+                                        .map_err(|e| e.to_string())?;
+                                    for c in text.chars() {
+                                        keys.push(format!("c:{c}"));
+                                        atoms.push(escaped(&c.to_string()));
+                                    }
+                                }
+                                Event::Empty(ref e) => {
+                                    keys.push(format!("i:{}", tag_key(e)?));
+                                    atoms.push(xml[a..reader.buffer_position() as usize].into());
+                                }
+                                Event::Eof => return Err("unterminated hp:t".into()),
+                                _ => return Err("unsupported nested text markup".into()),
+                            }
+                        }
+                    }
+                    run.as_mut().unwrap().parts.push(ViewPart {
+                        part: Part::Text(keys),
+                        atoms,
+                        xml: String::new(),
+                    });
+                } else {
+                    let name = local(e.name().as_ref()).to_string();
+                    // Only structural identity attributes. Lexical attribute order
+                    // and unrelated control serialization are not run identity.
+                    let id = e
+                        .attributes()
+                        .collect::<Result<Vec<_>, _>>()
+                        .map_err(|e| e.to_string())?
+                        .iter()
+                        .find(|a| a.key.as_ref() == "id")
+                        .map(|a| {
+                            a.normalized_value(quick_xml::XmlVersion::Implicit1_0)
+                                .map(|s| s.into_owned())
+                        })
+                        .transpose()
+                        .map_err(|e| e.to_string())?;
+                    let mut key = format!("o:{name}:{id:?}");
+                    if !empty {
+                        let mut depth = 1;
+                        while depth > 0 {
+                            match reader.read_event().map_err(|e| e.to_string())? {
+                                Event::Start(ref ce) => {
+                                    if depth == 1 && name == "ctrl" {
+                                        key.push_str(&format!(
+                                            "/{}/{}",
+                                            local(ce.name().as_ref()),
+                                            identity_attrs(ce)?
+                                        ));
+                                    }
+                                    depth += 1;
+                                }
+                                Event::Empty(ref ce) if depth == 1 && name == "ctrl" => {
+                                    key.push_str(&format!(
+                                        "/{}/{}",
+                                        local(ce.name().as_ref()),
+                                        identity_attrs(ce)?
+                                    ));
+                                }
+                                Event::End(_) => depth -= 1,
+                                Event::Eof => return Err("unterminated control".into()),
+                                _ => {}
+                            }
+                        }
+                    }
+                    run.as_mut().unwrap().parts.push(ViewPart {
+                        part: Part::Control(key),
+                        atoms: Vec::new(),
+                        xml: xml[before..reader.buffer_position() as usize].into(),
+                    });
+                }
+            }
+            Event::End(ref e) if local(e.name().as_ref()) == "run" => {
+                runs.push(run.take().ok_or("unmatched run end")?);
+            }
+            Event::Eof => break,
+            Event::Text(t) if t.as_ref().trim().is_empty() => {}
+            _ => return Err("unsupported event between run elements".into()),
+        }
+    }
+    if run.is_some() {
+        return Err("unterminated run".into());
+    }
+    Ok(runs)
+}
+
+fn identity_attrs(e: &quick_xml::events::BytesStart<'_>) -> Result<String, String> {
+    let mut attrs = Vec::new();
+    for a in e.attributes() {
+        let a = a.map_err(|e| e.to_string())?;
+        if matches!(a.key.as_ref(), "id" | "beginIDRef" | "fieldid") {
+            attrs.push((
+                a.key.as_ref().to_string(),
+                a.normalized_value(quick_xml::XmlVersion::Implicit1_0)
+                    .map_err(|e| e.to_string())?
+                    .into_owned(),
+            ));
+        }
+    }
+    attrs.sort();
+    Ok(format!("{attrs:?}"))
+}
