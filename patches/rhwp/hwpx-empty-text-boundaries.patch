+/// Source `hp:t@charStyleIDRef` values replayed by the empty-text topology
+/// must reference character styles of this document's header.
+fn accept_text_styles(ctx: &mut SerializeContext, styles: Vec<u16>) -> Result<(), String> {
+    for style in styles {
+        if !ctx.text_char_style_ids.contains(&style) {
+            return Err("hp:t charStyleIDRef does not reference a character style".into());
+        }
+        ctx.style_ids.reference(style);
+    }
+    Ok(())
+}
