+// ---- Boundary hardening: reserved deferred identity, nested control identity ----
+
+/// Deferred (0) carrier bound through the real clipboard rebinding API.
+fn deferred() -> Paragraph {
+    let mut p = imported(&r("<hp:t>A</hp:t><hp:t/>"));
+    let mut t = p.hwpx_text_topology.take().unwrap();
+    p.hwpx_paragraph_identity = Default::default();
+    t.rebind_clone(&p);
+    p.hwpx_text_topology = Some(t);
+    p
+}
+
+/// Exactly what `SerializeContext::prepare_paragraph_ids` does for 0.
+fn reserve(p: &Paragraph, encoded: u64) -> bool {
+    use std::sync::atomic::Ordering::Relaxed;
+    let ok = p
+        .hwpx_paragraph_identity
+        .compare_exchange(0, encoded, Relaxed, Relaxed)
+        .is_ok();
+    if ok {
+        p.hwpx_text_topology
+            .as_ref()
+            .unwrap()
+            .record_reservation(p, encoded);
+    }
+    ok
+}
+
+#[test]
+fn empty_text_reserved_deferred_identity_cannot_reset_or_move() {
+    use std::sync::atomic::Ordering::Relaxed;
+    let p = deferred();
+    let t = p.hwpx_text_topology.as_ref().unwrap();
+    assert!(t.validate(&p).is_ok(), "deferred 0 before reservation");
+    assert!(reserve(&p, 101));
+    assert!(t.validate(&p).is_ok(), "authorized reservation");
+    assert!(t.validate(&p).is_ok(), "repeated validation");
+    // Back to zero after a recorded reservation: not a fresh deferred state.
+    p.hwpx_paragraph_identity.store(0, Relaxed);
+    assert_eq!(t.validate(&p).unwrap_err(), IDENTITY_VALUE_CHANGED);
+    // A second reservation cannot replace the first one (OnceLock).
+    assert!(reserve(&p, 205));
+    assert_eq!(t.validate(&p).unwrap_err(), IDENTITY_VALUE_CHANGED);
+    p.hwpx_paragraph_identity.store(102, Relaxed);
+    assert_eq!(t.validate(&p).unwrap_err(), IDENTITY_VALUE_CHANGED);
+    p.hwpx_paragraph_identity.store(101, Relaxed);
+    assert!(
+        t.validate(&p).is_ok(),
+        "the reserved value itself stays valid"
+    );
+    // A never-reserved deferred carrier stays valid at 0 and refuses a
+    // value written without the serializer's reservation.
+    let q = deferred();
+    q.hwpx_paragraph_identity.store(77, Relaxed);
+    assert_eq!(
+        q.hwpx_text_topology
+            .as_ref()
+            .unwrap()
+            .validate(&q)
+            .unwrap_err(),
+        IDENTITY_VALUE_CHANGED
+    );
+}
