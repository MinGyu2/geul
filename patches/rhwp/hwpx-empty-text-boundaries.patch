+    core.insert_text_native(0, 0, 0, "처음😀둘째").unwrap();
+    core.split_paragraph_native(0, 0, 2, None).unwrap();
+    core.split_paragraph_native(0, 0, 1, None).unwrap();
+    core.merge_paragraph_native(0, 1).unwrap();
+    core.split_paragraph_native(0, 0, 1, None).unwrap();
+    assert_eq!(
+        core.document.sections[0]
+            .paragraphs
+            .iter()
+            .map(|p| p.text.as_str())
+            .collect::<Vec<_>>(),
+        vec!["처", "음", "😀둘째"]
+    );
+    core.copy_selection_native(
+        0,
+        0,
+        0,
+        2,
+        core.document.sections[0].paragraphs[2].text.chars().count(),
+    )
+    .unwrap();
+    core.paste_internal_native(
+        0,
+        2,
+        core.document.sections[0].paragraphs[2].text.chars().count(),
+    )
+    .unwrap();
+    // Full export prepares the new paragraph identities before any writer.
+    let bytes = core.export_hwpx_native().unwrap();
+    let reopened = crate::document_core::DocumentCore::from_bytes(&bytes).unwrap();
+    assert_eq!(
+        core.document.sections[0]
+            .paragraphs
+            .iter()
+            .map(|p| p.text.as_str())
+            .collect::<Vec<_>>(),
+        reopened.document.sections[0]
+            .paragraphs
+            .iter()
+            .map(|p| p.text.as_str())
+            .collect::<Vec<_>>()
+    );
+}
