+#[test]
+fn empty_text_unrelated_edit_and_snapshot_clone_keep_owners() {
+    let p = imported(&r("<hp:t>A</hp:t><hp:t/>"));
+    let snapshot = p.clone();
+    let mut other = imported(&r("<hp:t>Z</hp:t>"));
+    other.insert_text_at(0, "가");
+    assert_eq!(render(&p).unwrap(), render(&snapshot).unwrap());
+    let mut detached = p.clone();
