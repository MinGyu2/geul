+/// Inject source paragraphs into a real generated HWPX package and load it
+/// through the actual document loader (no hand-built IR shortcuts).
+pub(crate) fn package_with(paragraphs: &str) -> Vec<u8> {
+    use std::io::{Read, Write};
+    let mut generated = crate::document_core::DocumentCore::new_empty();
+    generated.create_blank_document_native().unwrap();
+    let bytes = generated.export_hwpx_native().unwrap();
+    let mut archive = zip::ZipArchive::new(std::io::Cursor::new(bytes)).unwrap();
+    let mut writer = zip::ZipWriter::new(std::io::Cursor::new(Vec::new()));
+    for i in 0..archive.len() {
+        let mut entry = archive.by_index(i).unwrap();
+        let name = entry.name().to_string();
+        let mut data = Vec::new();
+        entry.read_to_end(&mut data).unwrap();
+        if name == "Contents/section0.xml" {
+            let xml = String::from_utf8(data).unwrap();
+            assert_eq!(xml.matches("</hs:sec>").count(), 1);
+            data = xml
+                .replace("</hs:sec>", &format!("{paragraphs}</hs:sec>"))
+                .into_bytes();
+        }
+        let options = if name == "mimetype" {
+            zip::write::SimpleFileOptions::default()
+                .compression_method(zip::CompressionMethod::Stored)
+        } else {
+            zip::write::SimpleFileOptions::default()
+        };
+        writer.start_file(name, options).unwrap();
+        writer.write_all(&data).unwrap();
+    }
+    writer.finish().unwrap().into_inner()
+}
