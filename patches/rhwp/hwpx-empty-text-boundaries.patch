+#[test]
+fn empty_text_self_closing_bare_run_ends_template_handoff() {
+    let body = format!(r#"<hp:run charPrIDRef="0"/>{}"#, r("<hp:t>A</hp:t><hp:t/>"));
+    let source = EMPTY_SECTION_XML.replace(TEMPLATE_TEXT_RUN, &body);
+    let section = parse_hwpx_section(&source).unwrap();
+    assert_eq!(section.paragraphs[0].char_shapes.len(), 2);
+    assert_eq!(
+        section.paragraphs[0]
+            .hwpx_text_topology
+            .as_ref()
+            .unwrap()
+            .runs
+            .iter()
+            .map(|r| r.group)
+            .collect::<Vec<_>>(),
+        vec![0, 0, 1]
+    );
+    let doc = Document {
+        sections: vec![section.clone()],
+        ..Default::default()
+    };
+    let mut ctx = SerializeContext::collect_from_document(&doc);
+    let out = String::from_utf8(write_section(&section, &doc, 0, &mut ctx).unwrap()).unwrap();
+    assert_eq!(ctx.text_topology_error, None);
+    assert!(out.contains(&format!("{}{}", r(""), r("<hp:t>A</hp:t><hp:t></hp:t>"))));
+}
