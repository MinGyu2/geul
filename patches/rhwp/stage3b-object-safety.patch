+    fn flat_leaf_drawing_deletable(
+        drawing: &crate::model::shape::DrawingObjAttr,
+        common: &crate::model::shape::CommonObjAttr,
+        expected_ctrl_id: u32,
+    ) -> bool {
+        drawing.shape_attr.ctrl_id == expected_ctrl_id
+            && (common.attr & (1 << 30)) == 0
+            && drawing.caption.is_none()
+            && drawing.text_box.as_ref().is_none_or(|tb| {
+                (1..=64).contains(&tb.paragraphs.len())
+                    && tb.paragraphs.iter().all(|p| {
+                        p.controls.is_empty()
+                            && p.field_ranges.is_empty()
+                            && p.orphan_field_ends.is_empty()
+                    })
+            })
+    }
+
+    fn format_group_props_json(shape: &ShapeObject) -> String {
+        let ShapeObject::Group(group) = shape else {
+            return String::new();
+        };
+        let flat_deletable = group.caption.is_none()
+            && (group.common.attr & (1 << 30)) == 0
+            && !group.children.is_empty()
+            && group.children.iter().all(|child| match child {
+                ShapeObject::Line(s) => Self::flat_leaf_drawing_deletable(
+                    &s.drawing,
+                    &s.common,
+                    crate::parser::tags::SHAPE_LINE_ID,
+                ),
+                ShapeObject::Rectangle(s) => Self::flat_leaf_drawing_deletable(
+                    &s.drawing,
+                    &s.common,
+                    crate::parser::tags::SHAPE_RECT_ID,
+                ),
+                ShapeObject::Ellipse(s) => Self::flat_leaf_drawing_deletable(
+                    &s.drawing,
+                    &s.common,
+                    crate::parser::tags::SHAPE_ELLIPSE_ID,
+                ),
+                ShapeObject::Polygon(s) => Self::flat_leaf_drawing_deletable(
+                    &s.drawing,
+                    &s.common,
+                    crate::parser::tags::SHAPE_POLYGON_ID,
+                ),
+                ShapeObject::Curve(s) => Self::flat_leaf_drawing_deletable(
+                    &s.drawing,
+                    &s.common,
+                    crate::parser::tags::SHAPE_CURVE_ID,
+                ),
+                ShapeObject::Picture(pic) => {
+                    matches!(pic.shape_attr.ctrl_id, 0 | crate::parser::tags::SHAPE_PICTURE_ID)
+                        && (pic.common.attr & (1 << 30)) == 0
+                        && pic.caption.is_none()
+                        && pic.image_attr.external_path.is_none()
+                        && pic.image_attr.bin_data_id >= 1
+                }
+                ShapeObject::Arc(_)
+                | ShapeObject::Group(_)
+                | ShapeObject::Chart(_)
+                | ShapeObject::Ole(_) => false,
+            });
+        format!(",\"groupFlatDeletable\":{}", flat_deletable)
+    }
