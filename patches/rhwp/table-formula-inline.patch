+    /// Ordinary first-paragraph numbers and sole full-paragraph formulas retain their
+    /// existing value semantics. A partial/multiple/other field never supplies a number.
+    fn formula_operand_number(p: &crate::model::paragraph::Paragraph) -> Option<f64> {
+        if !p.field_ranges.is_empty() || p.controls.iter().any(|c| matches!(c, Control::Field(_))) {
+            let [range] = p.field_ranges.as_slice() else { return None };
+            if p.controls.len() != 1 || range.control_idx != 0 || range.start_char_idx != 0
+                || range.end_char_idx != p.text.chars().count()
+                || !matches!(p.controls.first(), Some(Control::Field(f)) if f.field_type == crate::model::control::FieldType::Formula) {
+                return None;
+            }
+        }
+        parse_cell_number(&p.text)
+    }
