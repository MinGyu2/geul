+    fn formula_operand_cell_number(cell: &crate::model::table::Cell) -> Option<f64> {
+        // A formula in a later paragraph makes the cell a mixed formula operand,
+        // even when paragraph zero alone happens to parse as a number.
+        if cell.paragraphs.iter().skip(1).any(|p|p.controls.iter().any(|c|
+            matches!(c,Control::Field(f) if f.field_type==crate::model::control::FieldType::Formula))) { return None; }
+        cell.paragraphs.first().and_then(Self::formula_operand_number)
+    }
