+    /// Validate the entire dependency closure using real ownership and the parser's AST.
+    /// Multiple inline fields are independent roots; referenced cells must be unambiguous.
+    pub(crate) fn validate_formula_references(table: &crate::model::table::Table,
+        row: usize, col: usize, formula: &str) -> Result<(), HwpError> {
+        use crate::document_core::table_calc::{formula_references, TableContext};
+        let error = || HwpError::InvalidField("계산식 참조/순환 또는 모호한 셀 값".into());
+        let refs = |r, c, f: &str| formula_references(f, &TableContext {
+            row_count: table.row_count as usize, col_count: table.col_count as usize,
+            current_row: r, current_col: c,
+        }).map_err(|_| error());
+        let mut colors = std::collections::HashMap::new();
+        colors.insert((col, row), 1u8);
+        let mut stack = vec![((col,row), refs(row,col,formula)?, 0usize)];
+        let mut budget = stack[0].1.len();
+        while let Some((_, edges, next)) = stack.last_mut() {
+            if *next == edges.len() {
+                let (key,_,_) = stack.pop().unwrap(); colors.insert(key,2); continue;
+            }
+            let key = edges[*next]; *next += 1;
+            if colors.get(&key) == Some(&1) { return Err(error()); }
+            if colors.get(&key) == Some(&2) { continue; }
+            let cell = table.cells.iter().find(|c| (c.col as usize,c.row as usize)==key).ok_or_else(error)?;
+            if cell.paragraphs.iter().skip(1).any(|p|p.controls.iter().any(|c|
+                matches!(c,Control::Field(f) if f.field_type==crate::model::control::FieldType::Formula))) { return Err(error()); }
+            let p = cell.paragraphs.first().ok_or_else(error)?;
+            // Plain nonnumeric cells keep the evaluator's established empty/zero semantics.
+            // A field-bearing operand, however, must have one established numeric value.
+            if !p.field_ranges.is_empty() || p.controls.iter().any(|c| matches!(c, Control::Field(_))) {
+                Self::formula_operand_number(p).ok_or_else(error)?;
+                let Some(Control::Field(f)) = p.controls.first() else { return Err(error()) };
+                let expression = f.command.split_once("??").ok_or_else(error)?.0;
+                let edges = refs(key.1,key.0,expression)?;
+                let ctx = TableContext { row_count:table.row_count as usize,col_count:table.col_count as usize,
+                    current_row:key.1,current_col:key.0 };
+                let get = |c,r| table.cells.iter().find(|cell|cell.col as usize==c && cell.row as usize==r)
+                    .and_then(Self::formula_operand_cell_number);
+                let value = crate::document_core::table_calc::evaluate_formula(expression,&ctx,&get).map_err(|_|error())?;
+                let suffix=f.command.split_once("??").ok_or_else(error)?.1;
+                let (format,cache)=suffix.split_once(",;;").ok_or_else(error)?;
+                let expected = if format=="%g" { crate::document_core::table_calc::format_formula_g(value).ok_or_else(error)? }
+                    else if format.starts_with("%.") && format.ends_with('f') && format.len()==4 {
+                        let n=format[2..3].parse::<usize>().map_err(|_|error())?;format!("{:.*}",n,value)
+                    } else { return Err(error()) };
+                if expected!=cache || p.text!=cache { return Err(error()); }
+                budget += edges.len() + 1;
+                if budget > 4096 { return Err(error()); }
+                colors.insert(key,1); stack.push((key,edges,0));
+            } else { colors.insert(key,2); }
+        }
+        Ok(())
     }
 
