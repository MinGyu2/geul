+impl DocumentCore {
+    /// [geul Stage 1 F] Embed a permitted TrueType font for the document face named `face` (HWPX only:
+    /// OWPML `hh:font@isEmbedded` + `@binaryItemIDRef` → a manifest BinData item). Every font entry of
+    /// that exact name in the seven language groups is marked embedded and resolves to the same BinData.
+    /// The face must already be used by the document's font tables and must be one of the font's own
+    /// family names. Idempotent: an already embedded face, or identical bytes already stored as a font
+    /// resource, are reused (no duplicate resource). HWP 5.0 defines no font-embedding record, so an
+    /// HWP source is refused.
+    pub fn embed_font_native(&mut self, face: &str, bytes: &[u8]) -> Result<String, HwpError> {
+        let fail = |m: String| HwpError::RenderError(format!("embedFont: {m}"));
+        if self.source_format != crate::parser::FileFormat::Hwpx {
+            return Err(fail("only HWPX defines embedded fonts".into()));
+        }
+        let families = geul_embeddable_truetype(bytes).map_err(fail)?;
+        if face.is_empty() || !families.iter().any(|f| f == face) {
+            return Err(fail("face is not a family name of the font".into()));
+        }
+        let entries: Vec<(usize, usize)> = self
+            .document
+            .doc_info
+            .font_faces
+            .iter()
+            .enumerate()
+            .flat_map(|(lang, fonts)| fonts.iter().enumerate().filter(|(_, f)| f.name == face).map(move |(i, _)| (lang, i)))
+            .collect();
+        if entries.is_empty() {
+            return Err(fail("face is not used by the document".into()));
+        }
+        // One resource per face: an entry already embedded must point at existing bytes of this font.
+        let existing: Vec<u16> = entries
+            .iter()
+            .filter_map(|&(l, i)| {
+                let f = &self.document.doc_info.font_faces[l][i];
+                f.is_embedded.then_some(f.resolved_bin_data_id).flatten()
+            })
+            .collect();
+        let content_id = |doc: &crate::model::document::Document, id: u16| doc.bin_data_content.iter().any(|c| c.id == id);
+        let id = if let Some(&id) = existing.first() {
+            if !existing.iter().all(|&e| e == id) || !content_id(&self.document, id) {
+                return Err(fail("face has inconsistent embedded resources".into()));
+            }
+            id
+        } else if let Some(c) = self.document.bin_data_content.iter().find(|c| {
+            c.extension.eq_ignore_ascii_case("ttf") && c.data.load_limited(GEUL_MAX_EMBED_FONT_BYTES).as_deref() == Some(bytes)
+        }) {
+            c.id
+        } else {
+            let storage = self.document.next_bin_data_storage_id();
+            let sequence = self.document.doc_info.bin_data_list.len() + 1;
+            // The serializer resolves a font reference by BinData sequence before storage id; refuse a
+            // document whose ids are not contiguous instead of risking a reference to another item.
+            if usize::from(storage) != sequence || self.document.bin_data_content.len() + 1 != sequence {
+                return Err(fail("BinData ids are not contiguous".into()));
+            }
+            self.register_embedded_bin_data(bytes, "ttf");
+            storage
+        };
+        let created = existing.is_empty();
+        for &(l, i) in &entries {
+            let f = &mut self.document.doc_info.font_faces[l][i];
+            f.is_embedded = true;
+            f.resolved_bin_data_id = Some(id);
+            f.bin_item_id_ref = format!("image{id}");
+            f.raw_data = None;
+        }
+        self.document.doc_info.raw_stream = None;
+        self.document.doc_info.raw_stream_dirty = true;
+        Ok(format!("{{\"ok\":true,\"binDataId\":{id},\"entries\":{},\"created\":{created}}}", entries.len()))
+    }
+
+    /// [geul Stage 1 F] Embedded font faces of the document: language group, entry id, face, BinData id
+    /// and stored byte length (0 when the reference does not resolve to stored bytes).
+    pub fn get_embedded_fonts_native(&self) -> String {
+        let mut items = Vec::new();
+        for (lang, fonts) in self.document.doc_info.font_faces.iter().enumerate() {
+            for (i, f) in fonts.iter().enumerate().filter(|(_, f)| f.is_embedded) {
+                let len = f
+                    .resolved_bin_data_id
+                    .and_then(|id| self.document.bin_data_content.iter().find(|c| c.id == id))
+                    .and_then(|c| c.data.load_limited(GEUL_MAX_EMBED_FONT_BYTES))
+                    .map_or(0, |b| b.len());
+                items.push(format!(
+                    "{{\"lang\":{lang},\"id\":{i},\"face\":\"{}\",\"binDataId\":{},\"bytes\":{len}}}",
+                    super::super::helpers::json_escape(&f.name),
+                    f.resolved_bin_data_id.map_or("null".to_string(), |v| v.to_string())
+                ));
+            }
+        }
+        format!("[{}]", items.join(","))
+    }
+}
