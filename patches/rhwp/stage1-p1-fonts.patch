+/// [geul Stage 1 F] Serialized identity of a face without its embedding resource fields.
+fn geul_font_identity(font: &Font) -> Result<Vec<u8>, serde_json::Error> {
+    let mut f = font.clone();
+    f.is_embedded = false;
+    f.bin_item_id_ref.clear();
+    f.resolved_bin_data_id = None;
+    serde_json::to_vec(&f)
