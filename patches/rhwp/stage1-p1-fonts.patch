+/// [geul Stage 1 F] Most bytes of one embedded font resource (the renderer's per-font load limit).
+const GEUL_MAX_EMBED_FONT_BYTES: usize = 32 * 1024 * 1024;
+
+/// [geul Stage 1 F] A TrueType-outline sfnt (single face, `glyf` + `loca`) whose OS/2 `fsType` permits
+/// editable embedding (installable 0x0000 or editable 0x0008; restricted, preview & print and
+/// bitmap-only are refused; more than one usage bit or reserved bits are refused as malformed).
+/// Returns the nameID 1/16 family names of the face. The application checks the same rules before
+/// sending bytes; this is defence in depth so the engine never stores a font it may not embed.
+pub(crate) fn geul_embeddable_truetype(bytes: &[u8]) -> Result<Vec<String>, String> {
+    let be16 = |o: usize| -> Option<u16> { Some(u16::from_be_bytes([*bytes.get(o)?, *bytes.get(o + 1)?])) };
+    let be32 = |o: usize| -> Option<u32> {
+        Some(u32::from_be_bytes([*bytes.get(o)?, *bytes.get(o + 1)?, *bytes.get(o + 2)?, *bytes.get(o + 3)?]))
+    };
+    if bytes.len() < 12 || bytes.len() > GEUL_MAX_EMBED_FONT_BYTES {
+        return Err("font size out of range".into());
+    }
+    let version = be32(0).ok_or("truncated")?;
+    if version != 0x0001_0000 && version != u32::from_be_bytes(*b"true") {
+        return Err("not a TrueType-outline font".into());
+    }
+    let count = be16(4).ok_or("truncated")? as usize;
+    if count == 0 || count > 512 {
+        return Err("bad table directory".into());
+    }
+    let mut tables = std::collections::HashMap::new();
+    for i in 0..count {
+        let rec = 12 + i * 16;
+        let tag = bytes.get(rec..rec + 4).ok_or("truncated directory")?;
+        let offset = be32(rec + 8).ok_or("truncated directory")? as usize;
+        let length = be32(rec + 12).ok_or("truncated directory")? as usize;
+        if offset.checked_add(length).map_or(true, |end| end > bytes.len()) {
+            return Err("table outside the file".into());
+        }
+        tables.insert(tag.to_vec(), (offset, length));
+    }
+    for tag in [&b"glyf"[..], b"loca", b"head", b"maxp", b"cmap", b"name", b"OS/2"] {
+        if !tables.contains_key(tag) {
+            return Err(format!("missing {} table", String::from_utf8_lossy(tag)));
+        }
+    }
+    let (os2, os2_len) = tables[&b"OS/2"[..]];
+    if os2_len < 10 {
+        return Err("short OS/2 table".into());
+    }
+    let fs_type = be16(os2 + 8).ok_or("truncated OS/2")?;
+    let usage = fs_type & 0x000E;
+    if fs_type & 0xFCF1 != 0 || usage.count_ones() > 1 {
+        return Err("malformed embedding permissions".into());
+    }
+    if usage == 0x0002 {
+        return Err("restricted license embedding".into());
+    }
+    if usage == 0x0004 {
+        return Err("preview & print embedding only".into());
+    }
+    if fs_type & 0x0200 != 0 {
+        return Err("bitmap embedding only".into());
+    }
+    let (name, name_len) = tables[&b"name"[..]];
+    let end = name + name_len;
+    let records = be16(name + 2).ok_or("truncated name")? as usize;
+    let storage = name + be16(name + 4).ok_or("truncated name")? as usize;
+    let mut families = Vec::new();
+    for i in 0..records.min(4096) {
+        let r = name + 6 + i * 12;
+        if r + 12 > end {
+            break;
+        }
+        let (platform, name_id) = (be16(r).unwrap_or(0), be16(r + 6).unwrap_or(0));
+        if name_id != 1 && name_id != 16 {
+            continue;
+        }
+        let (len, off) = (be16(r + 8).unwrap_or(0) as usize, be16(r + 10).unwrap_or(0) as usize);
+        let Some(raw) = bytes.get(storage + off..storage + off + len).filter(|_| storage + off + len <= end) else { continue };
+        let text = if platform == 0 || platform == 3 {
+            let units: Vec<u16> = raw.chunks_exact(2).map(|c| u16::from_be_bytes([c[0], c[1]])).collect();
+            String::from_utf16_lossy(&units)
+        } else if platform == 1 {
+            raw.iter().map(|&b| b as char).collect()
+        } else {
+            continue;
+        };
+        if !text.is_empty() && !families.contains(&text) {
+            families.push(text);
+        }
+    }
+    if families.is_empty() {
+        return Err("font has no family name".into());
+    }
+    Ok(families)
+}
