+fn attach_nested_shape_source_path(
+    node: &mut RenderNode,
+    section_index: usize,
+    parent_paragraph_index: usize,
+    parent_cell_path: &[CellPathEntry],
+    control_index: usize,
+) {
+    if parent_cell_path.is_empty() {
+        return;
+    }
+    let Ok(section_index) = u32::try_from(section_index) else {
+        return;
+    };
+    let Ok(parent_paragraph_index) = u32::try_from(parent_paragraph_index) else {
+        return;
+    };
+    let Ok(control_index) = u32::try_from(control_index) else {
+        return;
+    };
+    let mut path = vec![section_index, parent_paragraph_index];
+    for entry in parent_cell_path {
+        let (Ok(control), Ok(cell), Ok(paragraph)) = (
+            u32::try_from(entry.control_index),
+            u32::try_from(entry.cell_index),
+            u32::try_from(entry.cell_para_index),
+        ) else {
+            return;
+        };
+        path.extend([control, cell, paragraph]);
+    }
+    path.push(control_index);
+    node.source_path = Some(path);
+}
