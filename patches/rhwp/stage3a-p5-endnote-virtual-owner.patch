+#[cfg(test)]
+mod endnote_hit_info_tests {
+    use crate::document_core::{DocumentCore, NoteOwnerPath};
+    use crate::model::control::Control;
+
+    #[test]
+    fn virtual_endnote_hit_resolves_exact_note_and_rejects_body_or_wrong_kind_aliases() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        core.insert_text_native(0, 0, 0, "body text").unwrap();
+        let inserted = core.insert_endnote_native(0, 0, 4).unwrap();
+        let inserted: serde_json::Value = serde_json::from_str(&inserted).unwrap();
+        let control_idx = inserted["controlIdx"].as_u64().unwrap() as usize;
+        let (instance_id, number) =
+            match &core.document.sections[0].paragraphs[0].controls[control_idx] {
+                Control::Endnote(note) => (note.instance_id, note.number),
+                _ => panic!("inserted control is not an endnote"),
+            };
+        core.insert_text_in_note_native(
+            "endnote",
+            0,
+            0,
+            control_idx,
+            instance_id,
+            number,
+            0,
+            2,
+            "note text",
+        )
+        .unwrap();
+        let info: serde_json::Value = serde_json::from_str(
+            &core
+                .get_note_info_at_native("endnote", 0, 0, control_idx, NoteOwnerPath::Body)
+                .unwrap(),
+        )
+        .unwrap();
+        let edit: serde_json::Value =
+            serde_json::from_str(&core.get_note_edit_info_native(0, 0, control_idx).unwrap())
+                .unwrap();
+        let virtual_para = edit["virtualParaIndex"].as_u64().unwrap() as usize;
+        let page = edit["pageNum"].as_u64().unwrap() as u32;
+
+        let hit: serde_json::Value = serde_json::from_str(
+            &core
+                .get_endnote_hit_info_native(0, virtual_para, 0, page)
+                .unwrap(),
+        )
+        .unwrap();
+        assert_eq!(hit["kind"], "endnote");
+        assert_eq!(hit["section"], 0);
+        assert_eq!(hit["anchorParagraph"], 0);
+        assert_eq!(hit["control"], control_idx);
+        assert_eq!(hit["ownerPath"]["sourceType"], "body");
+        assert_eq!(hit["instanceId"], instance_id);
+        assert_eq!(hit["number"], number);
+        assert_eq!(hit["noteParagraph"], 0);
+        assert_eq!(hit["noteOffset"], info["editableStarts"][0]);
+        assert!(hit["renderPrefixLength"].as_u64().unwrap() > 0);
+        assert_eq!(hit["sourceLeadingSpaces"], 2);
+
+        assert!(core.get_endnote_hit_info_native(0, 0, 0, page).is_err());
+        assert!(core
+            .get_endnote_hit_info_native(0, virtual_para, 0, page.saturating_add(1))
+            .is_err());
+        assert!(core
+            .get_note_info_at_native("footnote", 0, 0, control_idx, NoteOwnerPath::Body)
+            .is_err());
+        assert!(core
+            .get_note_info_at_native(
+                "endnote",
+                0,
+                0,
+                control_idx,
+                NoteOwnerPath::TableCell {
+                    cell_index: 0,
+                    cell_para_index: 0,
+                    cell_control_index: 0,
+                }
+            )
+            .is_err());
+    }
