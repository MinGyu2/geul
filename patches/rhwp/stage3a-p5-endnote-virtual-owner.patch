+    /// Resolve an endnote hit in the rendered virtual paragraph back to its exact
+    /// owning control. Body paragraph indices never enter this path.
+    pub fn get_endnote_hit_info_native(
+        &self,
+        render_section_idx: usize,
+        virtual_para_idx: usize,
+        render_char_offset: usize,
+        preferred_page_num: u32,
+    ) -> Result<String, HwpError> {
+        use crate::document_core::NoteOwnerPath;
+        use crate::model::control::Control;
+
+        let body_count = self
+            .document
+            .sections
+            .get(render_section_idx)
+            .ok_or_else(|| HwpError::RenderError("미주 표시 구역이 없습니다".to_string()))?
+            .paragraphs
+            .len();
+        let local_idx = virtual_para_idx.checked_sub(body_count).ok_or_else(|| {
+            HwpError::RenderError("본문 문단은 미주 주소로 해석할 수 없습니다".to_string())
+        })?;
+        let pagination = self.pagination.get(render_section_idx).ok_or_else(|| {
+            HwpError::RenderError("미주 페이지네이션을 찾을 수 없습니다".to_string())
+        })?;
+        let source = pagination
+            .endnote_para_sources
+            .get(local_idx)
+            .ok_or_else(|| HwpError::RenderError("가상 미주 문단 주소가 없습니다".to_string()))?;
+        let owner_section = self
+            .document
+            .sections
+            .get(source.section_index)
+            .ok_or_else(|| HwpError::RenderError("미주 소유 구역이 없습니다".to_string()))?;
+        let owner_para = owner_section
+            .paragraphs
+            .get(source.para_index)
+            .ok_or_else(|| HwpError::RenderError("미주 앵커 문단이 없습니다".to_string()))?;
+        let Control::Endnote(note) = owner_para
+            .controls
+            .get(source.control_index)
+            .ok_or_else(|| HwpError::RenderError("미주 컨트롤 주소가 없습니다".to_string()))?
+        else {
+            return Err(HwpError::RenderError(
+                "가상 문단 소유자가 미주 컨트롤이 아닙니다".to_string(),
+            ));
+        };
+        let note_para = note
+            .paragraphs
+            .get(source.note_para_index)
+            .ok_or_else(|| HwpError::RenderError("미주 내부 문단 주소가 없습니다".to_string()))?;
+
+        // Every paragraph of this note must occupy one contiguous virtual range
+        // with a distinct inner paragraph index. This prevents a stale index
+        // from crossing into a neighboring endnote.
+        let first_local_idx = local_idx
+            .checked_sub(source.note_para_index)
+            .ok_or_else(|| {
+                HwpError::RenderError("미주 가상 문단 기준이 잘못되었습니다".to_string())
+            })?;
+        for (note_para_index, _) in note.paragraphs.iter().enumerate() {
+            let mapped = pagination
+                .endnote_para_sources
+                .get(first_local_idx + note_para_index);
+            if !mapped.is_some_and(|mapped| {
+                mapped.section_index == source.section_index
+                    && mapped.para_index == source.para_index
+                    && mapped.control_index == source.control_index
+                    && mapped.note_para_index == note_para_index
+            }) {
+                return Err(HwpError::RenderError(
+                    "미주 내부 문단과 가상 주소가 연속하지 않습니다".to_string(),
+                ));
+            }
+        }
+
+        let source_chars: Vec<char> = note_para.text.chars().collect();
+        let leading_spaces = if source.note_para_index == 0 {
+            source_chars
+                .iter()
+                .take_while(|ch| matches!(**ch, ' ' | '\u{00a0}' | '\u{2007}'))
+                .count()
+        } else {
+            0
+        };
+        let rendered_para = pagination
+            .endnote_paragraphs
+            .get(local_idx)
+            .ok_or_else(|| HwpError::RenderError("렌더된 미주 문단이 없습니다".to_string()))?;
+        let rendered_chars: Vec<char> = rendered_para.text.chars().collect();
+        if render_char_offset > rendered_chars.len() {
+            return Err(HwpError::RenderError(
+                "미주 렌더 문자 주소가 범위를 벗어났습니다".to_string(),
+            ));
+        }
+        let first_source_chars: Vec<char> = note
+            .paragraphs
+            .first()
+            .ok_or_else(|| HwpError::RenderError("미주에 내부 문단이 없습니다".to_string()))?
+            .text
+            .chars()
+            .collect();
+        let first_leading_spaces = first_source_chars
+            .iter()
+            .take_while(|ch| matches!(**ch, ' ' | '\u{00a0}' | '\u{2007}'))
+            .count();
+        let first_render_local = first_local_idx;
+        let first_rendered = pagination
+            .endnote_paragraphs
+            .get(first_render_local)
+            .ok_or_else(|| HwpError::RenderError("첫 렌더 미주 문단이 없습니다".to_string()))?;
+        let first_rendered_chars: Vec<char> = first_rendered.text.chars().collect();
+        let first_content = &first_source_chars[first_leading_spaces..];
+        if first_rendered_chars.len() < first_content.len()
+            || first_rendered_chars[first_rendered_chars.len() - first_content.len()..]
+                != *first_content
+        {
+            return Err(HwpError::RenderError(
+                "렌더 미주 본문이 원본 내부 문단과 일치하지 않습니다".to_string(),
+            ));
+        }
+        let render_prefix_length = first_rendered_chars.len() - first_content.len();
+        if render_prefix_length == 0 || render_prefix_length > 64 {
+            return Err(HwpError::RenderError(
+                "미주 번호 접두부를 증명할 수 없습니다".to_string(),
+            ));
+        }
+
+        let owner_path = NoteOwnerPath::Body;
+        let raw_info = self.get_note_info_at_native(
+            "endnote",
+            source.section_index,
+            source.para_index,
+            source.control_index,
+            owner_path,
+        )?;
+        let info: serde_json::Value = serde_json::from_str(&raw_info)
+            .map_err(|_| HwpError::RenderError("미주 소유 정보를 읽을 수 없습니다".to_string()))?;
+        let editable_start = info
+            .get("editableStarts")
+            .and_then(serde_json::Value::as_array)
+            .and_then(|items| items.get(source.note_para_index))
+            .and_then(serde_json::Value::as_u64)
+            .map(|value| value as usize)
+            .ok_or_else(|| {
+                HwpError::RenderError("미주 내부 문단이 편집 가능하지 않습니다".to_string())
+            })?;
+        let note_offset = if source.note_para_index == 0 {
+            if render_char_offset <= render_prefix_length {
+                editable_start
+            } else {
+                leading_spaces
+                    .saturating_add(render_char_offset - render_prefix_length)
+                    .max(editable_start)
+            }
+        } else {
+            render_char_offset.max(editable_start)
+        };
+        if note_offset > source_chars.len() {
+            return Err(HwpError::RenderError(
+                "미주 문자 주소가 원본 문단 범위를 벗어났습니다".to_string(),
+            ));
+        }
+
+        let page_base = self.global_page_base_for_section(render_section_idx);
+        let page_contains_para = |page: &crate::renderer::pagination::PageContent| {
+            page.column_contents
+                .iter()
+                .flat_map(|column| column.items.iter())
+                .any(|item| item.para_index() == virtual_para_idx)
+        };
+        let page_num = pagination
+            .pages
+            .iter()
+            .enumerate()
+            .find(|(_, page)| {
+                page_base.saturating_add(page.page_index) == preferred_page_num
+                    && page_contains_para(page)
+            })
+            .map(|(_, _)| preferred_page_num)
+            .ok_or_else(|| {
+                HwpError::RenderError("미주 문단이 지정된 쪽에 배치되지 않았습니다".to_string())
+            })?;
+
+        Ok(serde_json::json!({
+            "hit": true,
+            "kind": "endnote",
+            "section": source.section_index,
+            "anchorParagraph": source.para_index,
+            "control": source.control_index,
+            "ownerPath": owner_path.to_json(),
+            "instanceId": note.instance_id,
+            "number": note.number,
+            "noteParagraph": source.note_para_index,
+            "noteOffset": note_offset,
+            "renderSection": render_section_idx,
+            "renderParagraph": virtual_para_idx,
+            "renderParagraphBase": body_count + first_local_idx,
+            "renderPrefixLength": render_prefix_length,
+            "sourceLeadingSpaces": first_leading_spaces,
+            "viewPage": page_num,
+        })
+        .to_string())
+    }
+
