+    /// Return only HWPX LINE records whose full source envelopes are known.
+    /// CURVE records and proprietary attributes remain editable only at their
+    /// already-supported endpoints.
+    pub fn editable_hwpx_curve_line_segments(
+        &self, sec: usize, para: usize, ctrl: usize,
+    ) -> Option<Vec<usize>> {
+        if self.source_format != crate::parser::FileFormat::Hwpx {
+            return None;
+        }
+        let ShapeObject::Curve(curve) = self.advanced_body_shape(sec, para, ctrl)? else {
+            return None;
+        };
+        if !geul_hwpx_curve_matches(&curve.hwpx_segments, &curve.points) {
+            return None;
+        }
+        Some(
+            curve.hwpx_segments
+                .iter()
+                .enumerate()
+                .filter_map(|(index, segment)| {
+                    geul_hwpx_line_segment_is_editable(segment).then_some(index)
+                })
+                .collect(),
+        )
+    }
+
+    /// Split one explicit standard HWPX LINE at an interior collinear point,
+    /// or join two such lines at an interior collinear vertex. No CURVE or
+    /// extended segment record is rewritten by this operation.
+    pub fn edit_hwpx_curve_line(
+        &mut self, sec: usize, para: usize, ctrl: usize, index: usize,
+        split_at: Option<crate::model::Point>,
+    ) -> Result<(), HwpError> {
+        let (mut segments, mut points, width, height) = {
+            if self.source_format != crate::parser::FileFormat::Hwpx {
+                return Err(geul_bad_shape_edit());
+            }
+            let Some(ShapeObject::Curve(curve)) = self.advanced_body_shape(sec, para, ctrl) else {
+                return Err(geul_bad_shape_edit());
+            };
+            if !geul_hwpx_curve_matches(&curve.hwpx_segments, &curve.points) {
+                return Err(geul_bad_shape_edit());
+            }
+            (
+                curve.hwpx_segments.clone(),
+                curve.points.clone(),
+                curve.drawing.shape_attr.original_width as i32,
+                curve.drawing.shape_attr.original_height as i32,
+            )
+        };
+        let between = |a, point, b| {
+            !geul_same_point(&a, &point) && !geul_same_point(&point, &b)
+                && geul_within_segment_bounds(point, a, b)
+                && geul_cross(a, b, point) == 0
+        };
+        if let Some(point) = split_at {
+            if segments.len() >= 256 || points.len() >= 257 || index >= segments.len()
+                || !geul_hwpx_line_segment_is_editable(&segments[index])
+                || point.x < 0 || point.y < 0 || point.x > width || point.y > height
+                || !between(segments[index].start, point, segments[index].end)
+            {
+                return Err(geul_bad_shape_edit());
+            }
+            let mut first = segments[index].clone();
+            let mut second = first.clone();
+            first.end = point;
+            first.coordinates_edited = true;
+            second.start = point;
+            second.coordinates_edited = true;
+            segments.splice(index..=index, [first, second]);
+            points.insert(index + 1, point);
+        } else {
+            if index == 0 || index >= points.len() - 1 || index >= segments.len()
+                || !geul_hwpx_line_segment_is_editable(&segments[index - 1])
+                || !geul_hwpx_line_segment_is_editable(&segments[index])
+                || !between(points[index - 1], points[index], points[index + 1])
+            {
+                return Err(geul_bad_shape_edit());
+            }
+            let mut merged = segments[index - 1].clone();
+            merged.end = points[index + 1];
+            merged.coordinates_edited = true;
+            segments[index - 1] = merged;
+            segments.remove(index);
+            points.remove(index);
+        }
+        if !geul_hwpx_curve_matches(&segments, &points) {
+            return Err(geul_bad_shape_edit());
+        }
+        let ShapeObject::Curve(curve) = self.resolve_shape_control_mut(sec, para, ctrl)? else {
+            return Err(geul_bad_shape_edit());
+        };
+        curve.points = points;
+        curve.hwpx_segments = segments;
         self.refresh_advanced_shape(sec);
         Ok(())
     }
