+/// A line segment can be split or joined only when its source record contains
+/// exactly the standard attributes we understand. Unknown attributes stay
+/// round-trippable, but editing that segment could change their meaning.
+fn geul_hwpx_line_segment_is_editable(segment: &HwpxCurveSegment) -> bool {
+    if segment.has_children || segment.attributes.len() != 5 {
+        return false;
+    }
+    let mut names = std::collections::BTreeSet::new();
+    for (name, _) in &segment.attributes {
+        if !matches!(name.as_str(), "type" | "x1" | "y1" | "x2" | "y2")
+            || !names.insert(name.as_str())
+        {
+            return false;
+        }
+    }
+    names.len() == 5
+        && segment
+            .attributes
+            .iter()
+            .find(|(name, _)| name == "type")
+            .is_some_and(|(_, value)| value == "LINE")
 }
