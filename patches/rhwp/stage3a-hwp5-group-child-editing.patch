+
+fn parse_hwp5_container_child_ctrl_ids(data: &[u8], attr: &ShapeComponentAttr) -> Option<Vec<u32>> {
+    if attr.ctrl_id != tags::SHAPE_CONTAINER_ID || !attr.is_two_ctrl_id {
+        return None;
+    }
+    if attr.raw_rendering.len() < 2 {
+        return None;
+    }
+    let rendering_count = u16::from_le_bytes([attr.raw_rendering[0], attr.raw_rendering[1]]) as usize;
+    if rendering_count.checked_mul(96).and_then(|n| n.checked_add(50)) != Some(attr.raw_rendering.len()) {
+        return None;
+    }
+    let table_at = 8usize.checked_add(42)?.checked_add(attr.raw_rendering.len())?;
+    let count_end = table_at.checked_add(2)?;
+    let count = u16::from_le_bytes(data.get(table_at..count_end)?.try_into().ok()?) as usize;
+    let ids_bytes = count.checked_mul(4)?;
+    let expected_len = table_at.checked_add(2)?.checked_add(ids_bytes)?.checked_add(4)?;
+    if data.len() != expected_len {
+        return None;
+    }
+    let mut ids = Vec::with_capacity(count);
+    for index in 0..count {
+        let at = table_at + 2 + index * 4;
+        ids.push(u32::from_le_bytes(data.get(at..at + 4)?.try_into().ok()?));
+    }
+    Some(ids)
 }
 
