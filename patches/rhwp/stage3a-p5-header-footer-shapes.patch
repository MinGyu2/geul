+fn header_footer_paragraphs<'a>(
+    control: &'a Control,
+    kind: &str,
+) -> Result<&'a [Paragraph], HwpError> {
+    match (kind, control) {
+        ("header", Control::Header(header)) => Ok(&header.paragraphs),
+        ("footer", Control::Footer(footer)) => Ok(&footer.paragraphs),
+        _ => Err(HwpError::RenderError(
+            "머리말/꼬리말 종류와 실제 소유자가 일치하지 않습니다".to_string(),
+        )),
+    }
+}
+
+fn header_footer_paragraphs_mut<'a>(
+    control: &'a mut Control,
+    kind: &str,
+) -> Result<&'a mut Vec<Paragraph>, HwpError> {
+    match (kind, control) {
+        ("header", Control::Header(header)) => Ok(&mut header.paragraphs),
+        ("footer", Control::Footer(footer)) => Ok(&mut footer.paragraphs),
+        _ => Err(HwpError::RenderError(
+            "머리말/꼬리말 종류와 실제 소유자가 일치하지 않습니다".to_string(),
+        )),
+    }
+}
