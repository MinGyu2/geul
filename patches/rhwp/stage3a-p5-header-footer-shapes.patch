+fn validate_header_footer_shape_edit(
+    shape: &ShapeObject,
+    props_json: &str,
+) -> Result<(), HwpError> {
+    use serde_json::Value;
+    let invalid = || HwpError::RenderError("Unsupported header/footer Shape edit".to_string());
+    if shape.common().locked {
+        return Err(HwpError::RenderError(
+            "잠긴 머리말/꼬리말 개체는 편집할 수 없습니다".to_string(),
+        ));
+    }
+    let value: Value = serde_json::from_str(props_json).map_err(|_| invalid())?;
+    let object = value
+        .as_object()
+        .filter(|object| !object.is_empty())
+        .ok_or_else(invalid)?;
+    const ALLOWED: &[&str] = &[
+        "width",
+        "height",
+        "horzOffset",
+        "vertOffset",
+        "rotationAngle",
+        "horzFlip",
+        "vertFlip",
+        "borderColor",
+        "borderWidth",
+        "fillType",
+        "fillBgColor",
+        "treatAsChar",
+        "textWrap",
+    ];
+    if object.keys().any(|key| !ALLOWED.contains(&key.as_str())) {
+        return Err(invalid());
+    }
+    let integer = |key: &str, min: i64, max: i64| -> Result<(), HwpError> {
+        if object.get(key).is_some_and(|value| {
+            value
+                .as_i64()
+                .is_none_or(|number| !(min..=max).contains(&number))
+        }) {
+            Err(invalid())
+        } else {
+            Ok(())
+        }
+    };
+    for key in ["width", "height"] {
+        integer(key, 1, 2_000_000)?;
+    }
+    for key in ["horzOffset", "vertOffset"] {
+        integer(key, -2_000_000, 2_000_000)?;
+    }
+    integer("rotationAngle", 0, 359)?;
+    integer("borderColor", 0, 0x00ff_ffff)?;
+    integer("borderWidth", 1, 7200)?;
+    integer("fillBgColor", 0, 0x00ff_ffff)?;
+    for key in ["horzFlip", "vertFlip", "treatAsChar"] {
+        if object.get(key).is_some_and(|value| !value.is_boolean()) {
+            return Err(invalid());
+        }
+    }
+    if object
+        .get("fillType")
+        .is_some_and(|value| !matches!(value.as_str(), Some("none" | "solid")))
+        || object.get("textWrap").is_some_and(|value| {
+            !matches!(
+                value.as_str(),
+                Some(
+                    "Square"
+                        | "Tight"
+                        | "Through"
+                        | "TopAndBottom"
+                        | "BehindText"
+                        | "InFrontOfText"
+                )
+            )
+        })
+    {
+        return Err(invalid());
+    }
+    if (object.contains_key("width") || object.contains_key("height"))
+        && shape.common().size_protect
+    {
+        return Err(HwpError::RenderError(
+            "크기 보호된 머리말/꼬리말 개체는 크기를 바꿀 수 없습니다".to_string(),
+        ));
+    }
+    Ok(())
+}
+
+fn parse_header_footer_cell_path(json: &str) -> Result<Vec<(usize, usize, usize)>, HwpError> {
+    if json.len() > 16 * 1024 {
+        return Err(HwpError::RenderError(
+            "머리말/꼬리말 셀 경로가 너무 큽니다".to_string(),
+        ));
+    }
+    let parsed: Vec<HeaderFooterCellPathEntry> = serde_json::from_str(json)
+        .map_err(|error| HwpError::RenderError(format!("셀 경로 JSON 파싱 실패: {error}")))?;
+    if parsed.len() > 64 {
+        return Err(HwpError::RenderError(
+            "머리말/꼬리말 셀 경로 깊이 초과".to_string(),
+        ));
+    }
+    Ok(parsed
+        .into_iter()
+        .map(|entry| {
+            (
+                entry.control_index as usize,
+                entry.cell_index as usize,
+                entry.cell_para_index as usize,
+            )
+        })
+        .collect())
+}
 
