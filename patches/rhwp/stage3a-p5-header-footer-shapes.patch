+    /// Mutate exactly one Shape owned by the addressed header/footer paragraph or table cell.
+    pub fn set_header_footer_shape_properties_native(
+        &mut self,
+        section_idx: usize,
+        kind: &str,
+        outer_para_idx: usize,
+        outer_control_idx: usize,
+        inner_para_idx: usize,
+        cell_path_json: &str,
+        inner_control_idx: usize,
+        props_json: &str,
+    ) -> Result<String, HwpError> {
+        let path = parse_header_footer_cell_path(cell_path_json)?;
+        let caption_changed = {
+            let section = self.document.sections.get_mut(section_idx).ok_or_else(|| {
+                HwpError::RenderError(format!("구역 인덱스 {section_idx} 범위 초과"))
+            })?;
+            let outer_para = section.paragraphs.get_mut(outer_para_idx).ok_or_else(|| {
+                HwpError::RenderError(format!("외부 문단 인덱스 {outer_para_idx} 범위 초과"))
+            })?;
+            let outer_control =
+                outer_para
+                    .controls
+                    .get_mut(outer_control_idx)
+                    .ok_or_else(|| {
+                        HwpError::RenderError(format!(
+                            "외부 컨트롤 인덱스 {outer_control_idx} 범위 초과"
+                        ))
+                    })?;
+            let inner_paragraphs = header_footer_paragraphs_mut(outer_control, kind)?;
+            let mut paragraph = inner_paragraphs.get_mut(inner_para_idx).ok_or_else(|| {
+                HwpError::RenderError(format!("내부 문단 인덱스 {inner_para_idx} 범위 초과"))
+            })?;
+            for (level, &(table_idx, cell_idx, cell_para_idx)) in path.iter().enumerate() {
+                let control = paragraph.controls.get_mut(table_idx).ok_or_else(|| {
+                    HwpError::RenderError(format!(
+                        "셀 경로 {level}의 표 컨트롤이 범위를 벗어났습니다"
+                    ))
+                })?;
+                let table = match control {
+                    Control::Table(table) => table,
+                    _ => {
+                        return Err(HwpError::RenderError(
+                            "셀 경로가 표 소유자를 가리키지 않습니다".to_string(),
+                        ));
+                    }
+                };
+                let cell = table.cells.get_mut(cell_idx).ok_or_else(|| {
+                    HwpError::RenderError(format!("셀 경로 {level}의 셀이 범위를 벗어났습니다"))
+                })?;
+                paragraph = cell.paragraphs.get_mut(cell_para_idx).ok_or_else(|| {
+                    HwpError::RenderError(format!("셀 경로 {level}의 문단이 범위를 벗어났습니다"))
+                })?;
+            }
+            let control = paragraph
+                .controls
+                .get_mut(inner_control_idx)
+                .ok_or_else(|| {
+                    HwpError::RenderError(format!(
+                        "내부 컨트롤 인덱스 {inner_control_idx} 범위 초과"
+                    ))
+                })?;
+            let shape = match control {
+                Control::Shape(shape) => shape.as_mut(),
+                _ => {
+                    return Err(HwpError::RenderError(
+                        "지정된 story 개체가 Shape이 아닙니다".to_string(),
+                    ));
+                }
+            };
+            validate_header_footer_shape_edit(shape, props_json)?;
+            Self::apply_shape_props_inner(
+                shape,
+                props_json,
+                matches!(self.source_format, crate::parser::FileFormat::Hwp),
+            )?
+        };
+        if caption_changed {
+            crate::parser::assign_auto_numbers(&mut self.document);
+        }
+        self.document.sections[section_idx].raw_stream = None;
+        self.recompose_section(section_idx);
+        self.paginate_if_needed();
+        self.invalidate_page_tree_cache();
+        self.event_log.push(DocumentEvent::PictureResized {
+            section: section_idx,
+            para: outer_para_idx,
+            ctrl: outer_control_idx,
+        });
+        Ok("{\"ok\":true}".to_string())
+    }
