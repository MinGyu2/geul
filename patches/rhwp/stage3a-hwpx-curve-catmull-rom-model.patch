+    /// All-CURVE HWPX chains with standard, childless source envelopes expose
+    /// anchor insertion/removal. Their cubic handles are derived on demand.
+    pub fn editable_hwpx_curve_segments(
+        &self, sec: usize, para: usize, ctrl: usize,
+    ) -> Option<Vec<usize>> {
+        if self.source_format != crate::parser::FileFormat::Hwpx {
+            return None;
+        }
+        let ShapeObject::Curve(curve) = self.advanced_body_shape(sec, para, ctrl)? else {
+            return None;
+        };
+        let beziers = curve.hwpx_bezier_segments()?;
+        Some((0..beziers.len()).collect())
