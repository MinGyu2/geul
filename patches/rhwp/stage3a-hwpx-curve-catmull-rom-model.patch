+    /// Insert an anchor into one strict HWPX CURVE segment, or remove an
+    /// existing internal/closed-path anchor. Only standard source records are
+    /// eligible, so no opaque segment metadata is discarded or guessed.
+    pub fn edit_hwpx_curve_anchor(
+        &mut self, sec: usize, para: usize, ctrl: usize, index: usize,
+        insert: Option<crate::model::Point>,
+    ) -> Result<(), HwpError> {
+        let (mut points, mut segments, width, height, closed, beziers) = {
+            if self.source_format != crate::parser::FileFormat::Hwpx {
+                return Err(geul_bad_shape_edit());
+            }
+            let Some(ShapeObject::Curve(curve)) = self.advanced_body_shape(sec, para, ctrl) else {
+                return Err(geul_bad_shape_edit());
+            };
+            let Some(beziers) = curve.hwpx_bezier_segments() else {
+                return Err(geul_bad_shape_edit());
+            };
+            let closed = curve.points.len() > 1
+                && geul_same_point(&curve.points[0], curve.points.last().unwrap());
+            (
+                curve.points.clone(),
+                curve.hwpx_segments.clone(),
+                curve.drawing.shape_attr.original_width as i32,
+                curve.drawing.shape_attr.original_height as i32,
+                closed,
+                beziers,
+            )
+        };
+        if let Some(point) = insert {
+            let expected = beziers.get(index).map(|segment| crate::model::Point {
+                x: ((segment.start.x + 3.0 * segment.control1.x
+                    + 3.0 * segment.control2.x + segment.end.x) / 8.0).round() as i32,
+                y: ((segment.start.y + 3.0 * segment.control1.y
+                    + 3.0 * segment.control2.y + segment.end.y) / 8.0).round() as i32,
+            });
+            if segments.len() >= 256 || points.len() >= 257 || index >= segments.len()
+                || point.x < 0 || point.y < 0 || point.x > width || point.y > height
+                || expected.is_none_or(|expected| expected.x != point.x || expected.y != point.y)
+                || points.iter().any(|existing| geul_same_point(existing, &point))
+            {
+                return Err(geul_bad_shape_edit());
+            }
+            let mut first = segments[index].clone();
+            let mut second = first.clone();
+            first.end = point;
+            first.coordinates_edited = true;
+            second.start = point;
+            second.coordinates_edited = true;
+            segments.splice(index..=index, [first, second]);
+            points.insert(index + 1, point);
+        } else {
+            let anchors = if closed { points.len() - 1 } else { points.len() };
+            if index >= anchors
+                || (closed && anchors <= 3)
+                || (!closed && (points.len() <= 3 || index == 0 || index + 1 >= points.len()))
+            {
+                return Err(geul_bad_shape_edit());
+            }
+            let previous_segment = if index == 0 { segments.len() - 1 } else { index - 1 };
+            let next_anchor = if index + 1 < anchors { points[index + 1] } else { points[0] };
+            segments[previous_segment].end = next_anchor;
+            segments[previous_segment].coordinates_edited = true;
+            segments.remove(index);
+            points.remove(index);
+            if closed && index == 0 {
+                points.pop();
+                points.push(points[0]);
+            }
+        }
+        let candidate = crate::model::shape::CurveShape {
+            points: points.clone(),
+            hwpx_segments: segments.clone(),
+            ..Default::default()
+        };
+        if candidate.hwpx_bezier_segments().is_none() {
+            return Err(geul_bad_shape_edit());
+        }
+        let ShapeObject::Curve(curve) = self.resolve_shape_control_mut(sec, para, ctrl)? else {
+            return Err(geul_bad_shape_edit());
+        };
+        curve.points = points;
+        curve.hwpx_segments = segments;
+        self.refresh_advanced_shape(sec);
+        Ok(())
     }
 
