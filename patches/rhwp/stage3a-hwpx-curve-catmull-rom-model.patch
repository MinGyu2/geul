+    fn hwpx_standard_curve_derives_hancom_catmull_rom_bezier_handles() {
+        // Anchors from a Hancom-rendered SimpleCurve HWPX reference sample.
+        let curve = hwpx_curve_from_anchors(
+            &[
+                (450, 6140),
+                (8000, 11215),
+                (2500, 19340),
+                (14175, 20515),
+                (15675, 8440),
+                (2475, 15),
+            ],
+            true,
+        );
+        let beziers = LayoutEngine::hwpx_curve_catmull_beziers(&curve).unwrap();
+        assert_eq!(beziers.len(), 6);
+        let close = |actual: f64, expected: f64| assert!((actual - expected).abs() < 1e-9);
+        close(beziers[0].0.0, 1370.8333333333333);
+        close(beziers[0].0.1, 8006.666666666667);
+        close(beziers[0].1.0, 7658.333333333333);
+        close(beziers[0].1.1, 9015.0);
+
+        // The 16-step cubic envelope reproduces the sample's serialized orgSz.
+        let mut xs = Vec::new();
+        let mut ys = Vec::new();
+        for (index, (control1, control2, end)) in beziers.iter().enumerate() {
+            let start = curve.points[index];
+            for step in 0..=16 {
+                let t = step as f64 / 16.0;
+                let u = 1.0 - t;
+                let x = u.powi(3) * start.x as f64
+                    + 3.0 * u.powi(2) * t * control1.0
+                    + 3.0 * u * t.powi(2) * control2.0
+                    + t.powi(3) * end.0;
+                let y = u.powi(3) * start.y as f64
