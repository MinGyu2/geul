+impl CurveShape {
+    /// Derive cubic handles for an unextended, all-CURVE HWPX anchor chain.
+    /// Hancom's observed interpolation is Catmull-Rom: handles use adjacent
+    /// anchor differences divided by six; closed paths wrap neighbors and
+    /// open paths clamp the endpoint neighbor to the endpoint itself.
+    ///
+    /// Return `None` when a source envelope is mixed, extended, disconnected,
+    /// or inconsistent. Such records stay preserved but are not reinterpreted.
+    pub fn hwpx_bezier_segments(&self) -> Option<Vec<DerivedBezierSegment>> {
+        let segments = &self.hwpx_segments;
+        if segments.is_empty()
+            || segments.len() > 4096
+            || self.points.len() != segments.len() + 1
+        {
+            return None;
+        }
+        let same_point = |a: &Point, b: &Point| a.x == b.x && a.y == b.y;
+        for (index, segment) in segments.iter().enumerate() {
+            if segment.has_children
+                || segment.attributes.len() != 5
+                || !same_point(&segment.start, &self.points[index])
+                || !same_point(&segment.end, &self.points[index + 1])
+            {
+                return None;
+            }
+            let mut names = std::collections::BTreeSet::new();
+            for (name, _) in &segment.attributes {
+                if !matches!(name.as_str(), "type" | "x1" | "y1" | "x2" | "y2")
+                    || !names.insert(name.as_str())
+                {
+                    return None;
+                }
+            }
+            let attribute = |name: &str| {
+                segment
+                    .attributes
+                    .iter()
+                    .find(|(key, _)| key == name)
+                    .map(|(_, value)| value.as_str())
+            };
+            if names.len() != 5
+                || attribute("type") != Some("CURVE")
+                || attribute("x1").and_then(|value| value.parse::<i32>().ok())
+                    != Some(segment.start.x)
+                || attribute("y1").and_then(|value| value.parse::<i32>().ok())
+                    != Some(segment.start.y)
+                || attribute("x2").and_then(|value| value.parse::<i32>().ok())
+                    != Some(segment.end.x)
+                || attribute("y2").and_then(|value| value.parse::<i32>().ok())
+                    != Some(segment.end.y)
+            {
+                return None;
+            }
+        }
+
+        let closed = self.points.len() > 1
+            && same_point(&self.points[0], self.points.last()?);
+        let anchors = if closed {
+            let unique = self.points.len().checked_sub(1)?;
+            if unique < 3 || unique != segments.len() {
+                return None;
+            }
+            &self.points[..unique]
+        } else {
+            if self.points.len() < 2 || self.points.len() - 1 != segments.len() {
+                return None;
+            }
+            self.points.as_slice()
+        };
+
+        let count = anchors.len();
+        let mut derived = Vec::with_capacity(segments.len());
+        for index in 0..segments.len() {
+            let start = index;
+            let end = if closed { (index + 1) % count } else { index + 1 };
+            let previous = if index > 0 {
+                index - 1
+            } else if closed {
+                count - 1
+            } else {
+                start
+            };
+            let next = if end + 1 < count {
+                end + 1
+            } else if closed {
+                0
+            } else {
+                end
+            };
+            let p0 = anchors[start];
+            let p1 = anchors[end];
+            let p_prev = anchors[previous];
+            let p_next = anchors[next];
+            derived.push(DerivedBezierSegment {
+                start: DerivedCurvePoint { x: p0.x as f64, y: p0.y as f64 },
+                control1: DerivedCurvePoint {
+                    x: p0.x as f64 + (p1.x as f64 - p_prev.x as f64) / 6.0,
+                    y: p0.y as f64 + (p1.y as f64 - p_prev.y as f64) / 6.0,
+                },
+                control2: DerivedCurvePoint {
+                    x: p1.x as f64 - (p_next.x as f64 - p0.x as f64) / 6.0,
+                    y: p1.y as f64 - (p_next.y as f64 - p0.y as f64) / 6.0,
+                },
+                end: DerivedCurvePoint { x: p1.x as f64, y: p1.y as f64 },
+            });
+        }
+        Some(derived)
+    }
 }
 
