+                    + 3.0 * u * t.powi(2) * control2.1
+                    + t.powi(3) * end.1;
+                xs.push(x);
+                ys.push(y);
+            }
+        }
+        let width = xs.iter().copied().fold(f64::NEG_INFINITY, f64::max)
+            - xs.iter().copied().fold(f64::INFINITY, f64::min);
+        let height = ys.iter().copied().fold(f64::NEG_INFINITY, f64::max)
+            - ys.iter().copied().fold(f64::INFINITY, f64::min);
+        assert_eq!(width.round() as i32, 16636);
+        assert_eq!(height.round() as i32, 21360);
+    }
