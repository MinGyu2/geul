+    fn spine_of(original: &str, sections: usize) -> Result<String, SerializeError> {
+        let hrefs: Vec<String> = (0..sections)
+            .map(|i| format!("Contents/section{i}.xml"))
+            .collect();
+        write_content_hpf(&hrefs, &[], &[], Some(original.as_bytes()))
+            .map(|out| String::from_utf8(out).unwrap())
+    }
+
+    const OPF: &str = r#"<opf:package xmlns:opf="http://www.idpf.org/2007/opf/"><opf:manifest/>"#;
+
+    #[test]
+    fn spine_linear_presence_and_value_follow_the_original() {
+        let original = format!(
+            r#"{OPF}<opf:spine><opf:itemref idref="header" linear="no"/><opf:itemref idref="section0"/><opf:itemref idref="section1" linear="yes"/></opf:spine></opf:package>"#
+        );
+        let s = spine_of(&original, 3).unwrap();
+        assert!(
+            s.contains(r#"<opf:itemref idref="header" linear="no"/>"#),
+            "{s}"
+        );
+        assert!(s.contains(r#"<opf:itemref idref="section0"/>"#), "{s}");
+        assert!(
+            s.contains(r#"<opf:itemref idref="section1" linear="yes"/>"#),
+            "{s}"
+        );
+        // A spine item the original did not have keeps the previous default.
+        assert!(
+            s.contains(r#"<opf:itemref idref="section2" linear="yes"/>"#),
+            "{s}"
+        );
+        // Repeated export from the same original is identical.
+        assert_eq!(spine_of(&original, 3).unwrap(), s);
+    }
+
+    #[test]
+    fn unsupported_or_conflicting_spine_linear_is_refused() {
+        let unknown = format!(
+            r#"{OPF}<opf:spine><opf:itemref idref="section0" linear="maybe"/></opf:spine></opf:package>"#
+        );
+        assert!(
+            matches!(spine_of(&unknown, 1), Err(SerializeError::UnsupportedInput(m)) if m.contains("linear"))
+        );
+        let conflict = format!(
+            r#"{OPF}<opf:spine><opf:itemref idref="section0" linear="no"/><opf:itemref idref="section0"/></opf:spine></opf:package>"#
+        );
+        assert!(
+            matches!(spine_of(&conflict, 1), Err(SerializeError::UnsupportedInput(m)) if m.contains("conflicting"))
+        );
+    }
+
+    #[test]
+    fn unreadable_original_content_hpf_keeps_previous_spine_default() {
