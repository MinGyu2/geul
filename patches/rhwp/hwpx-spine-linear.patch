+/// `linear` of each original spine `itemref`, keyed by `idref`: `None` when
+/// the attribute is absent. OPF defines absent as "yes", but the presence is part
+/// of the source package, and an explicit "no" (non-linear item) must never be
+/// rewritten as "yes". Values other than yes/no, or one idref listed with
+/// conflicting values, are refused instead of being normalized. A content.hpf
+/// that cannot be read keeps the previous default (geul treats such an original
+/// as malformed and does not save it).
+fn extract_spine_linear(
+    original: &str,
+) -> Result<std::collections::BTreeMap<String, Option<String>>, SerializeError> {
+    use quick_xml::events::Event;
+    let mut reader = quick_xml::Reader::from_str(original);
+    let mut out = std::collections::BTreeMap::new();
+    loop {
+        match reader.read_event() {
+            Ok(Event::Empty(ref e)) | Ok(Event::Start(ref e))
+                if e.name().as_ref().rsplit(':').next() == Some("itemref") =>
+            {
+                let (mut idref, mut linear) = (None, None);
+                for attr in e.attributes().flatten() {
+                    match attr.key.as_ref().rsplit(':').next() {
+                        Some("idref") => idref = Some(attr.value.as_ref().to_owned()),
+                        Some("linear") => linear = Some(attr.value.as_ref().to_owned()),
+                        _ => {}
+                    }
+                }
+                let Some(idref) = idref else { continue };
+                if let Some(value) = &linear {
+                    if value != "yes" && value != "no" {
+                        return Err(SerializeError::UnsupportedInput(format!(
+                            "unsupported OPF spine linear value: {value:?}"
+                        )));
+                    }
+                }
+                if let Some(previous) = out.insert(idref, linear.clone()) {
+                    if previous != linear {
+                        return Err(SerializeError::UnsupportedInput(
+                            "conflicting OPF spine linear values for one idref".into(),
+                        ));
+                    }
+                }
+            }
+            Ok(Event::Eof) => return Ok(out),
+            Err(_) => return Ok(std::collections::BTreeMap::new()),
+            _ => {}
+        }
+    }
+}
