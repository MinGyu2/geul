+
+/// Return the shared node chain only for connected, fully described HWPX
+/// segments whose original command identities are understood by the editor.
+/// Unknown command types remain round-trippable but fail closed for editing.
+fn geul_hwpx_curve_points(segments: &[HwpxCurveSegment]) -> Option<Vec<crate::model::Point>> {
+    if !(2..=256).contains(&segments.len()) {
+        return None;
+    }
+    let mut points = Vec::with_capacity(segments.len() + 1);
+    for (index, segment) in segments.iter().enumerate() {
+        let attribute = |name: &str| {
+            let mut values = segment.attributes.iter().filter(|(key, _)| key == name);
+            let value = values.next()?.1.as_str();
+            values.next().is_none().then_some(value)
+        };
+        let x1 = attribute("x1")?.parse::<i32>().ok()?;
+        let y1 = attribute("y1")?.parse::<i32>().ok()?;
+        let x2 = attribute("x2")?.parse::<i32>().ok()?;
+        let y2 = attribute("y2")?.parse::<i32>().ok()?;
+        if !matches!(attribute("type"), Some("LINE" | "CURVE"))
+            || (!segment.coordinates_edited && (x1 != segment.start.x || y1 != segment.start.y
+                || x2 != segment.end.x || y2 != segment.end.y))
+            || (index > 0 && !geul_same_point(&segments[index - 1].end, &segment.start))
+        {
+            return None;
+        }
+        if index == 0 {
+            points.push(segment.start);
+        }
+        points.push(segment.end);
+    }
+    Some(points)
+}
+
+fn geul_hwpx_curve_matches(segments: &[HwpxCurveSegment], points: &[crate::model::Point]) -> bool {
