+/// Serialize original HWPX segment records without translating their type or
+/// unrelated attributes through the HWP5 cubic command model.
+fn hwpx_curve_segments_xml(segments: &[crate::model::shape::HwpxCurveSegment]) -> String {
+    segments
+        .iter()
+        .map(|segment| {
+            let mut xml = String::from("<hp:seg");
+            for (name, original) in &segment.attributes {
+                let value = if segment.coordinates_edited {
+                    match name.as_str() {
+                        "x1" => segment.start.x.to_string(),
+                        "y1" => segment.start.y.to_string(),
+                        "x2" => segment.end.x.to_string(),
+                        "y2" => segment.end.y.to_string(),
+                        _ => original.clone(),
+                    }
+                } else {
+                    original.clone()
+                };
+                xml.push(' ');
+                xml.push_str(name);
+                xml.push_str("=\"");
+                xml.push_str(&xml_escape(&value));
+                xml.push('"');
+            }
+            xml.push_str("/>");
+            xml
         })
         .collect()
 }
