+    fn editable_terminal_curve(&self, sec: usize, para: usize, ctrl: usize)
+        -> Option<(&crate::model::shape::CurveShape, usize)>
+    {
+        let ShapeObject::Curve(curve) = self.advanced_body_shape(sec, para, ctrl)? else {
+            return None;
+        };
+        if !curve.drawing.shape_attr.hwp5_known_curve_leaf {
+            return None;
+        }
+        let path = self.editable_shape_path(sec, para, ctrl)?;
+        let handles = path["points"].as_array()?;
+        let controls = handles.iter().filter(|point| point["control"].as_bool() == Some(true)).count();
+        Some((curve, curve.segment_types.len() - controls))
+    }
+
+    pub fn curve_terminal_line_edits(&self, sec: usize, para: usize, ctrl: usize) -> Option<serde_json::Value> {
+        let (curve, used) = self.editable_terminal_curve(sec, para, ctrl)?;
+        Some(serde_json::json!({
+            "append": curve.points.len() < 257,
+            "remove": curve.segment_types[used - 1] == 0
+        }))
+    }
+
+    pub fn edit_curve_terminal_line(
+        &mut self, sec: usize, para: usize, ctrl: usize, append: Option<crate::model::Point>,
+    ) -> Result<(), HwpError> {
+        let (curve, used) = self.editable_terminal_curve(sec, para, ctrl).ok_or_else(geul_bad_shape_edit)?;
+        let mut points = curve.points.clone();
+        let mut commands = curve.segment_types.clone();
+        if let Some(end) = append {
+            let attr = &curve.drawing.shape_attr;
+            if points.len() == 257 || !(0..=attr.original_width as i32).contains(&end.x)
+                || !(0..=attr.original_height as i32).contains(&end.y)
+            {
+                return Err(geul_bad_shape_edit());
+            }
+            points.push(end);
+            // An unused zero command at 'used' is now a line. The array still
+            // has one byte per point after the start, including unused zeroes.
+            commands.push(0);
+        } else {
+            if commands[used - 1] != 0 {
+                return Err(geul_bad_shape_edit());
+            }
+            points.pop();
+            commands.pop();
+        }
+        geul_cubic_handles(&points, &commands).ok_or_else(geul_bad_shape_edit)?;
+        let ShapeObject::Curve(curve) = self.resolve_shape_control_mut(sec, para, ctrl)? else {
+            return Err(geul_bad_shape_edit());
+        };
+        curve.points = points;
+        curve.segment_types = commands;
+        self.refresh_advanced_shape(sec);
+        Ok(())
+    }
