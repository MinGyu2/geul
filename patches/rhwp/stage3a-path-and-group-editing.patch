+fn geul_same_point(a: &crate::model::Point, b: &crate::model::Point) -> bool {
+    a.x == b.x && a.y == b.y
+}
+
+fn geul_polygon_valid(points: &[crate::model::Point]) -> bool {
+    if !(3..=257).contains(&points.len()) {
+        return false;
+    }
+    let closed = points.last().is_some_and(|last| geul_same_point(&points[0], last));
+    let vertices = &points[..points.len() - usize::from(closed)];
+    if vertices.len() < 3 || vertices.iter().map(|p| (p.x, p.y)).collect::<std::collections::BTreeSet<_>>().len() != vertices.len() {
+        return false;
+    }
+    // A closed polygon needs nonzero signed area. Check collinearity separately
+    // for an open polyline, where a negative or zero signed area can be valid.
+    !closed || vertices.iter().zip(vertices.iter().cycle().skip(1)).map(|(a, b)| {
+        i128::from(a.x) * i128::from(b.y) - i128::from(a.y) * i128::from(b.x)
+    }).sum::<i128>() != 0
+}
+
+/// Match the HWP5 renderer's existing command decoding. Only accept a
+/// complete command stream, with zero-valued unused storage bytes.
+fn geul_cubic_handles(points: &[crate::model::Point], segments: &[u8]) -> Option<Vec<bool>> {
+    if !(4..=257).contains(&points.len()) || segments.len() + 1 != points.len()
+        || geul_same_point(points.first()?, points.last()?)
+    {
+        return None;
+    }
+    let mut handles = vec![false; points.len()];
+    let (mut offset, mut segment) = (1, 0);
+    while offset < points.len() {
+        let start = offset - 1;
+        match segments[segment] {
+            0 => offset += 1,
+            1 if offset + 2 < points.len() => {
+                handles[offset..offset + 2].fill(true);
+                offset += 3;
+            }
+            _ => return None,
+        }
+        if geul_same_point(&points[start], &points[offset - 1]) {
+            return None;
+        }
+        segment += 1;
+    }
+    (handles.contains(&true) && segments[segment..].iter().all(|value| *value == 0))
+        .then_some(handles)
+}
+
+fn geul_group_child_color(child: &ShapeObject) -> Option<u32> {
+    let drawing = child.drawing()?;
+    if child.common().locked || child.common().size_protect
+        || drawing.caption.is_some() || drawing.text_box.is_some()
+        || drawing.fill.fill_type != crate::model::style::FillType::Solid
+        || drawing.fill.gradient.is_some() || drawing.fill.image.is_some()
+    {
+        return None;
+    }
+    let color = drawing.fill.solid.as_ref()?.background_color;
+    (color <= 0xff_ffff).then_some(color)
+}
 
