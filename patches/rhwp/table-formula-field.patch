+#[test]
+fn geul_formula_field_replacement_and_refusals_leave_document_unchanged() {
+    let mut doc = geul_formula_doc();
+    doc.core
+        .insert_table_formula_field_native(0, 0, 0, 0, 2, "=SUM(A1:B1)")
+        .unwrap();
+    // 바꾸기: 같은 칸의 식을 바꾸면 필드 하나, 새 식·결과.
+    doc.core
+        .insert_table_formula_field_native(0, 0, 0, 0, 2, "=A1*B1+1")
+        .unwrap();
+    assert_eq!(
+        geul_formula_fields(&doc),
+        vec![("=A1*B1+1??%g,;;201".to_string(), "201".to_string(), 0, 0x08)]
+    );
+    let before = doc.core.export_hwp_native().unwrap();
+    for (row, col, formula) in [
+        (1, 2, "=A2/0"),         // 0으로 나누기
+        (1, 2, "SUM(A1:B1)"),    // '=' 없음
+        (1, 2, "=SUM(A1:B1)?;"), // 명령 구분자
+        (1, 2, "=SUM"),
+        (1, 2, "=SUM("),
+        (1, 2, "=SUM(A1:B1"),
+        (1, 2, "=SUM(A1,,B1)"),
+        (1, 2, "=1+"),
+        (1, 2, "=SUM(A1:B1) 2"),
+        (1, 2, "=SUM()"),
+        (1, 2, "=SUM(A1:Z99)"),
+        (1, 2, "=A0"),
+        (1, 2, "=IF(1,2,Z99)"),
+        (1, 2, "=SUM(A4294967295)"),
+        (1, 2, "=BAD(A1)"),
+        (1, 2, "=ROUND(A1,2)"),
+        (1, 2, "=LOG(A1,2)"),
+        (1, 2, "\t=1+2"),
+        (1, 2, "=SUM(1.2.3)"),
+        (9, 9, "=1+1"), // 표 밖 칸
+    ] {
+        assert!(
+            doc.core
+                .insert_table_formula_field_native(0, 0, 0, row, col, formula)
+                .is_err(),
+            "{formula}"
+        );
+        assert_eq!(
+            doc.core.export_hwp_native().unwrap(),
+            before,
+            "{formula}: 실패해도 문서 그대로"
+        );
+    }
+    // 다른 필드가 있는 칸은 거부(ClickHere 누름틀).
+    doc.core
+        .insert_click_here_field_at_in_cell(0, 0, 0, 5, 0, 0, false, "안내", "", "", true)
+        .unwrap();
+    let before = doc.core.export_hwp_native().unwrap();
+    assert!(doc
+        .core
+        .insert_table_formula_field_native(0, 0, 0, 1, 2, "=1+1")
+        .is_err());
+    assert_eq!(doc.core.export_hwp_native().unwrap(), before);
+    // 기존 읽기 전용 계산은 그대로 문서를 바꾸지 않는다.
+    doc.evaluate_table_formula(0, 0, 0, 2, 2, "=SUM(A1:A2)", false)
+        .unwrap();
+    assert_eq!(doc.core.export_hwp_native().unwrap(), before);
+}
