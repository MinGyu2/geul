+/// Validate every branch before evaluation (including unselected IF branches),
+/// and cap coordinate allocation with the same conservative budget as geul.
+fn validate_node(node: &FormulaNode, ctx: &TableContext, visits: &mut usize) -> Result<(), String> {
+    let cost = match node {
+        FormulaNode::CellRef { col, row } => {
+            resolve_cell_ref(col, *row, ctx)?;
+            1
+        }
+        FormulaNode::Range { start, end } => {
+            validate_node(start, ctx, visits)?;
+            validate_node(end, ctx, visits)?;
+            ctx.row_count
+                .checked_mul(ctx.col_count)
+                .ok_or("범위 크기 초과")?
+        }
+        FormulaNode::Direction(dir) => match dir {
+            DirectionKind::Left | DirectionKind::Right => ctx.col_count,
+            DirectionKind::Above | DirectionKind::Below => ctx.row_count,
+        },
+        FormulaNode::Negate(inner) => {
+            validate_node(inner, ctx, visits)?;
+            0
+        }
+        FormulaNode::BinOp { left, right, .. } => {
+            validate_node(left, ctx, visits)?;
+            validate_node(right, ctx, visits)?;
+            0
+        }
+        FormulaNode::FuncCall { name, args } => {
+            let valid = match name.as_str() {
+                "SUM" | "AVG" | "AVERAGE" | "PRODUCT" | "MIN" | "MAX" | "COUNT" => !args.is_empty(),
+                "ABS" | "SQRT" | "INT" | "SIGN" | "EXP" | "LOG10" | "SIN" | "COS" | "TAN"
+                | "ASIN" | "ACOS" | "ATAN" | "RADIAN" | "ROUND" | "CEILING" | "FLOOR" | "LOG"
+                | "TRUNC" => args.len() == 1,
+                "MOD" => args.len() == 2,
+                "IF" => args.len() == 3,
+                _ => false,
+            };
+            if !valid {
+                return Err("지원하지 않는 함수 또는 인수 개수".into());
+            }
+            for arg in args {
+                validate_node(arg, ctx, visits)?;
+            }
+            0
+        }
+        FormulaNode::Number(_) => 0,
+    };
+    *visits = visits
+        .checked_add(cost)
+        .filter(|v| *v <= 4096)
+        .ok_or("셀 접근 한도 초과")?;
+    Ok(())
 }
