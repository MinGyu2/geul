+#[test]
+fn geul_formula_field_is_created_and_survives_hwp_and_hwpx() {
+    // 새 문서(HWP 저장): 빈 칸에 계산식 필드.
+    let mut doc = geul_formula_doc();
+    let out: Value = serde_json::from_str(
+        &doc.core
+            .insert_table_formula_field_native(0, 0, 0, 0, 2, "=SUM(A1:B1)")
+            .expect("필드 생성"),
+    )
+    .unwrap();
+    assert_eq!(out["text"], "30");
+    assert_eq!(out["command"], "=SUM(A1:B1)??%g,;;30");
+    // 덮어쓴 칸(문단 하나, 컨트롤 없음)도 계산식 필드가 된다: 기존 글은 결과로 바뀐다.
+    doc.core
+        .insert_table_formula_field_native(0, 0, 0, 2, 0, "=AVG(A1:A2)")
+        .expect("글 있는 칸");
+    let fields = geul_formula_fields(&doc);
+    assert_eq!(
+        fields,
+        vec![
+            (
+                "=SUM(A1:B1)??%g,;;30".to_string(),
+                "30".to_string(),
+                0,
+                0x08
+            ),
+            (
+                "=AVG(A1:A2)??%g,;;5.5".to_string(),
+                "5.5".to_string(),
+                0,
+                0x08
+            ),
+        ]
+    );
+    let reopened = HwpDocument::from_bytes(&doc.core.export_hwp_native().expect("HWP 저장"))
+        .expect("HWP 다시 열기");
+    assert_eq!(geul_formula_fields(&reopened), fields);
+    let mut again = reopened;
+    let table = again.core.document.sections[0].paragraphs[0]
+        .controls
+        .iter()
+        .position(|c| matches!(c, crate::model::control::Control::Table(_)))
+        .expect("다시 연 표");
+    again
+        .insert_text_in_cell_native(0, 0, table, 0, 0, 0, "1")
+        .expect("원본 셀 고침");
+    again
+        .core
+        .insert_table_formula_field_native(0, 0, table, 0, 2, "=SUM(A1:B1)")
+        .expect("다시 계산");
+    let fin = HwpDocument::from_bytes(&again.core.export_hwp_native().unwrap()).unwrap();
+    assert_eq!(
+        geul_formula_fields(&fin)[0],
+        (
+            "=SUM(A1:B1)??%g,;;130".to_string(),
+            "130".to_string(),
+            0,
+            0x08
+        )
+    );
+    assert_eq!(geul_formula_fields(&fin)[1], fields[1]);
+
+    // 한컴 저장본(HWP·HWPX 저장): 한컴 계산식 바꾸기 + 숫자 칸을 새 계산식으로.
+    for format in ["hwp", "hwpx"] {
+        let mut doc = geul_calc_cell();
+        let hancom = geul_formula_fields(&doc);
+        doc.core
+            .insert_table_formula_field_native(0, 0, 2, 2, 3, "=SUM(A1:D1)")
+            .expect("한컴 필드 바꾸기");
+        let mut want = hancom.clone();
+        let text = geul_formula_fields(&doc)[3].1.clone();
+        want[3] = (format!("=SUM(A1:D1)??%g,;;{text}"), text, 0, 0x08);
+        assert_eq!(
+            geul_formula_fields(&doc),
+            want,
+            "{format}: 다른 한컴 계산식 그대로"
+        );
+        let save = |d: &HwpDocument| {
+            if format == "hwp" {
+                d.core.export_hwp_native()
+            } else {
+                d.core.export_hwpx_native()
+            }
+        };
+        let reopened = HwpDocument::from_bytes(&save(&doc).expect("저장")).expect("다시 열기");
+        assert_eq!(
+            geul_formula_fields(&reopened),
+            want,
+            "{format}: 식·결과·필드 속성 보존"
+        );
+        let mut again = reopened;
+        again
+            .core
+            .insert_table_formula_field_native(0, 0, 2, 2, 3, "=1+2")
+            .expect("다시 연 필드의 식 바꾸기");
+        want[3].0 = "=1+2??%g,;;3".into();
+        want[3].1 = "3".into();
+        let fin =
+            HwpDocument::from_bytes(&save(&again).expect("둘째 저장")).expect("둘째 다시 열기");
+        assert_eq!(geul_formula_fields(&fin), want, "{format}: 둘째 저장");
+    }
+}
