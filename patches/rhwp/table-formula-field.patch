+/// [geul] 한컴 계산식 필드의 결과 서식 `%g`(C printf: 유효 숫자 6, 뒤 0 제거, 지수 -4 미만·6 이상이면 지수 표기).
+pub(crate) fn format_formula_g(value: f64) -> Option<String> {
+    if !value.is_finite() {
+        return None;
+    }
+    if value == 0.0 {
+        return Some("0".into());
+    }
+    // 유효 숫자 6자리로 먼저 반올림한 지수로 표기를 고른다(999999.5 → 1e+06, printf 와 같음).
+    let sci = format!("{:.5e}", value);
+    let (mantissa, e) = sci.split_once('e')?;
+    let e: i32 = e.parse().ok()?;
+    if e < -4 || e >= 6 {
+        let m = mantissa.trim_end_matches('0').trim_end_matches('.');
+        let sign = if e < 0 { '-' } else { '+' };
+        return Some(format!("{m}e{sign}{:02}", e.abs()));
+    }
+    let decimals = (5 - e).max(0) as usize;
+    let fixed = format!("{:.*}", decimals, value);
+    Some(if fixed.contains('.') {
+        fixed
+            .trim_end_matches('0')
+            .trim_end_matches('.')
+            .to_string()
+    } else {
+        fixed
+    })
+}
