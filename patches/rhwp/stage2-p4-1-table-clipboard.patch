+            let bf_id = if !bf_modified && template_cell.border_fill_id != 0 {
+                template_cell.border_fill_id
+            } else if let Some(idx) = self
+                .document
+                .doc_info
+                .border_fills
+                .iter()
+                .position(|e| border_fills_strictly_equal(e, &bf))
+            {
