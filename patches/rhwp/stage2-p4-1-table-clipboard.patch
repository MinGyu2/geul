+            } else if let Some(pos) = staged_bfs
+                .iter()
+                .position(|s| border_fills_strictly_equal(s, &bf))
+            {
+                u16::try_from(existing_bf_len + pos + 1)
+                    .map_err(|_| HwpError::RenderError("borderFill limit exceeded".into()))?
+            } else {
+                let id = u16::try_from(existing_bf_len + staged_bfs.len() + 1)
+                    .map_err(|_| HwpError::RenderError("borderFill limit exceeded".into()))?;
+                staged_bfs.push(bf);
+                id
+            };
+            built_cells.push((ci, new_paras, va, bf_id));
+        }
