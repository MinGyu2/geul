+                        u16::try_from(existing_ps_len + pos)
+                            .map_err(|_| HwpError::RenderError("paraShape limit exceeded".into()))?
+                    } else {
+                        let id = u16::try_from(existing_ps_len + staged_pss.len())
+                            .map_err(|_| HwpError::RenderError("paraShape limit exceeded".into()))?;
+                        staged_pss.push(modified);
+                        id
+                    };
+                    para.para_shape_id = ps_id;
+                }
+
+                let mut full_text = String::new();
+                let mut run_spans: Vec<(usize, usize, CharShapeMods)> = Vec::new();
+                let mut char_cursor = 0usize;
+                for run in &p_arg.runs {
+                    let run_chars = run.text.chars().count();
+                    if run_chars == 0 {
+                        continue;
+                    }
+                    let mut mods = CharShapeMods::default();
+                    let mut has_mods = false;
+                    if let Some(b) = run.bold {
+                        mods.bold = Some(b);
+                        has_mods = true;
+                    }
+                    if let Some(i) = run.italic {
+                        mods.italic = Some(i);
