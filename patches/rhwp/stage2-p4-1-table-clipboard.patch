+            let template_para = template_cell
+                .paragraphs
+                .first()
+                .cloned()
+                .unwrap_or_else(Paragraph::new_empty);
+
+            let mut new_paras = Vec::with_capacity(cell_arg.paragraphs.len());
+            for p_arg in &cell_arg.paragraphs {
+                let mut para = Paragraph::new_empty_like(&template_para);
+                if let Some(Some(al)) = &p_arg.align {
+                    let align = match al.as_str() {
+                        "left" => Alignment::Left,
+                        "center" => Alignment::Center,
+                        "right" => Alignment::Right,
+                        "justify" => Alignment::Justify,
+                        _ => {
+                            return Err(HwpError::RenderError(
+                                "invalid paragraph alignment".into(),
+                            ));
+                        }
+                    };
+                    let align_code: u32 = match align {
+                        Alignment::Justify => 0,
+                        Alignment::Left => 1,
+                        Alignment::Right => 2,
+                        Alignment::Center => 3,
+                        Alignment::Distribute => 4,
+                        Alignment::Split => 5,
+                    };
+                    let mut modified = self
+                        .document
+                        .doc_info
+                        .para_shapes
+                        .get(para.para_shape_id as usize)
+                        .cloned()
+                        .ok_or_else(|| HwpError::RenderError("missing paraShape".into()))?;
+                    modified.raw_data = None;
+                    modified.alignment = align;
+                    modified.attr1 = (modified.attr1 & !(0x07 << 2)) | (align_code << 2);
+                    let ps_id = if let Some(idx) = self
+                        .document
+                        .doc_info
+                        .para_shapes
+                        .iter()
+                        .position(|e| *e == modified)
+                    {
