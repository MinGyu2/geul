+                            }
+                        }
+                    };
+                }
+                if let Some(bs) = &fmt.borders {
+                    bf_modified = true;
+                    bf.raw_data = None;
+                    if let Some(e) = &bs.left {
+                        bf.borders[0] = parse_border_line(e)?;
+                    }
+                    if let Some(e) = &bs.right {
+                        bf.borders[1] = parse_border_line(e)?;
+                    }
+                    if let Some(e) = &bs.top {
