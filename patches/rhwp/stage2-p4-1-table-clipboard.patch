+            if let Some(fmt) = &cell_arg.formatting {
+                if let Some(Some(v_str)) = &fmt.vertical_align {
+                    va = match v_str.as_str() {
+                        "top" => crate::model::table::VerticalAlign::Top,
+                        "middle" => crate::model::table::VerticalAlign::Center,
+                        "bottom" => crate::model::table::VerticalAlign::Bottom,
+                        _ => {
