+            expected_geos.sort_unstable();
+            let merges_match = target_geos == expected_geos;
+            let mut cloned = table.clone();
+            if !merges_match {
+                if !spec.allow_merge_rewrite {
+                    return Err(HwpError::RenderError(
+                        "target merge geometry differs in HWP".into(),
+                    ));
+                }
+                loop {
+                    let merged_pos = cloned
+                        .cells
+                        .iter()
+                        .find(|c| {
+                            c.row >= spec.start_row
+                                && c.row <= end_row
+                                && c.col >= spec.start_col
+                                && c.col <= end_col
+                                && (c.row_span > 1 || c.col_span > 1)
+                        })
+                        .map(|c| (c.row, c.col));
+                    match merged_pos {
+                        Some((r, c)) => cloned.split_cell(r, c).map_err(HwpError::RenderError)?,
+                        None => break,
+                    }
+                }
+                for c in &spec.cells {
