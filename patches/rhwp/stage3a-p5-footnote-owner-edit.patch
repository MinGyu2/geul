+    fn hwpx_xml_node(node: roxmltree::Node<'_, '_>) -> Value {
+        use roxmltree::NodeType;
+
+        match node.node_type() {
+            NodeType::Root => Value::Array(node.children().map(hwpx_xml_node).collect()),
+            NodeType::Element => {
+                let mut attributes: Vec<_> = node
+                    .attributes()
+                    .map(|attribute| {
+                        (
+                            attribute.namespace().unwrap_or("").to_string(),
+                            attribute.name().to_string(),
+                            attribute.value().to_string(),
+                        )
+                    })
+                    .collect();
+                attributes.sort();
+                serde_json::json!({
+                    "element": [node.tag_name().namespace(), node.tag_name().name()],
+                    "attributes": attributes,
+                    "children": node.children().map(hwpx_xml_node).collect::<Vec<_>>(),
+                })
+            }
+            NodeType::PI => {
+                let pi = node.pi().expect("processing instruction node");
+                serde_json::json!({"pi": [pi.target, pi.value]})
+            }
+            NodeType::Comment => serde_json::json!({"comment": node.text()}),
+            NodeType::Text => serde_json::json!({"text": node.text()}),
+        }
+    }
+
+    /// Match T009's XML-part rule: full namespace-aware event content (including comments and PIs),
+    /// with attribute order and XML declaration spelling treated as serialization details.
+    fn hwpx_unrelated_part_preserved(name: &str, before: &[u8], after: &[u8]) -> bool {
+        if before == after {
+            return true;
+        }
+        if !name.ends_with(".xml") {
+            return false;
+        }
+        let (Ok(before), Ok(after)) = (std::str::from_utf8(before), std::str::from_utf8(after))
+        else {
+            return false;
+        };
+        let (Ok(before), Ok(after)) = (
+            roxmltree::Document::parse(before),
+            roxmltree::Document::parse(after),
+        ) else {
+            return false;
+        };
+        hwpx_xml_node(before.root()) == hwpx_xml_node(after.root())
+    }
+
+    fn normalize_opf_modified_date(bytes: &[u8]) -> Vec<u8> {
+        let mut xml = String::from_utf8(bytes.to_vec()).expect("OPF manifest must be UTF-8");
+        xml = xml.replace(" standalone=\"yes\"", "");
+        xml = xml.replace("encoding=\"UTF-8\" ?>", "encoding=\"UTF-8\"?>");
+        if let Some(start) = xml.find("<opf:meta name=\"ModifiedDate\"") {
+            if let Some(open_end) = xml[start..].find('>') {
+                let open_end = start + open_end + 1;
+                let open = xml[start..open_end].trim_end();
+                let close = if open.ends_with("/>") {
+                    open_end
+                } else {
+                    open_end
+                        + xml[open_end..]
+                            .find("</opf:meta>")
+                            .map(|offset| offset + "</opf:meta>".len())
+                            .expect("ModifiedDate element must be closed")
+                };
+                xml.replace_range(start..close, "<opf:meta name=\"ModifiedDate\"/>");
+            }
+        }
+        xml.into_bytes()
+    }
+
+    fn assert_opf_manifest_matches_except_modified_date(before: &[u8], after: &[u8]) {
+        let before = normalize_opf_modified_date(before);
+        let after = normalize_opf_modified_date(after);
+        if before != after {
+            let left = String::from_utf8(before).expect("normalized source OPF UTF-8");
+            let right = String::from_utf8(after).expect("normalized saved OPF UTF-8");
+            let offset = left
+                .bytes()
+                .zip(right.bytes())
+                .position(|(a, b)| a != b)
+                .unwrap_or(left.len().min(right.len()));
+            let start_target = offset.saturating_sub(100);
+            let start = (0..=start_target)
+                .rev()
+                .find(|index| left.is_char_boundary(*index))
+                .unwrap_or(0);
+            let left_end_target = (offset + 180).min(left.len());
+            let right_end_target = (offset + 180).min(right.len());
+            let left_end = (left_end_target..=left.len())
+                .find(|index| left.is_char_boundary(*index))
+                .unwrap_or(left.len());
+            let right_end = (right_end_target..=right.len())
+                .find(|index| right.is_char_boundary(*index))
+                .unwrap_or(right.len());
+            panic!(
+                "HWPX manifest changed outside declaration and ModifiedDate at byte {offset}: source={:?}, saved={:?}",
+                &left[start..left_end], &right[start..right_end]
+            );
+        }
+    }
