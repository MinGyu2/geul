+    fn assert_authentic_hwpx_footnote_edit_round_trips(fixture: &str, source_type: &str) {
+        let source = std::fs::read(authentic_fixture_path(fixture))
+            .expect("pinned authentic HWPX note sample");
+        let mut document = crate::wasm_api::HwpDocument::from_bytes(&source)
+            .expect("open authentic HWPX note sample");
+        let (_, expected, section, doc_info_before) =
+            edit_first_authentic_footnote(&mut document, source_type);
+        let saved = document
+            .export_hwpx()
+            .unwrap_or_else(|_| panic!("serialize authentic HWPX footnote edit"));
+        let reopened = crate::wasm_api::HwpDocument::from_bytes(&saved)
+            .expect("reopen saved authentic HWPX note sample");
+        let actual: Vec<Value> = serde_json::from_str(
+            &reopened
+                .get_note_inventory()
+                .unwrap_or_else(|_| panic!("reopened HWPX note inventory")),
+        )
+        .expect("reopened HWPX note inventory JSON");
+        assert_eq!(
+            actual, expected,
+            "note identity, numbering and all other note state must survive"
+        );
+        assert_eq!(
+            semantic_doc_info(&reopened),
+            doc_info_before,
+            "HWPX edit must preserve semantic document information"
+        );
+
+        let before_parts = hwpx_parts(&source);
+        let after_parts = hwpx_parts(&saved);
+        assert_eq!(
+            before_parts.keys().collect::<Vec<_>>(),
+            after_parts.keys().collect::<Vec<_>>(),
+            "note text mutation must preserve HWPX part inventory"
+        );
+        let allowed = format!("Contents/section{section}.xml");
+        for (name, before) in before_parts {
+            if name == "Contents/content.hpf" {
+                assert_opf_manifest_matches_except_modified_date(&before, &after_parts[&name]);
+            } else if name != allowed {
+                assert!(
+                    hwpx_unrelated_part_preserved(&name, &before, &after_parts[&name]),
+                    "unrelated HWPX part changed semantically: {name}"
+                );
+            }
+        }
+    }
