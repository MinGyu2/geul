+
+    pub(crate) fn merge_paragraph_in_note_at_native(
+        &mut self,
+        kind: &str,
+        section_idx: usize,
+        para_idx: usize,
+        control_idx: usize,
+        owner_path: NoteOwnerPath,
+        expected_instance_id: u32,
+        expected_number: u16,
+        note_para_idx: usize,
+    ) -> Result<String, HwpError> {
+        if note_para_idx == 0 {
+            return Err(HwpError::RenderError(
+                "첫 번째 노트 문단에는 앞 문단이 없습니다".to_string(),
+            ));
+        }
+        self.validate_note_owner_at_native(
+            kind,
+            section_idx,
+            para_idx,
+            control_idx,
+            owner_path,
+            expected_instance_id,
+            expected_number,
+        )?;
+        let previous = self
+            .note_paragraph_ref_at(
+                section_idx,
+                para_idx,
+                control_idx,
+                owner_path,
+                note_para_idx - 1,
+            )
+            .ok_or_else(|| {
+                HwpError::RenderError("앞 노트 문단 주소가 범위를 벗어났습니다".to_string())
+            })?;
+        if Self::note_paragraph_editable_start(kind, expected_number, previous).is_none() {
+            return Err(HwpError::RenderError(
+                "앞 노트 문단 컨트롤 배치를 증명할 수 없습니다".to_string(),
+            ));
+        }
+        let current = self
+            .note_paragraph_ref_at(
+                section_idx,
+                para_idx,
+                control_idx,
+                owner_path,
+                note_para_idx,
+            )
+            .ok_or_else(|| {
+                HwpError::RenderError("노트 문단 주소가 범위를 벗어났습니다".to_string())
+            })?;
+        if !current.controls.is_empty() {
+            return Err(HwpError::RenderError(
+                "컨트롤이 든 노트 문단은 병합할 수 없습니다".to_string(),
+            ));
+        }
+        let (merge_offset, removed_meta) = match self
+            .note_control_mut_at(section_idx, para_idx, control_idx, owner_path)
+            .ok_or_else(|| {
+                HwpError::RenderError(
+                    "노트 소유 주소가 오래되었거나 범위를 벗어났습니다".to_string(),
+                )
+            })? {
+            Control::Footnote(note) => {
+                let offset = note.paragraphs[note_para_idx - 1].text.chars().count();
+                let removed = note.paragraphs.remove(note_para_idx);
+                let meta = super::super::helpers::removed_para_meta_field(&removed.capture_meta());
+                note.paragraphs[note_para_idx - 1].merge_from(&removed);
+                (offset, meta)
+            }
+            Control::Endnote(note) => {
+                let offset = note.paragraphs[note_para_idx - 1].text.chars().count();
+                let removed = note.paragraphs.remove(note_para_idx);
+                let meta = super::super::helpers::removed_para_meta_field(&removed.capture_meta());
+                note.paragraphs[note_para_idx - 1].merge_from(&removed);
+                (offset, meta)
+            }
+            _ => {
+                return Err(HwpError::RenderError(
+                    "주소가 각주/미주 컨트롤을 가리키지 않습니다".to_string(),
+                ))
+            }
+        };
+        let previous_idx = note_para_idx - 1;
+        self.reflow_note_paragraph_at(section_idx, para_idx, control_idx, owner_path, previous_idx);
+        self.document.sections[section_idx].raw_stream = None;
+        self.mark_section_dirty(section_idx);
+        self.paginate_if_needed();
+        self.event_log.push(DocumentEvent::ParagraphMerged {
+            section: section_idx,
+            para: para_idx,
+        });
+        Ok(super::super::helpers::json_ok_with(&format!(
+            "\"fnParaIndex\":{},\"charOffset\":{}{}",
+            previous_idx, merge_offset, removed_meta
+        )))
     }
 
