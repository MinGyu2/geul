 impl DocumentCore {
+    pub(crate) fn note_control_ref_at(
+        &self,
+        section_idx: usize,
+        para_idx: usize,
+        control_idx: usize,
+        owner_path: NoteOwnerPath,
+    ) -> Option<&Control> {
+        let anchor = self
+            .document
+            .sections
+            .get(section_idx)?
+            .paragraphs
+            .get(para_idx)?
+            .controls
+            .get(control_idx)?;
+        match owner_path {
+            NoteOwnerPath::Body => Some(anchor),
+            NoteOwnerPath::TableCell {
+                cell_index,
+                cell_para_index,
+                cell_control_index,
+            } => {
+                let Control::Table(table) = anchor else {
+                    return None;
+                };
+                table
+                    .cells
+                    .get(cell_index)?
+                    .paragraphs
+                    .get(cell_para_index)?
+                    .controls
+                    .get(cell_control_index)
+            }
+            NoteOwnerPath::ShapeTextBox {
+                tb_para_index,
+                tb_control_index,
+            } => {
+                let Control::Shape(shape) = anchor else {
+                    return None;
+                };
+                shape
+                    .drawing()?
+                    .text_box
+                    .as_ref()?
+                    .paragraphs
+                    .get(tb_para_index)?
+                    .controls
+                    .get(tb_control_index)
+            }
+        }
+    }
