+    /// Resolve one direct-body footnote paragraph to the page-local render address that currently contains it.
+    pub(crate) fn get_footnote_view_address_native(
+        &self,
+        section_idx: usize,
+        para_idx: usize,
+        control_idx: usize,
+        instance_id: u32,
+        number: u16,
+        note_para_idx: usize,
+        char_offset: usize,
+        preferred_page_num: u32,
+        owner_path: NoteOwnerPath,
