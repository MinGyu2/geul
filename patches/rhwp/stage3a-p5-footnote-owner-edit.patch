+    /// Stable inventory for save/reopen comparison. Only owner paths exposed by page hit-testing are included;
+    /// a nested note that the renderer cannot address exactly makes the inventory fail closed.
+    pub(crate) fn get_note_inventory_native(&self) -> Result<String, HwpError> {
+        fn entry(
+            section: usize,
+            para: usize,
+            control_index: usize,
+            owner_path: NoteOwnerPath,
+            control: &Control,
+        ) -> Result<serde_json::Value, HwpError> {
+            let (kind, instance_id, number, paragraphs) = match control {
+                Control::Footnote(note) => {
+                    ("footnote", note.instance_id, note.number, &note.paragraphs)
+                }
+                Control::Endnote(note) => {
+                    ("endnote", note.instance_id, note.number, &note.paragraphs)
+                }
+                _ => {
+                    return Err(HwpError::RenderError(
+                        "노트 인벤토리에 노트가 아닌 컨트롤이 전달되었습니다".to_string(),
+                    ))
+                }
+            };
+            let texts: Vec<&str> = paragraphs.iter().map(|p| p.text.as_str()).collect();
+            let editable_starts: Vec<Option<usize>> = paragraphs
+                .iter()
+                .map(|p| DocumentCore::note_paragraph_editable_start(kind, number, p))
+                .collect();
+            let control_states: Vec<serde_json::Value> = paragraphs
+                .iter()
+                .map(|paragraph| serde_json::to_value(&paragraph.controls))
+                .collect::<Result<_, _>>()
+                .map_err(|_| {
+                    HwpError::RenderError("노트 문단 컨트롤을 직렬화할 수 없습니다".to_string())
+                })?;
+            let total_text_len = texts.iter().map(|text| text.chars().count()).sum::<usize>();
+            Ok(serde_json::json!({
+                "section": section, "anchorParagraph": para, "control": control_index,
+                "ownerPath": owner_path.to_json(), "kind": kind, "instanceId": instance_id,
+                "number": number, "paraCount": paragraphs.len(), "totalTextLen": total_text_len,
+                "texts": texts, "editableStarts": editable_starts, "controlStates": control_states,
+            }))
+        }
+
+        fn contains_note(control: &Control) -> bool {
+            match control {
+                Control::Footnote(_) | Control::Endnote(_) => true,
+                Control::Table(table) => table
+                    .cells
+                    .iter()
+                    .flat_map(|cell| &cell.paragraphs)
+                    .flat_map(|paragraph| &paragraph.controls)
+                    .any(contains_note),
+                Control::Shape(shape) => shape
+                    .drawing()
+                    .and_then(|drawing| drawing.text_box.as_ref())
+                    .is_some_and(|text_box| {
+                        text_box
+                            .paragraphs
+                            .iter()
+                            .flat_map(|p| &p.controls)
+                            .any(contains_note)
+                    }),
+                _ => false,
+            }
+        }
+
+        let mut entries = Vec::new();
+        for (section_idx, section) in self.document.sections.iter().enumerate() {
+            for (para_idx, paragraph) in section.paragraphs.iter().enumerate() {
+                for (control_idx, control) in paragraph.controls.iter().enumerate() {
+                    match control {
+                        Control::Footnote(_) | Control::Endnote(_) => entries.push(entry(
+                            section_idx,
+                            para_idx,
+                            control_idx,
+                            NoteOwnerPath::Body,
+                            control,
+                        )?),
+                        Control::Table(table) => {
+                            for (cell_index, cell) in table.cells.iter().enumerate() {
+                                for (cell_para_index, cell_para) in
+                                    cell.paragraphs.iter().enumerate()
+                                {
+                                    for (cell_control_index, cell_control) in
+                                        cell_para.controls.iter().enumerate()
+                                    {
+                                        if matches!(
+                                            cell_control,
+                                            Control::Footnote(_) | Control::Endnote(_)
+                                        ) {
+                                            entries.push(entry(
+                                                section_idx,
+                                                para_idx,
+                                                control_idx,
+                                                NoteOwnerPath::TableCell {
+                                                    cell_index,
+                                                    cell_para_index,
+                                                    cell_control_index,
+                                                },
+                                                cell_control,
+                                            )?);
+                                        } else if contains_note(cell_control) {
+                                            return Err(HwpError::RenderError("중첩 표/도형 안 노트의 저장 소유 경로를 증명할 수 없습니다".to_string()));
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                        Control::Shape(shape) => {
+                            if let Some(text_box) = shape
+                                .drawing()
+                                .and_then(|drawing| drawing.text_box.as_ref())
+                            {
+                                for (tb_para_index, tb_para) in
+                                    text_box.paragraphs.iter().enumerate()
+                                {
+                                    for (tb_control_index, tb_control) in
+                                        tb_para.controls.iter().enumerate()
+                                    {
+                                        if matches!(
+                                            tb_control,
+                                            Control::Footnote(_) | Control::Endnote(_)
+                                        ) {
+                                            entries.push(entry(
+                                                section_idx,
+                                                para_idx,
+                                                control_idx,
+                                                NoteOwnerPath::ShapeTextBox {
+                                                    tb_para_index,
+                                                    tb_control_index,
+                                                },
+                                                tb_control,
+                                            )?);
+                                        } else if contains_note(tb_control) {
+                                            return Err(HwpError::RenderError("중첩 표/도형 안 노트의 저장 소유 경로를 증명할 수 없습니다".to_string()));
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                        other if contains_note(other) => return Err(HwpError::RenderError(
+                            "지원되지 않는 컨트롤 내부 노트의 저장 소유 경로를 증명할 수 없습니다"
+                                .to_string(),
+                        )),
+                        _ => {}
+                    }
+                }
+            }
+        }
+        let result = serde_json::Value::Array(entries);
+        let raw = serde_json::to_string(&result).map_err(|_| {
+            HwpError::RenderError("노트 인벤토리를 직렬화할 수 없습니다".to_string())
+        })?;
+        if raw.len() > 8 * 1024 * 1024 {
+            return Err(HwpError::RenderError(
+                "노트 인벤토리가 크기 제한을 넘었습니다".to_string(),
+            ));
+        }
+        Ok(raw)
+    }
