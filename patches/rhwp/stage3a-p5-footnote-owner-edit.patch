+        use crate::renderer::pagination::FootnoteSource;
+        use crate::renderer::render_tree::{RenderNode, RenderNodeType};
+
+        self.validate_note_owner_at_native(
+            "footnote",
+            section_idx,
+            para_idx,
+            control_idx,
+            owner_path,
+            instance_id,
+            number,
+        )?;
+        let note = self
+            .note_control_ref_at(section_idx, para_idx, control_idx, owner_path)
+            .and_then(|control| match control {
+                Control::Footnote(note) => Some(note),
+                _ => None,
+            })
+            .ok_or_else(|| HwpError::RenderError("각주 소유자를 찾을 수 없습니다".to_string()))?;
+        let Some(note_paragraph) = note.paragraphs.get(note_para_idx) else {
+            return Err(HwpError::RenderError(
+                "각주 문단 주소가 범위를 벗어났습니다".to_string(),
+            ));
+        };
+        let text_len = note_paragraph.text.chars().count();
+        if char_offset > text_len {
+            return Err(HwpError::RenderError(
+                "각주 문자 주소가 범위를 벗어났습니다".to_string(),
+            ));
+        }
+        let empty = text_len == 0;
+
+        fn has_caret_offset(
+            node: &RenderNode,
+            footnote_index: usize,
+            marker_para: usize,
+            char_offset: usize,
+            empty: bool,
+        ) -> bool {
+            matches!(&node.node_type, RenderNodeType::TextRun(run)
+            if run.section_index == Some(footnote_index) && run.para_index == Some(marker_para)
+                && match run.char_start {
+                    Some(start) => char_offset >= start
+                        && char_offset <= start.saturating_add(run.text.chars().count()),
+                    None => empty && char_offset == 0,
+                })
+                || node.children.iter().any(|child| {
+                    has_caret_offset(child, footnote_index, marker_para, char_offset, empty)
+                })
+        }
+
+        let pagination = self
+            .pagination
+            .get(section_idx)
+            .ok_or_else(|| HwpError::RenderError("각주 페이지를 찾을 수 없습니다".to_string()))?;
+        let page_base = self.global_page_base_for_section(section_idx);
+        let marker_para = usize::MAX - 2000 - note_para_idx;
+        let mut first_match = None;
+        for (local_page_idx, page) in pagination.pages.iter().enumerate() {
+            let Some(footnote_index) =
+                page.footnotes
+                    .iter()
+                    .position(|reference| match (&reference.source, owner_path) {
+                        (
+                            FootnoteSource::Body {
+                                para_index,
+                                control_index,
+                            },
+                            NoteOwnerPath::Body,
+                        ) => *para_index == para_idx && *control_index == control_idx,
+                        (
+                            FootnoteSource::TableCell {
+                                para_index,
+                                table_control_index,
+                                cell_index,
+                                cell_para_index,
+                                cell_control_index,
+                            },
+                            NoteOwnerPath::TableCell {
