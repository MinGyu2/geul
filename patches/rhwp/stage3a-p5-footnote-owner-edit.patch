+    fn reflow_note_paragraph_at(
+        &mut self,
+        section_idx: usize,
+        para_idx: usize,
+        control_idx: usize,
+        owner_path: NoteOwnerPath,
+        note_para_idx: usize,
+    ) {
+        use crate::renderer::hwpunit_to_px;
+        let available_width = {
+            let Some(section) = self.document.sections.get(section_idx) else {
+                return;
+            };
+            let page_def = &section.section_def.page_def;
+            hwpunit_to_px(
+                page_def.width as i32 - page_def.margin_left as i32 - page_def.margin_right as i32,
+                self.dpi,
+            )
+        };
+        let Some(para_shape_id) = self
+            .note_paragraph_ref_at(
+                section_idx,
+                para_idx,
+                control_idx,
+                owner_path,
+                note_para_idx,
+            )
+            .map(|paragraph| paragraph.para_shape_id)
+        else {
+            return;
+        };
+        let para_style = self.styles.para_styles.get(para_shape_id as usize);
+        let final_width = (available_width
+            - para_style.map(|s| s.margin_left).unwrap_or(0.0)
+            - para_style.map(|s| s.margin_right).unwrap_or(0.0))
+        .max(0.0);
+        let dpi = self.dpi;
+        let styles = self.styles.clone();
+        if let Some(paragraph) = self.note_paragraph_mut_at(
+            section_idx,
+            para_idx,
+            control_idx,
+            owner_path,
+            note_para_idx,
+        ) {
+            reflow_line_segs(
+                paragraph,
+                ParagraphBox::content_width_px(final_width, dpi),
+                &styles,
+                dpi,
+            );
+        }
+    }
