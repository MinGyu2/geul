+
+    fn validate_note_paragraph_edit_at_native(
+        &self,
+        kind: &str,
+        section_idx: usize,
+        para_idx: usize,
+        control_idx: usize,
+        owner_path: NoteOwnerPath,
+        expected_instance_id: u32,
+        expected_number: u16,
+        note_para_idx: usize,
+        start: usize,
+        end: usize,
+    ) -> Result<(), HwpError> {
+        self.validate_note_owner_at_native(
+            kind,
+            section_idx,
+            para_idx,
+            control_idx,
+            owner_path,
+            expected_instance_id,
+            expected_number,
+        )?;
+        let paragraph = self
+            .note_paragraph_ref_at(
+                section_idx,
+                para_idx,
+                control_idx,
+                owner_path,
+                note_para_idx,
+            )
+            .ok_or_else(|| {
+                HwpError::RenderError(
+                    "노트 문단 주소가 오래되었거나 범위를 벗어났습니다".to_string(),
+                )
+            })?;
+        let len = paragraph.text.chars().count();
+        let editable_start = Self::note_paragraph_editable_start(kind, expected_number, paragraph)
+            .ok_or_else(|| {
+                HwpError::RenderError("노트 문단 컨트롤 배치를 증명할 수 없습니다".to_string())
+            })?;
+        if start < editable_start || start > end || end > len {
+            return Err(HwpError::RenderError(
+                "노트 문단의 컨트롤 또는 텍스트 범위를 증명할 수 없습니다".to_string(),
+            ));
+        }
+        Ok(())
+    }
+
+    fn note_paragraph_editable_start(
+        kind: &str,
+        number: u16,
+        paragraph: &crate::model::paragraph::Paragraph,
+    ) -> Option<usize> {
+        if paragraph.controls.is_empty() {
+            return Some(0);
+        }
+        let expected_type = match kind {
+            "footnote" => crate::model::control::AutoNumberType::Footnote,
+            "endnote" => crate::model::control::AutoNumberType::Endnote,
+            _ => return None,
+        };
+        let [Control::AutoNumber(auto)] = paragraph.controls.as_slice() else {
+            return None;
+        };
+        if auto.number_type != expected_type
+            || auto.number != number
+            || auto.assigned_number != number
+        {
+            return None;
+        }
+        let positions = paragraph.control_text_positions();
+        let [position] = positions.as_slice() else {
+            return None;
+        };
+        // HWP footnote paragraphs reserve the two leading placeholder spaces
+        // around the inline AutoNumber. Editing before both have been passed
+        // can consume or move the format's note marker even when a raw control
+        // position alone looks editable.
+        let start = position.checked_add(1)?.max(2);
+        (start <= paragraph.text.chars().count()).then_some(start)
+    }
