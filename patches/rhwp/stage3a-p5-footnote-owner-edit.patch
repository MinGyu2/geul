+    #[test]
+    fn footnote_view_address_matches_the_exact_note_paragraph() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        core.insert_text_native(0, 0, 0, "body").unwrap();
+        core.insert_footnote_native(0, 0, 0).unwrap();
+        let control_idx = core.document.sections[0].paragraphs[0]
+            .controls
+            .iter()
+            .position(|control| matches!(control, Control::Footnote(_)))
+            .unwrap();
+        let (instance_id, number) =
+            match &core.document.sections[0].paragraphs[0].controls[control_idx] {
+                Control::Footnote(note) => (note.instance_id, note.number),
+                _ => unreachable!(),
+            };
+        core.insert_text_in_note_native(
+            "footnote",
+            0,
+            0,
+            control_idx,
+            instance_id,
+            number,
+            0,
+            2,
+            "note",
+        )
+        .unwrap();
+
+        let address: serde_json::Value = serde_json::from_str(
+            &core
+                .get_footnote_view_address_native(
+                    0,
+                    0,
+                    control_idx,
+                    instance_id,
+                    number,
+                    0,
+                    2,
+                    0,
+                    NoteOwnerPath::Body,
+                )
+                .unwrap(),
+        )
+        .unwrap();
+        assert_eq!(address["ok"], true);
+        assert_eq!(address["sectionIdx"], 0);
+        assert_eq!(address["paraIdx"], 0);
+        assert_eq!(address["controlIdx"], control_idx);
+        assert_eq!(address["instanceId"], instance_id);
+        assert_eq!(address["number"], number);
+        assert_eq!(address["noteParaIdx"], 0);
+        assert_eq!(address["ownerPath"]["sourceType"], "body");
+        assert!(core
+            .get_footnote_view_address_native(
+                0,
+                0,
+                control_idx,
+                instance_id,
+                number + 1,
+                0,
+                2,
+                0,
+                NoteOwnerPath::Body
+            )
+            .is_err());
+        assert!(core
+            .get_footnote_view_address_native(
+                0,
+                0,
+                control_idx,
+                instance_id,
+                number,
+                9,
+                0,
+                0,
+                NoteOwnerPath::Body
+            )
+            .is_err());
+    }
