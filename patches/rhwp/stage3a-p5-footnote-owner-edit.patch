+    /// Validate the exact direct-body note owner used by an editing session.
+    /// Indices alone are not enough: after a reload or a stale hit they could
+    /// name another note of the same local number.
+    pub fn validate_note_owner_native(
+        &self,
+        kind: &str,
+        section_idx: usize,
+        para_idx: usize,
+        control_idx: usize,
+        expected_instance_id: u32,
+        expected_number: u16,
+    ) -> Result<(), HwpError> {
+        if !matches!(kind, "footnote" | "endnote") {
+            return Err(HwpError::RenderError(
+                "지원하지 않는 노트 종류입니다".to_string(),
+            ));
+        }
+        let control = self
+            .document
+            .sections
+            .get(section_idx)
+            .and_then(|section| section.paragraphs.get(para_idx))
+            .and_then(|paragraph| paragraph.controls.get(control_idx))
+            .ok_or_else(|| {
+                HwpError::RenderError(
+                    "노트 소유 주소가 오래되었거나 범위를 벗어났습니다".to_string(),
+                )
+            })?;
+        let (actual_kind, instance_id, number) = match control {
+            Control::Footnote(note) => ("footnote", note.instance_id, note.number),
+            Control::Endnote(note) => ("endnote", note.instance_id, note.number),
+            _ => {
+                return Err(HwpError::RenderError(
+                    "주소가 각주/미주 컨트롤을 가리키지 않습니다".to_string(),
+                ))
+            }
+        };
+        if actual_kind != kind || instance_id != expected_instance_id || number != expected_number {
+            return Err(HwpError::RenderError(
+                "노트 종류, 식별자 또는 번호가 현재 소유자와 일치하지 않습니다".to_string(),
+            ));
+        }
+        Ok(())
+    }
