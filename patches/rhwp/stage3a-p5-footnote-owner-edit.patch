 use crate::model::paragraph::{ParaMeta, Paragraph};
 use crate::renderer::composer::{reflow_line_segs, restamp_indentation, ParagraphBox};
 
+/// A note may be owned by a body paragraph, a table-cell paragraph, or a shape text box.
+/// This path is separate from the note's rendered page/index and is validated on every edit.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum NoteOwnerPath {
+    Body,
+    TableCell {
+        cell_index: usize,
+        cell_para_index: usize,
+        cell_control_index: usize,
+    },
+    ShapeTextBox {
+        tb_para_index: usize,
+        tb_control_index: usize,
+    },
+}
+
+impl NoteOwnerPath {
+    pub(crate) fn from_json(raw: &str) -> Result<Self, HwpError> {
+        if raw.len() > 1024 {
+            return Err(HwpError::RenderError(
+                "노트 소유 경로가 너무 깁니다".to_string(),
+            ));
+        }
+        let value: serde_json::Value = serde_json::from_str(raw).map_err(|_| {
+            HwpError::RenderError("노트 소유 경로 JSON이 잘못되었습니다".to_string())
+        })?;
+        let object = value
+            .as_object()
+            .ok_or_else(|| HwpError::RenderError("노트 소유 경로가 객체가 아닙니다".to_string()))?;
+        let index = |key: &str| -> Result<usize, HwpError> {
+            let value = object
+                .get(key)
+                .and_then(serde_json::Value::as_u64)
+                .ok_or_else(|| {
+                    HwpError::RenderError("노트 소유 경로 인덱스가 잘못되었습니다".to_string())
+                })?;
+            if value > u32::MAX as u64 {
+                return Err(HwpError::RenderError(
+                    "노트 소유 경로 인덱스가 범위를 벗어났습니다".to_string(),
+                ));
+            }
+            Ok(value as usize)
+        };
+        match object.get("sourceType").and_then(serde_json::Value::as_str) {
+            Some("body") if object.len() == 1 => Ok(Self::Body),
+            Some("table")
+                if object.len() == 4
+                    && object.contains_key("cellIndex")
+                    && object.contains_key("cellParaIndex")
+                    && object.contains_key("cellControlIndex") =>
+            {
+                Ok(Self::TableCell {
+                    cell_index: index("cellIndex")?,
+                    cell_para_index: index("cellParaIndex")?,
+                    cell_control_index: index("cellControlIndex")?,
+                })
+            }
+            Some("shape")
+                if object.len() == 3
+                    && object.contains_key("tbParaIndex")
+                    && object.contains_key("tbControlIndex") =>
+            {
+                Ok(Self::ShapeTextBox {
+                    tb_para_index: index("tbParaIndex")?,
+                    tb_control_index: index("tbControlIndex")?,
+                })
+            }
+            _ => Err(HwpError::RenderError(
+                "노트 소유 경로 종류나 필드가 지원되지 않습니다".to_string(),
+            )),
+        }
+    }
+
+    pub(crate) fn to_json(self) -> serde_json::Value {
+        match self {
+            Self::Body => serde_json::json!({"sourceType":"body"}),
+            Self::TableCell {
+                cell_index,
+                cell_para_index,
+                cell_control_index,
+            } => serde_json::json!({
+                "sourceType":"table", "cellIndex":cell_index,
+                "cellParaIndex":cell_para_index, "cellControlIndex":cell_control_index,
+            }),
+            Self::ShapeTextBox {
+                tb_para_index,
+                tb_control_index,
+            } => serde_json::json!({
+                "sourceType":"shape", "tbParaIndex":tb_para_index, "tbControlIndex":tb_control_index,
+            }),
+        }
+    }
+}
