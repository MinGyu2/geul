+    pub(crate) fn split_paragraph_in_note_at_native(
+        &mut self,
+        kind: &str,
+        section_idx: usize,
+        para_idx: usize,
+        control_idx: usize,
+        owner_path: NoteOwnerPath,
+        expected_instance_id: u32,
+        expected_number: u16,
+        note_para_idx: usize,
+        char_offset: usize,
+        restore_meta: Option<ParaMeta>,
+    ) -> Result<String, HwpError> {
+        self.validate_note_paragraph_edit_at_native(
+            kind,
+            section_idx,
+            para_idx,
+            control_idx,
+            owner_path,
+            expected_instance_id,
+            expected_number,
+            note_para_idx,
+            char_offset,
+            char_offset,
+        )?;
+        let mut new_para = self
+            .note_paragraph_mut_at(
+                section_idx,
+                para_idx,
+                control_idx,
+                owner_path,
+                note_para_idx,
+            )
+            .ok_or_else(|| {
+                HwpError::RenderError(
+                    "노트 문단 주소가 오래되었거나 범위를 벗어났습니다".to_string(),
+                )
+            })?
+            .split_at(char_offset);
+        if let Some(meta) = restore_meta {
+            restore_para_meta(&mut new_para, meta, &self.document.doc_info.para_shapes);
+        }
+        let inserted_para = note_para_idx + 1;
+        match self
+            .note_control_mut_at(section_idx, para_idx, control_idx, owner_path)
+            .ok_or_else(|| {
+                HwpError::RenderError(
+                    "노트 소유 주소가 오래되었거나 범위를 벗어났습니다".to_string(),
+                )
+            })? {
+            Control::Footnote(note) => note.paragraphs.insert(inserted_para, new_para),
+            Control::Endnote(note) => note.paragraphs.insert(inserted_para, new_para),
+            _ => {
+                return Err(HwpError::RenderError(
+                    "주소가 각주/미주 컨트롤을 가리키지 않습니다".to_string(),
+                ))
+            }
+        }
+        self.reflow_note_paragraph_at(
+            section_idx,
+            para_idx,
+            control_idx,
+            owner_path,
+            note_para_idx,
+        );
+        self.reflow_note_paragraph_at(
+            section_idx,
+            para_idx,
+            control_idx,
+            owner_path,
+            inserted_para,
+        );
+        self.document.sections[section_idx].raw_stream = None;
+        self.mark_section_dirty(section_idx);
+        self.paginate_if_needed();
+        self.event_log.push(DocumentEvent::ParagraphSplit {
+            section: section_idx,
+            para: para_idx,
+            offset: char_offset,
+        });
+        Ok(super::super::helpers::json_ok_with(&format!(
+            "\"fnParaIndex\":{},\"charOffset\":0",
+            inserted_para
+        )))
+    }
