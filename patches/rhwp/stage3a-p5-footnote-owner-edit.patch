+    pub(crate) fn delete_text_in_note_at_native(
+        &mut self,
+        kind: &str,
+        section_idx: usize,
+        para_idx: usize,
+        control_idx: usize,
+        owner_path: NoteOwnerPath,
+        expected_instance_id: u32,
+        expected_number: u16,
+        note_para_idx: usize,
+        char_offset: usize,
+        count: usize,
+    ) -> Result<String, HwpError> {
+        let end = char_offset
+            .checked_add(count)
+            .ok_or_else(|| HwpError::RenderError("노트 삭제 범위가 오버플로합니다".to_string()))?;
+        self.validate_note_paragraph_edit_at_native(
