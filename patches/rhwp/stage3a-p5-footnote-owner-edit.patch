+                    "노트 문단 주소가 오래되었거나 범위를 벗어났습니다".to_string(),
+                )
+            })?
+            .text
+            .chars()
+            .skip(char_offset)
+            .take(count)
+            .collect();
+        self.note_paragraph_mut_at(
+            section_idx,
+            para_idx,
+            control_idx,
+            owner_path,
+            note_para_idx,
+        )
+        .ok_or_else(|| {
+            HwpError::RenderError("노트 문단 주소가 오래되었거나 범위를 벗어났습니다".to_string())
+        })?
+        .delete_text_at(char_offset, count);
+        self.reflow_note_paragraph_at(
+            section_idx,
+            para_idx,
+            control_idx,
+            owner_path,
+            note_para_idx,
+        );
+        self.document.sections[section_idx].raw_stream = None;
