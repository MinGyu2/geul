+            para: para_idx,
+            offset: char_offset,
+            count,
+        });
+        Ok(super::super::helpers::json_ok_with(&format!(
+            "\"charOffset\":{},\"deletedText\":\"{}\"",
+            char_offset,
+            super::super::helpers::json_escape(&deleted_text)
+        )))
+    }
