+/// Horizontal caption bands that extend a TAC picture's inline flow box.
+/// Returned values include the picture-to-caption gap.
+pub(crate) fn tac_picture_caption_lateral_bands_px(
+    picture: &crate::model::image::Picture,
+    dpi: f64,
+) -> (f64, f64) {
+    let Some(caption) = picture.caption.as_ref() else {
+        return (0.0, 0.0);
+    };
+    let band = hwpunit_to_px(caption.width as i32, dpi)
+        + hwpunit_to_px(i32::from(caption.spacing), dpi);
+    match caption.direction {
+        CaptionDirection::Left => (band, 0.0),
+        CaptionDirection::Right => (0.0, band),
+        CaptionDirection::Top | CaptionDirection::Bottom => (0.0, 0.0),
+    }
 }
 
