+
+fn geul_edit_cubic_segment(
+    points: &mut Vec<crate::model::Point>,
+    segments: &mut Vec<u8>,
+    used: usize,
+    index: usize,
+    insert: Option<[crate::model::Point; 3]>,
+) -> bool {
+    let Some(handles) = geul_cubic_handles(points, segments) else { return false; };
+    if used > segments.len() { return false; }
+    let mut updated_points = points.clone();
+    let mut commands = segments[..used].to_vec();
+    if let Some([control1, control2, end]) = insert {
+        if index == 0 || index >= updated_points.len() || handles[index] || updated_points.len() > 254 {
+            return false;
+        }
+        let command = handles[1..=index].iter().filter(|handle| !**handle).count();
+        if command > commands.len() || geul_same_point(&updated_points[index], &end) {
+            return false;
+        }
+        updated_points.splice(index + 1..index + 1, [control1, control2, end]);
+        commands.insert(command, 1);
+        commands.resize(updated_points.len() - 1, 0);
+    } else {
+        if index == 0 || index + 2 >= updated_points.len() || !handles[index]
+            || !handles[index + 1] || handles[index + 2]
+        {
+            return false;
+        }
+        let command = handles[1..index].iter().filter(|handle| !**handle).count();
+        if commands.get(command) != Some(&1) {
+            return false;
+        }
+        updated_points.drain(index..index + 3);
+        commands.remove(command);
+        commands.resize(updated_points.len() - 1, 0);
+    }
+    if !geul_cubic_handles(&updated_points, &commands).is_some_and(|handles| handles.contains(&true)) {
+        return false;
+    }
+    *points = updated_points;
+    *segments = commands;
+    true
+}
