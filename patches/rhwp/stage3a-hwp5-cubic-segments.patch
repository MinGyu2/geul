+#[cfg(test)]
+mod geul_cubic_segment_tests {
+    use super::{geul_cubic_handles, geul_edit_cubic_segment};
+    use crate::model::Point;
+
+    fn p(x: i32, y: i32) -> Point { Point { x, y } }
+
+    #[test]
+    fn inserts_and_removes_one_interior_cubic_without_reordering_existing_points() {
+        let mut points = vec![p(0, 0), p(10, 20), p(20, 20), p(30, 20), p(40, 20)];
+        let original = points.clone();
+        let mut commands = vec![1, 0, 0, 0];
+        assert!(geul_edit_cubic_segment(&mut points, &mut commands, 2, 3,
+            Some([p(34, 22), p(38, 25), p(42, 30)])));
+        let coords = |points: &[Point]| points.iter().map(|point| (point.x, point.y)).collect::<Vec<_>>();
+        assert_eq!(coords(&points[..4]), coords(&original[..4]));
+        assert_eq!(coords(&points[7..]), coords(&original[4..]));
+        assert_eq!(commands, vec![1, 1, 0, 0, 0, 0, 0]);
+        assert!(geul_cubic_handles(&points, &commands).is_some());
+
+        assert!(geul_edit_cubic_segment(&mut points, &mut commands, 3, 4, None));
+        assert_eq!(coords(&points), coords(&original));
+        assert_eq!(commands, vec![1, 0, 0, 0]);
+    }
+
+    #[test]
+    fn rejected_cubic_removal_leaves_the_path_unchanged() {
+        let mut points = vec![p(0, 0), p(10, 20), p(20, 20), p(30, 20), p(40, 20)];
+        let mut commands = vec![1, 0, 0, 0];
+        let before = (points.iter().map(|point| (point.x, point.y)).collect::<Vec<_>>(), commands.clone());
+        assert!(!geul_edit_cubic_segment(&mut points, &mut commands, 2, 0, None));
+        assert_eq!((points.iter().map(|point| (point.x, point.y)).collect::<Vec<_>>(), commands), before);
+    }
+
+    #[test]
+    fn rejected_cubic_insertion_leaves_points_and_command_padding_unchanged() {
+        let mut points = vec![p(0, 0), p(10, 20), p(20, 20), p(30, 20), p(40, 20)];
+        let mut commands = vec![1, 0, 0, 0];
+        let before = (points.iter().map(|point| (point.x, point.y)).collect::<Vec<_>>(), commands.clone());
+        assert!(!geul_edit_cubic_segment(&mut points, &mut commands, 2, 3,
+            Some([p(34, 22), p(38, 25), p(30, 20)])));
+        assert_eq!((points.iter().map(|point| (point.x, point.y)).collect::<Vec<_>>(), commands), before);
+    }
 }
 
