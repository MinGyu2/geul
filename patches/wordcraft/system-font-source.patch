+/// A [`SystemFontSource`] listing fixed files, with fixed aliases and fallbacks.
+struct ListSource {
+    files: std::sync::Mutex<Vec<PathBuf>>,
+    aliases: Vec<(&'static str, &'static str)>,
+    fallbacks: Vec<String>,
+}
+
+impl SystemFontSource for ListSource {
+    fn name(&self) -> &str {
+        "test-list"
+    }
+    fn font_files(&self) -> Vec<PathBuf> {
+        self.files.lock().unwrap().clone()
+    }
+    fn resolve_family(&self, family: &str) -> Option<String> {
+        self.aliases.iter().find(|(a, _)| a.eq_ignore_ascii_case(family)).map(|(_, t)| t.to_string())
+    }
+    fn fallback_families(&self, _c: char) -> Vec<String> {
+        self.fallbacks.clone()
+    }
+}
+
+fn list_source(files: Vec<PathBuf>) -> Arc<ListSource> {
+    Arc::new(ListSource { files: std::sync::Mutex::new(files), aliases: vec![("sans-serif", FAMILY)], fallbacks: vec![] })
+}
+
+#[test]
+fn a_system_font_source_replaces_the_folder_walk() {
+    let dir = font_dir("source");
+    // The folder holds the family, but the source lists only the Regular file (twice, as a
+    // configuration does once per face) and a damaged one: the folder is not walked.
+    let db = FontDb::with_font_dirs(vec![dir.clone()]);
+    let src = list_source(vec![dir.join("Sysfont-Regular.ttf"), dir.join("Sysfont-Regular.ttf"), dir.join("damaged.ttf"), dir.join("missing.ttf")]);
+    assert_eq!(db.set_system_font_source(Some(src.clone())), 1);
+    assert_eq!(db.system_font_source_name().as_deref(), Some("test-list"));
+    assert_eq!(db.styles(FAMILY), ["Regular"]);
+    // A source listing nothing (no font configuration): no system fonts, the bundled ones remain.
+    let g = db.generation();
+    src.files.lock().unwrap().clear();
+    assert_eq!(db.load_system_fonts(), 0);
+    assert!(db.generation() > g, "a rescan tells watchers");
+    assert!(!db.has_family(FAMILY));
+    assert!(db.has_family(FALLBACK_FAMILY));
+    // Refreshing picks up files the configuration lists later.
+    src.files.lock().unwrap().push(dir.join("Sub/Sysfont-Bold.TTF"));
+    assert_eq!(db.load_system_fonts(), 1);
+    assert_eq!(db.styles(FAMILY), ["Bold"]);
+    // Back to the folder walk.
+    assert_eq!(db.set_system_font_source(None), 2);
+}
+
+#[test]
+fn source_aliases_resolve_generic_families_without_renaming_requests() {
+    let dir = font_dir("alias");
+    let db = FontDb::with_font_dirs(vec![]);
+    db.set_system_font_source(Some(list_source(vec![dir.join("Sysfont-Regular.ttf")])));
+    assert_eq!(db.resolve_alias("sans-serif").as_deref(), Some(FAMILY));
+    assert_eq!(db.face("sans-serif", "Regular").family, FAMILY);
+    // A name the configuration doesn't map keeps the bundled fallback.
+    assert_eq!(db.resolve_alias("No Such Font"), None);
+    assert_eq!(db.face("No Such Font", "Regular").family, FALLBACK_FAMILY);
+    // An alias to a family that isn't installed is no answer.
+    let db2 = FontDb::with_font_dirs(vec![]);
+    db2.set_system_font_source(Some(list_source(vec![])));
+    assert_eq!(db2.resolve_alias("sans-serif"), None);
+}
+
+#[test]
+fn source_fallback_families_are_tried_first_for_uncovered_characters() {
+    // The renamed Source Sans 3 maps Latin; ask for a character only it (as the source's choice)
+    // would be loaded for: no other cataloged family, and a preferred family isn't installed.
+    let dir = font_dir("srcfallback");
+    let db = FontDb::with_font_dirs(vec![]);
+    let src = Arc::new(ListSource {
+        files: std::sync::Mutex::new(vec![dir.join("Sysfont-Regular.ttf")]),
+        aliases: vec![],
+        fallbacks: vec!["Not Installed".into(), FAMILY.into()],
+    });
+    db.set_system_font_source(Some(src));
+    assert!(!db.is_loaded(FAMILY));
+    // 'ŉ' (U+0149) is in Source Sans 3; exclude every loaded face so the system search runs.
+    let c = '\u{0149}';
+    db.set_system_fallback(true);
+    let ok = db.system_fallback(c);
+    assert!(ok && db.is_loaded(FAMILY), "the source's family was loaded for the character");
+}
