+fn set_column_width_cmd(s: &mut Session, v: &Value) -> CmdResult {
+    let distribute = v.get("distribute").and_then(|x| x.as_bool()).unwrap_or(false);
+    let width = match v.get("width") {
+        None | Some(Value::Null) => None,
+        Some(raw) => {
+            let w = raw.as_f64().ok_or_else(|| CmdError::Params("`width` must be a number".into()))? as f32;
+            if !w.is_finite() || !(6.0..=1584.0).contains(&w) {
+                return Err(CmdError::Params(format!("column width out of bounds: {w}")));
+            }
+            Some(wordcraft_doc::table::quantize_twips(w).max(6.0))
+        }
+    };
+    if distribute && width.is_some() {
+        return Err(CmdError::Params("cannot specify both `width` and `distribute`".into()));
+    }
+    if !distribute && width.is_none() {
+        return Err(CmdError::Params("setColumnWidth requires `width` or `distribute: true`".into()));
+    }
+    let (tp, _r0, _r1, g0, g1, _) = selected_cell_rect(s)?;
+    let story = s.sel.focus.story;
+    let t = s.doc.table_mut(story, &tp)?;
+    if distribute {
+        let total: f32 = t.grid.iter().sum();
+        let n = t.grid.len().max(1) as f32;
+        let each = wordcraft_doc::table::quantize_twips(total / n).max(6.0);
+        t.grid.iter_mut().for_each(|g| *g = each);
+        t.props.width = None;
+        t.props.width_pct = None;
+    } else if let Some(w) = width {
+        for g in g0..=g1 {
+            if let Some(col) = t.grid.get_mut(g) {
+                *col = w;
+            }
+        }
+        t.props.width = None;
+        t.props.width_pct = None;
+    }
+    sync_cell_widths(t);
+    touch_cells(s, &tp)?;
+    sel_result(s)
+}
+
+fn set_row_height_cmd(s: &mut Session, v: &Value) -> CmdResult {
+    let distribute = v.get("distribute").and_then(|x| x.as_bool()).unwrap_or(false);
+    let clear = matches!(v.get("height"), Some(Value::Null));
+    let height = match v.get("height") {
+        None | Some(Value::Null) => None,
+        Some(raw) => {
+            let h = raw.as_f64().ok_or_else(|| CmdError::Params("`height` must be a number or null".into()))? as f32;
+            if !h.is_finite() || !(1.0..=1584.0).contains(&h) {
+                return Err(CmdError::Params(format!("row height out of bounds: {h}")));
+            }
+            Some(wordcraft_doc::table::quantize_twips(h).max(1.0))
+        }
+    };
+    let rule = match p::str(v, "rule") {
+        None => None,
+        Some("atLeast") => Some(HeightRule::AtLeast),
+        Some("exact") => Some(HeightRule::Exact),
+        Some(x) => return Err(CmdError::Params(format!("unknown height rule `{x}`"))),
+    };
+    if distribute {
+        if height.is_some() || clear || rule.is_some() {
+            return Err(CmdError::Params("`distribute` cannot be combined with explicit height or rule".into()));
+        }
+    } else if !clear && height.is_none() {
+        return Err(CmdError::Params("setRowHeight requires `height` or `distribute: true`".into()));
+    }
+    let (tp, r0, r1, _g0, _g1, _) = selected_cell_rect(s)?;
+    let story = s.sel.focus.story;
+    let t = s.doc.table_mut(story, &tp)?;
+    if distribute {
+        let h = wordcraft_doc::table::quantize_twips(
+            t.rows.iter().filter_map(|r| r.props.height).fold(0.0f32, f32::max).max(18.0),
+        );
+        for row in &mut t.rows {
+            row.props.height = Some(h);
+            if row.props.height_rule == HeightRule::Auto {
+                row.props.height_rule = HeightRule::AtLeast;
+            }
+        }
+    } else if clear {
+        for r in r0..=r1 {
+            if let Some(row) = t.rows.get_mut(r) {
+                row.props.height = None;
+                row.props.height_rule = HeightRule::Auto;
+            }
+        }
+    } else if let Some(h) = height {
+        let chosen = rule.unwrap_or(HeightRule::AtLeast);
+        for r in r0..=r1 {
+            if let Some(row) = t.rows.get_mut(r) {
+                row.props.height = Some(h);
+                row.props.height_rule = chosen;
+            }
+        }
+    }
+    touch_cells(s, &tp)?;
+    sel_result(s)
+}
