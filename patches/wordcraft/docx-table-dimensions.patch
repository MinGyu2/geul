+
+    #[test]
+    fn cell_dimensions_preserve_unrelated_and_roundtrip() {
+        use wordcraft_doc::props::HeightRule;
+        let mut s = new_session();
+        s.run("insert.table", &json!({"rows": 3, "cols": 3})).unwrap();
+        s.run("caret.set", &json!({"pos": {"story": "body", "path": [0, 0, 0, 0], "off": 0}})).unwrap();
+
+        assert!(s.run("table.setColumnWidth", &json!({"width": 2.0})).is_err());
+        assert!(s.run("table.setColumnWidth", &json!({"width": 9999.0})).is_err());
+        assert!(s.run("table.setRowHeight", &json!({"height": 0.2})).is_err());
+        assert!(s.run("table.setRowHeight", &json!({"height": 24.0, "rule": "bogus"})).is_err());
+
+        // Single column width 120pt -> unrelated cols untouched, sync_cell_widths updated
+        let orig_c2 = s.doc.body[0].as_table().unwrap().grid[2];
+        s.run("table.setColumnWidth", &json!({"width": 120.0})).unwrap();
+        let t = s.doc.body[0].as_table().unwrap();
+        assert!((t.grid[0] - 120.0).abs() < 0.01);
+        assert!((t.grid[2] - orig_c2).abs() < 0.01);
+
+        // Multi-row height exact 36pt on rows 0..=1 -> row 2 untouched
+        s.run("caret.set", &json!({"pos": {"story": "body", "path": [0, 0, 0, 0], "off": 0}, "extend": false})).unwrap();
+        s.run("caret.set", &json!({"pos": {"story": "body", "path": [0, 1, 1, 0], "off": 0}, "extend": true})).unwrap();
+        s.run("table.setRowHeight", &json!({"height": 36.0, "rule": "exact"})).unwrap();
+        let t = s.doc.body[0].as_table().unwrap();
+        assert_eq!(t.rows[0].props.height, Some(36.0));
+        assert_eq!(t.rows[1].props.height_rule, HeightRule::Exact);
+        assert_eq!(t.rows[2].props.height, None);
+
+        // Clear row height back to Auto, then distribute columns
+        s.run("table.setRowHeight", &json!({"height": null})).unwrap();
+        assert_eq!(s.doc.body[0].as_table().unwrap().rows[0].props.height_rule, HeightRule::Auto);
+        s.run("table.setColumnWidth", &json!({"distribute": true})).unwrap();
+        let t = s.doc.body[0].as_table().unwrap();
+        assert!((t.grid[0] - t.grid[1]).abs() < 0.01);
+
+        let bytes = crate::io::save_bytes("table_dims.docx", &s.doc).unwrap();
+        let reopened = crate::io::open_bytes("table_dims.docx", &bytes).unwrap();
+        assert_eq!(roundtrip_equivalent(&s.doc, &reopened), Ok(true));
+    }
