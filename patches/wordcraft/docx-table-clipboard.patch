+fn para_plain_editable(p: &Paragraph) -> bool {
+    p.objects.is_empty()
+        && p.section.is_none()
+        && !p.text.contains(wordcraft_doc::para::OBJ)
+        && p.props.num_change.is_none()
+        && p.props.fmt_change.is_none()
+        && p.mark.ins.is_none()
+        && p.mark.del.is_none()
+        && p.mark.fmt_change.is_none()
+        && p.runs.iter().all(|r| r.props.ins.is_none() && r.props.del.is_none() && r.props.fmt_change.is_none())
+}
+
+fn cell_plain_editable(c: &wordcraft_doc::Cell) -> bool {
+    c.controls.is_empty()
+        && c.props.fmt_change.is_none()
+        && c.blocks.iter().all(|b| b.as_para().is_some_and(para_plain_editable))
+}
+
+fn rect_plain_editable(t: &Table, r0: usize, r1: usize, g0: usize, g1: usize) -> bool {
+    if t.rect_has_controls(r0, r1, g0, g1) {
+        return false;
+    }
+    for r in r0..=r1 {
+        if !t.rows[r].controls.is_empty() || t.rows[r].props.fmt_change.is_some() {
+            return false;
+        }
+        let (Some(a), Some(b)) = (t.cell_at_grid(r, g0), t.cell_at_grid(r, g1)) else {
+            return false;
+        };
+        for ci in a..=b {
+            if !cell_plain_editable(&t.rows[r].cells[ci]) {
+                return false;
+            }
+        }
+    }
+    true
+}
+
+fn clear_cells_cmd(s: &mut Session, _: &Value) -> CmdResult {
+    let (tp, r0, r1, g0, g1, count) = selected_cell_rect(s)?;
+    if count < 2 {
+        return Err(CmdError::Failed("clearCells requires a multi-cell selection".into()));
+    }
+    let story = s.sel.focus.story;
+    {
+        let t = s.doc.table(story, &tp).ok_or_else(|| CmdError::Failed("there's no table there".into()))?;
+        if !rect_plain_editable(t, r0, r1, g0, g1) {
+            return Err(CmdError::Failed("cannot cut cells with unsupported objects or revisions".into()));
+        }
+    }
+    let t = s.doc.table_mut(story, &tp)?;
+    for r in r0..=r1 {
+        let (Some(a), Some(b)) = (t.cell_at_grid(r, g0), t.cell_at_grid(r, g1)) else {
+            return Err(CmdError::Failed("invalid cell grid".into()));
+        };
+        for ci in a..=b {
+            t.rows[r].cells[ci].blocks = vec![para_block(Paragraph::new())];
+        }
+    }
+    touch_cells(s, &tp)?;
+    let c0 = s.doc.table(story, &tp).and_then(|t| t.cell_at_grid(r0, g0)).unwrap_or(0);
+    fix_caret(s, &tp, r0, c0)
+}
