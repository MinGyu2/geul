+        assert_eq!(s.doc.body[0].as_table().unwrap().rows[0].cells[0].blocks[0].as_para().unwrap().plain_text(), "Hdr");
+
+        let bytes = crate::io::save_bytes("table_clip.docx", &s.doc).unwrap();
+        let reopened = crate::io::open_bytes("table_clip.docx", &bytes).unwrap();
+        assert_eq!(roundtrip_equivalent(&s.doc, &reopened), Ok(true));
+    }
 }
