+fn cell_alignment(s: &mut Session, v: &Value) -> CmdResult {
+    let horizontal = match v.get("horizontal") {
+        None | Some(Value::Null) => None,
+        Some(Value::String(raw)) => Some(match raw.as_str() {
+            "left" => Align::Left,
+            "center" => Align::Center,
+            "right" => Align::Right,
+            "justify" => Align::Justify,
+            _ => return Err(CmdError::Params(format!("unknown horizontal alignment `{raw}`"))),
+        }),
+        Some(_) => return Err(CmdError::Params("`horizontal` must be a string".into())),
+    };
+    let vertical = match v.get("vertical") {
+        None | Some(Value::Null) => None,
+        Some(Value::String(raw)) => Some(match raw.as_str() {
+            "top" => VAlign::Top,
+            "middle" => VAlign::Center,
+            "bottom" => VAlign::Bottom,
+            _ => return Err(CmdError::Params(format!("unknown vertical alignment `{raw}`"))),
+        }),
+        Some(_) => return Err(CmdError::Params("`vertical` must be a string".into())),
+    };
+    if horizontal.is_none() && vertical.is_none() {
+        return Err(CmdError::Params("cellAlignment requires `horizontal` and/or `vertical`".into()));
+    }
+    let (tp, r0, r1, g0, g1, _) = selected_cell_rect(s)?;
+    let story = s.sel.focus.story;
+    let t = s.doc.table_mut(story, &tp)?;
+    for r in r0..=r1 {
+        let mut g = 0usize;
+        for cl in &mut t.rows[r].cells {
+            let span = cl.span();
+            let cg0 = g;
+            let cg1 = g + span - 1;
+            g += span;
+            if cg0 <= g1 && cg1 >= g0 {
+                if let Some(va) = vertical {
+                    cl.props.valign = va;
+                }
+                if let Some(h) = horizontal {
+                    for b in &mut cl.blocks {
+                        if let Block::Para(p) = std::sync::Arc::make_mut(b) {
+                            p.props.align = Some(h);
+                            p.touch();
+                        }
+                    }
+                }
+            }
+        }
+    }
+    touch_cells(s, &tp)?;
+    sel_result(s)
+}
