+
+    #[test]
+    fn cell_alignment_preserves_unrelated_and_roundtrips() {
+        use wordcraft_doc::props::{Align, VAlign};
+        let mut s = new_session();
+        s.run("insert.table", &json!({"rows": 3, "cols": 3})).unwrap();
+        s.run("caret.set", &json!({"pos": {"story": "body", "path": [0, 0, 0, 0], "off": 0}})).unwrap();
+
+        assert!(s.run("table.cellAlignment", &json!({})).is_err());
+        assert!(s.run("table.cellAlignment", &json!({"horizontal": "diagonal"})).is_err());
+        assert!(s.run("table.cellAlignment", &json!({"vertical": "skew"})).is_err());
+
+        // Set only horizontal justify on (0,0)
+        s.run("table.cellAlignment", &json!({"horizontal": "justify"})).unwrap();
+        let t = s.doc.body[0].as_table().unwrap();
+        assert_eq!(t.rows[0].cells[0].blocks[0].as_para().unwrap().props.align, Some(Align::Justify));
+        assert_eq!(t.rows[0].cells[0].props.valign, VAlign::Top);
+        assert_eq!(t.rows[0].cells[1].blocks[0].as_para().unwrap().props.align, None);
+
+        // Set only vertical middle on 2x2 rect (0..=1, 0..=1), preserving justify on (0,0)
+        s.run("caret.set", &json!({"pos": {"story": "body", "path": [0, 0, 0, 0], "off": 0}, "extend": false})).unwrap();
+        s.run("caret.set", &json!({"pos": {"story": "body", "path": [0, 1, 1, 0], "off": 0}, "extend": true})).unwrap();
+        s.run("table.cellAlignment", &json!({"vertical": "middle"})).unwrap();
+        let t = s.doc.body[0].as_table().unwrap();
+        assert_eq!(t.rows[0].cells[0].props.valign, VAlign::Center);
+        assert_eq!(t.rows[0].cells[0].blocks[0].as_para().unwrap().props.align, Some(Align::Justify));
+        assert_eq!(t.rows[1].cells[1].props.valign, VAlign::Center);
+        assert_eq!(t.rows[2].cells[2].props.valign, VAlign::Top);
+
+        let bytes = crate::io::save_bytes("table_align.docx", &s.doc).unwrap();
+        let reopened = crate::io::open_bytes("table_align.docx", &bytes).unwrap();
+        assert_eq!(roundtrip_equivalent(&s.doc, &reopened), Ok(true));
+    }
 }
