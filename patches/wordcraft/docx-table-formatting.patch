+    #[test]
+    fn cell_shading_and_cell_borders_preserve_unrelated_and_roundtrip() {
+        use wordcraft_doc::props::{BorderStyle, Rgb};
+        let mut s = new_session();
+        s.run("insert.table", &json!({"rows": 3, "cols": 3})).unwrap();
+        s.run("caret.set", &json!({"pos": {"story": "body", "path": [0, 0, 0, 0], "off": 0}})).unwrap();
+
+        // Invalid parameters rejected
+        assert!(s.run("table.shading", &json!({"color": "ZZZZZZ"})).is_err());
+        assert!(s.run("table.cellBorders", &json!({"kind": "inside", "style": "single"})).is_err());
+        assert!(s.run("table.cellBorders", &json!({"kind": "all", "style": "bogus"})).is_err());
+        assert!(s.run("table.cellBorders", &json!({"kind": "all", "style": "single", "width": 0.05})).is_err());
+
+        // Single cell shading + removal
+        s.run("table.shading", &json!({"color": "FFE0B2"})).unwrap();
+        assert_eq!(
+            s.doc.body[0].as_table().unwrap().rows[0].cells[0].props.shading,
+            Some(Rgb(0xFF, 0xE0, 0xB2))
+        );
+        assert_eq!(s.doc.body[0].as_table().unwrap().rows[0].cells[1].props.shading, None);
+        s.run("table.shading", &json!({"color": null})).unwrap();
+        assert_eq!(s.doc.body[0].as_table().unwrap().rows[0].cells[0].props.shading, None);
+        assert!(s.undo());
+        assert_eq!(
+            s.doc.body[0].as_table().unwrap().rows[0].cells[0].props.shading,
+            Some(Rgb(0xFF, 0xE0, 0xB2))
+        );
+
+        // Select 2x2 rect (0..=1, 0..=1) and set outside double red borders
+        s.run("caret.set", &json!({"pos": {"story": "body", "path": [0, 0, 0, 0], "off": 0}, "extend": false})).unwrap();
+        s.run("caret.set", &json!({"pos": {"story": "body", "path": [0, 1, 1, 0], "off": 0}, "extend": true})).unwrap();
+        s.run(
+            "table.cellBorders",
+            &json!({"kind": "outside", "style": "double", "width": 1.5, "color": "C00000"}),
+        )
+        .unwrap();
+        let t = s.doc.body[0].as_table().unwrap();
+        // (0,0) top/left changed, right/bottom untouched; neighbor (0,2).left synced
+        let b00 = t.rows[0].cells[0].props.borders.unwrap();
+        assert_eq!(b00.top.unwrap().style, BorderStyle::Double);
+        assert_eq!(b00.left.unwrap().style, BorderStyle::Double);
+        assert!(b00.right.is_none() && b00.bottom.is_none());
+        let b02 = t.rows[0].cells[2].props.borders.unwrap();
+        assert_eq!(b02.left.unwrap().style, BorderStyle::Double);
+        assert!(t.rows[2].cells[2].props.borders.is_none());
+
+        // Inside borders on 2x2 rect
+        s.run(
+            "table.cellBorders",
+            &json!({"kind": "inside", "style": "dashed", "width": 0.75, "color": "0070C0"}),
+        )
+        .unwrap();
+        let t = s.doc.body[0].as_table().unwrap();
+        assert_eq!(t.rows[0].cells[0].props.borders.unwrap().right.unwrap().style, BorderStyle::Dashed);
+        assert_eq!(t.rows[0].cells[1].props.borders.unwrap().left.unwrap().style, BorderStyle::Dashed);
+
+        // Export & reopen roundtrip
+        let bytes = crate::io::save_bytes("table_fmt.docx", &s.doc).unwrap();
+        let reopened = crate::io::open_bytes("table_fmt.docx", &bytes).unwrap();
+        assert_eq!(roundtrip_equivalent(&s.doc, &reopened), Ok(true));
+    }
