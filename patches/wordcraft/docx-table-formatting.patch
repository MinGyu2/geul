+/// Resolve the selected rectangular cell region `(tp, r0, r1, g0, g1, logical_cell_count)`.
+/// Rejects cross-table selections and selections that partially overlap merged cells.
+fn selected_cell_rect(s: &Session) -> Result<(Path, usize, usize, usize, usize, usize), CmdError> {
+    let (tp, r, c) = cell(s)?;
+    let story = s.sel.focus.story;
+    let t = s.doc.table(story, &tp).ok_or_else(|| CmdError::Disabled("the cursor isn't in a table".into()))?;
+    if !t.is_grid_consistent() {
+        return Err(CmdError::Failed("inconsistent table grid".into()));
+    }
+    if let Some(range) = s.cell_range().filter(|cr| cr.story == story && cr.table == tp) {
+        let count = t
+            .logical_rect_valid(range.rows.0, range.rows.1, range.cols.0, range.cols.1)
+            .ok_or_else(|| CmdError::Failed("selection overlaps merged cells partially".into()))?;
+        return Ok((tp, range.rows.0, range.rows.1, range.cols.0, range.cols.1, count));
+    }
+    if s.sel.is_collapsed() {
+        let (r0, r1, g0, g1) = t.cell_extent(r, c).ok_or_else(|| CmdError::Failed("invalid cell extent".into()))?;
+        return Ok((tp, r0, r1, g0, g1, 1));
+    }
+    if s.sel.anchor.story != story {
+        return Err(CmdError::Failed("selection spans outside the table".into()));
+    }
+    let (Some((ta, ra, ca)), Some((tb, rb, cb))) = (s.sel.anchor.path.cell(), s.sel.focus.path.cell()) else {
+        return Err(CmdError::Failed("selection spans outside the table".into()));
+    };
+    if ta != tp || tb != tp {
+        return Err(CmdError::Failed("selection spans outside the table".into()));
+    }
+    if (ra, ca) == (rb, cb) {
+        let (r0, r1, g0, g1) = t.cell_extent(ra, ca).ok_or_else(|| CmdError::Failed("invalid cell extent".into()))?;
+        return Ok((tp, r0, r1, g0, g1, 1));
+    }
+    let (ga0, ga1) = grid_cols(t, ra, ca);
+    let (gb0, gb1) = grid_cols(t, rb, cb);
+    let (r0, r1, g0, g1) = (ra.min(rb), ra.max(rb), ga0.min(gb0), ga1.max(gb1));
+    let count = t
+        .logical_rect_valid(r0, r1, g0, g1)
+        .ok_or_else(|| CmdError::Failed("selection overlaps merged cells partially".into()))?;
+    Ok((tp, r0, r1, g0, g1, count))
+}
+
+fn shading(s: &mut Session, v: &Value) -> CmdResult {
+    let color = match v.get("color") {
+        None | Some(Value::Null) => None,
+        Some(Value::String(raw)) => Some(Rgb::parse(raw).ok_or_else(|| CmdError::Params(format!("invalid shading color `{raw}`")))?),
+        Some(_) => return Err(CmdError::Params("shading `color` must be `RRGGBB` or null".into())),
+    };
+    let (tp, r0, r1, g0, g1, _) = selected_cell_rect(s)?;
+    let story = s.sel.focus.story;
+    let t = s.doc.table_mut(story, &tp)?;
+    for r in r0..=r1 {
+        let mut g = 0usize;
+        for cl in &mut t.rows[r].cells {
+            let span = cl.span();
+            let cg0 = g;
+            let cg1 = g + span - 1;
+            g += span;
+            if cg0 <= g1 && cg1 >= g0 {
+                cl.props.shading = color;
+            }
+        }
+    }
+    touch_cells(s, &tp)?;
+    sel_result(s)
+}
+
+fn parse_cell_border_style(s: &str) -> Result<BorderStyle, CmdError> {
+    match s {
+        "none" => Ok(BorderStyle::None),
+        "single" => Ok(BorderStyle::Single),
+        "double" => Ok(BorderStyle::Double),
+        "dotted" => Ok(BorderStyle::Dotted),
+        "dashed" => Ok(BorderStyle::Dashed),
+        "thick" => Ok(BorderStyle::Thick),
+        "triple" => Ok(BorderStyle::Triple),
+        "dotDash" => Ok(BorderStyle::DotDash),
+        "wave" => Ok(BorderStyle::Wave),
+        _ => Err(CmdError::Params(format!("unknown border style `{s}`"))),
+    }
+}
+
+fn cell_borders(s: &mut Session, v: &Value) -> CmdResult {
+    let kind = p::str(v, "kind").ok_or_else(|| CmdError::Params("missing border `kind`".into()))?;
+    if !matches!(kind, "all" | "outside" | "inside" | "none" | "top" | "bottom" | "left" | "right") {
+        return Err(CmdError::Params(format!("unknown border kind `{kind}`")));
+    }
+    let none = Border { style: BorderStyle::None, width: 0.0, color: None, space: 0.0 };
+    let border = if kind == "none" {
+        none
+    } else {
+        let style = match v.get("style") {
+            None => BorderStyle::Single,
+            Some(Value::String(st)) => parse_cell_border_style(st)?,
+            Some(_) => return Err(CmdError::Params("border `style` must be a string".into())),
+        };
+        if style == BorderStyle::None {
+            none
+        } else {
+            let width = match v.get("width") {
+                None => 0.5,
+                Some(x) => {
+                    let w = x.as_f64().map(|f| f as f32).ok_or_else(|| CmdError::Params("border `width` must be a number".into()))?;
+                    if !w.is_finite() || !(0.25..=12.0).contains(&w) {
+                        return Err(CmdError::Params("border `width` out of range (0.25..=12.0 pt)".into()));
+                    }
+                    (w * 8.0).round() / 8.0
+                }
+            };
+            let color = match v.get("color") {
+                None | Some(Value::Null) => None,
+                Some(Value::String(raw)) => Some(Rgb::parse(raw).ok_or_else(|| CmdError::Params(format!("invalid border color `{raw}`")))?),
+                Some(_) => return Err(CmdError::Params("border `color` must be `RRGGBB` or null".into())),
+            };
+            Border { style, width, color, space: 0.0 }
+        }
+    };
+    let (tp, r0, r1, g0, g1, count) = selected_cell_rect(s)?;
+    if kind == "inside" && count < 2 {
+        return Err(CmdError::Failed("select two or more cells for inside borders".into()));
+    }
+    let story = s.sel.focus.story;
+    let t = s.doc.table_mut(story, &tp)?;
+    let nrows = t.rows.len();
+    let ncols = t.grid.len();
+    let apply_top = matches!(kind, "all" | "outside" | "none" | "top");
+    let apply_bottom = matches!(kind, "all" | "outside" | "none" | "bottom");
+    let apply_left = matches!(kind, "all" | "outside" | "none" | "left");
+    let apply_right = matches!(kind, "all" | "outside" | "none" | "right");
+    let apply_inside = matches!(kind, "all" | "inside" | "none");
+
+    for g in g0..=g1 {
+        if apply_top {
+            if let Some(ci) = t.cell_at_grid(r0, g) {
+                t.rows[r0].cells[ci].props.borders.get_or_insert_with(Default::default).top = Some(border);
+            }
+            if r0 > 0
+                && let Some(ci) = t.cell_at_grid(r0 - 1, g)
+            {
+                t.rows[r0 - 1].cells[ci].props.borders.get_or_insert_with(Default::default).bottom = Some(border);
+            }
+        }
+        if apply_bottom {
+            if let Some(ci) = t.cell_at_grid(r1, g) {
+                t.rows[r1].cells[ci].props.borders.get_or_insert_with(Default::default).bottom = Some(border);
+            }
+            if r1 + 1 < nrows
+                && let Some(ci) = t.cell_at_grid(r1 + 1, g)
+            {
+                t.rows[r1 + 1].cells[ci].props.borders.get_or_insert_with(Default::default).top = Some(border);
+            }
+        }
+        if apply_inside {
+            for r in r0..r1 {
+                if let (Some(ca), Some(cb)) = (t.cell_at_grid(r, g), t.cell_at_grid(r + 1, g))
+                    && t.rows[r + 1].cells[cb].props.vmerge != wordcraft_doc::props::VMerge::Continue
+                {
+                    t.rows[r].cells[ca].props.borders.get_or_insert_with(Default::default).bottom = Some(border);
+                    t.rows[r + 1].cells[cb].props.borders.get_or_insert_with(Default::default).top = Some(border);
+                }
+            }
+        }
+    }
+
+    for r in r0..=r1 {
+        if apply_left {
+            if let Some(ci) = t.cell_at_grid(r, g0) {
+                t.rows[r].cells[ci].props.borders.get_or_insert_with(Default::default).left = Some(border);
+            }
+            if g0 > 0
+                && let Some(ci) = t.cell_at_grid(r, g0 - 1)
+            {
+                t.rows[r].cells[ci].props.borders.get_or_insert_with(Default::default).right = Some(border);
+            }
+        }
+        if apply_right {
+            if let Some(ci) = t.cell_at_grid(r, g1) {
+                t.rows[r].cells[ci].props.borders.get_or_insert_with(Default::default).right = Some(border);
+            }
+            if g1 + 1 < ncols
+                && let Some(ci) = t.cell_at_grid(r, g1 + 1)
+            {
+                t.rows[r].cells[ci].props.borders.get_or_insert_with(Default::default).left = Some(border);
+            }
+        }
+        if apply_inside {
+            for g in g0..g1 {
+                if let (Some(ca), Some(cb)) = (t.cell_at_grid(r, g), t.cell_at_grid(r, g + 1))
+                    && ca != cb
+                {
+                    t.rows[r].cells[ca].props.borders.get_or_insert_with(Default::default).right = Some(border);
+                    t.rows[r].cells[cb].props.borders.get_or_insert_with(Default::default).left = Some(border);
+                }
+            }
+        }
+    }
+
+    touch_cells(s, &tp)?;
+    sel_result(s)
+}
