+    /// Maximum supported subdivision counts `(max_rows, max_columns)` for an unmerged `1×1` cell
+    /// `(r, c)`. Returns `None` if the cell cannot be split as an unmerged cell.
+    pub fn unmerged_split_limits(&self, r: usize, c: usize) -> Option<(usize, usize)> {
+        if !self.is_grid_consistent() {
+            return None;
+        }
+        let (r0, r1, g0, g1) = self.cell_extent(r, c)?;
+        if r0 != r1 || g0 != g1 || r0 != r {
+            return None;
+        }
+        let cell = self.rows.get(r)?.cells.get(c)?;
+        if !cell.controls.is_empty() {
+            return None;
+        }
+        let row_room = MAX_ROWS.saturating_sub(self.rows.len()).saturating_add(1).min(16);
+        let max_rows = if self.rect_has_controls(r, r, 0, self.grid.len().saturating_sub(1)) {
+            1
+        } else {
+            row_room
+        };
+        let col_room = MAX_COLS.saturating_sub(self.grid.len()).saturating_add(1).min(16);
+        let col_w = self.grid.get(g0).copied().unwrap_or(0.0);
+        let width_cap = if col_w.is_finite() && col_w >= 12.0 {
+            (wordcraft_geom::to_twips(col_w) / 120).max(1) as usize
+        } else {
+            1
+        };
+        let max_cols = if self.rect_has_controls(0, self.rows.len().saturating_sub(1), g0, g0) {
+            1
+        } else {
+            col_room.min(width_cap)
+        };
+        if max_rows <= 1 && max_cols <= 1 {
+            return None;
+        }
+        Some((max_rows, max_cols))
+    }
