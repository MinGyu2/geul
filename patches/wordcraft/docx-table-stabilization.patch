+    /// Keeps all original content in `(r, c)`, inherits cell visual properties onto created cells, updates
+    /// other rows cleanly (`span += columns - 1` or sibling `VMerge::Restart`/`Continue`), and preserves twip widths.
+    pub fn split_cell_grid(&mut self, r: usize, c: usize, rows: usize, columns: usize) -> bool {
+        if rows == 0 || columns == 0 || rows * columns < 2 || rows > 16 || columns > 16 {
+            return false;
