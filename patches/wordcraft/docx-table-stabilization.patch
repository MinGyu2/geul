+
+fn cell_has_data(c: &Cell) -> bool {
+    !c.controls.is_empty() || c.props.fmt_change.is_some() || cell_has_content(&c.blocks)
+}
+
+fn obj_relocatable(obj: &crate::para::InlineObject) -> bool {
+    use crate::para::InlineObject;
+    match obj {
+        InlineObject::Group { children, .. } => children.iter().all(|ch| obj_relocatable(&ch.obj)),
+        InlineObject::Opaque { .. } => false,
+        _ => !obj.is_marker(),
+    }
+}
+
+fn blocks_relocatable(blocks: &Blocks) -> bool {
+    blocks.iter().all(|b| match b.as_ref() {
+        crate::Block::Para(p) => {
+            p.section.is_none()
+                && !para_has_revisions(p)
+                && p.objects.iter().all(obj_relocatable)
+        }
+        crate::Block::Table(nested) => {
+            nested.controls.is_empty()
+                && nested.props.fmt_change.is_none()
+                && nested.rows.iter().all(|r| {
+                    r.controls.is_empty()
+                        && r.props.fmt_change.is_none()
+                        && r.cells.iter().all(cell_relocatable)
+                })
+        }
+    })
+}
+
+/// Whether `cell`'s contents and metadata can be safely moved or merged into another cell
+/// without losing or corrupting unsupported OOXML structures (markers, section breaks, SDTs, revisions).
+pub fn cell_relocatable(c: &Cell) -> bool {
+    !cell_has_data(c) || (c.controls.is_empty() && c.props.fmt_change.is_none() && blocks_relocatable(&c.blocks))
+}
+
+fn combine_cell_blocks(first: Blocks, second: Blocks) -> Blocks {
+    let mut out = if cell_has_content(&first) { first } else { Vec::new() };
+    if cell_has_content(&second) {
+        out.extend(second);
+    }
+    if out.is_empty() {
+        out.push(para_block(Paragraph::new()));
+    } else if out.last().is_some_and(|b| matches!(**b, crate::Block::Table(_))) {
+        out.push(para_block(Paragraph::new()));
+    }
+    out
 }
 
