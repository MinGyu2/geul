+        assert!(tbl.rows[0].props.cant_split && tbl.rows[1].props.cant_split);
+        assert!(!tbl.rows[2].props.header);
+
+        let layout = s.layout();
+        assert!(layout.pages.len() >= 2, "table should span multiple pages: {}", layout.pages.len());
+        let page2_paths: Vec<(&[u32], f32)> = layout.pages[1]
+            .items
+            .iter()
+            .filter_map(|it| match it {
+                wordcraft_layout::Placed::Lines { path, y, .. } => Some((path.0.as_slice(), *y)),
+                _ => None,
+            })
+            .collect();
+        let y_h0 = page2_paths.iter().find(|(p, _)| *p == &[0, 0, 0, 0]).map(|(_, y)| *y);
+        let y_h1 = page2_paths.iter().find(|(p, _)| *p == &[0, 1, 0, 0]).map(|(_, y)| *y);
+        assert!(y_h0.is_some(), "page 2 missing repeated header row 0: {page2_paths:?}");
+        assert!(y_h1.is_some(), "page 2 missing repeated header row 1: {page2_paths:?}");
+        assert!(y_h0.unwrap() < y_h1.unwrap());
+
+        let bytes = crate::io::save_bytes("table_headers.docx", &s.doc).unwrap();
+        let reopened = crate::io::open_bytes("table_headers.docx", &bytes).unwrap();
+        assert_eq!(roundtrip_equivalent(&s.doc, &reopened), Ok(true));
+        let rt = reopened.body[0].as_table().unwrap();
+        assert!(rt.rows[0].props.header && rt.rows[1].props.header);
+        assert!(rt.rows[0].props.cant_split && rt.rows[1].props.cant_split);
+    }
