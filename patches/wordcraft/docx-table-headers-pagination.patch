+            s.run("caret.set", &json!({"pos": {"story": "body", "path": [0, r, 0, 0], "off": 0}})).unwrap();
+            s.run("text.insert", &json!({"text": format!("BODY_{r}")})).unwrap();
+            s.run("table.properties", &json!({ "rowHeight": 80.0, "rowHeightRule": "atLeast" })).unwrap();
+        }
+        // Select rows 0..=1 and mark them repeating headers + disallow row break across pages.
+        s.run("select.range", &json!({
+            "anchor": {"story": "body", "path": [0, 0, 0, 0], "off": 0},
+            "focus": {"story": "body", "path": [0, 1, 1, 0], "off": 0},
+        })).unwrap();
+        s.run("table.properties", &json!({ "headerRow": true, "allowBreak": false })).unwrap();
+        let tbl = s.doc.body[0].as_table().unwrap();
