+
+    #[test]
+    fn repeating_headers_and_row_break_layout_and_roundtrip() {
+        let mut s = new_session();
+        s.run("insert.table", &json!({ "rows": 14, "cols": 2 })).unwrap();
+        // Put header text in rows 0..=1 and set explicit row heights so the table spans 2 pages.
+        for (idx, label) in [(0, "HDR_ZERO"), (1, "HDR_ONE")] {
+            s.run("caret.set", &json!({"pos": {"story": "body", "path": [0, idx, 0, 0], "off": 0}})).unwrap();
+            s.run("text.insert", &json!({"text": label})).unwrap();
+            s.run("table.properties", &json!({ "rowHeight": 40.0, "rowHeightRule": "exact" })).unwrap();
+        }
