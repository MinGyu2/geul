+    #[test]
+    fn paste_cells_rejects_overflowing_geometry_without_mutation() {
+        use crate::CmdError;
+        let mut s = new_session();
+        s.run("insert.table", &json!({"rows": 3, "cols": 3})).unwrap();
+        s.run("caret.set", &json!({"pos": {"story": "body", "path": [0, 0, 0, 0], "off": 0}})).unwrap();
+        let para = |t: &str| json!([{ "runs": [{ "text": t }] }]);
+        let cell = |row: u64, col: u64, rs: u64, cs: u64| json!({ "row": row, "col": col, "rowSpan": rs, "colSpan": cs, "paragraphs": para("x") });
+        let big = usize::MAX as u64;
+        let payload = |sr: u64, sc: u64, rows: u64, cols: u64, cells: serde_json::Value| json!({ "startRow": sr, "startCol": sc, "rows": rows, "cols": cols, "cells": cells });
+        let malformed = [
+            payload(0, 0, 2, 1, json!([cell(0, 0, 1, 1), cell(1, 0, big, 1)])),         // rowSpan wraps near the end row
+            payload(0, 0, 1, 2, json!([cell(0, 0, 1, 1), cell(0, 1, 1, big)])),         // colSpan wraps near the end column
+            payload(0, 0, 1, 2, json!([cell(0, 0, 1, 1), cell(0, 1, 1, 0)])),           // zero span
+            payload(0, 0, 1, 2, json!([cell(0, 0, 1, 1), cell(0, 1, 1, 2)])),           // span past the remaining extent
+            payload(0, 0, 1, 2, json!([cell(0, 0, 1, 1), cell(0, 2, 1, 1)])),           // column outside the payload
+            payload(big, 0, 1, 2, json!([cell(0, 0, 1, 1), cell(0, 1, 1, 1)])),         // target rectangle overflows
+            payload(0, 0, (1u64 << 63) + 1, 2, json!([cell(0, 0, 1, 1), cell(0, 1, 1, 1)])), // rows*cols wraps to 2
+        ];
+        let before = s.doc.clone();
+        let undo_before = s.can_undo();
+        for (i, p) in malformed.iter().enumerate() {
+            // Rejected explicitly, never by the panic safety net (Failed "... panicked").
+            let err = s.run("table.pasteCells", p).expect_err("malformed geometry accepted");
+            assert!(!matches!(&err, CmdError::Failed(m) if m.contains("panicked")), "case {i}: {err:?}");
+            assert!(s.doc == before, "case {i} mutated the document");
+            assert_eq!(s.can_undo(), undo_before, "case {i} recorded history");
+        }
+        // Exact upper boundaries stay valid: a span reaching the last row/column of the target.
+        assert!(s.run("table.pasteCells", &payload(1, 1, 2, 2, json!([cell(0, 0, 2, 1), cell(0, 1, 1, 1), cell(1, 1, 1, 1)]))).is_ok());
+        let t = s.doc.body[0].as_table().unwrap();
+        assert!(t.is_grid_consistent());
+    }
