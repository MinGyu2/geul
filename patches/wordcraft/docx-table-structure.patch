+        assert!(s.undo());
+        assert_eq!(cell_texts(&s)[0].len(), 1);
+        assert!(s.redo());
+        assert_eq!(cell_texts(&s)[0].len(), 2);
+
+        // Merge Below on col 0: (0,0) + (1,0) -> preserves ["A1","B1","A2"].
+        s.run("caret.set", &json!({"pos": {"story": "body", "path": [0, 0, 0, 0], "off": 0}})).unwrap();
+        s.run("table.mergeBelow", &json!({})).unwrap();
+        assert_eq!(cell_texts(&s)[0][0], vec!["A1", "B1", "A2"]);
+        // Right neighbor (0,1) has rowSpan=1 while (0,0) has rowSpan=2 -> mergeRight refused cleanly!
+        assert!(s.run("table.mergeRight", &json!({})).is_err());
+
+        // Split vertical merge cleanly.
+        s.run("table.splitCell", &json!({})).unwrap();
+        assert_eq!(cell_texts(&s)[0][0], vec!["A1", "B1", "A2"]);
+
+        // Select 2x2 rectangle and run table.mergeCells.
+        s.run(
+            "caret.set",
+            &json!({"pos": {"story": "body", "path": [0, 0, 0, 0], "off": 0}, "extend": false}),
+        )
+        .unwrap();
+        s.run(
+            "caret.set",
+            &json!({"pos": {"story": "body", "path": [0, 1, 1, 0], "off": 2}, "extend": true}),
+        )
+        .unwrap();
+        s.run("table.mergeCells", &json!({})).unwrap();
+        assert_eq!(cell_texts(&s)[0][0], vec!["A1", "B1", "A2", "B2"]);
+
+        // Undo -> redo -> splitCell -> export/reopen roundtrip matches authoritatively.
+        s.run("table.splitCell", &json!({})).unwrap();
+        assert!(s.undo());
+        assert!(s.redo());
+        let bytes = crate::io::save_bytes("table.docx", &s.doc).unwrap();
+        let reopened = crate::io::open_bytes("table.docx", &bytes).unwrap();
+        assert_eq!(roundtrip_equivalent(&s.doc, &reopened), Ok(true));
+    }
+}
