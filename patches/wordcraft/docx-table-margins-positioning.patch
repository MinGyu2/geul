+
+    #[test]
+    fn cell_margins_and_table_positioning_preserve_unrelated_and_roundtrip() {
+        use wordcraft_doc::props::Align;
+        let mut s = new_session();
+        s.run("insert.table", &json!({ "rows": 2, "cols": 2 })).unwrap();
+        s.run("caret.set", &json!({"pos": {"story": "body", "path": [0, 0, 0, 0], "off": 0}})).unwrap();
+        // Table-wide cellMargins + align + indent
+        s.run("table.properties", &json!({
+            "cellMargins": [4.0, 8.0, 4.0, 8.0],
+            "align": "center",
+            "indent": 18.0
+        })).unwrap();
+        let t = s.doc.body[0].as_table().unwrap();
+        assert_eq!(t.props.cell_margins, Some([4.0, 8.0, 4.0, 8.0]));
+        assert_eq!(t.props.align, Some(Align::Center));
+        assert_eq!(t.props.indent, Some(18.0));
+
+        // Per-cell margin override on cell (0,0), leaving (0,1) inheriting table default
+        s.run("table.properties", &json!({ "margins": [10.0, 12.0, 10.0, 12.0] })).unwrap();
+        let t = s.doc.body[0].as_table().unwrap();
+        assert_eq!(t.rows[0].cells[0].props.margins, Some([10.0, 12.0, 10.0, 12.0]));
+        assert_eq!(t.rows[0].cells[1].props.margins, None);
+
+        // Undo restores pre-override state cleanly; Redo restores override; reset clears override
+        assert!(s.undo());
+        assert_eq!(s.doc.body[0].as_table().unwrap().rows[0].cells[0].props.margins, None);
+        assert!(s.redo());
+        assert_eq!(s.doc.body[0].as_table().unwrap().rows[0].cells[0].props.margins, Some([10.0, 12.0, 10.0, 12.0]));
+
+        let bytes = crate::io::save_bytes("table_margins.docx", &s.doc).unwrap();
+        let reopened = crate::io::open_bytes("table_margins.docx", &bytes).unwrap();
+        assert_eq!(roundtrip_equivalent(&s.doc, &reopened), Ok(true));
+        let rt = reopened.body[0].as_table().unwrap();
+        assert_eq!(rt.props.cell_margins, Some([4.0, 8.0, 4.0, 8.0]));
+        assert_eq!(rt.props.align, Some(Align::Center));
+        assert_eq!(rt.props.indent, Some(18.0));
+        assert_eq!(rt.rows[0].cells[0].props.margins, Some([10.0, 12.0, 10.0, 12.0]));
+        assert_eq!(rt.rows[0].cells[1].props.margins, None);
+
+        // Reset cell override to None -> inherits table default
+        s.run("table.properties", &json!({ "margins": null })).unwrap();
+        assert_eq!(s.doc.body[0].as_table().unwrap().rows[0].cells[0].props.margins, None);
+        // Out-of-range margin rejected
+        assert!(s.run("table.properties", &json!({ "margins": [-1.0, 0.0, 0.0, 0.0] })).is_err());
+    }
