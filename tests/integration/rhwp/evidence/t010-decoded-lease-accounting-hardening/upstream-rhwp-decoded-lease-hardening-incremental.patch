+/// Retain `lease` in one owner's lease map unless that map already holds `max` other keys.
+/// Bounds lease metadata independently of bytes. A refused lease is only not retained by this
+/// owner: the caller's own `Rc` stays valid for its use, and a later lookup re-resolves the key.
+pub fn insert_lease_bounded<V>(
+    map: &mut HashMap<ImageKey, V>,
+    key: ImageKey,
+    lease: V,
+    max: usize,
+) -> bool {
+    if !map.contains_key(&key) && map.len() >= max {
+        return false;
+    }
+    map.insert(key, lease);
+    true
+}
