+/// allocation, split by whether another owner (document font table) shares it. Excludes hash
+/// maps, resource keys, layer nodes and text sources: a lower bound, not a whole-tree bound.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct ResourcePayloadEstimate {
