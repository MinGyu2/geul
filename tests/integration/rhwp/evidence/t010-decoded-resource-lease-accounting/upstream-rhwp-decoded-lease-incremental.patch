+/// Disposal of one uniquely owned decoded backing (Canvas: width/height 0).
+pub trait Backing {
+    fn dispose(&self);
+}
+
+/// Unique decoded-backing ledger. Bytes are RGBA backing *estimates*, never RSS/GPU memory.
+/// One [`SharedBacking`] is one allocation however many cache/job `Rc` references point to it;
+/// references are not bytes. Reservation precedes allocation; the last owner's drop disposes
+/// the backing and releases its charge exactly once.
+#[derive(Default)]
+pub struct DecodedLedger {
+    unique_bytes: Cell<usize>,
+    unique_count: Cell<usize>,
+    reserved_bytes: Cell<usize>,
+    peak_bytes: Cell<usize>,
+    created: Cell<u64>,
+    disposed: Cell<u64>,
+    refused: Cell<u64>,
+    over_limit: Cell<u64>,
+    accounting_errors: Cell<u64>,
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct LedgerStats {
+    pub unique_bytes: usize,
+    pub unique_count: usize,
+    pub reserved_bytes: usize,
+    /// Peak of unique + reserved estimated bytes.
+    pub peak_bytes: usize,
+    pub created: u64,
+    pub disposed: u64,
+    /// Enforced reservations refused before allocation.
+    pub refused: u64,
+    /// Unenforced (legacy synchronous) reservations admitted above the limit; explicit, not silent.
+    pub over_limit: u64,
+    /// Checked arithmetic that would have overflowed/underflowed (must stay 0).
+    pub accounting_errors: u64,
+}
+
+impl DecodedLedger {
+    pub fn stats(&self) -> LedgerStats {
+        LedgerStats {
+            unique_bytes: self.unique_bytes.get(),
+            unique_count: self.unique_count.get(),
+            reserved_bytes: self.reserved_bytes.get(),
+            peak_bytes: self.peak_bytes.get(),
+            created: self.created.get(),
+            disposed: self.disposed.get(),
+            refused: self.refused.get(),
+            over_limit: self.over_limit.get(),
+            accounting_errors: self.accounting_errors.get(),
+        }
+    }
+
+    fn add(&self, cell: &Cell<usize>, bytes: usize) -> bool {
+        match cell.get().checked_add(bytes) {
+            Some(v) => {
+                cell.set(v);
+                true
+            }
+            None => {
+                self.accounting_errors.set(self.accounting_errors.get() + 1);
+                false
+            }
+        }
+    }
+
+    fn sub(&self, cell: &Cell<usize>, bytes: usize) {
+        match cell.get().checked_sub(bytes) {
+            Some(v) => cell.set(v),
+            None => {
+                self.accounting_errors.set(self.accounting_errors.get() + 1);
+                cell.set(0);
+            }
+        }
+    }
+
+    fn note_peak(&self) {
+        let total = self
+            .unique_bytes
+            .get()
+            .saturating_add(self.reserved_bytes.get());
+        self.peak_bytes.set(self.peak_bytes.get().max(total));
+    }
+
+    /// Reserve `bytes` before allocating when `committed + reserved + bytes <= limit`, where
+    /// `committed` is the caller's charge already counted against the same limit. Checked
+    /// arithmetic; overflow never fits. `enforce == false` admits but counts `over_limit`.
+    pub fn reserve(
+        self: &Rc<Self>,
+        bytes: usize,
+        committed: usize,
+        limit: usize,
+        enforce: bool,
+    ) -> Option<Reservation> {
+        let fits = committed
+            .checked_add(self.reserved_bytes.get())
+            .and_then(|v| v.checked_add(bytes))
+            .is_some_and(|total| total <= limit);
+        if !fits {
+            if enforce {
+                self.refused.set(self.refused.get() + 1);
+                return None;
+            }
+            self.over_limit.set(self.over_limit.get() + 1);
+        }
+        if !self.add(&self.reserved_bytes, bytes) {
+            return None;
+        }
+        self.note_peak();
+        Some(Reservation {
+            ledger: self.clone(),
+            bytes,
+        })
+    }
+}
+
+/// Pending allocation charge. Dropping it without commit (error/refusal) releases the bytes.
+pub struct Reservation {
+    ledger: Rc<DecodedLedger>,
+    bytes: usize,
+}
+
+impl Reservation {
+    pub fn bytes(&self) -> usize {
+        self.bytes
+    }
+
+    /// Convert the reservation into one unique backing charged `actual` bytes.
+    pub fn commit<B: Backing>(mut self, backing: B, actual: usize) -> Rc<SharedBacking<B>> {
+        let ledger = self.ledger.clone();
+        ledger.sub(&ledger.reserved_bytes, self.bytes);
+        self.bytes = 0;
+        if actual > 0 && !ledger.add(&ledger.unique_bytes, actual) {
+            // Never record a charge that cannot be released symmetrically.
+            backing.dispose();
+            return Rc::new(SharedBacking {
+                backing,
+                bytes: 0,
+                ledger,
+                disposed: Cell::new(true),
+            });
+        }
+        ledger.unique_count.set(ledger.unique_count.get() + 1);
+        ledger.created.set(ledger.created.get() + 1);
+        ledger.note_peak();
+        Rc::new(SharedBacking {
+            backing,
+            bytes: actual,
+            ledger,
+            disposed: Cell::new(false),
+        })
+    }
+}
+
+impl Drop for Reservation {
+    fn drop(&mut self) {
