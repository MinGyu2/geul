+        request.source_end = 2;
+        assert!(core.paragraph_block_budget_native(&request).is_err());
+    }
+
+    #[test]
+    fn positive_copies_measure_and_enforce_existing_budgets() {
+        let doc = crate::wasm_api::HwpDocument::create_empty();
+        let core: &DocumentCore = &doc;
+        let mut request = request(1);
+        let budget = core.paragraph_block_budget_native(&request).unwrap();
+        assert_eq!(budget.added_paragraphs, 1);
+        assert!(budget.structure_bytes > 0);
+        assert!(budget.added_nodes > 0);
+        request.limits.max_structure_bytes = 1;
+        assert!(core.paragraph_block_budget_native(&request).is_err());
+        request.count = usize::MAX;
+        assert!(core.paragraph_block_budget_native(&request).is_err());
+    }
