+        let core: &DocumentCore = &doc;
+        let mut request = request(0);
+        request.limits.max_structure_bytes = 1;
+        request.limits.max_nodes = 1;
+        let budget = core.paragraph_block_budget_native(&request).unwrap();
+        assert_eq!(budget.added_paragraphs, 0);
+        assert_eq!(budget.structure_bytes, 0);
+        assert_eq!(budget.added_nodes, 0);
+        assert_eq!(budget.mapping_bytes, 0);
