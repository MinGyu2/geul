diff --git a/src/renderer/typeset/format_memo.rs b/src/renderer/typeset/format_memo.rs
new file mode 100644
index 0000000..8f05618
--- /dev/null
+++ b/src/renderer/typeset/format_memo.rs
@@ -0,0 +1,185 @@
+//! 본문 문단 `format` 결과의 패스 간 재사용 (Geul T010 D4).
+//!
+//! 본문 글자 하나를 고쳐도 `paginate_pass` 는 dirty 구역의 모든 문단을 다시 `format` 한다
+//! (60쪽·593문단 문서에서 키마다 약 13 ms). 고치지 않은 문단의 `format` 결과는 같은 입력이면
+//! 같으므로 이전 패스의 값을 다시 쓴다. 재사용은 아래가 **모두** 성립할 때만 한다 — 하나라도
+//! 어긋나면 지금처럼 다시 계산한다(fail closed).
+//!
+//! - 문단이 dirty가 아니다: `dirty_paragraphs` 는 측정 캐시와 같은 규칙으로 편집·삽입·삭제를
+//!   따라가고 구역 단위 변경은 `None`(전부 dirty)으로 만든다.
+//! - 구역 단위로 파생되는 `format` 입력이 같다: 배율, 레이아웃 프로파일, 통짜 사다리 판정,
+//!   용지/쪽 어울림 증거, 스타일 세대 번호(`DocumentCore::styles_revision` — 스타일을 바꾸는 모든 곳에서
+//!   프로세스 전역 유일 값으로 바뀜), 문단 수.
+//! - 문단 단위 호출 입력이 같다: 단 폭(비트 동일), 어울림 플래그 두 개, 번호 표지와 조합 문단의
+//!   번호 문자열(다른 문단 편집으로 바뀔 수 있는 교차 문단 입력), 글자 수.
+use crate::model::paragraph::{MarkerHead, NumberingMarker, Paragraph};
+use crate::model::provenance::LayoutCompatibilityProfile;
+use crate::renderer::composer::ComposedParagraph;
+use crate::renderer::float_placement::FloatCarveEvidence;
+
+use super::paragraph::metrics::FormattedParagraph;
+
+/// 구역 하나의 재사용 가능한 `format` 결과. `MeasuredSection` 안에 있어 측정 캐시와 같이
+/// 지워지고(`clear`·교체) 문단 삽입·삭제에 같이 옮겨진다.
+#[derive(Debug, Clone, Default)]
+pub struct FormatMemo {
+    section: Option<SectionKey>,
+    entries: Vec<Option<Entry>>,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+struct SectionKey {
+    dpi_bits: u64,
+    profile: LayoutCompatibilityProfile,
+    uniform_filler_ladder: bool,
+    float_carve_evidence: Vec<FloatCarveEvidence>,
+    styles_revision: u64,
+    paragraphs: usize,
+}
+
+#[derive(Debug, Clone)]
+struct Entry {
+    column_width_bits: Option<u64>,
+    hwp3_body_reflow: bool,
+    known_square_band: bool,
+    marker: NumberingMarker,
+    composed_numbering: Option<Option<(String, MarkerHead)>>,
+    char_count: u32,
+    text_len: usize,
+    value: FormattedParagraph,
+}
+
+impl FormatMemo {
+    /// 문단 삽입: 새 자리는 비워 둔다(그 문단은 dirty라 어차피 다시 계산).
+    pub fn shift_for_insert(&mut self, insert_at: usize) {
+        if insert_at <= self.entries.len() {
+            self.entries.insert(insert_at, None);
+        }
+        self.section = None;
+    }
+
+    pub fn shift_for_remove(&mut self, remove_at: usize) {
+        if remove_at < self.entries.len() {
+            self.entries.remove(remove_at);
+        }
+        self.section = None;
+    }
+
+    #[cfg(test)]
+    pub(crate) fn reusable_entries(&self) -> usize {
+        self.entries.iter().filter(|e| e.is_some()).count()
+    }
+}
+
+/// 한 번의 구역 조판 동안의 재사용 상태.
+#[derive(Debug)]
+pub(crate) struct FormatMemoPass {
+    previous: FormatMemo,
+    dirty: Option<Vec<bool>>,
+    styles_revision: u64,
+    previous_valid: bool,
+    next: FormatMemo,
+    pub(crate) hits: usize,
+    pub(crate) misses: usize,
+}
+
+impl FormatMemoPass {
+    pub(crate) fn new(previous: FormatMemo, dirty: Option<Vec<bool>>, styles_revision: u64) -> Self {
+        Self {
+            previous,
+            dirty,
+            styles_revision,
+            previous_valid: false,
+            next: FormatMemo::default(),
+            hits: 0,
+            misses: 0,
+        }
+    }
+
+    /// 구역 진입 때 한 번: 구역 파생 입력을 정하고 이전 값의 사용 가능 여부를 정한다.
+    pub(super) fn begin_section(
+        &mut self,
+        dpi: f64,
+        profile: LayoutCompatibilityProfile,
+        uniform_filler_ladder: bool,
+        float_carve_evidence: &[FloatCarveEvidence],
+        paragraphs: usize,
+    ) {
+        let key = SectionKey {
+            dpi_bits: dpi.to_bits(),
+            profile,
+            uniform_filler_ladder,
+            float_carve_evidence: float_carve_evidence.to_vec(),
+            styles_revision: self.styles_revision,
+            paragraphs,
+        };
+        self.previous_valid = self.dirty.is_some()
+            && self.previous.section.as_ref() == Some(&key)
+            && self.previous.entries.len() == paragraphs;
+        self.next = FormatMemo {
+            section: Some(key),
+            entries: vec![None; paragraphs],
+        };
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    pub(super) fn get_or_format(
+        &mut self,
+        para_idx: usize,
+        para: &Paragraph,
+        composed: Option<&ComposedParagraph>,
+        column_width_px: Option<f64>,
+        hwp3_body_reflow: bool,
+        known_square_band: bool,
+        format: impl FnOnce() -> FormattedParagraph,
+    ) -> FormattedParagraph {
+        let column_width_bits = column_width_px.map(f64::to_bits);
+        let composed_numbering = composed.map(|c| c.numbering_text.clone());
+        let clean = self.previous_valid
+            && self
+                .dirty
+                .as_ref()
+                .and_then(|bits| bits.get(para_idx))
+                .is_some_and(|dirty| !*dirty);
+        let reused = clean
+            .then(|| self.previous.entries.get(para_idx).and_then(Option::as_ref))
+            .flatten()
+            .filter(|e| {
+                e.column_width_bits == column_width_bits
+                    && e.hwp3_body_reflow == hwp3_body_reflow
+                    && e.known_square_band == known_square_band
+                    && e.marker == para.numbering_marker
+                    && e.composed_numbering == composed_numbering
+                    && e.char_count == para.char_count
+                    && e.text_len == para.text.len()
+            })
+            .map(|e| e.value.clone());
+        let value = match reused {
+            Some(value) => {
+                self.hits += 1;
+                value
+            }
+            None => {
+                self.misses += 1;
+                format()
+            }
+        };
+        if let Some(slot) = self.next.entries.get_mut(para_idx) {
+            *slot = Some(Entry {
+                column_width_bits,
+                hwp3_body_reflow,
+                known_square_band,
+                marker: para.numbering_marker.clone(),
+                composed_numbering,
+                char_count: para.char_count,
+                text_len: para.text.len(),
+                value: value.clone(),
+            });
+        }
+        value
+    }
+
+    pub(crate) fn finish(self) -> FormatMemo {
+        self.next
+    }
+}
