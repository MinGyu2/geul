@@ -0,0 +1,265 @@
+//! Geul T010: body-edit pagination profile and format-memo equivalence oracle (native).
+//!
+//! The oracle opens each document twice — A with `format_memo_enabled` (default), B without — applies
+//! the same deterministic pseudo-random edit script to both and compares the complete pagination
+//! after every edit (every struct destructured without `..`; hash containers compared sorted), then
+//! the SVG of every page at the end. Any difference fails the test.
+use crate::renderer::pagination::{ColumnContent, PageContent, PaginationResult};
+use crate::wasm_api::HwpDocument;
+use std::collections::BTreeMap;
+use std::fmt::Debug;
+use std::path::PathBuf;
+use std::time::Instant;
+
+fn sorted<K: Debug, V: Debug>(it: impl Iterator<Item = (K, V)>) -> BTreeMap<String, String> {
+    it.map(|(k, v)| (format!("{k:?}"), format!("{v:?}"))).collect()
+}
+
+fn canonical_column(cc: &ColumnContent) -> String {
+    let ColumnContent {
+        paragraph_float_placements,
+        inline_flow_plans,
+        inline_placements,
+        column_index,
+        start_height,
+        endnote_flow,
+        items,
+        zone_layout,
+        zone_y_offset,
+        wrap_around_paras,
+        used_height,
+        wrap_anchors,
+        overlay_continuations,
+        overlay_cuts,
+    } = cc;
+    format!(
+        "{:?}|{:?}|{:?}|{column_index}|{start_height:?}|{endnote_flow}|{items:?}|{zone_layout:?}|{zone_y_offset:?}|{wrap_around_paras:?}|{used_height:?}|{:?}|{overlay_continuations:?}|{overlay_cuts:?}",
+        sorted(paragraph_float_placements.iter()),
+        sorted(inline_flow_plans.iter()),
+        sorted(inline_placements.iter()),
+        sorted(wrap_anchors.iter()),
+    )
+}
+
+fn canonical_page(p: &PageContent) -> String {
+    let PageContent {
+        page_index,
+        page_number,
+        section_index,
+        layout,
+        column_contents,
+        active_header,
+        active_footer,
+        page_number_restarted,
+        page_number_pos,
+        page_hide,
+        footnotes,
+        active_master_page,
+        extra_master_pages,
+        ladder_band_tables,
+    } = p;
+    let columns: Vec<String> = column_contents.iter().map(canonical_column).collect();
+    format!(
+        "{page_index}|{page_number}|{section_index}|{layout:?}|{columns:?}|{active_header:?}|{active_footer:?}|{page_number_restarted}|{page_number_pos:?}|{page_hide:?}|{footnotes:?}|{active_master_page:?}|{extra_master_pages:?}|{ladder_band_tables:?}"
+    )
+}
+
+fn canonical_result(r: &PaginationResult) -> String {
+    let PaginationResult {
+        pages,
+        wrap_around_paras,
+        hidden_empty_paras,
+        pre_emitted_host_paras,
+        pre_emitted_host_heights,
+        pre_emitted_host_content_heights,
+        endnotes,
+        endnote_paragraphs,
+        endnote_para_sources,
+        endnote_between_notes_hu,
+        endnote_separator_above_hu,
+        endnote_separator_below_hu,
+    } = r;
+    let pages: Vec<String> = pages.iter().map(canonical_page).collect();
+    let mut hidden: Vec<_> = hidden_empty_paras.iter().collect();
+    hidden.sort();
+    let mut hosts: Vec<_> = pre_emitted_host_paras.iter().collect();
+    hosts.sort();
+    format!(
+        "{pages:?}|{wrap_around_paras:?}|{hidden:?}|{hosts:?}|{:?}|{:?}|{endnotes:?}|{endnote_paragraphs:?}|{endnote_para_sources:?}|{endnote_between_notes_hu}|{endnote_separator_above_hu}|{endnote_separator_below_hu}",
+        sorted(pre_emitted_host_heights.iter()),
+        sorted(pre_emitted_host_content_heights.iter()),
+    )
+}
+
+fn canonical(doc: &HwpDocument) -> Vec<String> {
+    doc.pagination.iter().map(canonical_result).collect()
+}
+
+struct Lcg(u64);
+impl Lcg {
+    fn next(&mut self, n: usize) -> usize {
+        self.0 = self.0.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+        ((self.0 >> 33) as usize) % n.max(1)
+    }
+}
+
+#[derive(Debug, Clone)]
+enum Op {
+    Insert(usize, usize, usize, &'static str),
+    Delete(usize, usize, usize),
+    Split(usize, usize, usize),
+    Merge(usize, usize),
+    Bold(usize, usize, usize, usize),
+}
+
+fn pick(doc: &HwpDocument, rng: &mut Lcg) -> Option<Op> {
+    let sections = doc.document.sections.len();
+    if sections == 0 {
+        return None;
+    }
+    let s = rng.next(sections);
+    let paras = doc.document.sections[s].paragraphs.len();
+    if paras == 0 {
+        return None;
+    }
+    let p = rng.next(paras);
+    let len = doc.get_paragraph_length_native(s, p).ok()?;
+    let at = rng.next(len + 1);
+    Some(match rng.next(10) {
+        0..=2 => Op::Insert(s, p, at, "a"),
+        3..=4 => Op::Insert(s, p, at, "가나"),
+        5..=6 if len > 0 => Op::Delete(s, p, at.min(len - 1)),
+        7 => Op::Split(s, p, at),
+        8 if p > 0 => Op::Merge(s, p),
+        9 if len > 1 => Op::Bold(s, p, at.min(len - 1), (at.min(len - 1) + 2).min(len)),
+        _ => Op::Insert(s, p, at, "x"),
+    })
+}
+
+fn apply(doc: &mut HwpDocument, op: &Op) -> Result<(), String> {
+    let r = match *op {
+        Op::Insert(s, p, at, t) => doc.insert_text_native(s, p, at, t),
+        Op::Delete(s, p, at) => doc.delete_text_native(s, p, at, 1),
+        Op::Split(s, p, at) => doc.split_paragraph_native(s, p, at, None),
+        Op::Merge(s, p) => doc.merge_paragraph_native(s, p),
+        Op::Bold(s, p, a, b) => doc.apply_char_format_native(s, p, a, b, r#"{"bold":true}"#),
+    };
+    r.map(|_| ()).map_err(|e| format!("{e:?}"))
+}
+
+fn corpus() -> Vec<PathBuf> {
+    let Ok(root) = std::env::var("GEUL_ORACLE_SAMPLES") else { return Vec::new() };
+    let max: usize = std::env::var("GEUL_ORACLE_MAX").ok().and_then(|v| v.parse().ok()).unwrap_or(400);
+    let mut out = Vec::new();
+    let mut stack = vec![PathBuf::from(root)];
+    while let Some(dir) = stack.pop() {
+        let Ok(rd) = std::fs::read_dir(&dir) else { continue };
+        for e in rd.flatten() {
+            let path = e.path();
+            if path.is_dir() {
+                stack.push(path);
+            } else if matches!(path.extension().and_then(|x| x.to_str()), Some("hwp" | "hwpx"))
+                && e.metadata().map(|m| m.len() <= 4 << 20).unwrap_or(false)
+            {
+                out.push(path);
+            }
+        }
+    }
+    out.sort();
+    out.truncate(max);
+    out
+}
+
+#[test]
+#[ignore]
+fn geul_format_memo_equivalence_oracle() {
+    let ops_per_doc: usize = std::env::var("GEUL_ORACLE_OPS").ok().and_then(|v| v.parse().ok()).unwrap_or(30);
+    let files = corpus();
+    assert!(!files.is_empty(), "GEUL_ORACLE_SAMPLES required");
+    let (mut opened, mut applied, mut rejected, mut svg_pages, mut reusable) = (0usize, 0usize, 0usize, 0usize, 0usize);
+    let mut mismatches = Vec::new();
+    for file in &files {
+        let Ok(bytes) = std::fs::read(file) else { continue };
+        let (Ok(mut a), Ok(mut b)) = (HwpDocument::from_bytes(&bytes), HwpDocument::from_bytes(&bytes)) else { continue };
+        b.format_memo_enabled = false;
+        opened += 1;
+        let name = file.display().to_string();
+        if canonical(&a) != canonical(&b) {
+            mismatches.push(format!("{name}: initial"));
+            continue;
+        }
+        let mut rng = Lcg(name.bytes().fold(1469598103934665603u64, |h, c| (h ^ c as u64).wrapping_mul(1099511628211)));
+        let mut diverged = false;
+        for step in 0..ops_per_doc {
+            let Some(op) = pick(&a, &mut rng) else { break };
+            let (ra, rb) = (apply(&mut a, &op), apply(&mut b, &op));
+            if ra.is_ok() != rb.is_ok() {
+                mismatches.push(format!("{name}: step {step} {op:?} outcome A={ra:?} B={rb:?}"));
+                diverged = true;
+                break;
+            }
+            if ra.is_err() {
+                rejected += 1;
+                continue;
+            }
+            applied += 1;
+            if canonical(&a) != canonical(&b) {
+                mismatches.push(format!("{name}: step {step} {op:?} pagination differs"));
+                diverged = true;
+                break;
+            }
+        }
+        if diverged {
+            continue;
+        }
+        reusable += a.measured_sections.iter().map(|m| m.format_memo.reusable_entries()).sum::<usize>();
+        let pages = a.page_count();
+        if pages != b.page_count() {
+            mismatches.push(format!("{name}: page count"));
+            continue;
+        }
+        for page in 0..pages {
+            match (a.render_page_svg_native(page), b.render_page_svg_native(page)) {
+                (Ok(x), Ok(y)) if x == y => svg_pages += 1,
+                (Err(_), Err(_)) => {}
+                _ => {
+                    mismatches.push(format!("{name}: svg page {page} differs"));
+                    break;
+                }
+            }
+        }
+    }
+    eprintln!(
+        "GEUL_ORACLE files={} opened={opened} applied={applied} rejected={rejected} svgPages={svg_pages} memoEntries={reusable} mismatches={}",
+        files.len(),
+        mismatches.len()
+    );
+    for m in &mismatches {
+        eprintln!("GEUL_ORACLE_MISMATCH {m}");
+    }
+    assert!(mismatches.is_empty());
+    assert!(opened > 0 && applied > 0);
+}
+
+fn asset() -> Option<Vec<u8>> {
+    std::env::var("GEUL_ASSET_DOC").ok().map(|p| std::fs::read(p).expect("asset document"))
+}
+
+#[test]
+#[ignore]
+fn geul_profile_body_insert() {
+    let Some(bytes) = asset() else { return };
+    for enabled in [false, true] {
+        let mut doc = HwpDocument::from_bytes(&bytes).expect("open");
+        doc.format_memo_enabled = enabled;
+        let mut times = Vec::new();
+        for _ in 0..12 {
+            let t = Instant::now();
+            doc.insert_text_native(0, 296, 0, "a").expect("insert");
+            times.push(t.elapsed().as_secs_f64() * 1000.0);
+            doc.delete_text_native(0, 296, 0, 1).expect("delete");
+        }
+        times.sort_by(f64::total_cmp);
+        eprintln!("GEUL_PROFILE memo={enabled} pages={} insert_ms p50={:.3} max={:.3}", doc.page_count(), times[6], times[11]);
+    }
+}
