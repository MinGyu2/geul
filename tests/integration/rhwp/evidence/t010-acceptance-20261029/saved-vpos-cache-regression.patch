+#[cfg(test)]
+mod issue_2063_saved_reset_scan {
+    use super::rowbreak_table_has_internal_saved_vpos_reset;
+    use crate::model::paragraph::{LineSeg, Paragraph};
+    use crate::model::table::{Cell, Table};
+
+    fn reset_cell(row: u16) -> Cell {
+        Cell {
+            row,
+            paragraphs: vec![
+                Paragraph {
+                    line_segs: vec![LineSeg {
+                        vertical_pos: 100,
+                        ..Default::default()
+                    }],
+                    ..Default::default()
+                },
+                Paragraph {
+                    line_segs: vec![LineSeg {
+                        vertical_pos: 0,
+                        ..Default::default()
+                    }],
+                    ..Default::default()
+                },
+            ],
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn table_scan_detects_saved_reset_in_one_row_and_ignores_out_of_range_rows() {
+        let mut table = Table {
+            row_count: 2,
+            cells: (0..64)
+                .map(|index| Cell {
+                    row: (index / 32) as u16,
+                    ..Default::default()
+                })
+                .collect(),
+            ..Default::default()
+        };
+        assert!(!rowbreak_table_has_internal_saved_vpos_reset(&table));
+        table.cells[63] = reset_cell(1);
+        assert!(rowbreak_table_has_internal_saved_vpos_reset(&table));
+
+        table.row_count = 1;
+        assert!(
+            !rowbreak_table_has_internal_saved_vpos_reset(&table),
+            "the original row-bounded scan ignores cells outside row_count"
+        );
+    }
+}
