+    #[test]
+    fn rebuild_priority_never_relaxes_allocation_or_metadata_limits() {
+        let log = Rc::new(RefCell::new(Vec::new()));
+        let mut cache = BoundedCache::new(400, 4, true);
+        for n in 0..100u8 {
+            cache.get(&key(n));
+            cache.note_rebuild_cost(key(n), 1_000_000.0);
+            let accepted = cache.insert(key(n), Some(surface(n as u32, &log)), 100);
+            if !accepted {
+                surface(n as u32, &log).release();
+            }
+            assert!(cache.stats().bytes <= 400);
+            assert!(cache.frequency.len() <= 16);
+            assert!(cache.rebuild_costs.len() <= 16);
+        }
