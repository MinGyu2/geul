+        cache.note_rebuild_cost(key(201), f64::NAN);
+        assert!(!cache.rebuild_costs.contains_key(&key(201)));
+        cache.set_budget(0, 0);
+        assert_eq!(cache.stats().bytes, 0);
+        assert!(cache.rebuild_costs.is_empty());
+    }
