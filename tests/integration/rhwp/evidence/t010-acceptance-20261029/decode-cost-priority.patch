     #[test]
+    fn costly_decode_is_admitted_before_repeated_rejection() {
+        let log = Rc::new(RefCell::new(Vec::new()));
+        let mut cache = BoundedCache::new(400, 64, true);
+        for n in 0..4 {
+            cache.get(&key(n));
+            cache.note_rebuild_cost(key(n), 1.0);
+            assert!(cache.insert(key(n), Some(surface(n as u32, &log)), 100));
+        }
+        for _ in 0..4 {
+            for n in 0..4 {
+                assert!(cache.get(&key(n)).is_some());
+            }
+        }
+        assert!(cache.get(&key(9)).is_none());
+        cache.note_rebuild_cost(key(9), 132.0);
+        assert!(cache.insert(key(9), Some(surface(9, &log)), 100));
+        assert!(cache.get(&key(9)).is_some());
+        assert_eq!(cache.stats().bytes, 400);
+        assert_eq!(cache.stats().evictions, 1);
+        assert_eq!(cache.stats().rejected, 0);
+    }
