+    pub fn note_rebuild_cost(&mut self, key: ImageKey, elapsed_ms: f64) {
+        if !self.admission
+            || !elapsed_ms.is_finite()
+            || elapsed_ms < 0.0
+            || !self.frequency.contains_key(&key)
+        {
+            return;
+        }
+        let cost = elapsed_ms.ceil().clamp(1.0, 60_000.0) as u32;
+        self.rebuild_costs
+            .entry(key)
+            .and_modify(|old| *old = (*old).max(cost))
+            .or_insert(cost);
+        self.prune_rebuild_costs();
+    }
+
+    fn prune_rebuild_costs(&mut self) {
+        self.rebuild_costs
+            .retain(|key, _| self.frequency.contains_key(key));
+    }
+
+    fn priority(&self, key: &ImageKey) -> u64 {
