+#[derive(Debug, PartialEq, Eq)]
+enum PairStatus { BothOk, BothErr, Asymmetric }
+
+fn pair_status<A, B, E, F>(a: &Result<A, E>, b: &Result<B, F>) -> PairStatus {
+    match (a.is_ok(), b.is_ok()) {
+        (true, true) => PairStatus::BothOk,
+        (false, false) => PairStatus::BothErr,
+        _ => PairStatus::Asymmetric,
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+enum SvgStatus { Equal, Different, BothErr, Asymmetric }
+
+fn svg_status<E, F>(a: &Result<String, E>, b: &Result<String, F>) -> SvgStatus {
+    match (a, b) {
+        (Ok(x), Ok(y)) if x == y => SvgStatus::Equal,
+        (Ok(_), Ok(_)) => SvgStatus::Different,
+        (Err(_), Err(_)) => SvgStatus::BothErr,
+        _ => SvgStatus::Asymmetric,
+    }
+}
+
+#[test]
+fn geul_oracle_failure_classification() {
+    let ok: Result<String, &str> = Ok("svg".into());
+    let other: Result<String, &str> = Ok("different".into());
+    let err: Result<String, &str> = Err("render error");
+    assert_eq!(pair_status(&ok, &ok), PairStatus::BothOk);
+    assert_eq!(pair_status(&err, &err), PairStatus::BothErr);
+    assert_eq!(pair_status(&ok, &err), PairStatus::Asymmetric);
+    assert_eq!(pair_status(&err, &ok), PairStatus::Asymmetric);
+    assert_eq!(svg_status(&ok, &ok), SvgStatus::Equal);
+    assert_eq!(svg_status(&ok, &other), SvgStatus::Different);
+    assert_eq!(svg_status(&err, &err), SvgStatus::BothErr);
+    assert_eq!(svg_status(&ok, &err), SvgStatus::Asymmetric);
+    assert_eq!(svg_status(&err, &ok), SvgStatus::Asymmetric);
+}
