+//! T010 experimental identity for a deliberately narrow Canvas replay subset.
+//! This helper is not a public API and does not authorize frame reuse by itself.
+use crate::paint::{layer_tree::{LayerNode, LayerNodeKind, PageLayerTree}, paint_op::PaintOp, RenderProfile};
+use crate::renderer::render_tree::BoundingBox;
+use serde::Serialize;
+
+const MAX_DEPTH: usize = 64;
+const MAX_NODES: usize = 65_536;
+const MAX_IMAGE_BYTES: usize = 16 << 20;
+
+struct Identity { digest: blake3::Hasher, nodes: usize, image_bytes: usize }
+impl Identity {
+    fn part(&mut self, bytes: &[u8]) {
+        self.digest.update(&(bytes.len() as u64).to_le_bytes());
+        self.digest.update(bytes);
+    }
+    fn value<T: Serialize>(&mut self, value: &T) -> Option<()> {
+        self.part(&serde_json::to_vec(value).ok()?);
+        Some(())
+    }
+    fn bbox(&mut self, b: &BoundingBox) -> Option<()> {
+        if ![b.x, b.y, b.width, b.height].iter().all(|x| x.is_finite()) { return None; }
+        self.value(b)
+    }
+    fn node(&mut self, n: &LayerNode, depth: usize) -> Option<()> {
+        if depth > MAX_DEPTH { return None; }
+        self.nodes = self.nodes.checked_add(1)?;
+        if self.nodes > MAX_NODES { return None; }
+        let LayerNode { bounds, source_node_id, layer, kind } = n;
+        self.bbox(bounds)?;
+        self.value(source_node_id)?;
+        self.value(layer)?;
+        match kind {
+            LayerNodeKind::Group { children, cache_hint: _, group_kind: _ } => {
+                // Canvas render_layer_node consumes children/layer/clip; the existing
+                // preparation::canvas_projection also replaces group_kind with Generic.
+                self.part(b"group"); self.value(&children.len())?;
+                for child in children { self.node(child, depth + 1)?; }
+            }
+            LayerNodeKind::ClipRect { clip, child, clip_kind } => {
+                self.part(b"clip"); self.bbox(clip)?;
+                self.part(format!("{clip_kind:?}").as_bytes());
+                self.node(child, depth + 1)?;
+            }
+            LayerNodeKind::Leaf { ops } => {
+                self.part(b"leaf"); self.value(&ops.len())?;
+                for op in ops {
+                    match op {
+                        PaintOp::PageBackground { bbox, background } => {
+                            // No gradients or background images in this subset.
+                            if background.gradient.is_some() || background.image.is_some() || !background.border_width.is_finite() { return None; }
+                            self.part(b"background"); self.bbox(bbox)?; self.value(background.as_ref())?;
+                        }
+                        PaintOp::Image { bbox, image, resolved } => {
+                            // No external/SVG image, alternate resolved payload or invalid floats.
+                            if resolved.is_some() || image.external_path.is_some() || !image.transform.rotation.is_finite()
+                                || !image.opacity.is_finite()
+                                || image.original_size.is_some_and(|(x,y)| !x.is_finite() || !y.is_finite())
+                                || image.content_inset.is_some_and(|xs| xs.iter().any(|x| !x.is_finite())) { return None; }
+                            let bytes = image.data.as_ref()?;
+                            if !matches!(crate::renderer::image_resolver::detect_image_mime_type(bytes), "image/png" | "image/jpeg") { return None; }
+                            self.image_bytes = self.image_bytes.checked_add(bytes.len())?;
+                            if self.image_bytes > MAX_IMAGE_BYTES { return None; }
+                            self.part(b"image"); self.bbox(bbox)?;
+                            // ImageNode Serialize intentionally skips data; include its exact bytes separately.
+                            self.value(image.as_ref())?; self.part(bytes);
+                        }
+                        _ => return None,
+                    }
+                }
+            }
+        }
+        Some(())
+    }
+}
+
+/// Digest over complete inputs in a restricted image-only subset. `None` means
+/// unknown, not equal. Browser environment, completed canvas ownership and job
+/// generations remain the caller's responsibility and are not certified here.
+pub(crate) fn image_page_identity(tree: &PageLayerTree) -> Option<String> {
+    if tree.profile != RenderProfile::Screen || !tree.page_width.is_finite() || !tree.page_height.is_finite()
+        || tree.page_width <= 0.0 || tree.page_height <= 0.0 || !tree.text_sources.entries.is_empty() { return None; }
+    let mut id = Identity { digest: blake3::Hasher::new(), nodes: 0, image_bytes: 0 };
+    id.part(b"geul-image-page-v1");
+    id.value(&tree.page_width)?; id.value(&tree.page_height)?;
+    let o = tree.output_options;
+    id.value(&(o.show_paragraph_marks, o.show_control_codes, o.show_transparent_borders, o.clip_enabled, o.debug_overlay))?;
+    id.node(&tree.root, 0)?;
+    Some(id.digest.finalize().to_hex().to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::paint::LayerNode;
+    use crate::renderer::render_tree::{ImageNode, PageBackgroundNode};
+    fn page(x: f64, byte: u8) -> PageLayerTree {
+        let box_ = BoundingBox::new(x, 1.0, 8.0, 10.0);
+        let image = ImageNode::new(1, Some(vec![137,80,78,71,13,10,26,10,byte]));
+        let background = PageBackgroundNode { background_color: Some(0xffffff), border_color: None, border_width: 0.0, gradient: None, image: None };
+        PageLayerTree::new(320.0, 200.0, LayerNode::leaf(BoundingBox::new(0.0,0.0,320.0,200.0), None,
+            vec![PaintOp::page_background(box_, background), PaintOp::Image { bbox: box_, image: Box::new(image), resolved: None }]))
+    }
+    #[test]
+    fn image_identity_distinguishes_geometry_bytes_and_options() {
+        let a=page(10.00001,1); let b=page(10.00049,1); let c=page(10.00001,2);
+        assert_eq!(image_page_identity(&a), image_page_identity(&a.clone()));
+        assert_ne!(image_page_identity(&a), image_page_identity(&b));
+        assert_ne!(image_page_identity(&a), image_page_identity(&c));
+        let mut changed=a.clone(); changed.output_options.clip_enabled=false;
+        assert_ne!(image_page_identity(&a), image_page_identity(&changed));
+    }
+    #[test]
+    fn image_identity_changes_with_transform_and_clip() {
+        let a = page(1.0, 1);
+        let mut rotated = a.clone();
+        if let LayerNodeKind::Leaf { ops } = &mut rotated.root.kind {
+            if let PaintOp::Image { image, .. } = &mut ops[1] { image.transform.rotation = 0.0001; }
+        }
+        assert_ne!(image_page_identity(&a), image_page_identity(&rotated));
+        let mut clipped = a.clone();
+        clipped.root = LayerNode::clip_rect(BoundingBox::new(0., 0., 320., 200.), None,
+            BoundingBox::new(0., 0., 100., 100.), clipped.root, crate::paint::layer_tree::ClipKind::Generic);
+        assert_ne!(image_page_identity(&a), image_page_identity(&clipped));
+    }
+    #[test]
+    fn image_identity_rejects_missing_and_unrecognized_bytes() {
+        for data in [None, Some(vec![1, 2, 3])] {
+            let mut a = page(1.0, 1);
+            if let LayerNodeKind::Leaf { ops } = &mut a.root.kind {
+                if let PaintOp::Image { image, .. } = &mut ops[1] { image.data = data; }
+            }
+            assert!(image_page_identity(&a).is_none());
+        }
+    }
+    #[test]
+    fn unknown_inputs_fail_closed() {
+        let mut a=page(f64::NAN,1); assert!(image_page_identity(&a).is_none());
+        a=page(1.0,1); a.profile=RenderProfile::Print; assert!(image_page_identity(&a).is_none());
+        a=page(1.0,1); if let LayerNodeKind::Leaf { ops }=&mut a.root.kind {
+            ops.push(PaintOp::ControlLabel { bbox: BoundingBox::new(0.,0.,1.,1.), label: "x".into() });
+        } assert!(image_page_identity(&a).is_none());
+    }
+}
