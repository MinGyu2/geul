+use crate::model::control::Control;
+use crate::renderer::render_tree::{BoundingBox, RenderNode, RenderNodeType};
+use crate::wasm_api::HwpDocument;
+use serde_json::Value;
+
+fn original() -> HwpDocument {
+    let path =
+        std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("samples/rnote/연구노트(화학).hwp");
+    HwpDocument::from_bytes(&std::fs::read(path).expect("public original fixture"))
+        .expect("parse fixture")
+}
+
+fn line(node: &RenderNode, para: usize) -> Option<BoundingBox> {
+    if let RenderNodeType::TextLine(meta) = &node.node_type {
+        if meta.section_index == Some(0) && meta.para_index == Some(para) {
+            return Some(node.bbox);
+        }
+    }
+    node.children.iter().find_map(|child| line(child, para))
+}
+
+fn rect(doc: &HwpDocument, para: usize) -> Value {
+    let value = doc
+        .get_cursor_rect_native(0, para, 0)
+        .expect("empty floating-image host must have a real paragraph caret");
+    serde_json::from_str(&value).expect("cursor JSON")
+}
+
+fn near(actual: f64, expected: f64) {
+    assert!((actual - expected).abs() <= 0.15, "{actual} != {expected}");
+}
+
+#[test]
+fn t010_caret_original_empty_float_hosts_keep_their_line_geometry() {
+    let doc = original();
+    assert_eq!(doc.page_count(), 24);
+    let pictures: Vec<_> = doc.document.sections[0]
+        .paragraphs
+        .iter()
+        .enumerate()
+        .filter(|(_, p)| {
+            p.controls.iter().any(|c| {
+                matches!(c,
+            Control::Picture(pic) if !pic.common.treat_as_char)
+            })
+        })
+        .map(|(index, _)| index)
+        .collect();
+    assert_eq!(
+        pictures.len(),
+        21,
+        "the other three hosts use an existing object caret path"
+    );
+    for para in pictures {
+        assert_eq!(doc.get_paragraph_length_native(0, para).unwrap(), 0);
+        let caret = rect(&doc, para);
+        assert_eq!(caret["pageIndex"], para);
+        // Independent fixture contract: 2835-HU body margins; stored 1000-HU line.
+        near(caret["x"].as_f64().unwrap(), 37.8);
+        near(caret["y"].as_f64().unwrap(), 37.8);
+        near(caret["height"].as_f64().unwrap(), 1000.0 * 96.0 / 7200.0);
+    }
+}
+
+#[test]
+fn t010_caret_existing_non_picture_object_carets_keep_their_geometry() {
+    let doc = original();
+    for (para, y) in [(16, 917.6), (17, 914.3), (18, 914.3)] {
+        let caret = rect(&doc, para);
+        assert_eq!(caret["pageIndex"], para);
+        near(caret["x"].as_f64().unwrap(), 41.6);
+        near(caret["y"].as_f64().unwrap(), y);
+        near(caret["height"].as_f64().unwrap(), 12.0);
+    }
+}
+
+#[test]
+fn t010_caret_empty_host_matches_the_independently_rendered_insertion_line() {
+    let mut doc = original();
+    let caret = rect(&doc, 23);
+    doc.insert_text_native(0, 23, 0, "X")
+        .expect("type into original host");
+    let tree = doc
+        .build_page_tree_cached(23)
+        .expect("typed full render tree");
+    let typed = line(&tree.root, 23).expect("real rendered text line");
+    near(caret["x"].as_f64().unwrap(), typed.x);
+    near(caret["y"].as_f64().unwrap(), typed.y);
+    near(caret["height"].as_f64().unwrap(), typed.height);
+}
+
+#[test]
+fn t010_caret_anchor_is_independent_of_the_floating_picture_offset() {
+    let mut doc = original();
+    let Control::Picture(picture) = &mut doc.document.sections[0].paragraphs[23].controls[0] else {
+        panic!("fixture must own the floating picture")
+    };
+    picture.common.horizontal_offset += 750;
+    picture.common.vertical_offset += 1500;
+    doc.paginate();
+    let caret = rect(&doc, 23);
+    near(caret["x"].as_f64().unwrap(), 37.8);
+    near(caret["y"].as_f64().unwrap(), 37.8);
+    // The paragraph anchor must not be fabricated from the image's displaced bbox.
+    let controls: Value = serde_json::from_str(&doc.get_page_control_layout(23).unwrap()).unwrap();
+    assert!(controls["controls"][0]["y"].as_f64().unwrap() > 50.0);
+}
+
+#[test]
+fn t010_caret_snapshot_restore_recovers_original_empty_geometry() {
+    let mut doc = original();
+    let saved = doc.save_snapshot_native();
+    doc.insert_text_native(0, 23, 0, "AB").expect("edit");
+    doc.restore_snapshot_native(saved)
+        .expect("restore original");
+    assert_eq!(doc.get_paragraph_length_native(0, 23).unwrap(), 0);
+    let caret = rect(&doc, 23);
+    assert_eq!(caret["pageIndex"], 23);
+    near(caret["x"].as_f64().unwrap(), 37.8);
+    near(caret["y"].as_f64().unwrap(), 37.8);
+}
