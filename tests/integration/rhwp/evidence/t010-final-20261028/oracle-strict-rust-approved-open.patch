+const STRICT_ORACLE_MAX_BYTES: u64 = 4 * 1024 * 1024;
+const STRICT_ORACLE_HUGE_PATH: &str = "issue2063_huge_cellbreak_table.hwp";
+const STRICT_ORACLE_HUGE_SHA256: &str =
+    "47de1ce82472050a4c5f33ccab2a3eac2c7e55d0e2a688febd085f0b4c8320ca";
+const STRICT_ORACLE_SOURCE_DOCUMENTS: usize = 1205;
+const STRICT_ORACLE_SELECTED_DOCUMENTS: usize = 1150;
+const STRICT_ORACLE_STAGE_A_DOCUMENTS: usize = 1149;
+const STRICT_ORACLE_APPROVED_EXCLUSIONS: usize = 59;
+const STRICT_ORACLE_SIZE_EXCLUSIONS: usize = 55;
+const STRICT_ORACLE_OPEN_FAILURES: [(&str, &str); 3] = [
+    (
+        "HWP3-password-123456.hwp",
+        "db743d084efc9e08e839a5b4d978b16b8676434011776e090e4cda43e57304be",
+    ),
+    (
+        "HWP5-password-123456.hwpx",
