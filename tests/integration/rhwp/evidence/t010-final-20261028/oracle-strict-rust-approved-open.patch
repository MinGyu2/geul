+        b.format_memo_enabled = false;
+        let initial_equal = canonical(&a) == canonical(&b);
+        pagination_attempted = 1;
+        if initial_equal {
+            pagination_successful = 1;
+        } else {
+            strict_oracle_bump(&mut errors, "pagination");
+            mismatches.push(format!("{}: initial pagination differs", input.relative));
+        }
+        let mut rng = Lcg(input.relative.bytes().fold(1469598103934665603u64, |h, c| {
+            (h ^ c as u64).wrapping_mul(1099511628211)
+        }));
+        if initial_equal {
+            for step in 0..ops_per_doc {
+                let Some(op) = pick(&a, &mut rng) else {
+                    eprintln!(
+                        "GEUL_ORACLE_ERROR {} stage=edit-selection step={step} no editable operation",
+                        input.relative
+                    );
+                    break;
+                };
+                edits_attempted += 1;
+                let ra = apply(&mut a, &op);
+                let rb = apply(&mut b, &op);
+                match pair_status(&ra, &rb) {
+                    PairStatus::Asymmetric => {
+                        strict_oracle_bump(&mut errors, "editAsymmetric");
+                        mismatches.push(format!("{}: asymmetric edit step={step}", input.relative));
+                        break;
+                    }
+                    PairStatus::BothErr => {
+                        strict_oracle_bump(&mut errors, "editSymmetric");
+                        edits_rejected += 1;
+                        eprintln!(
+                            "GEUL_ORACLE_ERROR {} stage=edit step={step} symmetric rejection A={ra:?} B={rb:?}",
+                            input.relative
+                        );
+                        continue;
+                    }
+                    PairStatus::BothOk => {}
+                }
+                edits_applied += 1;
+                pagination_attempted += 1;
+                if canonical(&a) == canonical(&b) {
+                    pagination_successful += 1;
+                } else {
+                    strict_oracle_bump(&mut errors, "pagination");
+                    mismatches.push(format!(
+                        "{}: pagination differs after edit step={step}",
+                        input.relative
+                    ));
+                    break;
+                }
+                if (step + 1) % 10 == 0 {
+                    eprintln!(
+                        "GEUL_PROGRESS {} stage=edits state=progress step={}/{}",
+                        input.relative,
+                        step + 1,
+                        ops_per_doc
+                    );
+                }
+            }
+        }
+        let page_count_a = a.page_count();
+        let page_count_b = b.page_count();
+        svg_expected = page_count_a.max(page_count_b) as usize;
+        if page_count_a != page_count_b {
+            strict_oracle_bump(&mut errors, "pagination");
+            mismatches.push(format!(
+                "{}: page count A={} B={}",
+                input.relative, page_count_a, page_count_b
+            ));
+        }
+        for page in 0..page_count_a.min(page_count_b) {
+            svg_attempted += 1;
+            let ra = a.render_page_svg_native(page);
+            let rb = b.render_page_svg_native(page);
+            match svg_status(&ra, &rb) {
+                SvgStatus::Equal => svg_successful += 1,
+                SvgStatus::Different => {
+                    strict_oracle_bump(&mut errors, "svgDifferent");
+                    mismatches.push(format!("{}: svg page {page} differs", input.relative));
+                }
+                SvgStatus::BothErr => {
+                    strict_oracle_bump(&mut errors, "svgSymmetric");
+                    mismatches.push(format!(
+                        "{}: svg page {page} failed symmetrically A={:?} B={:?}",
+                        input.relative,
+                        ra.err(),
+                        rb.err()
+                    ));
+                }
+                SvgStatus::Asymmetric => {
+                    strict_oracle_bump(&mut errors, "svgAsymmetric");
+                    mismatches.push(format!(
+                        "{}: svg page {page} failed asymmetrically A={:?} B={:?}",
+                        input.relative,
+                        ra.err(),
+                        rb.err()
+                    ));
+                }
+            }
+        }
+        let errors_clear = errors.values().all(|count| *count == 0);
+        complete = initial_equal
+            && edits_attempted == ops_per_doc
+            && edits_applied == ops_per_doc
+            && edits_rejected == 0
+            && pagination_attempted == ops_per_doc + 1
+            && pagination_successful == ops_per_doc + 1
+            && page_count_a == page_count_b
+            && svg_expected > 0
+            && svg_attempted == svg_expected
+            && svg_successful == svg_expected
+            && errors_clear;
+        if complete && exclusion_reason.is_none() {
+            status = "verified";
+        } else if complete {
+            // An approved open exclusion that unexpectedly opens is not the declared exclusion.
+            status = "incomplete";
+        }
+        let memo_entries = a
+            .measured_sections
+            .iter()
+            .map(|m| m.format_memo.reusable_entries())
+            .sum::<usize>();
+        let row = serde_json::json!({
+            "path": input.relative, "sha256": input.sha256, "status": status, "complete": complete,
+            "exclusionReason": if status == "excluded" { exclusion_reason } else { None },
+            "openedA": opened_a, "openedB": opened_b,
+            "edits": {"required": ops_per_doc, "attempted": edits_attempted, "applied": edits_applied, "rejected": edits_rejected},
+            "pagination": {"expected": ops_per_doc + 1, "attempted": pagination_attempted, "successful": pagination_successful},
+            "svg": {"pageCountA": page_count_a, "pageCountB": page_count_b, "expected": svg_expected, "attempted": svg_attempted, "successful": svg_successful},
+            "errors": errors, "memoEntries": memo_entries,
+        });
+        eprintln!("GEUL_ORACLE_DOC {}", row);
+        rows.push(row);
+        eprintln!(
+            "GEUL_PROGRESS {} stage=document state=done complete={complete}",
+            input.relative
+        );
+    }
+
+    let count_status = |status: &str| {
+        rows.iter()
+            .filter(|row| row["status"].as_str() == Some(status))
+            .count()
+    };
+    let opened = rows
+        .iter()
+        .filter(|row| {
+            row["openedA"].as_bool() == Some(true) && row["openedB"].as_bool() == Some(true)
+        })
+        .count();
+    let mut summary = serde_json::Map::new();
+    summary.insert("mode".into(), serde_json::json!("strict"));
+    summary.insert("files".into(), serde_json::json!(rows.len()));
+    summary.insert("opened".into(), serde_json::json!(opened));
+    summary.insert(
+        "excluded".into(),
+        serde_json::json!(count_status("excluded")),
+    );
+    summary.insert(
+        "failed".into(),
+        serde_json::json!(count_status("incomplete")),
+    );
+    summary.insert(
+        "verified".into(),
+        serde_json::json!(count_status("verified")),
+    );
+    let sum = |object: &str, field: &str| {
+        rows.iter()
+            .map(|row| strict_oracle_count(row, object, field))
+            .sum::<usize>()
+    };
+    for (summary_key, object, field) in [
+        ("attempted", "edits", "attempted"),
+        ("applied", "edits", "applied"),
+        ("rejected", "edits", "rejected"),
+        ("paginationExpected", "pagination", "expected"),
+        ("paginationAttempted", "pagination", "attempted"),
+        ("compared", "pagination", "successful"),
+        ("svgExpected", "svg", "expected"),
+        ("svgAttempted", "svg", "attempted"),
+        ("svgPages", "svg", "successful"),
+    ] {
+        summary.insert(summary_key.into(), serde_json::json!(sum(object, field)));
+    }
+    const ERROR_FIELDS: &[&str] = &[
+        "read",
+        "identity",
+        "openSymmetric",
+        "openAsymmetric",
+        "editSymmetric",
+        "editAsymmetric",
+        "pagination",
+        "svgSymmetric",
+        "svgAsymmetric",
+        "svgDifferent",
+    ];
+    for field in ERROR_FIELDS {
+        let total = rows
+            .iter()
+            .map(|row| row["errors"][*field].as_u64().unwrap_or(0) as usize)
+            .sum::<usize>();
+        summary.insert((*field).into(), serde_json::json!(total));
+    }
+    let summary_value = serde_json::Value::Object(summary);
+    eprintln!("GEUL_ORACLE_SUMMARY {}", summary_value);
+    for mismatch in &mismatches {
+        eprintln!("GEUL_ORACLE_MISMATCH {mismatch}");
+    }
+    assert_eq!(
+        rows.len(),
+        inputs.len(),
+        "strict oracle emitted an unexpected number of document rows"
+    );
+    assert_eq!(
+        count_status("verified"),
+        expected_verified,
+        "strict oracle did not fully verify every non-excluded document"
+    );
+    assert_eq!(
+        count_status("excluded"),
+        expected_excluded,
+        "strict oracle did not reproduce the approved exclusion count"
+    );
+    assert_eq!(
+        count_status("incomplete"),
+        0,
+        "strict oracle has incomplete documents"
+    );
+    assert!(
+        mismatches.is_empty(),
+        "strict oracle found equivalence errors"
+    );
+}
