+fn strict_sha256_hex(bytes: &[u8]) -> String {
+    const HEX: &[u8; 16] = b"0123456789abcdef";
+    let digest = Sha256::digest(bytes);
+    let mut encoded = String::with_capacity(digest.len() * 2);
+    for byte in digest {
+        let value = byte as usize;
+        encoded.push(HEX[value >> 4] as char);
+        encoded.push(HEX[value & 0x0f] as char);
+    }
+    encoded
+}
+
+#[derive(Clone)]
+struct StrictOracleInput {
+    path: PathBuf,
+    relative: String,
+    sha256: String,
+    size_bytes: u64,
+    exclusion_reason: Option<String>,
+}
+
+fn strict_oracle_inputs(
+    root: &std::path::Path,
+) -> Result<(Vec<StrictOracleInput>, usize, usize), String> {
+    let manifest_path =
+        std::env::var("GEUL_ORACLE_MANIFEST").map_err(|_| "GEUL_ORACLE_MANIFEST required")?;
+    let expected_sha = std::env::var("GEUL_ORACLE_EXPECTED_MANIFEST_SHA256")
+        .map_err(|_| "GEUL_ORACLE_EXPECTED_MANIFEST_SHA256 required")?;
+    if expected_sha.len() != 64 || !expected_sha.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err("invalid expected manifest SHA-256".into());
+    }
+    let manifest_bytes =
+        std::fs::read(&manifest_path).map_err(|e| format!("read manifest: {e}"))?;
+    let actual_sha = strict_sha256_hex(&manifest_bytes);
+    if actual_sha != expected_sha.to_ascii_lowercase() {
+        return Err(format!(
+            "manifest SHA-256 mismatch: expected {expected_sha}, got {actual_sha}"
+        ));
+    }
+    let manifest: serde_json::Value =
+        serde_json::from_slice(&manifest_bytes).map_err(|e| format!("parse manifest: {e}"))?;
+    if manifest["schema"].as_str() != Some("geul.t010.oracle-input-manifest.v1")
+        || manifest["source"]["gitlinkRevision"].as_str()
+            != Some("1a76570e833917d15817415a53c09ad61ab3203f")
+        || manifest["selection"]["maxBytesInclusive"].as_u64() != Some(STRICT_ORACLE_MAX_BYTES)
+        || manifest["selection"]["extensions"] != serde_json::json!([".hwp", ".hwpx"])
+    {
+        return Err("manifest schema, source revision, or selection contract mismatch".into());
+    }
+    let required_ops = manifest["requiredEditsPerDocument"]
+        .as_u64()
+        .ok_or("missing required edit count")? as usize;
+    if required_ops != 30 {
+        return Err(format!(
+            "strict edit requirement must be 30, got {required_ops}"
+        ));
+    }
+    if let Ok(configured) = std::env::var("GEUL_ORACLE_OPS") {
+        let configured: usize = configured.parse().map_err(|_| "invalid GEUL_ORACLE_OPS")?;
+        if configured != required_ops {
+            return Err(format!(
+                "GEUL_ORACLE_OPS cannot weaken strict coverage: {configured}"
+            ));
+        }
+    }
+    let expected_docs = manifest["expectedDocumentCount"]
+        .as_u64()
+        .ok_or("missing expected document count")? as usize;
+    let expected_selected = manifest["expectedSelectedDocumentCount"]
+        .as_u64()
+        .ok_or("missing selected document count")? as usize;
+    let expected_stage_a = manifest["expectedStageADocumentCount"]
+        .as_u64()
+        .ok_or("missing Stage A document count")? as usize;
+    let expected_exclusions = manifest["expectedApprovedExclusionCount"]
+        .as_u64()
+        .ok_or("missing approved exclusion count")? as usize;
+    if expected_docs != STRICT_ORACLE_SOURCE_DOCUMENTS
+        || expected_selected != STRICT_ORACLE_SELECTED_DOCUMENTS
+        || expected_stage_a != STRICT_ORACLE_STAGE_A_DOCUMENTS
+        || expected_exclusions != STRICT_ORACLE_APPROVED_EXCLUSIONS
+        || manifest["expectedApprovedExclusionsByReason"]
+            != serde_json::json!({
+                "approved-open-failure": STRICT_ORACLE_OPEN_FAILURES.len(),
+                "source-size-limit": STRICT_ORACLE_SIZE_EXCLUSIONS,
+                "stage-b-separate": 1,
+            })
+    {
+        return Err(
+            "strict corpus or approved exclusion counts differ from pinned expectations".into(),
+        );
+    }
+    let document_rows = manifest["documents"]
+        .as_array()
+        .ok_or("manifest documents must be an array")?;
+    if document_rows.len() != expected_docs {
+        return Err(format!(
+            "manifest document count mismatch: {} != {expected_docs}",
+            document_rows.len()
+        ));
+    }
+    let exclusion_rows = manifest["approvedExclusions"]
+        .as_array()
+        .ok_or("approvedExclusions must be an array")?;
+    let mut exclusions = std::collections::BTreeMap::new();
+    for exclusion in exclusion_rows {
+        let relative = exclusion["path"]
+            .as_str()
+            .ok_or("exclusion path missing")?
+            .to_string();
+        let reason = exclusion["reason"]
+            .as_str()
+            .ok_or("exclusion reason missing")?
+            .to_string();
+        let digest = exclusion["sha256"]
+            .as_str()
+            .ok_or("exclusion digest missing")?;
+        if exclusions
+            .insert(relative.clone(), (reason, digest.to_string()))
+            .is_some()
+        {
+            return Err(format!("duplicate approved exclusion: {relative}"));
+        }
+    }
+    if exclusions.len() != STRICT_ORACLE_APPROVED_EXCLUSIONS {
+        return Err(format!(
+            "approved exclusion count mismatch: {} != {}",
+            exclusions.len(),
+            STRICT_ORACLE_APPROVED_EXCLUSIONS
+        ));
+    }
+    for (relative, digest) in STRICT_ORACLE_OPEN_FAILURES {
+        if !matches!(
+            exclusions.get(relative),
+            Some((reason, excluded_digest))
+                if reason == "approved-open-failure" && excluded_digest == digest
+        ) {
+            return Err(format!(
+                "approved open-failure identity mismatch: {relative}"
+            ));
+        }
+    }
+    let mut seen = std::collections::BTreeSet::new();
+    let mut inputs = Vec::new();
+    let mut stage_b_exclusions = 0usize;
+    let mut open_exclusions = 0usize;
+    let mut size_limit_exclusions = 0usize;
+    for document in document_rows {
+        let relative = document["path"]
+            .as_str()
+            .ok_or("document path missing")?
+            .to_string();
+        let digest = document["sha256"]
+            .as_str()
+            .ok_or("document SHA-256 missing")?
+            .to_string();
+        let size_bytes = document["sizeBytes"]
+            .as_u64()
+            .ok_or("document size missing")?;
+        if relative.is_empty()
+            || relative.starts_with('/')
+            || relative
+                .split('/')
+                .any(|part| part == ".." || part.is_empty())
+        {
+            return Err(format!("unsafe manifest path: {relative}"));
+        }
+        if !seen.insert(relative.clone()) {
+            return Err(format!("duplicate manifest document: {relative}"));
+        }
+        let exclusion = exclusions.get(&relative);
+        if let Some((_, excluded_digest)) = exclusion {
+            if excluded_digest != &digest {
+                return Err(format!("approved exclusion identity mismatch: {relative}"));
+            }
+        }
+        if size_bytes > STRICT_ORACLE_MAX_BYTES {
+            if !matches!(exclusion, Some((reason, _)) if reason == "source-size-limit") {
+                return Err(format!("missing source-size exclusion: {relative}"));
+            }
+            size_limit_exclusions += 1;
+            continue;
+        }
+        if matches!(exclusion, Some((reason, _)) if reason == "source-size-limit") {
+            return Err(format!(
+                "selected document has a size-limit exclusion: {relative}"
+            ));
+        }
+        let reason = exclusion.map(|(reason, _)| reason.clone());
+        if reason.as_deref() == Some("stage-b-separate") {
+            stage_b_exclusions += 1;
+            if relative != STRICT_ORACLE_HUGE_PATH || digest != STRICT_ORACLE_HUGE_SHA256 {
+                return Err("Stage B exclusion is not the approved huge-table fixture".into());
+            }
+        } else if reason.as_deref() == Some("approved-open-failure") {
+            open_exclusions += 1;
+        } else if reason.is_some() {
+            return Err(format!(
+                "unsupported selected-document exclusion reason: {relative}"
+            ));
+        }
+        inputs.push(StrictOracleInput {
+            path: root.join(std::path::Path::new(&relative)),
+            relative,
+            sha256: digest,
+            size_bytes,
+            exclusion_reason: reason,
+        });
+    }
+    if inputs.len() != expected_selected {
+        return Err(format!(
+            "selected document count mismatch: {} != {expected_selected}",
+            inputs.len()
+        ));
+    }
+    if inputs.len() - stage_b_exclusions != expected_stage_a {
+        return Err(format!(
+            "Stage A document count mismatch: {} != {expected_stage_a}",
+            inputs.len() - stage_b_exclusions
+        ));
+    }
+    if size_limit_exclusions != STRICT_ORACLE_SIZE_EXCLUSIONS
+        || stage_b_exclusions != 1
+        || open_exclusions != STRICT_ORACLE_OPEN_FAILURES.len()
+        || exclusions.keys().any(|path| !seen.contains(path))
+    {
+        return Err(
+            "approved exclusion identities or reason counts do not match strict expectations"
+                .into(),
+        );
+    }
+    let expected_verified = expected_stage_a
+        .checked_sub(open_exclusions)
+        .ok_or("more open exclusions than Stage A documents")?;
+    let expected_excluded = stage_b_exclusions + open_exclusions;
+    Ok((inputs, expected_verified, expected_excluded))
+}
+
+fn strict_oracle_bump(
+    errors: &mut std::collections::BTreeMap<&'static str, usize>,
+    field: &'static str,
+) {
+    *errors.get_mut(field).expect("known oracle error field") += 1;
+}
+
+fn strict_oracle_count(row: &serde_json::Value, object: &str, field: &str) -> usize {
+    row.get(object)
+        .and_then(|value| value.get(field))
+        .and_then(serde_json::Value::as_u64)
+        .unwrap_or(0) as usize
+}
+
+fn strict_oracle_run() {
+    let mode = std::env::var("GEUL_ORACLE_MODE").unwrap_or_else(|_| "diagnostic".into());
