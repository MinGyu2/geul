+    fn record_rejection(&mut self, key: ImageKey) {
+        let last_tick = self.tick;
+        let streak = self
+            .rejection_streaks
+            .entry(key)
+            .or_insert(RejectionStreak {
+                count: 0,
+                last_tick,
+            });
+        streak.count = streak
+            .count
+            .saturating_add(1)
+            .min(REJECTION_PROMOTION_THRESHOLD);
+        streak.last_tick = last_tick;
+        self.prune_rejection_streaks();
+    }
+
+    fn prune_rejection_streaks(&mut self) {
+        let limit = self.max_entries.saturating_mul(4);
+        if limit == 0 {
+            self.rejection_streaks.clear();
+            return;
+        }
+        while self.rejection_streaks.len() > limit {
+            let oldest = self
+                .rejection_streaks
+                .iter()
+                .min_by_key(|(_, streak)| streak.last_tick)
+                .map(|(key, _)| *key);
+            let Some(oldest) = oldest else {
+                break;
+            };
+            self.rejection_streaks.remove(&oldest);
+        }
+    }
+
+    /// Whether ordinary LRU eviction can make space without changing the cache.
+    fn can_make_room(&self, bytes: usize, count: usize) -> bool {
+        let (mut total_bytes, mut total_entries) = (self.bytes, self.entries.len());
+        if total_bytes.saturating_add(bytes) <= self.max_bytes
+            && total_entries.saturating_add(count) <= self.max_entries
+        {
+            return true;
+        }
+        let mut victims: Vec<(&ImageKey, &Entry<V>)> = self
+            .entries
+            .iter()
+            .filter(|(_, entry)| !entry.pending)
+            .collect();
+        victims.sort_by_key(|(_, entry)| (!entry.transient, entry.used));
+        for (_, entry) in victims {
+            total_bytes = total_bytes.saturating_sub(entry.bytes);
+            total_entries = total_entries.saturating_sub(1);
+            if total_bytes.saturating_add(bytes) <= self.max_bytes
+                && total_entries.saturating_add(count) <= self.max_entries
+            {
+                return true;
+            }
+        }
+        false
     }
 
