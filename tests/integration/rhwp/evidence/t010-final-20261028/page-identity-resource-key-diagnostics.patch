+fn decoded_image_diagnostic<'a>(
+    diagnostics: &'a mut Diagnostics,
+    key: ImageKey,
+    input_bytes: usize,
+) -> Option<&'a mut DecodedImageDiagnostic> {
+    const MIN_INPUT_BYTES: usize = 512 << 10;
+    const MAX_DIAGNOSTIC_IMAGES: usize = 256;
+    if input_bytes < MIN_INPUT_BYTES
+        || (!diagnostics.decoded_images.contains_key(&key)
+            && diagnostics.decoded_images.len() >= MAX_DIAGNOSTIC_IMAGES)
+    {
+        return None;
+    }
+    let image = diagnostics.decoded_images.entry(key).or_default();
+    image.input_bytes = input_bytes;
+    Some(image)
+}
+
+pub fn note_decoded_image_lookup(key: ImageKey, input_bytes: usize, cache_hit: bool) {
+    POOL.with(|p| {
+        let mut p = p.borrow_mut();
+        if let Some(image) = decoded_image_diagnostic(&mut p.diagnostics, key, input_bytes) {
+            image.lookups = image.lookups.saturating_add(1);
+            if cache_hit {
+                image.cache_hits = image.cache_hits.saturating_add(1);
+            } else {
+                image.cache_misses = image.cache_misses.saturating_add(1);
+            }
+        }
+    });
+}
+
+pub fn note_decoded_image_shared_lease(key: ImageKey, input_bytes: usize) {
+    POOL.with(|p| {
