+) {
+    POOL.with(|p| {
+        let mut p = p.borrow_mut();
+        if let Some(image) = decoded_image_diagnostic(&mut p.diagnostics, key, input_bytes) {
+            image.decode_attempts = image.decode_attempts.saturating_add(1);
