     #[test]
+    fn promoted_candidate_survives_pressure_until_its_first_hit() {
+        let log = Rc::new(RefCell::new(Vec::new()));
+        let mut cache = BoundedCache::new(1_000, 8, true);
+        for n in 1..=4 {
+            assert!(cache.insert(key(n), Some(surface(n as u32, &log)), 250));
+            cache.frequency.insert(key(n), MAX_FREQUENCY);
+        }
+
+        let promoted = key(9);
+        for _ in 0..4 {
+            cache.since_aging = 0;
+            assert!(cache.get(&promoted).is_none());
+            let decoded = surface(9, &log);
+            assert!(!cache.insert(promoted, Some(decoded.clone()), 250));
+            decoded.release();
+        }
+        cache.since_aging = 0;
+        assert!(cache.get(&promoted).is_none());
+        let decoded = surface(9, &log);
+        assert!(cache.insert(promoted, Some(decoded), 250));
+        assert!(cache.entries.contains_key(&promoted));
+
+        // Make every older resident newer than the just-promoted value, then apply pressure.
+        for n in 2..=4 {
+            cache.frequency.insert(key(n), 1);
+            assert!(cache.get(&key(n)).is_some());
+        }
+        cache.frequency.insert(key(10), MAX_FREQUENCY - 1);
+        assert!(cache.get(&key(10)).is_none());
+        let other = surface(10, &log);
+        assert!(cache.insert(key(10), Some(other), 250));
+
+        assert!(cache.entries.contains_key(&promoted));
+        assert_eq!((cache.stats().entries, cache.stats().bytes), (4, 1_000));
+        assert!(cache.get(&promoted).is_some());
+    }
