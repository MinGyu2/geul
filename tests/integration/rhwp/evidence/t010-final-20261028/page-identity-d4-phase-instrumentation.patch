+
+pub fn reset_diagnostics() {
+    POOL.with(|p| p.borrow_mut().diagnostics = Diagnostics::default());
+}
+
+pub fn note_diagnostic(
+    stage: &'static str,
+    elapsed_ms: f64,
+    resource: Option<(&'static str, usize)>,
+) {
+    if !elapsed_ms.is_finite() || elapsed_ms < 0.0 {
+        return;
+    }
+    POOL.with(|p| {
+        let mut pool = p.borrow_mut();
+        let timing = pool.diagnostics.stages.entry(stage).or_default();
+        timing.calls = timing.calls.saturating_add(1);
+        timing.total_ms += elapsed_ms;
+        timing.max_ms = timing.max_ms.max(elapsed_ms);
+        if let Some((kind, bytes)) = resource {
+            if pool
+                .diagnostics
+                .slowest_resource
+                .is_none_or(|(old_ms, _, _)| elapsed_ms > old_ms)
+            {
+                pool.diagnostics.slowest_resource = Some((elapsed_ms, kind, bytes));
+            }
+        }
+    });
+}
+
+fn diagnostics_json(diagnostics: &Diagnostics) -> serde_json::Value {
+    let stages = diagnostics
+        .stages
+        .iter()
+        .map(|(name, timing)| {
+            (
+                (*name).to_owned(),
+                serde_json::json!({
+                    "calls": timing.calls,
+                    "totalMs": timing.total_ms,
+                    "maxMs": timing.max_ms,
+                }),
+            )
+        })
+        .collect::<serde_json::Map<_, _>>();
+    let slowest_resource = diagnostics
+        .slowest_resource
+        .map(|(elapsed_ms, kind, bytes)| {
+            serde_json::json!({"kind":kind,"inputBytes":bytes,"elapsedMs":elapsed_ms})
+        });
+    serde_json::json!({"stages":stages,"slowestResource":slowest_resource})
 }
 
