     #[test]
+    fn repeated_rejection_survives_global_frequency_aging() {
+        let log = Rc::new(RefCell::new(Vec::new()));
+        let mut cache = BoundedCache::new(400, 16, true);
+        for n in 1..=4 {
+            assert!(cache.insert(key(n), Some(surface(n as u32, &log)), 100));
+            assert!(cache.get(&key(n)).is_some());
+        }
+        for _ in 1..15 {
+            assert!(cache.get(&key(1)).is_some());
+        }
+
+        for attempt in 0..5 {
+            assert!(cache.get(&key(9)).is_none());
+            let candidate = surface(9, &log);
+            let admitted = cache.insert(key(9), Some(candidate.clone()), 100);
+            if admitted {
+                break;
+            }
+            candidate.release();
+            // Interleaved hot lookups trigger cache-wide aging and keep the resident hot.
+            for _ in 0..63 {
+                assert!(cache.get(&key(1)).is_some());
+            }
+            assert_eq!(attempt < 4, !cache.entries.contains_key(&key(9)));
+        }
+        assert!(
+            cache.entries.contains_key(&key(9)),
+            "a repeatedly rejected resource must win by its fifth admission attempt despite global aging"
+        );
+        assert!(cache.stats().bytes <= 400);
+        assert!(cache.stats().entries <= 4);
+    }
