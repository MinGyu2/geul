+    /// Bounded diagnostic snapshot taken immediately before a decoded-surface admission.
+    pub fn admission_debug(&self, key: &ImageKey) -> AdmissionDebug {
+        let max_resident_frequency = self
+            .entries
+            .iter()
+            .filter(|(_, entry)| !entry.pending)
+            .map(|(resident, _)| self.frequency.get(resident).copied().unwrap_or(0))
+            .max()
+            .unwrap_or(0);
+        AdmissionDebug {
+            candidate_frequency: self.frequency.get(key).copied().unwrap_or(0),
+            max_resident_frequency,
+            since_aging: self.since_aging,
+            entries: self.entries.len(),
+            bytes: self.bytes,
+        }
     }
 
