     #[test]
+    fn repeated_rejections_age_incumbents_and_eventually_admit_candidate() {
+        let log = Rc::new(RefCell::new(Vec::new()));
+        let mut cache = BoundedCache::new(400, 16, true);
+        for n in 1..=4 {
+            assert!(cache.insert(key(n), Some(surface(n as u32, &log)), 100));
+            assert!(cache.get(&key(n)).is_some());
+        }
+        for _ in 1..15 {
+            assert!(cache.get(&key(1)).is_some());
+        }
+        // Keep the hot entry least-recently-used so its frequency is the admission barrier.
+        for n in 2..=4 {
+            assert!(cache.get(&key(n)).is_some());
+        }
+
+        for _ in 0..3 {
+            assert!(cache.get(&key(9)).is_none());
+            let candidate = surface(9, &log);
+            assert!(!cache.insert(key(9), Some(candidate.clone()), 100));
+            candidate.release();
+            assert!(cache.entries.contains_key(&key(1)));
+        }
+
+        let mut admitted = false;
+        for _ in 3..6 {
+            assert!(cache.get(&key(9)).is_none());
+            let candidate = surface(9, &log);
+            if cache.insert(key(9), Some(candidate.clone()), 100) {
+                admitted = true;
+                break;
+            }
+            candidate.release();
+        }
+        assert!(
+            admitted,
+            "a repeatedly demanded resource must eventually pass admission"
+        );
+        assert_eq!(*log.borrow(), vec![9, 9, 9, 9, 9, 1]);
+        assert_eq!((cache.stats().entries, cache.stats().bytes), (4, 400));
+        assert_eq!(cache.stats().rejected, 5);
+        assert!(cache.get(&key(9)).is_some());
+    }
