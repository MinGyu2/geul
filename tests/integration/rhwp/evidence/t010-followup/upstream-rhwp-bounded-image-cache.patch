+
+/// 두 전역 캐시의 상태 (디코드한 Canvas, 브라우저 이미지).
+#[cfg(target_arch = "wasm32")]
+pub fn renderer_cache_stats() -> (CacheStats, CacheStats) {
+    (
+        DECODED_CANVAS_CACHE.with(|c| c.borrow().stats()),
+        IMAGE_CACHE.with(|c| c.borrow().stats()),
+    )
+}
+
+/// 두 캐시를 각각 `max_bytes` 이하로 줄인다(0 = 모두 비움). 다른 문서는 다음 그리기에서 다시 디코드한다.
+#[cfg(target_arch = "wasm32")]
+pub fn trim_renderer_caches(max_bytes: usize) {
