+    /// wasm exports for bookmarks/hyperlinks mutate `core` directly, bypassing the
+    /// DerefMut job cancellation; the identity alone must still go stale.
+    #[test]
+    fn direct_core_mutation_paths_and_failed_mutations() {
+        use crate::document_core::{hyperlink::HyperlinkTarget, DocumentCore};
+        let mut doc = crate::wasm_api::HwpDocument::create_empty();
+        let d: &mut DocumentCore = &mut doc;
+        d.insert_text_native(0, 0, 0, "준비 신원 링크").unwrap();
+        let target = HyperlinkTarget::body(0, 0);
+        // A refused edit changes neither the model nor the identity.
+        let id = d.preparation_identity().unwrap();
+        assert!(d
+            .insert_hyperlink_native(&target, 3, 1, "https://example.com/")
+            .is_err());
+        assert!(d.preparation_matches(&id));
+        d.insert_hyperlink_native(&target, 0, 2, "https://example.com/")
+            .unwrap();
+        assert!(!d.preparation_matches(&id));
+        let id = d.preparation_identity().unwrap();
+        d.add_bookmark_native(0, 0, 1, "mark").unwrap();
+        assert!(!d.preparation_matches(&id));
+        let id = d.preparation_identity().unwrap();
+        d.set_dpi(d.dpi * 2.0);
+        assert!(!d.preparation_matches(&id));
+        let id = d.preparation_identity().unwrap();
+        d.fallback_font.push('x');
+        assert!(!d.preparation_matches(&id));
     }
 }

