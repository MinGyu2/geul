+    // Controlled seam: `authorize_decoded` receives decoded dimensions as values, so impossible
+    // decoder outcomes are tested without changing or claiming anything about image internals.
+    mod dimension_contract {
+        use super::super::*;
+        use crate::renderer::surface_cache::{Backing, CommitError, DecodedLedger, SharedBacking};
+        use std::cell::Cell;
+        use std::rc::Rc;
+
+        const LIMIT: usize = 96 << 20;
+
+        #[derive(Default)]
+        struct Probe {
+            allocated: Cell<u32>,
+            disposed: Cell<u32>,
+        }
+        struct Canvas(Rc<Probe>);
+        impl Backing for Canvas {
+            fn dispose(&self) {
+                self.0.disposed.set(self.0.disposed.get() + 1);
+            }
+        }
+
+        /// The decode path after decoding: reserve from the header (when known), authorize,
+        /// and only then allocate and commit the Canvas backing.
+        fn decode(
+            ledger: &Rc<DecodedLedger>,
+            probe: &Rc<Probe>,
+            header: Option<(u32, u32)>,
+            decoded: (u32, u32),
+            committed: usize,
+        ) -> Result<Rc<SharedBacking<Canvas>>, DecodedRefusal<&'static str>> {
+            let header = header.map(|(w, h)| {
+                let r = ledger
+                    .reserve(rgba_bytes(w, h), committed, LIMIT, true)
+                    .unwrap();
+                ((w, h), r)
+            });
+            let reservation = authorize_decoded(header, decoded, |bytes| {
+                ledger
+                    .reserve(bytes, committed, LIMIT, true)
+                    .ok_or("refused")
+            })?;
+            probe.allocated.set(probe.allocated.get() + 1);
+            Ok(reservation
+                .commit(Canvas(probe.clone()), rgba_bytes(decoded.0, decoded.1))
+                .unwrap())
+        }
+
+        fn clean(ledger: &DecodedLedger) -> bool {
+            let s = ledger.stats();
+            s.reserved_bytes == 0 && s.accounting_errors == 0 && s.rejected_commits == 0
+        }
+
+        #[test]
+        fn exact_header_dimensions_commit() {
+            let (l, p) = (Rc::new(DecodedLedger::default()), Rc::new(Probe::default()));
+            let lease = decode(&l, &p, Some((100, 100)), (100, 100), 0).unwrap();
+            assert_eq!((lease.bytes(), l.stats().unique_bytes), (40_000, 40_000));
+            drop(lease);
+            assert_eq!((p.allocated.get(), p.disposed.get()), (1, 1));
+            assert!(clean(&l) && l.stats().unique_bytes == 0);
+        }
+
+        #[test]
+        fn every_dimension_mismatch_is_refused_before_allocation() {
+            let (l, p) = (Rc::new(DecodedLedger::default()), Rc::new(Probe::default()));
+            // A live shared backing must survive every refusal untouched.
+            let live = decode(&l, &p, Some((8, 8)), (8, 8), 0).unwrap();
+            let cases = [
+                ((100, 100), (101, 100)), // wider
+                ((100, 100), (100, 101)), // taller
+                ((100, 100), (90, 90)),   // smaller: fits the reservation's bytes
+                ((100, 40), (40, 100)),   // transposed: same pixel count
+                ((200, 20), (100, 40)),   // other shape with identical RGBA bytes
+            ];
+            for (header, decoded) in cases {
+                let result = decode(&l, &p, Some(header), decoded, 256);
+                assert_eq!(
+                    result.err(),
+                    Some(DecodedRefusal::Mismatch(DimensionMismatch {
+                        header,
+                        decoded
+                    }))
+                );
+                assert_eq!(p.allocated.get(), 1, "no backing allocated for {decoded:?}");
+                assert!(clean(&l), "reservation released for {decoded:?}");
+                assert_eq!((l.stats().unique_bytes, l.stats().unique_count), (256, 1));
+            }
+            assert_eq!(p.disposed.get(), 0, "the live backing was not disposed");
+            assert_eq!(
+                (live.bytes(), l.stats().created, l.stats().disposed),
+                (256, 1, 0)
+            );
+        }
+
+        #[test]
+        fn generic_reservation_still_allows_a_smaller_allocation() {
+            // The memory contract is actual <= reserved; only the image layer requires identity.
+            let l = Rc::new(DecodedLedger::default());
+            let p = Rc::new(Probe::default());
+            let r = l.reserve(rgba_bytes(100, 100), 0, LIMIT, true).unwrap();
+            assert_eq!(r.authorizes(rgba_bytes(90, 90)), Ok(()));
+            assert!(matches!(
+                r.authorizes(rgba_bytes(101, 100)),
+                Err(CommitError::ExceedsReservation { .. })
+            ));
+            let lease = r.commit(Canvas(p.clone()), rgba_bytes(90, 90)).unwrap();
+            assert_eq!(l.stats().unique_bytes, 32_400);
+            drop(lease);
+            assert_eq!(
+                check_decoded_dimensions(Some((100, 100)), (90, 90)).is_err(),
+                true
+            );
+            assert_eq!(check_decoded_dimensions(None, (90, 90)), Ok(()));
+        }
+
+        #[test]
+        fn unknown_dimensions_reserve_the_actual_size_within_the_budget() {
+            let (l, p) = (Rc::new(DecodedLedger::default()), Rc::new(Probe::default()));
+            let lease = decode(&l, &p, None, (64, 32), 0).unwrap();
+            assert_eq!((lease.bytes(), l.stats().unique_bytes), (8192, 8192));
+            assert!(clean(&l));
+            drop(lease);
+            assert_eq!(p.disposed.get(), 1);
+        }
+
+        #[test]
+        fn unknown_dimensions_budget_refusal_allocates_nothing() {
+            let (l, p) = (Rc::new(DecodedLedger::default()), Rc::new(Probe::default()));
+            let committed = LIMIT - 1024; // nonresident bytes already charged elsewhere
+            let result = decode(&l, &p, None, (32, 16), committed);
+            assert_eq!(result.err(), Some(DecodedRefusal::Reserve("refused")));
+            assert_eq!((p.allocated.get(), l.stats().refused), (0, 1));
+            assert!(clean(&l) && l.stats().unique_bytes == 0);
