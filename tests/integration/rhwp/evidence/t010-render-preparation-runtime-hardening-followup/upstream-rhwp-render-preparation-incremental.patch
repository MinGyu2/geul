+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Outcome {
+    Complete,
+    Pending,
+    ResourceLimit,
+    Canceled,
+    Error,
+}
+impl Outcome {
+    /// The first terminal reason is authoritative. Cleanup must run separately.
+    pub fn record(&mut self, next: Self) {
+        if *self == Self::Pending {
+            *self = next;
+        }
+    }
+
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Complete => "COMPLETE",
+            Self::Pending => "PENDING",
+            Self::ResourceLimit => "RESOURCE_LIMIT",
+            Self::Canceled => "CANCELED",
+            Self::Error => "ERROR",
+        }
+    }
+}

