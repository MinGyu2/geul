+//! Canvas 렌더러의 전역 이미지 캐시 수명 정책.
+//!
+//! `web_canvas.rs`의 `IMAGE_CACHE`(브라우저가 디코드하는 `HtmlImageElement`)와 `DECODED_CANVAS_CACHE`
+//! (Rust가 디코드해 그린 detached `HtmlCanvasElement`)는 WASM 스레드 전역이고 문서와 수명이 다르다.
+//! 같은 그림 바이트를 쓰는 여러 문서가 한 항목을 함께 쓰므로(내용 주소), 문서 하나를 닫는다고 항목을 지울
+//! 근거가 없다. 그래서 문서별 해제 대신 전역 예산을 둔다.
+//!
+//! 비용(`bytes`)의 뜻: 디코드한 Canvas는 `너비 × 높이 × 4`(RGBA backing store **추정**), 브라우저 이미지는
+//! data URL 길이(로드 전) 또는 data URL 길이 + 자연 크기의 RGBA 추정(로드 뒤), 실패를 기억하는 음성 항목은
+//! [`NEGATIVE_ENTRY_BYTES`]다. 브라우저가 실제로 잡는 메모리(디코드 사본·GPU 사본·data URL 문자열)나 프로세스
+//! RSS의 상한이 아니다 — 캐시가 붙잡아 GC가 놓지 못하게 하는 양의 추정이다.
+//!
+//! Resident accounting never exceeds bytes/entries. Pending admission can fail; the caller must
+//! release a rejected value. Completion either becomes resident or transfers an explicit ready
+//! lease to the caller. trim/budget reduction may cancel pending values; late callbacks are ignored.
+//! Active DOM resources use reference-counted leases: Release must not invalidate another owner.
+
+use std::cell::Cell;
+use std::collections::HashMap;
+use std::rc::{Rc, Weak};
+
+/// 디코드 실패를 기억하는 음성 항목의 계상 비용(바이트). 음성 항목도 항목 수 한도와 LRU를 따른다.
+pub const NEGATIVE_ENTRY_BYTES: usize = 64;
+/// 기본 예산: 디코드한 Canvas 합계 256 MiB(RGBA 약 67 Mpx), 브라우저 이미지 합계 64 MiB, 각 256개.
+/// 실측 작업 집합(이미지가 많은 23쪽 문서 하나에 약 380 MB)보다 작다 — 입장 제한이 그 차이에서의 동작을 정한다.
+pub const DEFAULT_DECODED_BYTES: usize = 256 << 20;
+pub const DEFAULT_IMAGE_BYTES: usize = 64 << 20;
+pub const DEFAULT_MAX_ENTRIES: usize = 256;
+/// 요청 횟수 상한(포화). 작게 두어 오래 쓴 항목도 aging 몇 번이면 새 항목과 겨룰 수 있다.
+const MAX_FREQUENCY: u8 = 15;
+
+/// 그림 바이트의 내용 주소.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct ImageKey {
+    fnv: u64,
+    mix: u64,
+    len: usize,
+}
+
+impl ImageKey {
+    pub fn of(data: &[u8]) -> Self {
+        // 전체 바이트의 FNV-1a 64(기존 키)에 길이와, 고르게 고른 바이트 64개의 두 번째 해시를 더한다.
+        // 그리기마다 계산하므로 전체 바이트를 두 번 훑지 않는다.
+        let mut fnv: u64 = 0xcbf2_9ce4_8422_2325;
+        for &b in data {
+            fnv ^= b as u64;
+            fnv = fnv.wrapping_mul(0x0000_0100_0000_01b3);
+        }
+        let mut mix: u64 = 0x9e37_79b9_7f4a_7c15;
+        if !data.is_empty() {
+            for i in 0..64usize {
+                let b = data[i * (data.len() - 1) / 63];
+                mix = (mix ^ b as u64)
+                    .wrapping_mul(0xff51_afd7_ed55_8ccd)
+                    .rotate_left(29);
+            }
+        }
+        Self {
+            fnv,
+            mix,
+            len: data.len(),
+        }
+    }
+}
+
+/// 내보낸 값을 놓는 방법(Canvas: 크기 0, 이미지: 로드 알림 해제 후 src 비움). 시험에서는 기록만 한다.
+pub trait Release {
+    fn release(&self);
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct CacheStats {
+    pub entries: usize,
+    pub negative_entries: usize,
+    pub pending_entries: usize,
+    pub transient_entries: usize,
+    pub bytes: usize,
+    pub max_bytes: usize,
+    pub max_entries: usize,
+    pub max_entry_bytes: usize,
+    pub hits: u64,
+    pub misses: u64,
+    pub evictions: u64,
+    /// 한 항목 한도를 넘어 보관하지 않았거나(디코드 Canvas) 일시 항목이 된(브라우저 이미지) 횟수.
+    pub oversize: u64,
+    /// 입장 제한으로 들이지 않은 횟수(그 값은 호출자가 그리고 놓았다).
+    pub rejected: u64,
+}
+
+struct Entry<V> {
+    value: Option<V>,
+    bytes: usize,
+    used: u64,
+    pending: bool,
+    transient: bool,
+}
+
+pub struct BoundedCache<V: Release> {
+    entries: HashMap<ImageKey, Entry<V>>,
+    bytes: usize,
+    max_bytes: usize,
+    max_entries: usize,
+    max_entry_bytes: usize,
+    tick: u64,
+    stats: CacheStats,
+    admission: bool,
+    frequency: HashMap<ImageKey, u8>,
+    since_aging: usize,
+}
+
+impl<V: Release + Clone> BoundedCache<V> {
+    /// `max_entry_bytes`는 예산의 1/4: 큰 그림 하나가 다른 모든 항목을 밀어내지 않게 한다.
+    /// `admission`이면 위의 입장 제한을 쓴다.
+    pub fn new(max_bytes: usize, max_entries: usize, admission: bool) -> Self {
+        Self {
+            entries: HashMap::new(),
+            bytes: 0,
+            max_bytes,
+            max_entries,
+            max_entry_bytes: max_bytes / 4,
+            tick: 0,
+            stats: CacheStats::default(),
+            admission,
+            frequency: HashMap::new(),
+            since_aging: 0,
+        }
+    }
+
+    /// 있으면 `Some(값 또는 음성)`. 쓴 시각과 요청 횟수를 갱신한다. 로드 중인 값도 돌려준다(그릴 수 있는지는
+    /// 호출자가 본다).
+    pub fn get(&mut self, key: &ImageKey) -> Option<Option<V>> {
+        self.tick += 1;
+        self.count_request(key);
+        match self.entries.get_mut(key) {
+            Some(entry) => {
+                entry.used = self.tick;
+                self.stats.hits += 1;
+                Some(entry.value.clone())
+            }
+            None => {
+                self.stats.misses += 1;
+                None
+            }
+        }
+    }
+
+    /// Look up without changing LRU, frequency or hit statistics.
+    pub fn peek(&self, key: &ImageKey) -> Option<Option<&V>> {
+        self.entries.get(key).map(|e| e.value.as_ref())
+    }
+
+    /// 넣는다. 보관했으면 true. 너무 크거나 입장 제한에 걸려 보관하지 않으면 false — 값은 호출자 것이다(그린 뒤
+    /// 놓는다). 음성 항목은 늘 들인다(작고, 실패한 디코드를 되풀이하지 않게 한다).
+    pub fn insert(&mut self, key: ImageKey, value: Option<V>, bytes: usize) -> bool {
+        let negative = value.is_none();
+        let bytes = if negative {
+            NEGATIVE_ENTRY_BYTES
+        } else {
+            bytes
+        };
+        self.remove(&key);
+        if bytes > self.max_bytes
+            || self.max_entries == 0
+            || (!negative && bytes > self.max_entry_bytes)
+        {
+            self.stats.oversize += 1;
+            return false;
+        }
+        if !negative && self.admission && !self.admits(&key, bytes) {
+            self.stats.rejected += 1;
+            return false;
+        }
+        self.make_room(bytes, 1);
+        if !self.fits(bytes, 1) {
+            return false;
+        }
+        self.put(key, value, bytes, false);
+        true
+    }
+
+    /// Reserve before browser allocation. Rejected values remain caller-owned.
+    pub fn can_insert_pending(&self, bytes: usize) -> bool {
+        bytes <= self.max_bytes
+            && self.max_entries > 0
+            && self
+                .entries
+                .values()
+                .filter(|e| e.pending)
+                .map(|e| e.bytes)
+                .sum::<usize>()
+                .saturating_add(bytes)
+                <= self.max_bytes
+            && self.entries.values().filter(|e| e.pending).count() < self.max_entries
+    }
+
+    pub fn insert_pending(&mut self, key: ImageKey, value: V, bytes: usize) -> bool {
+        if self.entries.contains_key(&key) || !self.can_insert_pending(bytes) {
+            return false;
+        }
+        self.make_room(bytes, 1);
+        if !self.fits(bytes, 1) {
+            return false;
+        }
+        self.put(key, Some(value), bytes, true);
+        true
+    }
+
+    /// `is_value`가 가리키는 값을 가진 로드 중 항목의 키. 로드 이벤트가 어느 항목의 것인지 찾는다
+    /// (내보냈거나 바뀐 값의 늦은 이벤트면 `None`).
+    pub fn pending_key(&self, is_value: impl Fn(&V) -> bool) -> Option<ImageKey> {
+        self.entries
+            .iter()
+            .find(|(_, e)| e.pending && e.value.as_ref().is_some_and(&is_value))
+            .map(|(k, _)| *k)
+    }
+
+    /// Complete a reservation. Oversize resources transfer to a caller-owned ready lease;
+    /// they never evict useful residents to obtain residency. Caller must release that lease.
+    pub fn loaded(&mut self, key: &ImageKey, decoded_bytes: usize) -> Option<(V, usize)> {
+        let entry = self.entries.get(key)?;
+        if !entry.pending {
+            return None;
+        }
+        let bytes = entry.bytes.saturating_add(decoded_bytes);
+        let other_pending = self
+            .entries
+            .iter()
+            .filter(|(k, e)| **k != *key && e.pending)
+            .map(|(_, e)| e.bytes)
+            .sum::<usize>();
+        if bytes > self.max_entry_bytes || other_pending.saturating_add(bytes) > self.max_bytes {
+            let mut entry = self.entries.remove(key)?;
+            self.bytes -= entry.bytes;
+            self.stats.oversize += 1;
+            return entry.value.take().map(|v| (v, bytes));
+        }
+        let entry = self.entries.get_mut(key)?;
+        entry.pending = false;
+        self.bytes = self.bytes - entry.bytes + bytes;
+        entry.bytes = bytes;
+        self.make_room_except(0, 0, Some(*key));
+        None
+    }
+
+    /// 로드 중이던 항목의 로드가 실패했다: 음성 항목으로 바꾼다(같은 바이트로 다시 로드하지 않음).
+    pub fn failed(&mut self, key: &ImageKey) {
+        if self.entries.get(key).is_some_and(|e| e.pending) {
+            self.remove(key);
+            self.insert(*key, None, NEGATIVE_ENTRY_BYTES);
+        }
+    }
+
+    /// Reduce retained accounting to target_bytes, including cancellation of pending entries.
+    /// A zero target releases every cache-owned reference; other Rc owners remain valid.
+    pub fn trim(&mut self, target_bytes: usize) {
+        while self.bytes > target_bytes || (target_bytes == 0 && !self.entries.is_empty()) {
+            if !self.evict_any() {
+                break;
+            }
+        }
+    }
+
+    /// 예산을 바꾼다. 줄이면 바로 맞춘다.
+    pub fn set_budget(&mut self, max_bytes: usize, max_entries: usize) {
+        self.max_bytes = max_bytes;
+        self.max_entries = max_entries;
+        self.max_entry_bytes = max_bytes / 4;
+        let oversize: Vec<ImageKey> = self
+            .entries
+            .iter()
+            .filter(|(_, e)| {
+                !e.pending && !e.transient && e.value.is_some() && e.bytes > self.max_entry_bytes
+            })
+            .map(|(k, _)| *k)
+            .collect();
+        for key in oversize {
+            self.evict(&key);
+        }
+        while !self.fits(0, 0) {
+            if !self.evict_any() {
+                break;
+            }
+        }
+        self.frequency.retain(|k, _| self.entries.contains_key(k));
+    }
+
+    pub fn stats(&self) -> CacheStats {
+        CacheStats {
+            entries: self.entries.len(),
+            negative_entries: self.entries.values().filter(|e| e.value.is_none()).count(),
+            pending_entries: self.entries.values().filter(|e| e.pending).count(),
+            transient_entries: self.entries.values().filter(|e| e.transient).count(),
+            bytes: self.bytes,
+            max_bytes: self.max_bytes,
+            max_entries: self.max_entries,
+            max_entry_bytes: self.max_entry_bytes,
+            ..self.stats
+        }
+    }
+
+    fn put(&mut self, key: ImageKey, value: Option<V>, bytes: usize, pending: bool) {
+        self.tick += 1;
+        self.bytes += bytes;
+        self.entries.insert(
+            key,
+            Entry {
+                value,
+                bytes,
+                used: self.tick,
+                pending,
+                transient: false,
+            },
+        );
+    }
+
+    /// 요청 횟수를 센다. 요청이 (보관 항목 수의 4배, 최소 64)번 쌓이면 모든 횟수를 반으로 줄인다. 셈표 크기는
+    /// 항목 수 한도의 4배로 묶는다(넘으면 바로 줄이고, 그래도 넘으면 보관하지 않은 키의 횟수를 버린다).
+    fn count_request(&mut self, key: &ImageKey) {
+        if !self.admission {
+            return;
+        }
+        self.since_aging += 1;
+        if self.since_aging >= 4 * self.entries.len().max(16) {
+            self.age();
+        }
+        let count = self.frequency.entry(*key).or_insert(0);
+        *count = count.saturating_add(1).min(MAX_FREQUENCY);
+        if self.frequency.len() > 4 * self.max_entries {
+            self.age();
+            if self.frequency.len() > 4 * self.max_entries {
+                let entries = &self.entries;
+                self.frequency.retain(|k, _| entries.contains_key(k));
+            }
+        }
+    }
+
+    fn age(&mut self) {
+        self.since_aging = 0;
+        self.frequency.retain(|_, count| {
+            *count /= 2;
+            *count > 0
+        });
+    }
+
+    /// 입장 제한: `bytes`를 넣으려고 내보내야 할 항목(일시 항목·오래된 순) 모두보다 새 키의 요청이 많은가.
+    /// 내보낼 것이 없으면(자리가 있음) 들인다.
+    fn admits(&self, key: &ImageKey, bytes: usize) -> bool {
+        let candidate = self.frequency.get(key).copied().unwrap_or(0);
+        let mut victims: Vec<(&ImageKey, &Entry<V>)> =
+            self.entries.iter().filter(|(_, e)| !e.pending).collect();
+        victims.sort_by_key(|(_, e)| (!e.transient, e.used));
+        let (mut total, mut count) = (self.bytes, self.entries.len());
+        for (victim, entry) in victims {
+            if total + bytes <= self.max_bytes && count < self.max_entries {
+                return true;
+            }
+            if !entry.transient && self.frequency.get(victim).copied().unwrap_or(0) >= candidate {
+                return false;
+            }
+            total -= entry.bytes;
+            count -= 1;
+        }
+        true
+    }
+
+    fn fits(&self, bytes: usize, count: usize) -> bool {
+        self.bytes.saturating_add(bytes) <= self.max_bytes
+            && self.entries.len().saturating_add(count) <= self.max_entries
+    }
+
+    /// Count reclaimable resident ownership without cloning values or changing LRU.
+    pub fn resident_capacity_where(&self, eligible: impl Fn(&V) -> bool) -> (usize, usize) {
+        self.entries
+            .values()
+            .filter(|e| !e.pending && e.value.as_ref().is_some_and(&eligible))
+            .fold((0, 0usize), |(count, bytes), e| {
+                (count + 1, bytes.saturating_add(e.bytes))
+            })
+    }
+
+    /// Remove one least-recently-used eligible resident. The predicate must not clone
+    /// ownership while deciding eligibility; pending entries are never selected.
+    pub fn evict_resident_where(&mut self, eligible: impl Fn(&V) -> bool) -> bool {
+        let key = self
+            .entries
+            .iter()
+            .filter(|(_, e)| !e.pending && e.value.as_ref().is_some_and(&eligible))
+            .min_by_key(|(_, e)| e.used)
+            .map(|(k, _)| *k);
+        if let Some(key) = key {
+            self.evict(&key);
+            true
+        } else {
+            false
+        }
+    }
+
+    fn evict_any(&mut self) -> bool {
+        let key = self
+            .entries
+            .iter()
+            .min_by_key(|(_, e)| (e.pending, e.used))
+            .map(|(k, _)| *k);
+        if let Some(key) = key {
+            self.evict(&key);
+            true
+        } else {
+            false
+        }
+    }
+
+    fn make_room(&mut self, bytes: usize, count: usize) {
+        self.make_room_except(bytes, count, None);
+    }
+
+    /// 로드 중 항목과 `keep`을 빼고, 일시 항목·오래된 것부터 내보내 `bytes`·`count`가 들어갈 자리를 만든다.
+    fn make_room_except(&mut self, bytes: usize, count: usize, keep: Option<ImageKey>) {
+        while !self.fits(bytes, count) {
+            if !self.evict_victim(keep) {
+                break;
+            }
+        }
+    }
+
+    fn evict_victim(&mut self, keep: Option<ImageKey>) -> bool {
+        let Some(key) = self
+            .entries
+            .iter()
+            .filter(|(k, e)| !e.pending && Some(**k) != keep)
+            .min_by_key(|(_, e)| (!e.transient, e.used))
+            .map(|(k, _)| *k)
+        else {
+            return false;
+        };
+        self.evict(&key);
+        true
+    }
+
+    fn evict(&mut self, key: &ImageKey) {
+        if self.remove(key) {
+            self.stats.evictions += 1;
+        }
+    }
+
+    fn remove(&mut self, key: &ImageKey) -> bool {
+        let Some(entry) = self.entries.remove(key) else {
+            return false;
+        };
+        self.bytes -= entry.bytes;
+        if let Some(value) = entry.value {
+            value.release();
+        }
+        true
+    }
+}
+
+/// Disposal of one uniquely owned decoded backing (Canvas: width/height 0).
+pub trait Backing {
+    fn dispose(&self);
+}
+
+/// Unique decoded-backing ledger. Bytes are RGBA backing *estimates*, never RSS/GPU memory.
+/// One [`SharedBacking`] is one allocation however many cache/job `Rc` references point to it;
+/// references are not bytes. Reservation precedes allocation; the last owner's drop disposes
+/// the backing and releases its charge exactly once.
+#[derive(Default)]
+pub struct DecodedLedger {
+    unique_bytes: Cell<usize>,
+    unique_count: Cell<usize>,
+    reserved_bytes: Cell<usize>,
+    peak_bytes: Cell<usize>,
+    created: Cell<u64>,
+    disposed: Cell<u64>,
+    refused: Cell<u64>,
+    over_limit: Cell<u64>,
+    accounting_errors: Cell<u64>,
+    rejected_commits: Cell<u64>,
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct LedgerStats {
+    pub unique_bytes: usize,
+    pub unique_count: usize,
+    pub reserved_bytes: usize,
+    /// Peak of unique + reserved estimated bytes.
+    pub peak_bytes: usize,
+    pub created: u64,
+    pub disposed: u64,
+    /// Enforced reservations refused before allocation.
+    pub refused: u64,
+    /// Unenforced (legacy synchronous) reservations admitted above the limit; explicit, not silent.
+    pub over_limit: u64,
+    /// Checked arithmetic that would have overflowed/underflowed (must stay 0).
+    pub accounting_errors: u64,
+    /// Commits refused after allocation (actual above the reservation, or overflow); each
+    /// rejected backing was disposed once and never returned as a lease.
+    pub rejected_commits: u64,
+}
+
+impl DecodedLedger {
+    pub fn stats(&self) -> LedgerStats {
+        LedgerStats {
+            unique_bytes: self.unique_bytes.get(),
+            unique_count: self.unique_count.get(),
+            reserved_bytes: self.reserved_bytes.get(),
+            peak_bytes: self.peak_bytes.get(),
+            created: self.created.get(),
+            disposed: self.disposed.get(),
+            refused: self.refused.get(),
+            over_limit: self.over_limit.get(),
+            accounting_errors: self.accounting_errors.get(),
+            rejected_commits: self.rejected_commits.get(),
+        }
+    }
+
+    fn add(&self, cell: &Cell<usize>, bytes: usize) -> bool {
+        match cell.get().checked_add(bytes) {
+            Some(v) => {
+                cell.set(v);
+                true
+            }
+            None => {
+                self.accounting_errors.set(self.accounting_errors.get() + 1);
+                false
+            }
+        }
+    }
+
+    fn sub(&self, cell: &Cell<usize>, bytes: usize) {
+        match cell.get().checked_sub(bytes) {
+            Some(v) => cell.set(v),
+            None => {
+                self.accounting_errors.set(self.accounting_errors.get() + 1);
+                cell.set(0);
+            }
+        }
+    }
+
+    fn note_peak(&self) {
+        let total = self
+            .unique_bytes
+            .get()
+            .saturating_add(self.reserved_bytes.get());
+        self.peak_bytes.set(self.peak_bytes.get().max(total));
+    }
+
+    /// Reserve `bytes` before allocating when `committed + reserved + bytes <= limit`, where
+    /// `committed` is the caller's charge already counted against the same limit. Checked
+    /// arithmetic; overflow never fits. `enforce == false` admits but counts `over_limit`.
+    pub fn reserve(
+        self: &Rc<Self>,
+        bytes: usize,
+        committed: usize,
+        limit: usize,
+        enforce: bool,
+    ) -> Option<Reservation> {
+        let fits = committed
+            .checked_add(self.reserved_bytes.get())
+            .and_then(|v| v.checked_add(bytes))
+            .is_some_and(|total| total <= limit);
+        if !fits {
+            if enforce {
+                self.refused.set(self.refused.get() + 1);
+                return None;
+            }
+            self.over_limit.set(self.over_limit.get() + 1);
+        }
+        if !self.add(&self.reserved_bytes, bytes) {
+            return None;
+        }
+        self.note_peak();
+        Some(Reservation {
+            ledger: self.clone(),
+            bytes,
+        })
+    }
+}
+
+/// Pending allocation charge. Dropping it without commit (error/refusal) releases the bytes.
+pub struct Reservation {
+    ledger: Rc<DecodedLedger>,
+    bytes: usize,
+}
+
+impl Reservation {
+    pub fn bytes(&self) -> usize {
+        self.bytes
+    }
+
+    /// Check an allocation size before allocating its backing (refusal before allocation). The
+    /// same rule is enforced again by [`Self::commit`] after allocation.
+    pub fn authorizes(&self, actual: usize) -> Result<(), CommitError> {
+        if actual > self.bytes {
+            return Err(CommitError::ExceedsReservation {
+                reserved: self.bytes,
+                actual,
+            });
+        }
+        let ledger = &self.ledger;
+        if ledger.unique_bytes.get().checked_add(actual).is_none()
+            || ledger.unique_count.get().checked_add(1).is_none()
+        {
+            return Err(CommitError::Overflow);
+        }
+        Ok(())
+    }
+
+    /// Convert the reservation into one unique backing charged `actual` bytes. `actual` must fit
+    /// the reserved capacity (a smaller allocation is charged its actual size); a larger one needs
+    /// its own reservation. On refusal the already allocated backing is disposed exactly once,
+    /// the reservation is released and no lease exists.
+    pub fn commit<B: Backing>(
+        mut self,
+        backing: B,
+        actual: usize,
+    ) -> Result<Rc<SharedBacking<B>>, CommitError> {
+        let ledger = self.ledger.clone();
+        let unique_bytes = ledger.unique_bytes.get().checked_add(actual);
+        let unique_count = ledger.unique_count.get().checked_add(1);
+        let refusal = if actual > self.bytes {
+            Some(CommitError::ExceedsReservation {
+                reserved: self.bytes,
+                actual,
+            })
+        } else if unique_bytes.is_none() || unique_count.is_none() {
+            ledger
+                .accounting_errors
+                .set(ledger.accounting_errors.get() + 1);
+            Some(CommitError::Overflow)
+        } else {
+            None
+        };
+        if let Some(error) = refusal {
+            ledger
+                .rejected_commits
+                .set(ledger.rejected_commits.get() + 1);
+            backing.dispose();
+            // Dropping `self` releases the reserved bytes.
+            return Err(error);
+        }
+        ledger.sub(&ledger.reserved_bytes, self.bytes);
+        self.bytes = 0;
+        ledger.unique_bytes.set(unique_bytes.unwrap_or_default());
+        ledger.unique_count.set(unique_count.unwrap_or_default());
+        ledger.created.set(ledger.created.get() + 1);
+        ledger.note_peak();
+        Ok(Rc::new(SharedBacking {
+            backing,
+            bytes: actual,
+            ledger,
+            disposed: Cell::new(false),
+        }))
+    }
+}
+
+/// Why [`Reservation::commit`] refused; the rejected backing has already been disposed once.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CommitError {
+    /// The actual allocation is larger than the reservation authorized.
+    ExceedsReservation { reserved: usize, actual: usize },
+    /// Charging the allocation would overflow the ledger.
+    Overflow,
+}
+
+impl Drop for Reservation {
+    fn drop(&mut self) {
+        if self.bytes > 0 {
+            self.ledger.sub(&self.ledger.reserved_bytes, self.bytes);
+        }
+    }
+}
+
+/// One decoded allocation shared by cache and job `Rc` owners. `Release` (cache eviction) only
+/// drops the cache reference; the backing is disposed when the last `Rc` drops.
+pub struct SharedBacking<B: Backing> {
+    backing: B,
+    bytes: usize,
+    ledger: Rc<DecodedLedger>,
+    disposed: Cell<bool>,
+}
+
+impl<B: Backing> SharedBacking<B> {
+    pub fn backing(&self) -> &B {
+        &self.backing
+    }
+    pub fn bytes(&self) -> usize {
+        self.bytes
+    }
+}
+
+impl<B: Backing> Drop for SharedBacking<B> {
+    fn drop(&mut self) {
+        if self.disposed.replace(true) {
+            return;
+        }
+        self.backing.dispose();
+        self.ledger.sub(&self.ledger.unique_bytes, self.bytes);
+        let count = self.ledger.unique_count.get();
+        if count == 0 {
+            self.ledger
+                .accounting_errors
+                .set(self.ledger.accounting_errors.get() + 1);
+        } else {
+            self.ledger.unique_count.set(count - 1);
+        }
+        self.ledger.disposed.set(self.ledger.disposed.get() + 1);
+    }
+}
+
+impl<B: Backing> Release for Rc<SharedBacking<B>> {
+    fn release(&self) {}
+}
+
+/// RGBA backing store 추정(오버플로는 포화).
+pub fn rgba_bytes(width: u32, height: u32) -> usize {
+    (width as usize)
+        .saturating_mul(height as usize)
+        .saturating_mul(4)
+}
+
+/// Retain `lease` in one owner's lease map unless that map already holds `max` other keys.
+/// Bounds lease metadata independently of bytes. A refused lease is only not retained by this
+/// owner: the caller's own `Rc` stays valid for its use, and a later lookup re-resolves the key.
+pub fn insert_lease_bounded<V>(
+    map: &mut HashMap<ImageKey, V>,
+    key: ImageKey,
+    lease: V,
+    max: usize,
+) -> bool {
+    if !map.contains_key(&key) && map.len() >= max {
+        return false;
+    }
+    map.insert(key, lease);
+    true
+}
+
+/// Drop lookup entries whose backing has already been disposed.
+pub fn prune_dead_leases<B: Backing>(registry: &mut HashMap<ImageKey, Weak<SharedBacking<B>>>) {
+    registry.retain(|_, w| w.strong_count() > 0);
+}
