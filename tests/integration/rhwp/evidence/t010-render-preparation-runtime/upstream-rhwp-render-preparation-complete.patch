+impl PageLayerTree {
+    /// Resolved binary payload this tree owns: arena payloads plus image node bytes,
+    /// converted/baked image payloads and raw SVG strings. Text, geometry and maps are
+    /// excluded, so this is a lower bound of tree memory, not a whole-tree bound.
+    pub fn payload_estimate(&self) -> ResourcePayloadEstimate {
+        fn walk(node: &LayerNode, estimate: &mut ResourcePayloadEstimate) {
+            match &node.kind {
+                LayerNodeKind::Group { children, .. } => {
+                    children.iter().for_each(|child| walk(child, estimate))
+                }
+                LayerNodeKind::ClipRect { child, .. } => walk(child, estimate),
+                LayerNodeKind::Leaf { ops } => {
+                    for op in ops {
+                        match op {
+                            PaintOp::Image {
+                                image, resolved, ..
+                            } => {
+                                let bytes = image.data.as_ref().map_or(0, Vec::capacity)
+                                    + resolved.as_ref().map_or(0, |r| r.data.capacity());
+                                estimate.image_bytes = estimate.image_bytes.saturating_add(bytes);
+                            }
+                            PaintOp::RawSvg { raw, .. } => {
+                                estimate.svg_bytes =
+                                    estimate.svg_bytes.saturating_add(raw.svg.capacity());
+                            }
+                            _ => {}
+                        }
+                    }
+                }
+            }
+        }
+        let mut estimate = self.resources.payload_estimate();
+        walk(&self.root, &mut estimate);
+        estimate
+    }
