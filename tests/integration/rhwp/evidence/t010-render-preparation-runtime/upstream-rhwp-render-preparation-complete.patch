+/// 브라우저가 디코드할 그림을 찾거나 로드를 시작한다. `Ok(Some)`이면 지금 그릴 수 있다. `Ok(None)`이면 로드 중이거나
+/// 실패를 기억한 그림이다(로드 중이면 끝날 때 알림이 온다 — 새 이미지를 만들어 앞 로드를 취소하지 않는다).
+/// `Err`는 이미지 요소를 만들지 못한 경우다(호출자가 자리 표시를 그린다). 그리기는 받은 handle을 바로 쓴다:
+/// 이 함수가 돌려준 뒤에는 그리기가 끝날 때까지 캐시를 바꾸지 않는다.
+/// The very same resolver feeds preparation and replay. Recipe memo keys only
+/// avoid repeating transforms; drawable identity is always ImageKey::of(bytes).
+#[cfg(target_arch = "wasm32")]
+enum CanvasPayload<'a> {
+    Borrowed(&'a [u8]),
+    Owned(Vec<u8>),
+    Memo(std::rc::Rc<super::render_job::ResolvedPayload>, &'a [u8]),
+}
+#[cfg(target_arch = "wasm32")]
+impl AsRef<[u8]> for CanvasPayload<'_> {
+    fn as_ref(&self) -> &[u8] {
+        match self {
+            Self::Borrowed(v) => v,
+            Self::Owned(v) => v,
+            Self::Memo(v, original) => v.data.as_deref().unwrap_or(original),
+        }
+    }
+}
+#[cfg(target_arch = "wasm32")]
+fn canvas_image_payload(data: &[u8], operation: u8) -> (CanvasPayload<'_>, bool) {
+    use super::render_job::{self, RecipeKey};
+    if operation == 0 {
+        return (CanvasPayload::Borrowed(data), false);
+    }
+    let key = RecipeKey {
+        source: ImageKey::of(data),
+        operation,
+        geometry: [0; 4],
+    };
+    if let Some(v) = render_job::memo(key) {
+        let baked = v.baked;
+        return (CanvasPayload::Memo(v, data), baked);
+    }
+    super::render_job::note_transform();
+    let result = match operation {
+        1 => super::image_resolver::real_picture_watermark_bytes_to_hancom_tone_png_bytes(data),
+        2 => {
+            super::image_resolver::real_picture_watermark_fill_bytes_to_hancom_tone_png_bytes(data)
+        }
+        3 => super::image_resolver::watermark_jpeg_bytes_to_hancom_baked_png_bytes(data),
+        _ => unreachable!(),
+    };
+    let baked = result.is_some();
+    if render_job::is_preparing() {
+        return match render_job::memoize(key, result, baked) {
+            Some(v) => (CanvasPayload::Memo(v, data), baked),
+            None => (CanvasPayload::Borrowed(data), false),
+        };
+    }
+    (
+        result.map_or(CanvasPayload::Borrowed(data), CanvasPayload::Owned),
+        baked,
+    )
+}
+#[cfg(target_arch = "wasm32")]
+fn canvas_svg_payload<'a>(raw: &'a RawSvgNode, bbox: &BoundingBox) -> Option<CanvasPayload<'a>> {
+    use super::{
+        render_job::{self, RecipeKey},
+        svg_fragment::{
+            decode_base64_data_url, try_parse_single_image_data_url, wrap_svg_fragment,
+        },
+    };
+    let key = RecipeKey {
+        source: ImageKey::of(raw.svg.as_bytes()),
+        operation: 4,
+        geometry: [
+            bbox.x.to_bits(),
+            bbox.y.to_bits(),
+            bbox.width.to_bits(),
+            bbox.height.to_bits(),
+        ],
+    };
+    if let Some(v) = render_job::memo(key) {
+        return v.data.is_some().then_some(CanvasPayload::Memo(v, &[]));
+    }
+    super::render_job::note_transform();
+    let bytes = if let Some(url) = try_parse_single_image_data_url(&raw.svg) {
+        decode_base64_data_url(url).map(|(_, v)| v)
+    } else {
+        Some(wrap_svg_fragment(&raw.svg, bbox.x, bbox.y, bbox.width, bbox.height).into_bytes())
+    };
+    if render_job::is_preparing() {
+        let v = render_job::memoize(key, bytes, false)?;
+        return v.data.is_some().then_some(CanvasPayload::Memo(v, &[]));
+    }
+    bytes.map(CanvasPayload::Owned)
+}
+/// True only for an actually drawable, job-owned resource; never an unleased
+/// cache handle. Does not allocate a target/scratch or run any draw operation.
+#[cfg(target_arch = "wasm32")]
+fn prepare_payload(data: &[u8]) -> bool {
+    use super::render_job;
+    let key = ImageKey::of(data);
+    if render_job::prepared(key) {
+        return true;
+    }
+    if !render_job::key_capacity() {
+        render_job::mark_limit();
+        return false;
+    }
+    if !render_job::browser_owned(key) && decoded_canvas(key, data).is_some() {
+        return render_job::record_prepared(key);
+    }
+    if !render_job::is_preparing() {
+        return false;
+    }
+    match browser_image(key, data) {
+        Ok(Some(_)) => render_job::record_prepared(key),
+        _ => false,
+    }
+}
+#[cfg(target_arch = "wasm32")]
+pub(crate) fn prepare_op(op: &PaintOp) -> bool {
+    match op {
+        PaintOp::Image {
+            image, resolved, ..
+        } => {
+            // Use the existing producer's resolved-payload effects adjustment too.
+            let resolved_image = resolved
+                .as_deref()
+                .map(|v| super::image_resolver::image_node_with_resolved_payload(image, Some(v)));
+            let image = resolved_image.as_ref().unwrap_or(image);
+            if let Some(data) = &image.data {
+                let operation = if image.is_real_picture_watermark_tone_preset() {
+                    2
+                } else if image.is_watermark()
+                    && super::image_resolver::detect_image_mime_type(data) == "image/jpeg"
+                {
+                    3
+                } else {
+                    0
+                };
+                let (payload, _) = canvas_image_payload(data, operation);
+                prepare_payload(payload.as_ref())
+            } else {
+                true
+            }
+        }
+        PaintOp::PageBackground { background, .. } => {
+            if let Some(image) = &background.image {
+                let (payload, _) = canvas_image_payload(
+                    &image.data,
+                    u8::from(image.is_real_picture_watermark_tone_preset()),
+                );
+                prepare_payload(payload.as_ref())
+            } else {
+                true
+            }
+        }
+        PaintOp::RawSvg { raw, bbox } => {
+            canvas_svg_payload(raw, bbox).is_none_or(|p| prepare_payload(p.as_ref()))
+        }
+        // Equation Canvas replay is vector/text, pattern fills use a tiny draw-scoped
+        // tile Canvas: neither requests an independently retained image backing.
+        _ => true,
+    }
+}
