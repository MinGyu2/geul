+/// Owned resolved payload of one arena. Images/SVG by heap capacity; font blobs once per `Arc`
+/// allocation, split by whether another owner (document font table) shares it. Excludes hash
+/// maps, resource keys, layer nodes and text sources: a lower bound, not a whole-tree bound.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct ResourcePayloadEstimate {
+    pub image_bytes: usize,
+    pub svg_bytes: usize,
+    pub exclusive_font_bytes: usize,
+    pub shared_font_bytes: usize,
+}
+
+impl ResourcePayloadEstimate {
+    /// Bytes this arena alone keeps alive (shared Arc payloads excluded to avoid double counting).
+    pub fn owned_bytes(&self) -> usize {
+        self.image_bytes
+            .saturating_add(self.svg_bytes)
+            .saturating_add(self.exclusive_font_bytes)
+    }
+}
+
 impl ResourceArena {
+    pub fn payload_estimate(&self) -> ResourcePayloadEstimate {
+        let mut estimate = ResourcePayloadEstimate {
+            image_bytes: self
+                .image_bytes
+                .iter()
+                .fold(0usize, |n, v| n.saturating_add(v.capacity())),
+            svg_bytes: self
+                .svg_fragments
+                .iter()
+                .fold(0usize, |n, s| n.saturating_add(s.capacity())),
+            ..Default::default()
+        };
+        let mut seen = std::collections::HashSet::new();
+        for blob in &self.font_blob_bytes {
+            if !seen.insert(Arc::as_ptr(blob) as *const u8 as usize) {
+                continue;
+            }
+            if Arc::strong_count(blob) > 1 {
+                estimate.shared_font_bytes = estimate.shared_font_bytes.saturating_add(blob.len());
+            } else {
+                estimate.exclusive_font_bytes =
+                    estimate.exclusive_font_bytes.saturating_add(blob.len());
+            }
+        }
+        estimate
+    }
