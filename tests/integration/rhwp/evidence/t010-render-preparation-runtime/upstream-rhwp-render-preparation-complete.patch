+pub fn request_scale(scale: f64) -> f64 {
+    if scale.is_finite() && scale > 0.0 {
+        scale
+    } else {
+        1.0
+    }
+}
+
+pub struct Preparation {
+    pub tree: PageLayerTree,
+    pub identity: preparation::Identity,
+    pub cursor: preparation::Cursor,
+    // Keeps the reservation alive when taken out of Job during a synchronous poll.
+    pub budget: Rc<preparation::Reservation>,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct RecipeKey {
+    pub source: ImageKey,
+    pub operation: u8,
+    pub geometry: [u64; 4],
+}
+pub struct ResolvedPayload {
+    pub data: Option<Vec<u8>>,
+    pub baked: bool,
+}
+pub fn memo(key: RecipeKey) -> Option<Rc<ResolvedPayload>> {
+    let job = active_job()?;
+    let mut j = job.borrow_mut();
+    let found = j
+        .memos
+        .iter()
+        .find(|(k, _)| *k == key)
+        .map(|(_, v)| v.clone());
+    if found.is_some() {
+        j.memo_hits += 1;
+    }
+    found
+}
+pub fn note_decode() {
+    if let Some(job) = active_job() {
+        let mut j = job.borrow_mut();
+        if j.phase == Phase::Preparing {
+            j.decode_attempts += 1;
+        }
+    }
+}
+pub fn note_transform() {
+    if let Some(job) = active_job() {
+        let mut j = job.borrow_mut();
+        if j.phase == Phase::Preparing {
+            j.transform_attempts += 1;
+        }
+    }
+}
+pub fn memoize(key: RecipeKey, data: Option<Vec<u8>>, baked: bool) -> Option<Rc<ResolvedPayload>> {
+    let job = active_job()?;
+    let mut j = job.borrow_mut();
+    if j.phase != Phase::Preparing {
+        return None;
+    }
+    if j.memos.len() >= preparation::MAX_KEYS
+        || !j.preparation_budget.as_ref()?.grow(
+            data.as_ref().map_or(0, Vec::capacity).checked_add(
+                std::mem::size_of::<ResolvedPayload>() + 2 * std::mem::size_of::<usize>(),
+            )?,
+        )
+    {
+        drop(j);
+        mark_limit();
+        return None;
+    }
+    let value = Rc::new(ResolvedPayload { data, baked });
+    j.memos.push((key, value.clone()));
+    Some(value)
+}
+pub fn is_full_replay() -> bool {
+    active_job().is_some_and(|j| j.borrow().phase == Phase::FullReplay)
+}
+pub fn browser_owned(key: ImageKey) -> bool {
+    active_job().is_some_and(|j| j.borrow().resources.contains_key(&key))
+}
+pub fn key_capacity() -> bool {
+    active_job().is_some_and(|j| j.borrow().prepared_keys.len() < preparation::MAX_KEYS)
+}
+pub fn is_preparing() -> bool {
+    active_job().is_some_and(|j| {
+        j.borrow().phase == Phase::Preparing && j.borrow().state == Outcome::Pending
+    })
+}
+pub fn verify_replay_key(key: ImageKey) -> bool {
+    let okay = active_job().is_none_or(|j| {
+        let j = j.borrow();
+        j.phase != Phase::FullReplay
+            || (j.prepared_keys.contains(&key)
+                && (j.decoded.contains_key(&key)
+                    || j.resources
+                        .get(&key)
+                        .is_some_and(|r| !r.pending.get() && !r.error.get() && !r.limited.get())))
+    });
+    if !okay {
+        mark_error();
+    }
+    okay
+}
+pub fn prepared(key: ImageKey) -> bool {
+    active_job().is_some_and(|j| {
+        let mut j = j.borrow_mut();
+        let found = j.prepared_keys.contains(&key);
+        if found {
+            j.ready_reuses += 1;
+        }
+        found
+    })
+}
+pub fn record_prepared(key: ImageKey) -> bool {
+    let Some(job) = active_job() else {
+        return false;
+    };
+    let mut j = job.borrow_mut();
+    if !j.prepared_keys.contains(&key) {
+        if j.prepared_keys.len() >= preparation::MAX_KEYS {
+            drop(j);
+            mark_limit();
+            return false;
+        }
+        // A decoded resource must really have a job lease, not a cache-only handle.
+        if !j.decoded.contains_key(&key) && !j.resources.contains_key(&key) {
+            drop(j);
+            mark_error();
+            return false;
+        }
+        j.prepared_keys.push(key);
+    }
+    true
+}
+pub fn continue_preparation() {
+    if let Some(job) = active_job() {
+        job.borrow_mut().preparation_yields += 1;
+    }
+    // Exactly one coalesced task, only when a poll made bounded forward progress.
+    // No self-rescheduling loop; an idle host expires on the existing timer.
+    CONTINUATION_READY.with(|v| v.set(true));
+    queue_notification(false, false);
+}
+
+pub struct Job {
+    pub id: u32,
+    pub phase: Phase,
+    pub preparation: Option<Preparation>,
+    pub preparation_budget: Option<Rc<preparation::Reservation>>,
+    pub prepared_keys: Vec<ImageKey>,
+    pub memos: Vec<(RecipeKey, Rc<ResolvedPayload>)>,
+    pub preparation_steps: u64,
+    pub preparation_attempts: u64,
+    pub preparation_ready: u64,
+    pub preparation_yields: u64,
+    pub replay_count: u64,
+    pub decode_attempts: u64,
+    pub transform_attempts: u64,
+    pub ready_reuses: u64,
+    pub memo_hits: u64,
+    pub page: u32,
+    pub replay: Replay,
+    pub scale: f64,
+    pub state: Outcome,
+    pub target: Option<HtmlCanvasElement>,
+    pub resources: HashMap<ImageKey, ImageLease>,
+    /// Decoded leases used by this job; kept across PENDING polls, released by finish/drop.
+    pub decoded: HashMap<ImageKey, DecodedLease>,
+    pub waiting: bool,
+    pub waiting_capacity: Option<usize>,
+    pub deadline: f64,
+    polls: u64,
+}
+impl Job {
+    fn wait_for_capacity(&mut self, required: usize) {
+        self.waiting = true;
+        self.waiting_capacity = Some(
+            self.waiting_capacity
+                .map_or(required, |old| old.min(required)),
+        );
+    }
+    pub fn finish(&mut self, state: Outcome) {
+        if self.state == Outcome::Pending || self.target.is_some() {
+            POOL.with(|p| {
+                let mut p = p.borrow_mut();
+                match state {
+                    Outcome::Canceled => p.cancellations += 1,
+                    Outcome::ResourceLimit => p.limits += 1,
+                    Outcome::Error => p.errors += 1,
+                    _ => {}
+                }
+            });
+        }
+        self.state = state;
+        self.phase = self.phase.finish();
+        self.preparation = None;
+        self.memos = Vec::new();
+        self.prepared_keys = Vec::new();
+        self.preparation_budget = None;
+        // Reconcile the module timer after all mutable job borrows have ended.
+        queue_notification(false, false);
+        let inactive_before =
+            (!self.resources.is_empty()).then(super::web_canvas::inactive_image_capacity);
+        self.resources = HashMap::new();
+        // Releases job references only; cache/shared owners keep their backing.
+        self.decoded = HashMap::new();
+        prune_decoded_registry();
+        self.target = None;
+        // A resident cache Rc may outlive the last job lease, so resource Drop
+        // alone cannot observe newly reclaimable capacity. Defer the check until
+        // all job/cache borrows and temporary leases have left this operation.
+        // Resource Drop handles destroyed resources; only a changed cache-only
+        // capacity needs this extra check. Shared-owner release changes neither.
+        // flush_notifications rechecks each waiting admission reservation.
+        if inactive_before
+            .is_some_and(|before| super::web_canvas::inactive_image_capacity() != before)
+        {
+            queue_notification(true, false);
+        }
+    }
+}
+#[derive(Default)]
+pub struct Owner {
+    current: RefCell<Option<Rc<RefCell<Job>>>>,
+}
+impl Owner {
+    pub fn invalidate(&self) {
+        self.cancel();
+        self.current.borrow_mut().take();
+    }
+    pub fn cancel(&self) {
+        if let Some(job) = self.current.borrow().as_ref() {
+            let mut job = job.borrow_mut();
+            if job.state == Outcome::Pending {
+                job.finish(Outcome::Canceled);
+            }
+        }
+    }
+    pub fn begin(&self, page: u32, target: &HtmlCanvasElement, scale: f64) -> Result<u32, JsValue> {
+        let id = self.begin_replay(page, target, scale, Replay::Full)?;
+        if PREPARATION_ENABLED.with(Cell::get) {
+            self.get(id).unwrap().borrow_mut().phase = Phase::Preparing;
+        }
+        Ok(id)
+    }
+    pub fn begin_replay(
+        &self,
+        page: u32,
+        target: &HtmlCanvasElement,
+        scale: f64,
+        replay: Replay,
+    ) -> Result<u32, JsValue> {
+        self.cancel();
+        let scale = request_scale(scale);
+        // A new generation targeting the same Canvas immediately releases stale leases,
+        // including a job owned by another live document.
+        let previous = POOL.with(|p| p.borrow().jobs.clone());
+        for previous in previous.into_iter().filter_map(|j| j.upgrade()) {
+            let mut previous = previous.borrow_mut();
+            if previous.state == Outcome::Pending && previous.target.as_ref() == Some(target) {
+                previous.finish(Outcome::Canceled);
+            }
+        }
+
+        let id = POOL
+            .with(|p| {
+                let mut p = p.borrow_mut();
+                p.jobs.retain(|j| {
+                    j.upgrade()
+                        .is_some_and(|j| j.borrow().state == Outcome::Pending)
+                });
+                if p.jobs.len() >= MAX_JOBS {
+                    p.limits += 1;
+                    return None;
+                }
+                p.sequence = p.sequence.checked_add(1)?;
+                Some(p.sequence)
+            })
+            .ok_or_else(|| JsValue::from_str("RESOURCE_LIMIT: job capacity"))?;
+        js_sys::Reflect::set(target, &TARGET_TOKEN.into(), &JsValue::from(id))?;
+        let job = Rc::new(RefCell::new(Job {
+            id,
+            phase: Phase::Compatibility,
+            preparation: None,
+            preparation_budget: None,
+            prepared_keys: Vec::new(),
+            memos: Vec::new(),
+            preparation_steps: 0,
+            preparation_attempts: 0,
+            preparation_ready: 0,
+            preparation_yields: 0,
+            replay_count: 0,
+            decode_attempts: 0,
+            transform_attempts: 0,
+            ready_reuses: 0,
+            memo_hits: 0,
+            page,
+            replay,
+            scale,
+            state: Outcome::Pending,
+            target: Some(target.clone()),
+            resources: HashMap::new(),
+            decoded: HashMap::new(),
+            waiting: false,
+            waiting_capacity: None,
+            polls: 0,
+            deadline: js_sys::Date::now() + DEADLINE_MS,
+        }));
+        POOL.with(|p| p.borrow_mut().jobs.push(Rc::downgrade(&job)));
+        *self.current.borrow_mut() = Some(job);
+        ensure_timer()?;
+        Ok(id)
+    }
+    pub fn compatible(
+        &self,
+        page: u32,
+        target: &HtmlCanvasElement,
+        scale: f64,
+        replay: &Replay,
+    ) -> Option<u32> {
+        self.current.borrow().as_ref().and_then(|j| {
+            let j = j.borrow();
+            let same_target = js_sys::Reflect::get(target, &TARGET_TOKEN.into())
+                .ok()
+                .and_then(|v| v.as_f64())
+                == Some(j.id as f64);
+            (matches!(
+                j.state,
+                Outcome::Pending | Outcome::Error | Outcome::ResourceLimit
+            ) && j.page == page
+                && j.scale == request_scale(scale)
+                && &j.replay == replay
+                && same_target)
+                .then_some(j.id)
+        })
+    }
+    pub fn current_id(&self) -> Option<u32> {
+        self.current.borrow().as_ref().map(|j| j.borrow().id)
+    }
+    pub fn get(&self, id: u32) -> Option<Rc<RefCell<Job>>> {
+        self.current
+            .borrow()
+            .as_ref()
+            .filter(|j| j.borrow().id == id)
+            .cloned()
+    }
+}
+impl Drop for Owner {
+    fn drop(&mut self) {
+        self.cancel();
+    }
+}
+
+#[derive(Default)]
+struct Pool {
+    sequence: u32,
+    jobs: Vec<Weak<RefCell<Job>>>,
+    resources: HashMap<ImageKey, Weak<ImageResource>>,
+    /// Lookup only: a Weak never keeps a decoded backing alive.
+    decoded: HashMap<ImageKey, Weak<SharedBacking<HtmlCanvasElement>>>,
+    decoded_revocations: u64,
+    decoded_shared_hits: u64,
+    decoded_attach_refusals: u64,
+    loads: u64,
+    notifications: u64,
+    cancellations: u64,
+    limits: u64,
+    errors: u64,
+    retries: u64,
+    capacity_notifications: u64,
+    listener_notifications: u64,
+    preparation_notifications: u64,
+}
+thread_local! {
+    static PREPARATION_ENABLED: Cell<bool> = const {Cell::new(false)};
+    static POOL: RefCell<Pool> = RefCell::new(Pool::default());
+    static ACTIVE: RefCell<Option<Rc<RefCell<Job>>>> = const { RefCell::new(None) };
+    static EVENT: JsValue = Closure::<dyn FnMut(JsValue)>::new(image_event).into_js_value();
+    static FRAME_BYTES: Cell<usize> = const { Cell::new(0) };
+    static BACKUP_BYTES: Cell<usize> = const { Cell::new(0) };
+    static BACKUP_PEAK: Cell<usize> = const { Cell::new(0) };
+    static STAGING_PEAK: Cell<usize> = const { Cell::new(0) };
+    static FRAME_PEAK: Cell<usize> = const { Cell::new(0) };
+    static TIMER: Cell<Option<i32>> = const { Cell::new(None) };
+    static TIMER_STARTS: Cell<u64> = const { Cell::new(0) };
+    static TIMER_TICKS: Cell<u64> = const { Cell::new(0) };
+    static NOTIFY_QUEUED: Cell<bool> = const { Cell::new(false) };
+    static CAPACITY_RELEASED: Cell<bool> = const { Cell::new(false) };
+    static CONTINUATION_READY:Cell<bool> = const {Cell::new(false)};
+    static COMPLETION_READY: Cell<bool> = const { Cell::new(false) };
+    static NOTIFY: JsValue = Closure::<dyn FnMut()>::new(flush_notifications).into_js_value();
+    static TICK: JsValue = Closure::<dyn FnMut()>::new(timer_tick).into_js_value();
+}
+
+// Drops may run inside a mutable cache/job borrow. Never invoke JS listeners there.
+// One event-loop task observes the final ownership state of the whole operation.
+fn queue_notification(capacity: bool, completion: bool) {
+    if capacity {
+        CAPACITY_RELEASED.with(|v| v.set(true));
+    }
+    if completion {
+        COMPLETION_READY.with(|v| v.set(true));
+    }
+    if NOTIFY_QUEUED.with(|v| v.replace(true)) {
+        return;
+    }
+    let queued = NOTIFY.with(|callback| {
+        web_sys::window().is_some_and(|w| {
+            w.set_timeout_with_callback_and_timeout_and_arguments_0(callback.unchecked_ref(), 0)
+                .is_ok()
+        })
+    });
+    if !queued {
+        NOTIFY_QUEUED.with(|v| v.set(false));
+    }
+}
+fn flush_notifications() {
+    sync_timer();
+    NOTIFY_QUEUED.with(|v| v.set(false));
+    let capacity = CAPACITY_RELEASED.with(|v| v.replace(false));
+    let completion = COMPLETION_READY.with(|v| v.replace(false));
+    let waiting: Vec<_> = POOL.with(|p| {
+        p.borrow()
+            .jobs
+            .iter()
+            .filter_map(Weak::upgrade)
+            .filter_map(|j| {
+                let j = j.borrow();
+                if j.state == Outcome::Pending {
+                    j.waiting_capacity
+                } else {
+                    None
+                }
+            })
+            .collect()
+    });
+    // Released slots may already have been consumed before this task runs. A
+    // shared-owner cancellation or a stale release must not advertise full slots.
+    let available = if capacity && !waiting.is_empty() {
+        let (count, bytes, pending) = POOL.with(|p| {
+            let resources: Vec<_> = p
+                .borrow()
+                .resources
+                .values()
+                .filter_map(Weak::upgrade)
+                .collect();
+            (
+                resources.len(),
+                resources.iter().map(|r| r.bytes.get()).sum::<usize>(),
+                resources.iter().filter(|r| r.pending.get()).count(),
+            )
+        });
+        let (reclaim_count, reclaim_bytes) = super::web_canvas::inactive_image_capacity();
+        pending < MAX_PENDING
+            && count.saturating_sub(reclaim_count) < MAX_RESOURCES
+            && waiting.iter().any(|required| {
+                bytes
+                    .saturating_sub(reclaim_bytes)
+                    .saturating_add(*required)
+                    <= MAX_OWNED_BYTES
+            })
+    } else {
+        false
+    };
+    let continuation = CONTINUATION_READY.with(|v| v.replace(false))
+        && POOL.with(|p| {
+            p.borrow().jobs.iter().filter_map(Weak::upgrade).any(|j| {
+                let j = j.borrow();
+                j.state == Outcome::Pending
+                    && !j.waiting
+                    && matches!(j.phase, Phase::Preparing | Phase::ResourcesReady)
+            })
+        });
+    if completion || available || continuation {
+        POOL.with(|p| {
+            let mut p = p.borrow_mut();
+            p.listener_notifications += 1;
+            if continuation {
+                p.preparation_notifications += 1;
+            }
+            if available {
+                p.capacity_notifications += 1;
+            }
+        });
+        super::web_canvas::notify_image_listener();
+    }
+}
+
+// Snapshot accounting borrows are dropped before cache reclamation, so temporary
+// upgraded Weak references cannot accidentally make an inactive resident ineligible.
+fn admission(required: usize, current_id: u32) -> u8 {
+    loop {
+        let (count, bytes, pending) = POOL.with(|p| {
+            let mut p = p.borrow_mut();
+            p.resources.retain(|_, r| r.strong_count() > 0);
+            let resources: Vec<_> = p.resources.values().filter_map(Weak::upgrade).collect();
+            (
+                resources.len(),
+                resources.iter().map(|r| r.bytes.get()).sum::<usize>(),
+                resources.iter().filter(|r| r.pending.get()).count(),
+            )
+        });
+        if pending >= MAX_PENDING {
+            return 1;
+        }
+        if count < MAX_RESOURCES && bytes.saturating_add(required) <= MAX_OWNED_BYTES {
+            return 0;
+        }
+        if super::web_canvas::reclaim_inactive_image() {
+            continue;
+        }
+        let other_owner = POOL.with(|p| {
+            p.borrow().jobs.iter().filter_map(Weak::upgrade).any(|j| {
+                let j = j.borrow();
+                j.id != current_id && j.state == Outcome::Pending && !j.resources.is_empty()
+            })
+        });
+        return if pending > 0 || other_owner { 1 } else { 2 };
+    }
+}
+
+fn has_pending_jobs() -> bool {
+    POOL.with(|p| {
+        p.borrow()
+            .jobs
+            .iter()
+            .filter_map(Weak::upgrade)
+            .any(|j| j.borrow().state == Outcome::Pending)
+    })
+}
+fn ensure_timer() -> Result<(), JsValue> {
+    if TIMER.with(Cell::get).is_some() || !has_pending_jobs() {
+        return Ok(());
+    }
+    let id = TICK.with(|tick| {
+        web_sys::window()
+            .ok_or_else(|| JsValue::from_str("ERROR: no window"))?
+            .set_timeout_with_callback_and_timeout_and_arguments_0(tick.unchecked_ref(), 250)
+    })?;
+    TIMER.with(|t| t.set(Some(id)));
+    TIMER_STARTS.with(|n| n.set(n.get() + 1));
+    Ok(())
+}
+fn sync_timer() {
+    if has_pending_jobs() {
+        let _ = ensure_timer();
+    } else if let Some(id) = TIMER.with(|t| t.replace(None)) {
+        if let Some(window) = web_sys::window() {
+            window.clear_timeout_with_handle(id);
+        }
+    }
+}
+fn timer_tick() {
+    TIMER.with(|t| t.set(None));
+    TIMER_TICKS.with(|n| n.set(n.get() + 1));
+    expire();
+    sync_timer();
+}
+fn expire() {
+    let mut changed = false;
+    let jobs = POOL.with(|p| p.borrow().jobs.clone());
+    for job in jobs.into_iter().filter_map(|j| j.upgrade()) {
+        let mut job = job.borrow_mut();
+        if job.state == Outcome::Pending && js_sys::Date::now() >= job.deadline {
+            job.finish(Outcome::Error);
+            changed = true;
+        }
+    }
+    if changed {
+        queue_notification(false, true);
+    }
+    POOL.with(|p| p.borrow_mut().resources.retain(|_, r| r.strong_count() > 0));
+}
+/// Explicit experimental gate. Switching mode cancels all owned generations;
+/// old callers retain their exact compatibility behavior without migration.
+pub fn set_preparation_enabled(enabled: bool) {
+    if PREPARATION_ENABLED.with(|v| v.replace(enabled)) != enabled {
+        invalidate_all();
+    }
+}
+pub fn invalidate_all() {
+    let mut changed = false;
+    let jobs = POOL.with(|p| p.borrow().jobs.clone());
+    for job in jobs.into_iter().filter_map(|j| j.upgrade()) {
+        let mut job = job.borrow_mut();
+        if job.state == Outcome::Pending {
+            job.finish(Outcome::Canceled);
+            changed = true;
+        }
+    }
+    if changed {
+        queue_notification(false, true);
+    }
+}
