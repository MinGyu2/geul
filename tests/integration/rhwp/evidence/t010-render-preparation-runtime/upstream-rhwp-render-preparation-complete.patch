+//! Experimental, module-bounded asynchronous Canvas jobs. No callback paints.
+//! A job borrows document sources only during poll; waiting jobs retain keys/DOM leases,
+//! never document bytes or deferred data URLs. Host polls after coalesced notifications.
+use super::preparation::{self, Phase};
+use super::surface_cache::{
+    insert_lease_bounded, prune_dead_leases, rgba_bytes, ImageKey, Release, SharedBacking,
+};
+use crate::paint::layer_tree::PageLayerTree;
+use std::{
+    cell::{Cell, RefCell},
+    collections::HashMap,
+    rc::{Rc, Weak},
+};
+use wasm_bindgen::{prelude::*, JsCast};
+use web_sys::{HtmlCanvasElement, HtmlImageElement};
+
+const MAX_JOBS: usize = 8;
+const MAX_RESOURCES: usize = 256;
+const MAX_PENDING: usize = 2;
+const MAX_URL_BYTES: usize = 32 << 20;
+const MAX_DECODED_BYTES: usize = 96 << 20;
+/// Decoded backings not owned by the resident cache (job-held or synchronous temporaries) share
+/// the existing single-decode bound. Resident bytes stay under the decoded cache budget, so the
+/// unique decoded estimate stays <= decoded cache budget + this value (the pre-lease peak bound).
+pub const MAX_NONRESIDENT_DECODED_BYTES: usize = MAX_DECODED_BYTES;
+/// Distinct decoded leases one job retains across PENDING polls, independent of bytes (tiny images
+/// cost little RGBA but one map entry each). Equal to the decoded cache's own entry bound: a job
+/// never keeps more distinct decoded backings alive than the cache could hold resident. With
+/// MAX_JOBS this bounds job lease metadata to 2048 entries; beyond it a draw uses its draw-scoped
+/// lease without retaining it, and a later poll re-resolves the key (no visual change).
+pub const MAX_JOB_DECODED_LEASES: usize = super::surface_cache::DEFAULT_MAX_ENTRIES;
+const MAX_OWNED_BYTES: usize = 256 << 20;
+pub const MAX_FRAME_BYTES: usize = 64 << 20;
+const DEADLINE_MS: f64 = 15_000.0;
+const TARGET_TOKEN: &str = "__rhwpExperimentalRenderJob";
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Outcome {
+    Complete,
+    Pending,
+    ResourceLimit,
+    Canceled,
+    Error,
+}
+impl Outcome {
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Complete => "COMPLETE",
+            Self::Pending => "PENDING",
+            Self::ResourceLimit => "RESOURCE_LIMIT",
+            Self::Canceled => "CANCELED",
+            Self::Error => "ERROR",
+        }
+    }
+}
+
+pub struct ImageResource {
+    pub image: HtmlImageElement,
+    bytes: Cell<usize>,
+    url_bytes: usize,
+    pending: Cell<bool>,
+    error: Cell<bool>,
+    limited: Cell<bool>,
+}
+impl Drop for ImageResource {
+    fn drop(&mut self) {
+        let _ = js_sys::Reflect::set(&self.image, &"onload".into(), &JsValue::NULL);
+        let _ = js_sys::Reflect::set(&self.image, &"onerror".into(), &JsValue::NULL);
+        self.image.set_src("");
+        queue_notification(true, false);
+    }
+}
+// Cache eviction drops only its Rc. Other jobs' leases keep the DOM object valid.
+impl Release for Rc<ImageResource> {
+    fn release(&self) {}
+}
+pub type ImageLease = Rc<ImageResource>;
+/// Rust-decoded Canvas backing; cache and jobs own separate `Rc` references to one allocation.
+pub type DecodedLease = Rc<SharedBacking<HtmlCanvasElement>>;
+
+/// Bounded replay metadata only; no document bytes, trees or extra Canvas retained.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Replay {
+    Full,
+    Filtered {
+        layer: String,
+        profile: String,
+    },
+    Legacy,
+    HeaderFooter {
+        section: u32,
+        header: bool,
