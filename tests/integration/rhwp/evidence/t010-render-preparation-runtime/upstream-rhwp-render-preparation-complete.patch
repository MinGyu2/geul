+#[cfg(target_arch = "wasm32")]
+enum DecodeReservation {
+    Reserved(super::surface_cache::Reservation),
+    Refused,
+    Oversize,
+    UnknownDimensions,
+}
+
+/// Reserve the Canvas backing before any decode allocation when the header gives dimensions,
+/// which are returned with the reservation as the image's declared size.
+#[cfg(target_arch = "wasm32")]
+fn reserve_decode(data: &[u8]) -> (Option<(u32, u32)>, DecodeReservation) {
+    let header = super::canvas_rgba::header_dimensions(data);
+    let reservation = match header {
+        Some((w, h)) => reserve_decoded_bytes(rgba_bytes(w, h)),
+        None => DecodeReservation::UnknownDimensions,
+    };
+    (header, reservation)
+}
+
+/// Reserve `bytes` of decoded backing. Job decodes are enforced against the nonresident bound
+/// after revoking other non-drawn job leases; synchronous legacy decodes keep their pre-lease
+/// behaviour and record an explicit over-limit instead.
+#[cfg(target_arch = "wasm32")]
+fn reserve_decoded_bytes(bytes: usize) -> DecodeReservation {
+    let active = super::render_job::active();
+    if active && bytes > 96 << 20 {
+        return DecodeReservation::Oversize;
+    }
+    let limit = super::render_job::MAX_NONRESIDENT_DECODED_BYTES;
+    if decoded_nonresident().saturating_add(bytes) > limit {
+        super::render_job::revoke_decoded(
+            limit.saturating_sub(bytes),
+            None,
+            decoded_nonresident,
+            decoded_is_resident,
+        );
+    }
+    match DECODED_LEDGER.with(|l| l.reserve(bytes, decoded_nonresident(), limit, active)) {
+        Some(r) => DecodeReservation::Reserved(r),
+        None => DecodeReservation::Refused,
+    }
+}
