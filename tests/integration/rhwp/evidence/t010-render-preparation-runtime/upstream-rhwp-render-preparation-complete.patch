+pub struct ActiveGuard;
+pub fn enter(job: Rc<RefCell<Job>>) -> ActiveGuard {
+    ACTIVE.with(|a| {
+        assert!(a.borrow().is_none());
+        *a.borrow_mut() = Some(job);
+    });
+    ActiveGuard
+}
+impl Drop for ActiveGuard {
+    fn drop(&mut self) {
+        ACTIVE.with(|a| a.borrow_mut().take());
+    }
+}
+pub fn active() -> bool {
+    ACTIVE.with(|a| a.borrow().is_some())
+}
+pub fn mark_error() {
+    ACTIVE.with(|a| {
+        if let Some(j) = a.borrow().as_ref() {
+            j.borrow_mut().state = Outcome::Error;
+        }
+    });
+}
+pub fn mark_limit() {
+    ACTIVE.with(|a| {
+        if let Some(j) = a.borrow().as_ref() {
+            j.borrow_mut().state = Outcome::ResourceLimit;
+        }
+    });
+}
+
+fn active_job() -> Option<Rc<RefCell<Job>>> {
+    ACTIVE.with(|a| a.borrow().clone())
+}
+/// The active job's own lease for `key`, if any.
+pub fn job_decoded(key: ImageKey) -> Option<DecodedLease> {
+    active_job().and_then(|j| j.borrow().decoded.get(&key).cloned())
+}
+/// A live backing owned by another job (evicted but still leased); upgrading is draw-scoped
+/// unless attached to the active job.
+pub fn shared_decoded(key: ImageKey) -> Option<DecodedLease> {
+    let lease = POOL.with(|p| p.borrow().decoded.get(&key).and_then(Weak::upgrade));
+    if lease.is_some() {
+        POOL.with(|p| p.borrow_mut().decoded_shared_hits += 1);
+    }
+    lease
+}
+pub fn register_decoded(key: ImageKey, lease: &DecodedLease) {
+    POOL.with(|p| {
+        let mut p = p.borrow_mut();
+        prune_dead_leases(&mut p.decoded);
+        p.decoded.insert(key, Rc::downgrade(lease));
+    });
+}
+/// Remove registry entries of disposed backings (terminal cleanup; registry <= live + 1).
+pub fn prune_decoded_registry() {
+    POOL.with(|p| prune_dead_leases(&mut p.borrow_mut().decoded));
+}
+/// Give the active pending job its own reference, up to MAX_JOB_DECODED_LEASES keys. Without an
+/// active job, or when the job's map is full, the caller's draw-scoped `Rc` is the only extra
+/// owner and drops after the synchronous draw.
+pub fn attach_decoded(key: ImageKey, lease: &DecodedLease) {
+    if let Some(job) = active_job() {
+        let mut job = job.borrow_mut();
+        if job.state == Outcome::Pending
+            && !insert_lease_bounded(&mut job.decoded, key, lease.clone(), MAX_JOB_DECODED_LEASES)
+        {
+            POOL.with(|p| p.borrow_mut().decoded_attach_refusals += 1);
+        }
+    }
+}
+/// Job-held decoded leases as (holder is active, key, lease) without touching cache order.
+fn decoded_holders() -> Vec<(bool, ImageKey, DecodedLease)> {
+    let active = active_job();
+    let jobs = POOL.with(|p| p.borrow().jobs.clone());
+    let mut out = Vec::new();
+    for job in jobs.into_iter().filter_map(|j| j.upgrade()) {
+        let is_active = active.as_ref().is_some_and(|a| Rc::ptr_eq(a, &job));
+        for (key, lease) in &job.borrow().decoded {
+            out.push((is_active, *key, lease.clone()));
+        }
+    }
+    out
+}
+/// Revoke job-held nonresident decoded leases until `nonresident()` <= `limit`: waiting jobs
+/// first, then the active job's earlier leases, never `keep` (the lease being drawn). A revoked
+/// lease is removed from every job map, so no job keeps a handle whose backing is disposed;
+/// each later draw re-resolves by key. Shared/resident backings are not disposed by this.
+pub fn revoke_decoded(
+    limit: usize,
+    keep: Option<&DecodedLease>,
+    nonresident: impl Fn() -> usize,
+    resident: impl Fn(ImageKey, &DecodedLease) -> bool,
+) {
+    if nonresident() <= limit {
+        return;
+    }
+    let mut candidates: Vec<(bool, ImageKey, DecodedLease)> = Vec::new();
+    // One candidate per backing; indexed by allocation so many entries stay linear.
+    let mut index: HashMap<*const SharedBacking<HtmlCanvasElement>, usize> = HashMap::new();
+    for (is_active, key, lease) in decoded_holders() {
+        if keep.is_some_and(|k| Rc::ptr_eq(k, &lease)) || resident(key, &lease) {
+            continue;
+        }
+        if let Some(&found) = index.get(&Rc::as_ptr(&lease)) {
+            candidates[found].0 |= is_active;
+        } else {
+            index.insert(Rc::as_ptr(&lease), candidates.len());
+            candidates.push((is_active, key, lease));
+        }
+    }
+    // Waiting holders first; within a class the larger backing first (fewest revocations).
+    candidates.sort_by_key(|(is_active, _, lease)| (*is_active, std::cmp::Reverse(lease.bytes())));
+    for (_, _, lease) in candidates {
+        if nonresident() <= limit {
+            break;
+        }
+        let jobs = POOL.with(|p| p.borrow().jobs.clone());
+        for job in jobs.into_iter().filter_map(|j| j.upgrade()) {
+            let mut j = job.borrow_mut();
+            if j.phase != Phase::Compatibility && j.decoded.values().any(|v| Rc::ptr_eq(v, &lease))
+            {
+                j.finish(Outcome::ResourceLimit);
+            } else {
+                j.decoded.retain(|_, l| !Rc::ptr_eq(l, &lease));
+            }
+        }
+        POOL.with(|p| p.borrow_mut().decoded_revocations += 1);
+        drop(lease);
+    }
+}
+/// (job reference count, job reference bytes; duplicates across jobs by design).
+fn decoded_reference_observation() -> (usize, usize) {
+    let jobs = POOL.with(|p| p.borrow().jobs.clone());
+    jobs.into_iter()
+        .filter_map(|j| j.upgrade())
+        .fold((0, 0usize), |(n, b), j| {
+            let j = j.borrow();
+            (
+                n + j.decoded.len(),
+                j.decoded
+                    .values()
+                    .fold(b, |b, l| b.saturating_add(l.bytes())),
+            )
+        })
+}
+
+pub fn image(key: ImageKey, data: &[u8]) -> Result<Option<HtmlImageElement>, Outcome> {
+    let Some(job) = ACTIVE.with(|a| a.borrow().clone()) else {
+        return Err(Outcome::Error);
+    };
+    if job.borrow().state != Outcome::Pending {
+        return Err(Outcome::Error);
+    }
+    let existing = job.borrow().resources.get(&key).cloned();
+    let lease = existing.or_else(|| super::web_canvas::resident_image(key));
+    let lease =
+        lease.or_else(|| POOL.with(|p| p.borrow().resources.get(&key).and_then(Weak::upgrade)));
+    let resource = if let Some(lease) = lease {
+        lease
+    } else {
+        // No URL, converted image bytes, or DOM handle exists before reservation.
+        if data.len() > MAX_URL_BYTES / 2 {
+            mark_limit();
+            return Err(Outcome::Error);
+        }
+        let estimate = data.len().saturating_mul(2).saturating_add(1024);
+        let current_id = job.borrow().id;
+        let decision = admission(estimate.saturating_add(MAX_DECODED_BYTES), current_id);
+        if decision == 1 {
+            job.borrow_mut()
+                .wait_for_capacity(estimate.saturating_add(MAX_DECODED_BYTES));
+            return Ok(None);
+        }
+        if decision == 2 {
+            mark_limit();
+            return Err(Outcome::Error);
+        }
+        // Conversion can expand; bound its output before constructing a DOM image.
+        let url = super::web_canvas::browser_data_url(data);
+        if url.len() > MAX_URL_BYTES {
+            mark_limit();
+            return Err(Outcome::ResourceLimit);
+        }
+        // Conversion may legitimately grow a small WMF/EMF source. Recheck the
+        // actual bounded URL before retaining a browser handle; the estimate is
+        // an admission forecast, not an arbitrary conversion-ratio restriction.
+        match admission(url.len().saturating_add(MAX_DECODED_BYTES), current_id) {
+            0 => {}
+            1 => {
+                // Do not repeat a completed expanding URL conversion while a
+                // retained preparation waits. This path refuses, never loops.
+                if is_preparing() {
+                    mark_limit();
+                    return Err(Outcome::ResourceLimit);
+                }
+                job.borrow_mut()
+                    .wait_for_capacity(url.len().saturating_add(MAX_DECODED_BYTES));
+                return Ok(None);
+            }
+            _ => {
+                mark_limit();
+                return Err(Outcome::ResourceLimit);
+            }
+        }
+        let img = HtmlImageElement::new().map_err(|_| {
+            mark_error();
+            Outcome::Error
+        })?;
+        let resource = Rc::new(ImageResource {
+            image: img,
+            bytes: Cell::new(url.len() + MAX_DECODED_BYTES),
+            url_bytes: url.len(),
+            pending: Cell::new(true),
+            error: Cell::new(false),
+            limited: Cell::new(false),
+        });
+        EVENT.with(|handler| {
+            let _ = js_sys::Reflect::set(&resource.image, &"onload".into(), handler);
+            let _ = js_sys::Reflect::set(&resource.image, &"onerror".into(), handler);
+        });
+        POOL.with(|p| {
+            let mut p = p.borrow_mut();
+            p.loads += 1;
+            p.resources.insert(key, Rc::downgrade(&resource));
+        });
+        resource.image.set_src(&url);
+        // Preserve the no-redundant-notify correction for immediately drawable images.
+        if resource.image.complete() && resource.image.natural_width() > 0 {
+            complete(&resource, true);
+        }
+        resource
+    };
+    job.borrow_mut().resources.insert(key, resource.clone());
+    if resource.limited.get() {
+        mark_limit();
+        return Err(Outcome::Error);
+    }
+    if resource.error.get() {
+        mark_error();
+        return Err(Outcome::Error);
+    }
+    if resource.pending.get() {
+        job.borrow_mut().waiting = true;
+        return Ok(None);
+    }
+    Ok(Some(resource.image.clone()))
+}
+fn complete(resource: &ImageResource, loaded: bool) {
+    if !resource.pending.replace(false) {
+        return;
+    }
+    let _ = js_sys::Reflect::set(&resource.image, &"onload".into(), &JsValue::NULL);
+    let _ = js_sys::Reflect::set(&resource.image, &"onerror".into(), &JsValue::NULL);
+    let decoded = rgba_bytes(
+        resource.image.natural_width(),
+        resource.image.natural_height(),
+    );
+    resource.error.set(!loaded || decoded == 0);
+    resource.limited.set(decoded > MAX_DECODED_BYTES);
+    resource
+        .bytes
+        .set(resource.url_bytes.saturating_add(decoded));
+}
+fn image_event(event: JsValue) {
+    let Ok(target) = js_sys::Reflect::get(&event, &"target".into()) else {
+        return;
+    };
+    let resource = POOL.with(|p| {
+        p.borrow()
+            .resources
+            .values()
+            .filter_map(Weak::upgrade)
+            .find(|r| AsRef::<JsValue>::as_ref(&r.image) == &target)
+    });
+    let Some(resource) = resource else {
+        return;
+    };
+    if !resource.pending.get() {
+        return;
+    }
+    let loaded = js_sys::Reflect::get(&event, &"type".into())
+        .ok()
+        .and_then(|v| v.as_string())
+        .as_deref()
+        == Some("load");
+    complete(&resource, loaded);
+    // Oversize/failed completions are terminal, not ready leases held until another insertion.
+    if resource.error.get() || resource.limited.get() {
+        let state = if resource.limited.get() {
+            Outcome::ResourceLimit
+        } else {
+            Outcome::Error
+        };
+        let jobs = POOL.with(|p| p.borrow().jobs.clone());
+        for job in jobs.into_iter().filter_map(|j| j.upgrade()) {
+            let mut job = job.borrow_mut();
+            if job.resources.values().any(|r| Rc::ptr_eq(r, &resource)) {
+                job.finish(state);
+            }
+        }
+    }
+    POOL.with(|p| p.borrow_mut().notifications += 1);
+    queue_notification(true, true);
+}
+pub fn polling(job: &mut Job) {
+    if job.polls > 0 {
+        POOL.with(|p| p.borrow_mut().retries += 1);
+    }
+    job.polls += 1;
+}
+pub fn target_current(job: &Job) -> bool {
+    job.target.as_ref().is_some_and(|c| {
+        js_sys::Reflect::get(c, &TARGET_TOKEN.into())
+            .ok()
+            .and_then(|v| v.as_f64())
+            == Some(job.id as f64)
+    })
+}
+pub fn promote(job: &Job) {
+    for (key, resource) in &job.resources {
+        if !resource.pending.get() && !resource.error.get() && !resource.limited.get() {
+            super::web_canvas::cache_resident_image(*key, resource.clone(), resource.bytes.get());
+        }
+    }
+}
+pub fn frame_begin(bytes: usize) {
+    FRAME_BYTES.with(|b| b.set(bytes));
+    FRAME_PEAK.with(|b| b.set(b.get().max(bytes)));
+    STAGING_PEAK.with(|b| b.set(b.get().max(bytes)));
+}
+pub fn backup_begin(bytes: usize) {
+    BACKUP_BYTES.with(|b| b.set(bytes));
+    BACKUP_PEAK.with(|b| b.set(b.get().max(bytes)));
+    let total = bytes.saturating_add(FRAME_BYTES.with(Cell::get));
+    STAGING_PEAK.with(|b| b.set(b.get().max(total)));
+}
+pub fn frame_end() {
+    FRAME_BYTES.with(|b| b.set(0));
+    BACKUP_BYTES.with(|b| b.set(0));
+}
+pub fn stats() -> serde_json::Value {
+    expire();
+    sync_timer();
+    let mut value = POOL.with(|p| {
+        let p = p.borrow();
+        let resources: Vec<_> = p.resources.values().filter_map(Weak::upgrade).collect();
+        let active: Vec<_> = p.jobs.iter().filter_map(Weak::upgrade).flat_map(|j| {
+            j.borrow().resources.values().cloned().collect::<Vec<_>>()
+        }).collect();
+        let pending: Vec<_> = resources.iter().filter(|r| r.pending.get()).collect();
+        serde_json::json!({"expiryTimerActive": TIMER.with(Cell::get).is_some(), "expiryTimerStarts": TIMER_STARTS.with(Cell::get), "expiryTimerTicks": TIMER_TICKS.with(Cell::get), "uniqueResourceCount": resources.len(), "activeLeaseCount": active.len(), "pendingCount": pending.len(), "inFlightEstimatedBytes": pending.iter().map(|r|r.bytes.get()).sum::<usize>(),
+            "readyLeaseCount": active.iter().filter(|r| !r.pending.get()).count(),
+            "activeLeaseEstimatedBytes": active.iter().map(|r| r.bytes.get()).sum::<usize>(),
+            "transientEstimatedBytes": active.iter().filter(|r| !r.pending.get()).map(|r| r.bytes.get()).sum::<usize>(),
+            "ownedEstimatedBytes": resources.iter().map(|r|r.bytes.get()).sum::<usize>(),
+            "maxOwnedBytes": MAX_OWNED_BYTES, "maxPending": MAX_PENDING, "maxResources": MAX_RESOURCES,
+            "maxFrameBytes": MAX_FRAME_BYTES, "temporaryCanvasBytes": FRAME_BYTES.with(Cell::get), "peakTemporaryCanvasBytes": FRAME_PEAK.with(Cell::get),
+            "backupImageDataBytes": BACKUP_BYTES.with(Cell::get), "peakBackupImageDataBytes": BACKUP_PEAK.with(Cell::get),
+            "peakStagingBytes": STAGING_PEAK.with(Cell::get), "maxStagingBytes": MAX_FRAME_BYTES * 2,
+            "loadAttempts": p.loads, "completionNotifications": p.notifications, "cancellations": p.cancellations,
+            "capacityNotifications": p.capacity_notifications, "listenerNotifications": p.listener_notifications, "resourceLimits": p.limits, "errors": p.errors, "retryCount": p.retries,
+            "activeJobs": p.jobs.iter().filter_map(Weak::upgrade).filter(|j|j.borrow().state == Outcome::Pending).count(),
+            "decodedRevocations": p.decoded_revocations, "decodedSharedLookups": p.decoded_shared_hits,
+            "decodedRegistryLive": p.decoded.values().filter(|w| w.strong_count() > 0).count(),
+            "decodedRegistryEntries": p.decoded.len(), "decodedAttachRefusals": p.decoded_attach_refusals,
+            "maxJobDecodedLeases": MAX_JOB_DECODED_LEASES,
+            "maxJobLeaseEntries": p.jobs.iter().filter_map(Weak::upgrade).map(|j| j.borrow().decoded.len()).max().unwrap_or(0)})
+    });
+    let (owned, peak) = preparation::accounting();
+    if let Some(o) = value.as_object_mut() {
+        o.insert("preparation".into(),POOL.with(|p|serde_json::json!({
+            "enabled":PREPARATION_ENABLED.with(Cell::get),"notifications":p.borrow().preparation_notifications,"ownedBytes":owned,"peakBytes":peak,"maxOwnedBytes":preparation::MAX_TOTAL_BYTES,
+            "maxJobBytes":preparation::MAX_JOB_BYTES,"resourceQuantum":preparation::RESOURCE_QUANTUM,"stepQuantum":preparation::STEP_QUANTUM,
+            "jobs":p.borrow().jobs.iter().filter_map(Weak::upgrade).map(|j|{let j=j.borrow();serde_json::json!({"id":j.id,"phase":j.phase.name(),"steps":j.preparation_steps,"attempts":j.preparation_attempts,"readyTransitions":j.preparation_ready,"yields":j.preparation_yields,"replays":j.replay_count,"keys":j.prepared_keys.len(),"decodeAttempts":j.decode_attempts,"transformAttempts":j.transform_attempts,"readyReuses":j.ready_reuses,"memoHits":j.memo_hits,"memoCount":j.memos.len(),"retainedBytes":j.preparation_budget.as_ref().map_or(0,|b|b.bytes())})}).collect::<Vec<_>>()
