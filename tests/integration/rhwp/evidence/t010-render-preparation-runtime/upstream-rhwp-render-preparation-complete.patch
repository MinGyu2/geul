--- /dev/null
+++ b/src/renderer/canvas_rgba.rs
@@ -0,0 +1,424 @@
+//! Exact Canvas preparation for large 8-bit grayscale images.
+//!
+//! image 0.25.10 casts Luma8 through pointwise RGB32F color conversion. Evaluate
+//! that same conversion once for each of the 256 possible channel values rather
+//! than repeating it for every pixel. No hand-written gamma approximation, global
+//! table, retained image, or cache-policy change is involved.
+use image::{DynamicImage, GrayImage, Luma, RgbaImage};
+
+use super::surface_cache::{rgba_bytes, Reservation};
+
+/// Header dimensions through the same format guess and decoder construction that
+/// `image::load_from_memory` uses; `None` when that decoder cannot even be constructed.
+pub(crate) fn header_dimensions(data: &[u8]) -> Option<(u32, u32)> {
+    image::ImageReader::new(std::io::Cursor::new(data))
+        .with_guessed_format()
+        .ok()?
+        .into_dimensions()
+        .ok()
+}
+
+/// Header-declared dimensions that differ from the decoded image.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct DimensionMismatch {
+    pub header: (u32, u32),
+    pub decoded: (u32, u32),
+}
+
+/// Image-data integrity, separate from memory capacity: a decoded image must have exactly the
+/// width and height its header declared. image 0.25.10 builds the buffer from the same decoder's
+/// `dimensions()` and applies no orientation, and `canvas_rgba` keeps them, so any difference is
+/// an inconsistent producer. Equal byte counts are not equal dimensions. `None` (header gave no
+/// dimensions) has nothing authoritative to compare and is left to the post-decode reservation.
+pub(crate) fn check_decoded_dimensions(
+    header: Option<(u32, u32)>,
+    decoded: (u32, u32),
+) -> Result<(), DimensionMismatch> {
+    match header {
+        Some(header) if header != decoded => Err(DimensionMismatch { header, decoded }),
+        _ => Ok(()),
+    }
+}
+
+/// Why a decoded image's Canvas backing was not authorized.
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum DecodedRefusal<E> {
+    /// Header and decoded dimensions differ (integrity error).
+    Mismatch(DimensionMismatch),
+    /// The reservation does not cover the decoded bytes (or the ledger would overflow).
+    Capacity,
+    /// The post-decode reservation was refused.
+    Reserve(E),
+}
+
+/// Authorize a decoded image's Canvas backing before allocating it. With header dimensions the
+/// image must match them exactly and the header reservation must cover its bytes; without them
+/// `reserve` reserves the actual bytes under the normal budget. A refusal drops the reservation.
+pub(crate) fn authorize_decoded<E>(
+    header: Option<((u32, u32), Reservation)>,
+    decoded: (u32, u32),
+    reserve: impl FnOnce(usize) -> Result<Reservation, E>,
+) -> Result<Reservation, DecodedRefusal<E>> {
+    let actual = rgba_bytes(decoded.0, decoded.1);
+    let reservation = match header {
+        Some((dimensions, reservation)) => {
+            check_decoded_dimensions(Some(dimensions), decoded)
+                .map_err(DecodedRefusal::Mismatch)?;
+            reservation
+        }
+        None => reserve(actual).map_err(DecodedRefusal::Reserve)?,
+    };
+    reservation
+        .authorizes(actual)
+        .map_err(|_| DecodedRefusal::Capacity)?;
+    Ok(reservation)
+}
+
+pub(crate) fn canvas_rgba(image: &DynamicImage) -> RgbaImage {
+    if let DynamicImage::ImageLuma8(gray) = image {
+        if gray.as_raw().len() >= 4096 {
+            let color = gray.color_space();
+            let mut ramp = GrayImage::from_fn(256, 1, |x, _| Luma([x as u8]));
+            if ramp.set_color_space(color).is_ok() {
+                let table = DynamicImage::ImageLuma8(ramp).to_rgba8();
+                let mut out = RgbaImage::new(gray.width(), gray.height());
+                if out.set_color_space(color).is_ok() {
+                    for (pixel, value) in out.as_mut().chunks_exact_mut(4).zip(gray.as_raw()) {
+                        let start = usize::from(*value) * 4;
+                        pixel.copy_from_slice(&table.as_raw()[start..start + 4]);
+                    }
+                    return out;
+                }
+            }
+        }
+    }
+    image.to_rgba8()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use image::metadata::Cicp;
+
+    #[test]
+    fn every_luma_value_matches_original_across_chunk_edges_and_color_spaces() {
+        for color in [Cicp::SRGB, Cicp::SRGB_LINEAR, Cicp::DISPLAY_P3] {
+            for (width, height) in [(257, 257), (4097, 1), (1, 4097)] {
+                let mut gray = GrayImage::from_fn(width, height, |x, y| {
+                    Luma([((x * 17 + y * 31) % 256) as u8])
+                });
+                gray.set_color_space(color).unwrap();
+                let input = DynamicImage::ImageLuma8(gray);
+                let expected = input.to_rgba8();
+                let actual = canvas_rgba(&input);
+                assert_eq!(actual.dimensions(), expected.dimensions());
+                assert_eq!(actual.color_space(), expected.color_space());
+                assert_eq!(actual.as_raw(), expected.as_raw());
+            }
+        }
+    }
+
+    fn encoded(image: &DynamicImage, format: image::ImageFormat) -> Vec<u8> {
+        let mut out = std::io::Cursor::new(Vec::new());
+        image.write_to(&mut out, format).unwrap();
+        out.into_inner()
+    }
+
+    /// Preflight/decode agreement for one input: a successful decode always had header
+    /// dimensions equal to the Canvas it produces, so the UnknownDimensions path cannot reach
+    /// a successful decode and a header reservation always covers the actual backing.
+    fn assert_preflight_agrees(data: &[u8]) -> (bool, bool) {
+        let header = header_dimensions(data);
+        let decoded = image::load_from_memory(data).ok();
+        if let Some(image) = &decoded {
+            let rgba = canvas_rgba(image);
+            assert_eq!(
+                header,
+                Some(rgba.dimensions()),
+                "decoded without matching header"
+            );
+        }
+        (header.is_some(), decoded.is_some())
+    }
+
+    fn corpus() -> Vec<Vec<u8>> {
+        let gray = DynamicImage::ImageLuma8(GrayImage::from_fn(97, 61, |x, y| {
+            Luma([((x * 7 + y * 13) % 256) as u8])
+        }));
+        let rgba = DynamicImage::ImageRgba8(RgbaImage::from_fn(13, 9, |x, y| {
+            image::Rgba([x as u8 * 19, y as u8 * 23, 77, 200])
+        }));
+        let rgb = DynamicImage::ImageRgb8(rgba.to_rgb8());
+        vec![
+            encoded(&gray, image::ImageFormat::Png),
+            encoded(&rgba, image::ImageFormat::Png),
+            encoded(&rgb, image::ImageFormat::Jpeg),
+            encoded(&gray, image::ImageFormat::Jpeg),
+            encoded(&rgba, image::ImageFormat::Bmp),
+            encoded(&rgb, image::ImageFormat::Tiff),
+            encoded(&gray, image::ImageFormat::Tiff),
+        ]
+    }
+
+    #[test]
+    fn valid_supported_images_have_exact_header_dimensions() {
+        for data in corpus() {
+            assert_eq!(assert_preflight_agrees(&data), (true, true));
+        }
+    }
+
+    #[test]
+    fn truncated_and_corrupted_images_never_decode_without_header_dimensions() {
+        let mut outcomes = std::collections::BTreeMap::new();
+        for data in corpus() {
+            // Every header byte, then a bounded sample of the body.
+            let step = (data.len() / 256).max(1);
+            let positions: Vec<usize> = (0..data.len().min(128))
+                .chain((128..data.len()).step_by(step))
+                .collect();
+            for &len in &positions {
+                *outcomes
+                    .entry(assert_preflight_agrees(&data[..len]))
+                    .or_insert(0) += 1;
+            }
+            for &at in &positions {
+                for value in [0x00, 0xff, data[at] ^ 0x5a] {
+                    let mut bad = data.clone();
+                    bad[at] = value;
+                    *outcomes.entry(assert_preflight_agrees(&bad)).or_insert(0) += 1;
+                }
+            }
+        }
+        // Header-only failures and header-ok/body-corrupt failures both occur.
+        assert_eq!(outcomes.get(&(false, true)), None);
+        assert!(outcomes.get(&(false, false)).is_some_and(|n| *n > 0));
+        assert!(outcomes.get(&(true, false)).is_some_and(|n| *n > 0));
+    }
+
+    #[test]
+    fn unsupported_and_malformed_inputs_have_no_dimensions_and_do_not_decode() {
+        let svg = b"<svg xmlns='http://www.w3.org/2000/svg' width='8' height='8'/>".to_vec();
+        let gif = b"GIF89a\x08\x00\x08\x00\x00\x00\x00;".to_vec();
+        let webp = b"RIFF\x10\x00\x00\x00WEBPVP8 ".to_vec();
+        let wmf = vec![0xD7, 0xCD, 0xC6, 0x9A, 0, 0, 0, 0];
+        let mut emf = vec![0u8; 64];
+        emf[0] = 1;
+        emf[40..44].copy_from_slice(b" EMF");
+        let png_magic_only = b"\x89PNG\r\n\x1a\n".to_vec();
