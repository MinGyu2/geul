@@ -0,0 +1,718 @@
+//! Bounded retained Canvas Full preparation. Allocation capacities, not RSS.
+//! The Canvas projection retains mandatory text provenance, and drops only
+//! arena/glyph/group data the Canvas path does not consume; it does not
+//! change the document cache or its source tree. Unknown metric snapshots refuse.
+use crate::paint::{
+    layer_tree::{GroupKind, LayerNode, LayerNodeKind, PageLayerTree},
+    paint_op::PaintOp,
+    resources::ResourceArena,
+};
+use std::{cell::Cell, mem::size_of};
+
+pub const MAX_JOB_BYTES: usize = 32 << 20;
+pub const MAX_TOTAL_BYTES: usize = 64 << 20;
+pub const METADATA_BYTES: usize = 128 << 10;
+pub const MAX_DEPTH: usize = 64;
+pub const MAX_NODES: usize = 65_536;
+pub const MAX_KEYS: usize = 256;
+pub const RESOURCE_QUANTUM: usize = 4;
+pub const STEP_QUANTUM: usize = 256;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Phase {
+    Compatibility,
+    Preparing,
+    ResourcesReady,
+    FullReplay,
+    Terminal,
+}
+impl Phase {
+    pub fn ready(self) -> Option<Self> {
+        (self == Self::Preparing).then_some(Self::ResourcesReady)
+    }
+    pub fn replay(self) -> Option<Self> {
+        (self == Self::ResourcesReady).then_some(Self::FullReplay)
+    }
+    pub fn finish(self) -> Self {
+        Self::Terminal
+    }
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Compatibility => "Compatibility",
+            Self::Preparing => "Preparing",
+            Self::ResourcesReady => "ResourcesReady",
+            Self::FullReplay => "FullReplay",
+            Self::Terminal => "Terminal",
+        }
+    }
+}
+thread_local! {
+    static OWNED: Cell<usize> = const { Cell::new(0) };
+    static PEAK: Cell<usize> = const { Cell::new(0) };
+}
+/// One reservation owns the retained tree AND memoized transformed payloads. Rc
+/// sharing this reservation never charges twice. Drop is the final release.
+#[derive(Debug)]
+pub struct Reservation {
+    bytes: Cell<usize>,
+}
+impl Reservation {
+    pub fn new(bytes: usize) -> Option<Self> {
+        let r = Self {
+            bytes: Cell::new(0),
+        };
+        r.grow(bytes).then_some(r)
+    }
+    pub fn grow(&self, additional: usize) -> bool {
+        let Some(job) = self
+            .bytes
+            .get()
+            .checked_add(additional)
+            .filter(|n| *n <= MAX_JOB_BYTES)
+        else {
+            return false;
+        };
+        OWNED.with(|total| {
+            let Some(next) = total
+                .get()
+                .checked_add(additional)
+                .filter(|n| *n <= MAX_TOTAL_BYTES)
+            else {
+                return false;
+            };
+            total.set(next);
+            self.bytes.set(job);
+            PEAK.with(|p| p.set(p.get().max(next)));
+            true
+        })
+    }
+    pub fn bytes(&self) -> usize {
+        self.bytes.get()
+    }
+}
+impl Drop for Reservation {
+    fn drop(&mut self) {
+        OWNED.with(|n| {
+            n.set(
+                n.get()
+                    .checked_sub(self.bytes.get())
+                    .expect("preparation reservation ownership"),
+            )
+        });
+    }
+}
+pub fn accounting() -> (usize, usize) {
+    (OWNED.with(Cell::get), PEAK.with(Cell::get))
+}
+
+struct Counter {
+    bytes: usize,
+    nodes: usize,
+}
+impl Counter {
+    fn add(&mut self, n: usize) -> Option<()> {
+        self.bytes = self.bytes.checked_add(n)?;
+        (self.bytes <= MAX_JOB_BYTES).then_some(())
+    }
+    fn vec<T>(&mut self, v: &Vec<T>) -> Option<()> {
+        self.add(v.capacity().checked_mul(size_of::<T>())?)
+    }
+    fn string(&mut self, s: &String) -> Option<()> {
+        self.add(s.capacity())
+    }
+    fn optional_string(&mut self, s: &Option<String>) -> Option<()> {
+        if let Some(s) = s {
+            self.string(s)?;
+        }
+        Some(())
+    }
+    fn cell(&mut self, c: &Option<super::layout::CellContext>) -> Option<()> {
+        if let Some(c) = c {
+            self.vec(&c.path)?;
+        }
+        Some(())
+    }
+    fn gradient(&mut self, g: &Option<Box<super::GradientFillInfo>>) -> Option<()> {
+        if let Some(g) = g {
+            self.add(size_of::<super::GradientFillInfo>())?;
+            self.vec(&g.colors)?;
+            self.vec(&g.positions)?;
+        }
+        Some(())
+    }
+    fn text(&mut self, r: &super::render_tree::TextRunNode) -> Option<()> {
+        // All remaining fields are inline. Supplemental snapshots own private maps,
+        // possibly font Arcs: refuse instead of using a lower-bound estimate.
+        if r.style.supplemental_metrics.is_some() {
+            return None;
+        }
+        self.string(&r.text)?;
+        self.optional_string(&r.display_text)?;
+        self.cell(&r.cell_context)?;
+        self.string(&r.style.font_family)?;
+        self.optional_string(&r.style.metric_font_family)?;
+        self.vec(&r.style.tab_stops)?;
+        self.vec(&r.style.tab_leaders)?;
+        self.vec(&r.style.inline_tabs)?;
+        if let Some(v) = &r.layout_positions {
+            self.vec(v)?;
+        }
+        if let Some(l) = &r.style.ascii_punct_latin {
+            self.add(size_of::<super::LatinSlotMetrics>())?;
+            self.string(&l.font_family)?;
+            self.optional_string(&l.metric_font_family)?;
+        }
+        Some(())
+    }
+    fn equation(&mut self, b: &super::equation::layout::LayoutBox, depth: usize) -> Option<()> {
+        use super::equation::layout::LayoutKind::*;
+        if depth > MAX_DEPTH {
+            return None;
+        }
+        self.nodes = self.nodes.checked_add(1)?;
+        if self.nodes > MAX_NODES {
+            return None;
+        }
+        match &b.kind {
+            Row(v) => {
+                self.vec(v)?;
+                for b in v {
+                    self.equation(b, depth + 1)?;
+                }
+            }
+            Text(s) | Number(s) | Symbol(s) | MathSymbol(s) | Function(s) => self.string(s)?,
+            Fraction { numer, denom } => {
+                self.box_eq(numer, depth)?;
+                self.box_eq(denom, depth)?;
+            }
+            Atop { top, bottom } => {
+                self.box_eq(top, depth)?;
+                self.box_eq(bottom, depth)?;
+            }
+            Sqrt { index, body } => {
+                if let Some(i) = index {
+                    self.box_eq(i, depth)?;
+                }
+                self.box_eq(body, depth)?;
+            }
+            Superscript { base, sup } => {
+                self.box_eq(base, depth)?;
+                self.box_eq(sup, depth)?;
+            }
+            Subscript { base, sub } => {
+                self.box_eq(base, depth)?;
+                self.box_eq(sub, depth)?;
+            }
+            SubSup { base, sub, sup } => {
+                self.box_eq(base, depth)?;
+                self.box_eq(sub, depth)?;
+                self.box_eq(sup, depth)?;
+            }
+            BigOp { symbol, sub, sup } => {
+                self.string(symbol)?;
+                for v in [sub, sup].into_iter().flatten() {
+                    self.box_eq(v, depth)?;
+                }
+            }
+            Limit { sub, .. } => {
+                if let Some(v) = sub {
+                    self.box_eq(v, depth)?;
+                }
+            }
+            Matrix { cells, .. } => {
+                self.vec(cells)?;
+                for row in cells {
+                    self.vec(row)?;
+                    for v in row {
+                        self.equation(v, depth + 1)?;
+                    }
+                }
+            }
+            Rel { arrow, over, under } => {
+                self.box_eq(arrow, depth)?;
+                self.box_eq(over, depth)?;
+                if let Some(v) = under {
+                    self.box_eq(v, depth)?;
+                }
+            }
+            EqAlign { rows } => {
+                self.vec(rows)?;
+                for (l, r) in rows {
+                    self.equation(l, depth + 1)?;
+                    self.equation(r, depth + 1)?;
+                }
+            }
+            Paren { left, right, body } => {
+                self.string(left)?;
+                self.string(right)?;
+                self.box_eq(body, depth)?;
+            }
+            Decoration { body, .. } | FontStyle { body, .. } => self.box_eq(body, depth)?,
+            Space(_) | Newline | Empty => {}
+        }
+        Some(())
+    }
+    fn box_eq(&mut self, b: &super::equation::layout::LayoutBox, d: usize) -> Option<()> {
+        self.add(size_of::<super::equation::layout::LayoutBox>())?;
+        self.equation(b, d + 1)
+    }
+    fn node(&mut self, n: &mut LayerNode, depth: usize) -> Option<()> {
+        if depth > MAX_DEPTH {
+            return None;
+        }
+        self.nodes = self.nodes.checked_add(1)?;
+        if self.nodes > MAX_NODES {
+            return None;
+        }
+        match &mut n.kind {
+            LayerNodeKind::Group {
+                children,
+                group_kind,
+                ..
+            } => {
+                *group_kind = GroupKind::Generic; // Canvas consumes children/layer/clip only.
+                self.vec(children)?;
+                for c in children {
+                    self.node(c, depth + 1)?;
+                }
+            }
+            LayerNodeKind::ClipRect { child, .. } => {
+                self.add(size_of::<LayerNode>())?;
+                self.node(child, depth + 1)?;
+            }
+            LayerNodeKind::Leaf { ops } => {
+                // Canvas ignores glyph alternatives. Keep all actual Canvas visuals.
+                ops.retain(|op| {
+                    !matches!(op, PaintOp::GlyphRun { .. } | PaintOp::GlyphOutline { .. })
+                });
+                self.vec(ops)?;
+                for op in ops {
+                    self.nodes = self.nodes.checked_add(1)?;
+                    if self.nodes > MAX_NODES {
+                        return None;
+                    }
+                    match op {
+                        PaintOp::TextRun { run, source, .. }
+                        | PaintOp::CharOverlap { run, source, .. }
+                        | PaintOp::TextControlMark { run, source, .. }
+                        | PaintOp::TabLeader { run, source, .. }
+                        | PaintOp::TextDecoration { run, source, .. } => {
+                            if let Some(source) = source {
+                                self.optional_string(&source.stable_source_key)?;
+                            }
+                            self.add(size_of::<super::render_tree::TextRunNode>())?;
+                            self.text(run)?;
+                        }
+                        PaintOp::Image {
+                            image, resolved, ..
+                        } => {
+                            self.add(size_of::<super::render_tree::ImageNode>())?;
+                            if let Some(v) = &image.data {
+                                self.vec(v)?;
+                            }
+                            self.optional_string(&image.external_path)?;
+                            self.cell(&image.cell_context)?;
+                            if let Some(v) = resolved {
+                                self.add(size_of::<crate::paint::paint_op::ResolvedImagePayload>())?;
+                                self.vec(&v.data)?;
+                            }
+                        }
+                        PaintOp::RawSvg { raw, .. } => {
+                            self.add(size_of::<super::render_tree::RawSvgNode>())?;
+                            self.string(&raw.svg)?;
+                            self.cell(&raw.cell_context)?;
+                        }
+                        PaintOp::PageBackground { background, .. } => {
+                            self.add(size_of::<super::render_tree::PageBackgroundNode>())?;
+                            self.gradient(&background.gradient)?;
+                            if let Some(i) = &background.image {
+                                self.vec(&i.data)?;
+                            }
+                        }
+                        PaintOp::Equation { equation, .. } => {
+                            self.add(size_of::<super::render_tree::EquationNode>())?;
+                            self.string(&equation.svg_content)?;
+                            self.string(&equation.color_str)?;
+                            self.string(&equation.script)?;
+                            if let Some(r) = &equation.note_ref {
+                                self.string(&r.kind)?;
+                            }
+                            self.equation(&equation.layout_box, 0)?;
+                        }
+                        PaintOp::Path { path, .. } => {
+                            self.add(size_of::<super::render_tree::PathNode>())?;
+                            self.vec(&path.commands)?;
+                            self.gradient(&path.gradient)?;
+                        }
+                        PaintOp::Rectangle { rect, .. } => {
+                            self.add(size_of::<super::render_tree::RectangleNode>())?;
+                            self.gradient(&rect.gradient)?;
+                        }
+                        PaintOp::Ellipse { ellipse, .. } => {
+                            self.add(size_of::<super::render_tree::EllipseNode>())?;
+                            self.gradient(&ellipse.gradient)?;
+                        }
+                        PaintOp::Line { .. } => {
+                            self.add(size_of::<super::render_tree::LineNode>())?
+                        }
+                        PaintOp::FootnoteMarker { marker, .. } => {
+                            self.add(size_of::<super::render_tree::FootnoteMarkerNode>())?;
+                            self.string(&marker.text)?;
+                            self.string(&marker.font_family)?;
+                        }
+                        PaintOp::FormObject { form, .. } => {
+                            self.add(size_of::<super::render_tree::FormObjectNode>())?;
+                            for s in [
+                                &form.caption,
+                                &form.text,
+                                &form.fore_color,
+                                &form.back_color,
+                                &form.name,
+                                &form.appearance.font_family,
+                            ] {
+                                self.string(s)?;
+                            }
+                            self.optional_string(&form.display_text)?;
+                        }
+                        PaintOp::Placeholder { placeholder, .. } => {
+                            self.add(size_of::<super::render_tree::PlaceholderNode>())?;
+                            self.string(&placeholder.label)?;
+                            self.cell(&placeholder.cell_context)?;
+                        }
+                        PaintOp::ControlLabel { label, .. } => self.string(label)?,
+                        PaintOp::GlyphRun { .. } | PaintOp::GlyphOutline { .. } => unreachable!(),
+                    }
+                }
+            }
+        }
+        Some(())
+    }
+}
+/// Moves/prunes an already owned tree; no second retained tree or copy of its
+/// image payload. Counts all capacities of the supported Canvas projection.
+pub fn canvas_projection(tree: &mut PageLayerTree) -> Option<usize> {
+    tree.resources = ResourceArena::default();
+    let mut c = Counter {
+        bytes: size_of::<PageLayerTree>().checked_add(METADATA_BYTES)?,
+        nodes: 0,
+    };
+    c.vec(&tree.text_sources.entries)?;
+    for entry in &tree.text_sources.entries {
+        c.string(&entry.text)?;
+        c.optional_string(&entry.stable_source_key)?;
+        c.vec(&entry.annotations)?;
+    }
+    c.node(&mut tree.root, 0)?;
+    Some(c.bytes)
+}
+
+/// DFS continuation: path components refer to owned immutable tree nodes. No
+/// document pointers or references escape a poll. Tree depth is admitted first.
+#[derive(Debug, Default)]
+pub struct Cursor {
+    path: Vec<usize>,
+    offsets: Vec<usize>,
+    pub steps: u64,
+    pub resources: u64,
+    pub done: bool,
+}
+impl Cursor {
+    pub fn new() -> Self {
+        Self {
+            path: Vec::with_capacity(MAX_DEPTH),
+            offsets: vec![0],
+            ..Default::default()
+        }
+    }
+    fn node<'a>(&self, tree: &'a PageLayerTree) -> &'a LayerNode {
+        let mut n = &tree.root;
+        for &i in &self.path {
+            n = match &n.kind {
+                LayerNodeKind::Group { children, .. } => &children[i],
+                LayerNodeKind::ClipRect { child, .. } => child,
+                _ => unreachable!(),
+            };
+        }
+        n
+    }
+    /// One bounded cursor step; Some(op) stays current until advance_op.
+    pub fn current<'a>(&mut self, tree: &'a PageLayerTree) -> Option<&'a PaintOp> {
+        if self.done {
+            return None;
+        }
+        let n = self.node(tree);
+        let index = *self.offsets.last().unwrap();
+        self.steps += 1;
+        match &n.kind {
+            LayerNodeKind::Leaf { ops } if index < ops.len() => return Some(&ops[index]),
+            LayerNodeKind::Group { children, .. } if index < children.len() => {
+                *self.offsets.last_mut().unwrap() += 1;
+                self.path.push(index);
+                self.offsets.push(0);
+                return None;
+            }
+            LayerNodeKind::ClipRect { .. } if index == 0 => {
+                *self.offsets.last_mut().unwrap() = 1;
+                self.path.push(0);
+                self.offsets.push(0);
+                return None;
+            }
+            _ => {}
+        }
+        self.offsets.pop();
+        if self.path.pop().is_none() {
+            self.done = true;
+        }
+        None
+    }
+    pub fn advance_op(&mut self) {
+        *self.offsets.last_mut().unwrap() += 1;
+    }
+}
