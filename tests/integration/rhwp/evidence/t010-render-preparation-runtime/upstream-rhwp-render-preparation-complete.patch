+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{
+        paint::{
+            layer_tree::{CacheHint, GroupKind},
+            paint_op::PaintOp,
+        },
+        renderer::render_tree::{BoundingBox, ImageNode, RawSvgNode},
+    };
+    use std::rc::Rc;
+    fn box_() -> BoundingBox {
+        BoundingBox::new(0., 0., 100., 100.)
+    }
+    fn tree(ops: Vec<PaintOp>) -> PageLayerTree {
+        PageLayerTree::new(100., 100., LayerNode::leaf(box_(), None, ops))
+    }
+    #[test]
+    fn phase_order_and_terminal_idempotence() {
+        assert_eq!(Phase::Preparing.ready(), Some(Phase::ResourcesReady));
+        assert_eq!(Phase::ResourcesReady.replay(), Some(Phase::FullReplay));
+        for p in [
+            Phase::Compatibility,
+            Phase::Preparing,
+            Phase::ResourcesReady,
+            Phase::FullReplay,
+            Phase::Terminal,
+        ] {
+            assert_eq!(p.finish().finish(), Phase::Terminal);
+            if p != Phase::Preparing {
+                assert_eq!(p.ready(), None);
+            }
+            if p != Phase::ResourcesReady {
+                assert_eq!(p.replay(), None);
+            }
+        }
+    }
+    #[test]
+    fn reservations_refuse_overflow_and_release_on_last_owner() {
+        let before = accounting().0;
+        assert!(Reservation::new(usize::MAX).is_none());
+        let a = Rc::new(Reservation::new(MAX_JOB_BYTES).unwrap());
+        let alias = a.clone();
+        assert!(!a.grow(1));
+        let b = Reservation::new(MAX_JOB_BYTES).unwrap();
+        assert!(Reservation::new(1).is_none());
+        drop(a);
+        assert_eq!(accounting().0, before + MAX_TOTAL_BYTES);
+        drop(alias);
+        drop(b);
+        assert_eq!(accounting().0, before);
+    }
+    #[test]
+    fn payload_capacity_and_not_just_length_is_charged() {
+        let mut data = Vec::with_capacity(8192);
+        data.push(1);
+        let mut t = tree(vec![PaintOp::image(
+            box_(),
+            ImageNode::new(1, Some(data)),
+            None,
+        )]);
+        let old = t.payload_estimate().owned_bytes();
+        let bytes = canvas_projection(&mut t).unwrap();
+        assert!(bytes >= old + METADATA_BYTES + size_of::<PageLayerTree>());
+        assert_eq!(t.resources.image_count(), 0);
+    }
+    #[test]
+    fn unused_canvas_metadata_is_not_retained() {
+        let mut t = tree(vec![PaintOp::RawSvg {
+            bbox: box_(),
+            raw: Box::new(RawSvgNode::new("<g/>".into())),
+        }]);
+        t.resources.intern_image_bytes(&vec![0; 1 << 20]);
+        let n = canvas_projection(&mut t).unwrap();
+        assert!(n < 1 << 20);
+        assert_eq!(t.resources.image_count(), 0);
+        assert!(t.text_sources.is_empty());
+    }
+    #[test]
+    fn oversize_tree_refuses_before_retention() {
+        let mut t = tree(vec![PaintOp::image(
+            box_(),
+            ImageNode::new(1, Some(Vec::with_capacity(MAX_JOB_BYTES))),
+            None,
+        )]);
+        assert!(canvas_projection(&mut t).is_none());
+    }
+    #[test]
+    fn cursor_resumes_without_restarting_completed_operations() {
+        let mut t = PageLayerTree::new(
+            100.,
+            100.,
+            LayerNode::group(
+                box_(),
+                None,
+                (0..5)
+                    .map(|i| {
+                        LayerNode::leaf(
+                            box_(),
+                            None,
+                            vec![PaintOp::ControlLabel {
+                                bbox: box_(),
+                                label: i.to_string(),
+                            }],
+                        )
+                    })
+                    .collect(),
+                CacheHint::None,
+                GroupKind::Body,
+            ),
+        );
+        canvas_projection(&mut t).unwrap();
+        let mut c = Cursor::new();
+        let mut seen = Vec::new();
+        let mut polls = 0;
+        while !c.done {
+            polls += 1;
+            for _ in 0..3 {
+                if let Some(PaintOp::ControlLabel { label, .. }) = c.current(&t) {
+                    seen.push(label.clone());
+                    c.advance_op();
+                }
+                if c.done {
+                    break;
+                }
+            }
+        }
+        assert!(polls > 1);
+        assert_eq!(seen, vec!["0", "1", "2", "3", "4"]);
+        assert!(c.current(&t).is_none());
+    }
+    #[test]
+    fn pending_operation_stays_current_until_explicit_advance() {
+        let t = tree(vec![PaintOp::ControlLabel {
+            bbox: box_(),
+            label: "pending".into(),
+        }]);
+        let mut c = Cursor::new();
+        let a = c.current(&t).unwrap() as *const _;
+        let b = c.current(&t).unwrap() as *const _;
+        assert_eq!(a, b);
+        c.advance_op();
+        assert!(c.current(&t).is_none());
+        assert!(c.done);
+    }
+    #[test]
+    fn excessive_tree_depth_is_refused() {
+        let mut root = LayerNode::leaf(box_(), None, vec![]);
+        for _ in 0..MAX_DEPTH + 2 {
+            root = LayerNode::clip_rect(
+                box_(),
+                None,
+                box_(),
+                root,
+                crate::paint::layer_tree::ClipKind::Generic,
+            );
+        }
+        assert!(canvas_projection(&mut PageLayerTree::new(100., 100., root)).is_none());
+    }
+    #[test]
+    fn model_output_and_cache_generations_are_distinct_from_target() {
+        let mut d = crate::document_core::DocumentCore::new_empty();
+        let id = d.preparation_identity().unwrap();
+        assert!(d.preparation_matches(&id));
+        d.invalidate_page_tree_cache();
+        assert!(!d.preparation_matches(&id));
+        let id = d.preparation_identity().unwrap();
+        d.show_control_codes = !d.show_control_codes;
+        assert!(!d.preparation_matches(&id));
+        let id = d.preparation_identity().unwrap();
+        d.render_normalization.document_epoch += 1;
+        assert!(!d.preparation_matches(&id));
+        let id = d.preparation_identity().unwrap();
+        d.bin_data_epoch += 1;
+        assert!(!d.preparation_matches(&id));
+        d.preparation_generation.set(Some(u64::MAX));
+        d.invalidate_page_tree_cache();
+        assert!(d.preparation_identity().is_none());
+    }
+}
