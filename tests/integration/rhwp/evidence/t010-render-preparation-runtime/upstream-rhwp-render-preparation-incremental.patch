+pub fn verify_replay_key(key: ImageKey) -> bool {
+    let okay = active_job().is_none_or(|j| {
+        let j = j.borrow();
+        j.phase != Phase::FullReplay
+            || (j.prepared_keys.contains(&key)
+                && (j.decoded.contains_key(&key)
+                    || j.resources
+                        .get(&key)
+                        .is_some_and(|r| !r.pending.get() && !r.error.get() && !r.limited.get())))
+    });
+    if !okay {
+        mark_error();
+    }
+    okay
+}
+pub fn prepared(key: ImageKey) -> bool {
+    active_job().is_some_and(|j| {
+        let mut j = j.borrow_mut();
+        let found = j.prepared_keys.contains(&key);
+        if found {
+            j.ready_reuses += 1;
+        }
+        found
+    })
+}
+pub fn record_prepared(key: ImageKey) -> bool {
+    let Some(job) = active_job() else {
+        return false;
+    };
+    let mut j = job.borrow_mut();
+    if !j.prepared_keys.contains(&key) {
+        if j.prepared_keys.len() >= preparation::MAX_KEYS {
+            drop(j);
+            mark_limit();
+            return false;
+        }
+        // A decoded resource must really have a job lease, not a cache-only handle.
+        if !j.decoded.contains_key(&key) && !j.resources.contains_key(&key) {
+            drop(j);
+            mark_error();
+            return false;
+        }
+        j.prepared_keys.push(key);
+    }
+    true
+}
+pub fn continue_preparation() {
+    if let Some(job) = active_job() {
+        job.borrow_mut().preparation_yields += 1;
+    }
+    // Exactly one coalesced task, only when a poll made bounded forward progress.
+    // No self-rescheduling loop; an idle host expires on the existing timer.
+    CONTINUATION_READY.with(|v| v.set(true));
+    queue_notification(false, false);
+}
