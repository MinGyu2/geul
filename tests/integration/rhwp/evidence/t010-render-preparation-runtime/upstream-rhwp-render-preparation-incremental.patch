+pub fn memoize(key: RecipeKey, data: Option<Vec<u8>>, baked: bool) -> Option<Rc<ResolvedPayload>> {
+    let job = active_job()?;
+    let mut j = job.borrow_mut();
+    if j.phase != Phase::Preparing {
+        return None;
+    }
+    if j.memos.len() >= preparation::MAX_KEYS
+        || !j.preparation_budget.as_ref()?.grow(
+            data.as_ref().map_or(0, Vec::capacity).checked_add(
