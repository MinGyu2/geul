+/// 렌더러 전역 이미지 캐시 상태(JSON). 문서와 별도 수명이며 모든 문서가 함께 쓴다.
+///
+/// `{"decoded":{entries,negativeEntries,pendingEntries,transientEntries,bytes,maxBytes,maxEntries,maxEntryBytes,hits,misses,evictions,oversize,rejected},"images":{...}}`
+///
+/// `bytes`는 캐시가 붙잡은 양의 추정이다(디코드 Canvas: RGBA 너비×높이×4, 브라우저 이미지: data URL 길이 + 로드 뒤 RGBA
+/// 추정). 브라우저 내부 사본·프로세스 메모리의 상한이 아니다.
+#[cfg(target_arch = "wasm32")]
+#[wasm_bindgen(js_name = rendererCacheStats)]
+pub fn renderer_cache_stats() -> String {
+    let (decoded, images) = crate::renderer::web_canvas::renderer_cache_stats();
+    let json = |s: crate::renderer::surface_cache::CacheStats| {
+        serde_json::json!({
+            "entries": s.entries, "negativeEntries": s.negative_entries, "bytes": s.bytes,
+            "maxBytes": s.max_bytes, "maxEntries": s.max_entries, "maxEntryBytes": s.max_entry_bytes,
+            "pendingEntries": s.pending_entries, "transientEntries": s.transient_entries,
+            "hits": s.hits, "misses": s.misses, "evictions": s.evictions, "oversize": s.oversize, "rejected": s.rejected,
+        })
+    };
+    serde_json::json!({ "decoded": json(decoded), "images": json(images) }).to_string()
+}
